// SPDX-License-Identifier: MIT
// What a GPU backend needs from the software renderer: coverage masks of icons drawn exactly as `Raster` draws them,
// to keep in a texture atlas, the polygon of a path, and the registered images' pixels (a text run's glyphs are
// raster_text.cee's shapeRun and rasterizeGlyph).

/// A registered image's size, from `Raster.imageSize`.
public struct ImageSize {
    public w: usize;
    public h: usize;
}

impl<region r> Raster<r> {
    /// The polygon Raster fills to draw `Command.Path(area, look)` with `data`, built under `m` (the frame's
    /// pixels from the element's points) as `drawPath` builds it: its edges as x0, y0, x1, y1 (frame pixels) into
    /// `out`, each subpath closed, horizontal edges left out. The number of edges, or null when the path did not fit
    /// `out` or Raster's points. The fill rule is the look's (even-odd only for an even-odd fill; strokes are
    /// nonzero), and the result is drawn clipped to `area`.
    public fn flattenPath(
        borrow mut this,
        data: Slice<u8>,
        area: Rect,
        look: PathLook,
        m: Affine2,
        out: SliceMut<f32>,
    ) -> usize? {
        if (!this.transforms.push(m.after(look.placement(area)))) {
            return null;
        }
        let before = this.overflowed;
        this.overflowed = false;
        beginPath(mut this);
        buildPath(mut this, data, look);
        let failed = this.overflowed;
        this.overflowed = before;
        this.transforms.pop();
        if (failed) {
            return null;
        }
        if (this.pointCount < 3) {
            return 0;
        }
        var n: usize = 0;
        for (c in 0..this.contourCount) {
            let start = this.contourStarts[c];
            let end = if (c + 1 < this.contourCount) this.contourStarts[c + 1] else this.pointCount;
            if (end <= start + 1) {
                continue;
            }
            for (i in start..end) {
                let a = this.points[i];
                let b = if (i + 1 < end) this.points[i + 1] else this.points[start];
                if (a.y == b.y) {
                    continue;
                }
                if (n * 4 + 4 > out.length) {
                    return null;
                }
                out[n * 4] = a.x;
                out[n * 4 + 1] = a.y;
                out[n * 4 + 2] = b.x;
                out[n * 4 + 3] = b.y;
                n += 1;
            }
        }
        return n;
    }

    /// The size of image `handle`, or null when no image is registered under it.
    public fn imageSize(borrow this, handle: u32) -> ImageSize? {
        match (this.imageIndex(handle)) {
            Some(k) => {
                let rec = this.images.get(k);
                return ImageSize { w: rec.w, h: rec.h };
            }
            null => { return null; }
        }
    }

    /// The pixels of image `handle`, to copy into a texture: row-major, `imageSize(handle).w` to a row, 0xAABBGGRR
    /// with straight alpha (bytes R, G, B, A). Null when no image is registered under it.
    public fn imagePixels(borrow this, handle: u32) -> Slice<u32>? {
        match (this.imageIndex(handle)) {
            Some(k) => {
                let rec = this.images.get(k);
                return borrow this.imagePool[rec.offset..rec.offset + rec.w * rec.h];
            }
            null => { return null; }
        }
    }

    /// Draws `command` (with `text` for a `Command.Text`) at one pixel per point into a transparent `width` ×
    /// `height` frame, and writes the frame's coverage, row by row, to `out`. Draw it in white for a mask: the
    /// coverage is then the alpha `Raster` would composite. False when the size exceeds the capacity or `out`. The
    /// frame's size and the pixel ratio are restored, so a `Raster` used for text metrics can make masks between
    /// frames.
    public fn rasterizeMask(
        borrow mut this,
        command: Command,
        text: Slice<u8>,
        width: usize,
        height: usize,
        out: SliceMut<u8>,
    ) -> bool {
        if (out.length < width * height) {
            return false;
        }
        let savedRatio = this.ratio;
        let savedWidth = idx(this.width);
        let savedHeight = idx(this.height);
        if (!this.resize(width, height)) {
            return false;
        }
        this.ratio = 1.0;
        this.begin(Color.rgba(0, 0, 0, 0));
        this.draw(command, text);
        this.finish();
        for (k in 0..width * height) {
            out[k] = truncate<u8>(this.pool[k] >> 24);
        }
        this.ratio = savedRatio;
        let restored = this.resize(savedWidth, savedHeight);
        return true;
    }
}
