// SPDX-License-Identifier: MIT
// TrueType fonts: a port of ThorVG 1.1.2's sfnt/TTF reader (tvgSfntReader.cpp, tvgTtfReader.cpp), which is what
// renders ClayWind's text today, so glyph shapes, advances, kerning and the ascent match it.
//   - tables by binary search of the table directory; head (unitsPerEm, loca format), hhea (ascent, descent,
//     line gap, long metrics count), maxp, cmap (3/10 or 0/4 format 12, else 3/1 or 0/3 format 4 or 6), hmtx;
//   - outlines from glyf/loca: quadratic contours become cubics (the 2/3 rule), y flipped; composite glyphs place
//     their components by offset (ThorVG ignores component scales too);
//   - kerning from a format-0 `kern` table (no GPOS, as ThorVG).
// Fonts read only the bytes they are given: the caller owns them (the Raster keeps them in its pool).

const INVALID_GLYPH: u32 = 0xFFFFFFFF;

/// A parsed font: table offsets and metrics (in font units).
public struct FontInfo {
    public unitsPerEm: f32;
    public ascent: f32;
    public descent: f32;
    public lineGap: f32;
    locaFormat: u32;
    numHmtx: u32;
    cmap: usize;
    hmtx: usize;
    loca: usize;
    glyf: usize;
    kern: usize;
    maxp: usize;
    /// A CFF face's 'CFF ' table and its parts (font_cff.cee), or 0.
    cff: usize;
    cffInfo: CffInfo;
    /// OpenType layout tables (font_layout.cee), or 0.
    gsub: usize;
    gpos: usize;
    gdef: usize;
    /// Colour layers and their palettes (COLR version 0, CPAL), or 0.
    colr: usize;
    cpal: usize;
    /// Apple's glyph metamorphosis table (font_morx.cee), used when there is no GSUB; or 0.
    morx: usize;
}

/// One glyph's outline in font units (y already flipped, as ThorVG builds it): ops 0 = move, 1 = line,
/// 2 = cubic (three points), 3 = close.
struct GlyphOutline {
    ops: [u8; 1024];
    xs: [f32; 3072];
    ys: [f32; 3072];
    opCount: usize;
    ptCount: usize;
    overflowed: bool;
}

fn emptyOutline() -> GlyphOutline => GlyphOutline {
    ops: [0u8; 1024],
    xs: [0.0f32; 3072],
    ys: [0.0f32; 3072],
    opCount: 0,
    ptCount: 0,
    overflowed: false,
};

fn outlineOp(o: borrow mut GlyphOutline, op: u8, x: f32, y: f32) {
    if (o.opCount >= 1024 || o.ptCount >= 3072) {
        o.overflowed = true;
        return;
    }
    o.ops[o.opCount] = op;
    o.opCount += 1;
    if (op != 3) {
        o.xs[o.ptCount] = x;
        o.ys[o.ptCount] = y;
        o.ptCount += 1;
    }
}

fn outlineCubic(o: borrow mut GlyphOutline, ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32) {
    if (o.opCount >= 1024 || o.ptCount + 3 > 3072) {
        o.overflowed = true;
        return;
    }
    o.ops[o.opCount] = 2;
    o.opCount += 1;
    o.xs[o.ptCount] = ax;
    o.ys[o.ptCount] = ay;
    o.xs[o.ptCount + 1] = bx;
    o.ys[o.ptCount + 1] = by;
    o.xs[o.ptCount + 2] = cx;
    o.ys[o.ptCount + 2] = cy;
    o.ptCount += 3;
}

// ---- byte access (big-endian, bounds-checked by the slice) ---------------------------------------------------

fn valid(d: Slice<u8>, offset: usize, margin: usize) -> bool => offset <= d.length && d.length - offset >= margin;

fn u8at(d: Slice<u8>, o: usize) -> u32 => d[o] as u32;
fn u16at(d: Slice<u8>, o: usize) -> u32 => ((d[o] as u32) << 8) | (d[o + 1] as u32);
fn i16at(d: Slice<u8>, o: usize) -> i32 {
    let v = u16at(d, o);
    return if (v >= 0x8000) truncate<i32>(v) - 65536 else truncate<i32>(v);
}
fn i8at(d: Slice<u8>, o: usize) -> i32 {
    let v = d[o] as u32;
    return if (v >= 0x80) truncate<i32>(v) - 256 else truncate<i32>(v);
}
fn u32at(d: Slice<u8>, o: usize) -> u32 => (u16at(d, o) << 16) | u16at(d, o + 2);

fn tagValue(t: [u8; 4]) -> u32 => ((t[0] as u32) << 24) | ((t[1] as u32) << 16) | ((t[2] as u32) << 8) | (t[3] as u32);

/// SfntReader::table: the offset of table `tag` in the face whose table directory is at `dir` (0 for a single font;
/// a collection's faces each have one), or 0 (bsearch over the sorted 16-byte directory records). Offsets are from
/// the file's start in a collection too.
fn tableOffset(d: Slice<u8>, dir: usize, tag: [u8; 4]) -> usize {
    if (!valid(d, dir, 12)) {
        return 0;
    }
    let count = u16at(d, dir + 4) as usize;
    if (!valid(d, dir + 12, count * 16)) {
        return 0;
    }
    let key = tagValue(tag);
    var lo: usize = 0;
    var hi = count;
    while (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        let v = u32at(d, dir + 12 + mid * 16);
        if (v == key) {
            return u32at(d, dir + 12 + mid * 16 + 8) as usize;
        }
        if (v < key) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return 0;
}

/// SfntReader::header + TtfReader::header: null if this is not a usable TrueType font (the first face of a
/// collection).
public fn parseFont(d: Slice<u8>) -> FontInfo? => parseFontFace(d, 0);

/// How many faces a font file holds: a collection's count ('ttcf'), 1 for a single font, 0 for neither.
public fn fontFaceCount(d: Slice<u8>) -> u32 {
    if (!valid(d, 0, 12)) {
        return 0;
    }
    if (u32at(d, 0) == 0x74746366) {
        return u32at(d, 8);
    }
    return 1;
}

/// Face `face` of a font file (a TrueType collection's faces in order; 0 for a single font): null if there is no
/// such face or it is not a usable TrueType font (CFF outlines are not read).
public fn parseFontFace(d: Slice<u8>, face: u32) -> FontInfo? {
    if (!valid(d, 0, 12)) {
        return null;
    }
    var dir: usize = 0;
    if (u32at(d, 0) == 0x74746366) {
        let faces = u32at(d, 8);
        if (face >= faces || !valid(d, 12, (faces as usize) * 4)) {
            return null;
        }
        dir = u32at(d, 12 + (face as usize) * 4) as usize;
        if (!valid(d, dir, 12)) {
            return null;
        }
    } else if (face != 0) {
        return null;
    }
    let kind = u32at(d, dir);
    if (kind != 0x00010000 && kind != 0x74727565 && kind != 0x4F54544F) {
        return null;
    }
    let head = tableOffset(d, dir, ['h', 'e', 'a', 'd']);
    if (head == 0 || !valid(d, head, 54)) {
        return null;
    }
    let hhea = tableOffset(d, dir, ['h', 'h', 'e', 'a']);
    if (hhea == 0 || !valid(d, hhea, 36)) {
        return null;
    }
    let maxp = tableOffset(d, dir, ['m', 'a', 'x', 'p']);
    if (maxp == 0 || !valid(d, maxp, 6)) {
        return null;
    }
    let glyphs = u16at(d, maxp + 4);
    let hmtxs = u16at(d, hhea + 34);
    if (glyphs == 0 || hmtxs == 0 || hmtxs > glyphs) {
        return null;
    }
    let cmap = tableOffset(d, dir, ['c', 'm', 'a', 'p']);
    if (cmap == 0 || !valid(d, cmap, 4)) {
        return null;
    }
    let hmtx = tableOffset(d, dir, ['h', 'm', 't', 'x']);
    if (!valid(d, hmtx, (hmtxs as usize) * 4)) {
        return null;
    }
    let kern = tableOffset(d, dir, ['k', 'e', 'r', 'n']);
    if (kern != 0 && (!valid(d, kern, 4) || u16at(d, kern) != 0)) {
        return null;
    }
    let loca = tableOffset(d, dir, ['l', 'o', 'c', 'a']);
    let glyf = tableOffset(d, dir, ['g', 'l', 'y', 'f']);
    let cff = tableOffset(d, dir, ['C', 'F', 'F', ' ']);
    var cffInfo = CffInfo { charStrings: 0, globalSubrs: 0, localSubrs: 0, fdArray: 0, fdSelect: 0 };
    if (cff != 0) {
        cffInfo = parseCff(d, cff)?;
    } else if ((loca == 0 || glyf == 0) && tableOffset(d, dir, ['C', 'B', 'L', 'C']) == 0 &&
        tableOffset(d, dir, ['s', 'b', 'i', 'x']) == 0) {
        // No outlines: only a colour-bitmap face (its bitmaps come from the host, raster_color.cee) has none.
        return null;
    }
    return FontInfo {
        unitsPerEm: round<f32>(u16at(d, head + 18)),
        ascent: round<f32>(i16at(d, hhea + 4)),
        descent: round<f32>(i16at(d, hhea + 6)),
        lineGap: round<f32>(i16at(d, hhea + 8)),
        locaFormat: u16at(d, head + 50),
        numHmtx: hmtxs,
        cmap: cmap,
        hmtx: hmtx,
        loca: loca,
        glyf: glyf,
        kern: kern,
        maxp: maxp,
        cff: cff,
        cffInfo: cffInfo,
        gsub: tableOffset(d, dir, ['G', 'S', 'U', 'B']),
        gpos: tableOffset(d, dir, ['G', 'P', 'O', 'S']),
        gdef: tableOffset(d, dir, ['G', 'D', 'E', 'F']),
        colr: tableOffset(d, dir, ['C', 'O', 'L', 'R']),
        cpal: tableOffset(d, dir, ['C', 'P', 'A', 'L']),
        morx: tableOffset(d, dir, ['m', 'o', 'r', 'x']),
    };
}

// ---- character map ---------------------------------------------------------------------------------------------

fn cmap12(d: Slice<u8>, table: usize, codepoint: u32) -> u32 {
    let len = u32at(d, table + 4) as usize;
    if (len < 16 || !valid(d, table, len)) {
        return INVALID_GLYPH;
    }
    let count = u32at(d, table + 12) as usize;
    if (!valid(d, table + 16, count * 12)) {
        return INVALID_GLYPH;
    }
    // The groups are sorted by their first code point: a binary search.
    var lo: usize = 0;
    var hi = count;
    while (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        let first = u32at(d, table + mid * 12 + 16);
        let last = u32at(d, table + mid * 12 + 20);
        if (codepoint < first) {
            hi = mid;
        } else if (codepoint > last) {
            lo = mid + 1;
        } else {
            return (codepoint - first) + u32at(d, table + mid * 12 + 24);
        }
    }
    return INVALID_GLYPH;
}

/// SfntReader::cmap_4 (the binary search over end codes that settles on the next highest).
fn cmap4(d: Slice<u8>, table: usize, codepoint: u32) -> u32 {
    if (codepoint > 0xFFFF || !valid(d, table, 8)) {
        return INVALID_GLYPH;
    }
    let segX2 = u16at(d, table) as usize;
    if (segX2 == 0 || (segX2 & 1) != 0) {
        return INVALID_GLYPH;
    }
    let endCodes = table + 8;
    let startCodes = endCodes + segX2 + 2;
    let idDeltas = startCodes + segX2;
    let idRangeOffsets = idDeltas + segX2;
    if (!valid(d, idRangeOffsets, segX2)) {
        return INVALID_GLYPH;
    }
    let n = segX2 / 2;
    var low: usize = 0;
    var high = n - 1;
    while (low != high) {
        let mid = low + (high - low) / 2;
        if (codepoint > u16at(d, endCodes + mid * 2)) {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    let segment = low * 2;
    let startCode = u16at(d, startCodes + segment);
    if (startCode > codepoint) {
        return 0;
    }
    let delta = u16at(d, idDeltas + segment);
    let rangeOffset = u16at(d, idRangeOffsets + segment);
    if (rangeOffset == 0) {
        return (codepoint + delta) & 0xFFFF;
    }
    let offset = idRangeOffsets + segment + (rangeOffset as usize) + 2 * ((codepoint - startCode) as usize);
    if (!valid(d, offset, 2)) {
        return INVALID_GLYPH;
    }
    let id = u16at(d, offset);
    return if (id > 0) (id + delta) & 0xFFFF else 0;
}

fn cmap6(d: Slice<u8>, table: usize, codepoint: u32) -> u32 {
    if (codepoint > 0xFFFF) {
        return 0;
    }
    let first = u16at(d, table);
    let count = u16at(d, table + 2);
    if (!valid(d, table, 4 + 2 * (count as usize)) || codepoint < first || codepoint - first >= count) {
        return INVALID_GLYPH;
    }
    return u16at(d, table + 4 + 2 * ((codepoint - first) as usize));
}

/// SfntReader::glyph: full-repertoire maps first, then BMP maps.
public fn glyphIndex(d: Slice<u8>, f: FontInfo, codepoint: u32) -> u32 => cmapLookup(d, f.cmap, codepoint);

/// The glyph of `codepoint` in a cmap table on its own (`cmap` starts at the table, as a font catalog reads it), or
/// 0 when it maps none.
public fn cmapGlyph(cmap: Slice<u8>, codepoint: u32) -> u32 {
    let g = cmapLookup(cmap, 0, codepoint);
    return if (g == INVALID_GLYPH) 0 else g;
}

/// glyphIndex for the cmap table at `base` of `d`.
fn cmapLookup(d: Slice<u8>, base: usize, codepoint: u32) -> u32 {
    let count = u16at(d, base + 2) as usize;
    if (!valid(d, base, 4 + count * 8)) {
        return INVALID_GLYPH;
    }
    for (i in 0..count) {
        let entry = base + 4 + i * 8;
        let kind = u16at(d, entry) * 64 + u16at(d, entry + 2);
        if (kind == 4 || kind == 202) {
            let table = base + (u32at(d, entry + 4) as usize);
            if (!valid(d, table, 8)) {
                return INVALID_GLYPH;
            }
            return if (u16at(d, table) == 12) cmap12(d, table, codepoint) else INVALID_GLYPH;
        }
    }
    for (i in 0..count) {
        let entry = base + 4 + i * 8;
        let kind = u16at(d, entry) * 64 + u16at(d, entry + 2);
        if (kind == 3 || kind == 193) {
            let table = base + (u32at(d, entry + 4) as usize);
            if (!valid(d, table, 6)) {
                return INVALID_GLYPH;
            }
            let format = u16at(d, table);
            if (format == 4) {
                return cmap4(d, table + 6, codepoint);
            }
            if (format == 6) {
                return cmap6(d, table + 6, codepoint);
            }
            return INVALID_GLYPH;
        }
    }
    return INVALID_GLYPH;
}

/// The subtable glyphIndex reads in the cmap table at `base` of `d`: its offset and format, or null.
fn cmapSubtable(d: Slice<u8>, base: usize) -> [usize; 2]? {
    if (!valid(d, base, 4)) {
        return null;
    }
    let count = u16at(d, base + 2) as usize;
    if (!valid(d, base, 4 + count * 8)) {
        return null;
    }
    for (pass in 0usize..2) {
        for (i in 0..count) {
            let entry = base + 4 + i * 8;
            let kind = u16at(d, entry) * 64 + u16at(d, entry + 2);
            let wanted = if (pass == 0) kind == 4 || kind == 202 else kind == 3 || kind == 193;
            if (wanted) {
                let table = base + (u32at(d, entry + 4) as usize);
                if (!valid(d, table, 2)) {
                    return null;
                }
                return [table, u16at(d, table) as usize];
            }
        }
    }
    return null;
}

/// How many code points a cmap table on its own maps in each block of 256 (`counts[b]` for code points b × 256 to
/// b × 256 + 255, as far as `counts` reaches; saturating), for choosing a fallback font by what it covers. Format 4
/// segments count whole, so a segment with unmapped code points in it counts them too.
public fn cmapCoverage(cmap: Slice<u8>, counts: SliceMut<u16>) {
    for (k in 0..counts.length) {
        counts[k] = 0;
    }
    let sub = match (cmapSubtable(cmap, 0)) {
        Some(s) => s,
        null => { return; }
    };
    let table = sub[0];
    if (sub[1] == 12) {
        if (!valid(cmap, table, 16)) {
            return;
        }
        let count = u32at(cmap, table + 12) as usize;
        if (!valid(cmap, table + 16, count * 12)) {
            return;
        }
        for (i in 0..count) {
            addCoverage(counts, u32at(cmap, table + 16 + i * 12), u32at(cmap, table + 20 + i * 12));
        }
    } else if (sub[1] == 4) {
        if (!valid(cmap, table, 14)) {
            return;
        }
        let segX2 = u16at(cmap, table + 6) as usize;
        let ends = table + 14;
        let starts = ends + segX2 + 2;
        if (!valid(cmap, starts, segX2)) {
            return;
        }
        for (k in 0..segX2 / 2) {
            let first = u16at(cmap, starts + k * 2);
            let last = u16at(cmap, ends + k * 2);
            if (first <= last && last != 0xFFFF) {
                addCoverage(counts, first, last);
            }
        }
    }
}

fn addCoverage(counts: SliceMut<u16>, first: u32, last: u32) {
    var cp = first;
    while (cp <= last) {
        let block = (cp >> 8) as usize;
        if (block >= counts.length) {
            return;
        }
        let blockEnd = (cp | 0xFF).min(last);
        let added = blockEnd - cp + 1;
        counts[block] = truncate<u16>(((counts[block] as u32) + added).min(0xFFFF));
        cp = blockEnd + 1;
    }
}

/// Where face `face` of a font file keeps its table directory: 0 for a single font, a collection's face offset,
/// or null when there is no such face. `d` holds the file's start (12 bytes, and a collection's 4 per face).
public fn faceDirectory(d: Slice<u8>, face: u32) -> usize? {
    if (!valid(d, 0, 12)) {
        return null;
    }
    if (u32at(d, 0) == 0x74746366) {
        let faces = u32at(d, 8);
        if (face >= faces || !valid(d, 12 + (face as usize) * 4, 4)) {
            return null;
        }
        return u32at(d, 12 + (face as usize) * 4) as usize;
    }
    return if (face == 0) 0 else null;
}

/// A table's place in a font file.
public struct FontTable {
    public offset: usize;
    public length: usize;
}

/// Table `tag` in a face's table directory, read on its own (`dir` starts at it): where it is in the file, or null.
public fn findTable(dir: Slice<u8>, tag: [u8; 4]) -> FontTable? {
    if (!valid(dir, 0, 12)) {
        return null;
    }
    let count = u16at(dir, 4) as usize;
    let key = tagValue(tag);
    for (i in 0..count) {
        let record = 12 + i * 16;
        if (!valid(dir, record, 16)) {
            return null;
        }
        if (u32at(dir, record) == key) {
            return FontTable { offset: u32at(dir, record + 8) as usize, length: u32at(dir, record + 12) as usize };
        }
    }
    return null;
}

/// Whether a face's table directory (read on its own) has outlines this reader draws: TrueType, or CFF (not CFF2).
public fn drawableFace(dir: Slice<u8>) -> bool {
    if (!valid(dir, 0, 4)) {
        return false;
    }
    let kind = u32at(dir, 0);
    return kind == 0x00010000 || kind == 0x74727565 || (kind == 0x4F54544F && findTable(
        dir,
        ['C', 'F', 'F', ' '],
    ) != null);
}

// ---- metrics ---------------------------------------------------------------------------------------------------

/// SfntReader::glyphMetrics: the advance width in font units.
public fn glyphAdvance(d: Slice<u8>, f: FontInfo, glyph: u32) -> f32 {
    if (glyph < f.numHmtx) {
        let o = f.hmtx + 4 * (glyph as usize);
        return if (valid(d, o, 4)) round<f32>(u16at(d, o)) else 0.0;
    }
    let boundary = f.hmtx + 4 * (f.numHmtx as usize);
    return if (boundary >= 4 && valid(d, boundary - 4, 4)) round<f32>(u16at(d, boundary - 4)) else 0.0;
}

/// TtfReader::positioning: the horizontal kerning between two glyphs, in font units (0 without a kern table).
public fn kerning(d: Slice<u8>, f: FontInfo, left: u32, right: u32) -> f32 {
    if (f.kern == 0) {
        return 0.0;
    }
    var k = f.kern;
    var tables = u16at(d, k + 2);
    k += 4;
    var x: f32 = 0.0;
    while (tables > 0) {
        if (!valid(d, k, 6)) {
            return x;
        }
        let length = u16at(d, k + 2) as usize;
        let format = u8at(d, k + 4);
        let flags = u8at(d, k + 5);
        k += 6;
        if (format == 0 && (flags & 1) != 0 && (flags & 2) == 0) {
            if (!valid(d, k, 8)) {
                return x;
            }
            let pairs = u16at(d, k) as usize;
            k += 8;
            let key = (left << 16) | right;
            var lo: usize = 0;
            var hi = pairs;
            while (lo < hi) {
                let mid = lo + (hi - lo) / 2;
                let rec = k + mid * 6;
                if (!valid(d, rec, 6)) {
                    break;
                }
                let v = u32at(d, rec);
                if (v == key) {
                    if ((flags & 4) == 0) {
                        x += round<f32>(i16at(d, rec + 4));
                    }
                    break;
                }
                if (v < key) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
        }
        // As ThorVG: advance by the subtable length from where the reading stopped.
        k += length;
        tables -= 1;
    }
    return x;
}

// ---- outlines --------------------------------------------------------------------------------------------------

/// TtfReader::outlineOffset: the glyph's outline, or 0 for an empty glyph.
fn outlineOffset(d: Slice<u8>, f: FontInfo, glyph: u32) -> usize {
    var cur: usize = 0;
    var next: usize = 0;
    if (f.locaFormat == 0) {
        let base = f.loca + 2 * (glyph as usize);
        if (!valid(d, base, 4)) {
            return 0;
        }
        cur = 2 * (u16at(d, base) as usize);
        next = 2 * (u16at(d, base + 2) as usize);
    } else {
        let base = f.loca + 4 * (glyph as usize);
        if (!valid(d, base, 8)) {
            return 0;
        }
        cur = u32at(d, base) as usize;
        next = u32at(d, base + 4) as usize;
    }
    return if (cur == next) 0 else f.glyf + cur;
}

/// TtfReader::convert: appends the glyph's outline, offset by (ox, oy) font units, to `out`.
fn decodeGlyph(
    d: Slice<u8>,
    f: FontInfo,
    glyph: u32,
    ox: f32,
    oy: f32,
    depth: u32,
    out: borrow mut GlyphOutline,
) -> bool {
    if (f.cff != 0) {
        return decodeCffGlyph(d, f.cff, f.cffInfo, glyph, ox, oy, mut out);
    }
    if (f.glyf == 0 || f.loca == 0) {
        return true;
    }
    let at = outlineOffset(d, f, glyph);
    if (at == 0) {
        return true;
    }
    if (!valid(d, at, 10)) {
        return false;
    }
    let contours = i16at(d, at);
    if (contours == 0) {
        return false;
    }
    if (contours < 0) {
        var maxDepth: u32 = 16;
        if (valid(d, f.maxp, 32) && u32at(d, f.maxp) >= 0x00010000) {
            maxDepth = u16at(d, f.maxp + 30);
        }
        if (depth > maxDepth) {
            return false;
        }
        return decodeComposite(d, f, at, ox, oy, depth + 1, out);
    }
    let cn = truncate<usize>(contours);
    var p = at + 10;
    if (!valid(d, p, cn * 2 + 2)) {
        return false;
    }
    let pointCount = (u16at(d, p + (cn - 1) * 2) as usize) + 1;
    if (pointCount > 1024) {
        out.overflowed = true;
        return false;
    }
    var ends = [0usize; 256];
    if (cn > 256) {
        out.overflowed = true;
        return false;
    }
    for (i in 0..cn) {
        ends[i] = u16at(d, p) as usize;
        p += 2;
    }
    p += 2 + (u16at(d, p) as usize);
    // Flags.
    var flags = [0u8; 1024];
    var value: u8 = 0;
    var repeat: u32 = 0;
    for (i in 0..pointCount) {
        if (repeat > 0) {
            repeat -= 1;
        } else {
            if (!valid(d, p, 1)) {
                return false;
            }
            value = d[p];
            p += 1;
            if ((value & 0x08) != 0) {
                if (!valid(d, p, 1)) {
                    return false;
                }
                repeat = d[p] as u32;
                p += 1;
            }
        }
        flags[i] = value;
    }
    // Coordinates: x deltas, then y deltas (y negated, as ThorVG builds it).
    var px = [0.0f32; 1024];
    var py = [0.0f32; 1024];
    var acc: i32 = 0;
    for (i in 0..pointCount) {
        let fl = flags[i];
        if ((fl & 0x02) != 0) {
            if (!valid(d, p, 1)) {
                return false;
            }
            let v = truncate<i32>(d[p] as u32);
            p += 1;
            acc += if ((fl & 0x10) != 0) v else -v;
        } else if ((fl & 0x10) == 0) {
            if (!valid(d, p, 2)) {
                return false;
            }
            acc += i16at(d, p);
            p += 2;
        }
        px[i] = ox + round<f32>(acc);
    }
    acc = 0;
    for (i in 0..pointCount) {
        let fl = flags[i];
        if ((fl & 0x04) != 0) {
            if (!valid(d, p, 1)) {
                return false;
            }
            let v = truncate<i32>(d[p] as u32);
            p += 1;
            acc += if ((fl & 0x20) != 0) v else -v;
        } else if ((fl & 0x20) == 0) {
            if (!valid(d, p, 2)) {
                return false;
            }
            acc += i16at(d, p);
            p += 2;
        }
        py[i] = oy - round<f32>(acc);
    }
    // Quadratic contours as cubics (2/3 rule), each starting with a move and ending with a close.
    let k: f32 = 2.0 / 3.0;
    var begin: usize = 0;
    for (c in 0..cn) {
        let end = ends[c];
        if (end < begin || end >= pointCount) {
            return false;
        }
        var offCurve = (flags[begin] & 1) == 0;
        let sx = if (offCurve) (px[begin] + px[end]) * 0.5 else px[begin];
        let sy = if (offCurve) (py[begin] + py[end]) * 0.5 else py[begin];
        outlineOp(mut out, 0, sx, sy);
        var lx = sx;
        var ly = sy;
        let count = end - begin + 1;
        for (x in 1..count) {
            let i = begin + x;
            let qx = px[i - 1];
            let qy = py[i - 1];
            if ((flags[i] & 1) != 0) {
                if (offCurve) {
                    outlineCubic(
                        mut out,
                        lx + k * (qx - lx),
                        ly + k * (qy - ly),
                        px[i] + k * (qx - px[i]),
                        py[i] + k * (qy - py[i]),
                        px[i],
                        py[i],
                    );
                    offCurve = false;
                } else {
                    outlineOp(mut out, 1, px[i], py[i]);
                }
                lx = px[i];
                ly = py[i];
            } else {
                if (offCurve) {
                    let ex = (px[i] + qx) * 0.5;
                    let ey = (py[i] + qy) * 0.5;
                    outlineCubic(
                        mut out,
                        lx + k * (qx - lx),
                        ly + k * (qy - ly),
                        ex + k * (qx - ex),
                        ey + k * (qy - ey),
                        ex,
                        ey,
                    );
                    lx = ex;
                    ly = ey;
                } else {
                    offCurve = true;
                }
            }
        }
        if (offCurve) {
            let qx = px[begin + count - 1];
            let qy = py[begin + count - 1];
            outlineCubic(
                mut out,
                lx + k * (qx - lx),
                ly + k * (qy - ly),
                sx + k * (qx - sx),
                sy + k * (qy - sy),
                sx,
                sy,
            );
        }
        outlineOp(mut out, 3, 0.0, 0.0);
        begin = end + 1;
    }
    return true;
}

/// TtfReader::composite: components placed by their x/y offsets (scales are read past, as ThorVG does).
/// An F2Dot14 number at `at`.
fn f2dot14(d: Slice<u8>, at: usize) -> f32 => round<f32>(i16at(d, at)) / 16384.0;

fn decodeComposite(
    d: Slice<u8>,
    f: FontInfo,
    at: usize,
    ox: f32,
    oy: f32,
    depth: u32,
    out: borrow mut GlyphOutline,
) -> bool {
    var p = at + 10;
    loop {
        if (!valid(d, p, 4)) {
            return false;
        }
        let flags = u16at(d, p);
        let component = u16at(d, p + 2);
        p += 4;
        var cx: f32 = 0.0;
        var cy: f32 = 0.0;
        if ((flags & 0x0001) != 0) {
            if (!valid(d, p, 4)) {
                return false;
            }
            if ((flags & 0x0002) != 0) {
                cx = round<f32>(i16at(d, p));
                cy = -round<f32>(i16at(d, p + 2));
            }
            p += 4;
        } else {
            if (!valid(d, p, 2)) {
                return false;
            }
            if ((flags & 0x0002) != 0) {
                cx = round<f32>(i8at(d, p));
                cy = -round<f32>(i8at(d, p + 1));
            }
            p += 2;
        }
        // A scaled component (WE_HAVE_A_SCALE, X_AND_Y_SCALE, TWO_BY_TWO): its 2x2 transform, in F2Dot14.
        var xx: f32 = 1.0;
        var xy: f32 = 0.0;
        var yx: f32 = 0.0;
        var yy: f32 = 1.0;
        var scaled = false;
        if ((flags & 0x0008) != 0 && valid(d, p, 2)) {
            xx = f2dot14(d, p);
            yy = xx;
            scaled = true;
            p += 2;
        } else if ((flags & 0x0040) != 0 && valid(d, p, 4)) {
            xx = f2dot14(d, p);
            yy = f2dot14(d, p + 2);
            scaled = true;
            p += 4;
        } else if ((flags & 0x0080) != 0 && valid(d, p, 8)) {
            xx = f2dot14(d, p);
            xy = f2dot14(d, p + 2);
            yx = f2dot14(d, p + 4);
            yy = f2dot14(d, p + 6);
            scaled = true;
            p += 8;
        }
        if (!scaled) {
            if (!decodeGlyph(d, f, component, ox + cx, oy + cy, depth, mut out)) {
                return false;
            }
        } else {
            // Decoded at the origin, then transformed (y is stored negated) and moved into place.
            let first = out.ptCount;
            if (!decodeGlyph(d, f, component, 0.0, 0.0, depth, mut out)) {
                return false;
            }
            for (i in first..out.ptCount) {
                let x = out.xs[i];
                let y = out.ys[i];
                out.xs[i] = ox + cx + xx * x - yx * y;
                out.ys[i] = oy + cy - xy * x + yy * y;
            }
        }
        if ((flags & 0x0020) == 0) {
            return true;
        }
    }
}

/// Decodes one UTF-8 code point at `i`; returns it and the bytes it used. Malformed input (a stray continuation
/// byte, a missing one, an overlong form, a surrogate, past U+10FFFF) is U+FFFD for one byte, as the WHATWG decoder
/// replaces it.
public fn decodeUtf8(s: Slice<u8>, i: usize) -> [u32; 2] {
    let b0 = s[i] as u32;
    if (b0 < 0x80) {
        return [b0, 1];
    }
    var need: usize = 0;
    var cp: u32 = 0;
    var low: u32 = 0x80;
    var high: u32 = 0xBF;
    if (b0 >= 0xC2 && b0 <= 0xDF) {
        need = 1;
        cp = b0 & 0x1F;
    } else if (b0 >= 0xE0 && b0 <= 0xEF) {
        need = 2;
        cp = b0 & 0x0F;
        if (b0 == 0xE0) {
            low = 0xA0; // not overlong
        } else if (b0 == 0xED) {
            high = 0x9F; // not a surrogate
        }
    } else if (b0 >= 0xF0 && b0 <= 0xF4) {
        need = 3;
        cp = b0 & 0x07;
        if (b0 == 0xF0) {
            low = 0x90; // not overlong
        } else if (b0 == 0xF4) {
            high = 0x8F; // not past U+10FFFF
        }
    } else {
        return [0xFFFD, 1];
    }
    if (i + need >= s.length) {
        return [0xFFFD, 1];
    }
    for (k in 1..need + 1) {
        let b = s[i + k] as u32;
        let lo = if (k == 1) low else 0x80;
        let hi = if (k == 1) high else 0xBF;
        if (b < lo || b > hi) {
            return [0xFFFD, 1];
        }
        cp = (cp << 6) | (b & 0x3F);
    }
    return [cp, truncate<u32>(need + 1)];
}
