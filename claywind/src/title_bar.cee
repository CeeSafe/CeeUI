// SPDX-License-Identifier: MIT
// A title bar the program draws (CeeSafe ADR 0206): the window's title and its minimize, maximize and close buttons,
// in the theme, along the top of the window. It is fixed over the content, which keeps clear of it as of a phone's
// status bar: the platform counts the bar in the safe area's top (claywind-desktop's Pane does), so a frame that
// keeps to the safe area, and anything placed from its top, is below it. The Ui draws it and says what was pressed;
// where it lies (`layout`) is what the window is told, so the system moves the window by the bar and opens its menu
// there. Platform-neutral: claywind-desktop gives the layout to the window and acts on the presses.

/// The bar's height in points.
public const TITLE_BAR_HEIGHT: f32 = 36.0;

/// The bar's place among floating elements: over the page's (a badge's 10), under menus and popups (500).
public const TITLE_BAR_Z: i32 = 100;

/// Which of the bar's buttons were pressed this frame (a click, or Enter or Space with the focus on it).
public struct TitleBarPress {
    public minimize: bool;
    public maximize: bool;
    public close: bool;
}

/// Where the bar and its buttons were laid out, in points from the frame's top left.
public struct TitleBarLayout {
    public height: f32;
    public minimize: Rect;
    public maximize: Rect;
    public close: Rect;
}

/// The title bar (ADR 0206's step 4).
public struct TitleBar {
    /// The bar, fixed along the window's top over the content (above the page's own floating elements, below its
    /// menus and popups): the title, then the buttons at the right. `maximized` chooses the maximize button's name
    /// (Restore when it is). Any place in the frame will do.
    public fn draw(ui: borrow mut Ui, title: StringView, maximized: bool) -> TitleBarPress =>
        TitleBar.drawWith(mut ui, title, maximized, Rect.zero());

    /// The bar beside the system's own buttons (CeeSafe's `Window.systemButtons()`, macOS's traffic lights):
    /// `systemButtons`, in points from the bar's top left, is left clear, the title after it, and when it is not
    /// empty the bar draws no buttons of its own, which are the system's then. An empty one is `draw`'s bar.
    public fn drawWith(
        ui: borrow mut Ui,
        title: StringView,
        maximized: bool,
        systemButtons: Rect,
    ) -> TitleBarPress {
        let theirs = systemButtons.w > 0.0 && systemButtons.h > 0.0;
        ui.open(
            Style.row().id("titleBar").fixed().top(0.0).left(0.0).z(TITLE_BAR_Z).w(
                Size.fixed(ui.screenSize().w),
            ).h(Size.fixed(TITLE_BAR_HEIGHT)).alignXY(AxisAlign.Start, AxisAlign.Center).bg(ui.tone(SLATE_900)),
        );
        if (theirs) {
            ui.open(Style.box().id("titleBar~system").w(Size.fixed(systemButtons.x + systemButtons.w)).h(
                Size.fixed(TITLE_BAR_HEIGHT),
            ));
            ui.close();
        }
        ui.open(Style.box().px(space(3.0)));
        ui.label(title, Text.of().color(ui.tone(SLATE_200)));
        ui.close();
        ui.open(Style.box().w(Size.grow()).h(Size.fixed(TITLE_BAR_HEIGHT)));
        ui.close();
        if (theirs) {
            ui.close();
            return TitleBarPress { minimize: false, maximize: false, close: false };
        }
        let minimize = TitleBar.button(mut ui, "titleBar~minimize", "Minimize", 0, false);
        let maximize = TitleBar.button(
            mut ui,
            "titleBar~maximize",
            if (maximized) "Restore" else "Maximize",
            if (maximized) 3 else 1,
            false,
        );
        let close = TitleBar.button(mut ui, "titleBar~close", "Close", 2, true);
        ui.close();
        return TitleBarPress { minimize: minimize, maximize: maximize, close: close };
    }

    /// Where the bar and its buttons were in the last frame laid out; null before the first.
    public fn layout(ui: borrow Ui) -> TitleBarLayout? {
        let bar = match (ui.boxOf("titleBar")) {
            Some(b) => b,
            null => { return null; }
        };
        let none = Rect.zero();
        return TitleBarLayout {
            height: bar.y + bar.h,
            minimize: match (ui.boxOf("titleBar~minimize")) { Some(r) => r, null => none },
            maximize: match (ui.boxOf("titleBar~maximize")) { Some(r) => r, null => none },
            close: match (ui.boxOf("titleBar~close")) { Some(r) => r, null => none },
        };
    }

    /// One of the buttons: 46 by the bar's height, its glyph (0 a line, 1 a square, 2 a cross, 3 two squares, one
    /// behind the other, for Restore) in the middle, red under the pointer for close, a lighter tone for the others.
    fn button(ui: borrow mut Ui, id: StringView, name: StringView, glyph: u32, danger: bool) -> bool {
        let h = hashId(id);
        let hover = if (danger) RED_600 else ui.tone(SLATE_700);
        ui.open(
            Style.box().idHash(h).w(Size.fixed(46.0)).h(Size.fixed(TITLE_BAR_HEIGHT)).center().cursor(Cursor.Default)
                .hover(Style.of().bg(hover)).active(Style.of().bg(if (danger) RED_700 else ui.tone(SLATE_600))),
        );
        let pressed = ui.clickedHash(h) || ui.activatedByKey(h);
        ui.access(h, AccessRole.Button, name.bytes());
        let ink = ui.tone(SLATE_200);
        if (glyph == 0) {
            ui.open(Style.box().size(Size.fixed(14.0)).icon(ICON_MINUS, ink, 0.0));
        } else if (glyph == 2) {
            ui.open(Style.box().size(Size.fixed(14.0)).icon(ICON_CLOSE, ink, 0.0));
        } else if (glyph == 3) {
            // Restore: the square in front at the lower left, and of the one behind it only what shows, its top and
            // right edges (the button's colour changes under the pointer, so nothing may be painted over). They float
            // in the box, so they take a z over the bar's, which floats too: at their own 0 the bar would cover them.
            // Over the button, they let the pointer through to it (passthrough), or a click at the button's middle
            // would land on them and press nothing.
            ui.open(Style.box().size(Size.fixed(12.0)));
            ui.open(
                Style.box().absolute().passthrough().z(TITLE_BAR_Z + 1).top(0.0).left(3.0).size(
                    Size.fixed(9.0),
                ).borderSides(
                    BorderWidth { left: 0.0, right: 1.25, top: 1.25, bottom: 0.0, betweenChildren: 0.0 },
                    ink,
                ),
            );
            ui.close();
            ui.open(
                Style.box().absolute().passthrough().z(TITLE_BAR_Z + 1).top(3.0).left(0.0).size(Size.fixed(9.0)).border(
                    1.25,
                    ink,
                ),
            );
            ui.close();
        } else {
            ui.open(Style.box().size(Size.fixed(10.0)).border(1.25, ink));
        }
        ui.close();
        ui.close();
        return pressed;
    }
}
