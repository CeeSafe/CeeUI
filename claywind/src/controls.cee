// SPDX-License-Identifier: MIT
// Interactive controls, ported from controls.h: immediate-mode functions you call every frame. Each draws itself with
// the style layer, reads and writes CALLER-OWNED state passed by reference, consumes input, and returns whether it
// changed. No hidden allocation and no per-widget retained store: you own the text buffer, the bool, the selected
// index, the open flag. A control's sub-elements get ids derived from its id ("save~3", "qty~inc" in C).
//
// Differences from C, all forced by the language and none visible: ids are hashed when built (no string formatting
// into fixed char buffers), text buffers are byte slices with a separate length (no NUL terminator), item lists are
// slices of views (C: `const char **` and a count), and the one control that measures text while it is declared
// (`textInputEx`, for its caret) takes the text metrics as an argument, since the Ui does not hold them between
// frames.

/// The id of sub-element `suffix`/`index` of control `base` (C: snprintf("%s~%d") / "%s~pop").
fn subId(base: StringView, suffix: StringView, index: i64) -> u32 {
    var buffer = [0u8; 96];
    var w = TextWriter.create(mut buffer[..]);
    w.text(base);
    w.byte('~');
    w.text(suffix);
    if (index >= 0) {
        w.signed(index);
    }
    return hashBytes(w.written());
}

/// The controls (controls.h's ClayWind_* functions).
public struct Controls {
    /// ClayWind_Button: true on the frame it is clicked.
    public fn button(ui: borrow mut Ui, id: StringView, label: StringView) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h); // Tab reaches it, and Enter or Space presses it
        let focused = ui.hasFocus(h);
        ui.open(
            Style.box().idHash(h).px(space(4.0)).py(space(2.0)).bg(
                ui.tone(SLATE_700),
            ).rounded(Radius.Md).cursor(Cursor.Pointer)
                .hover(Style.of().bg(ui.tone(SLATE_600))).active(Style.of().bg(ui.tone(SLATE_500)))
                .isFocused(focused).focus(Style.of().ring(2.0, BLUE_400, 2.0)),
        );
        // A click: the pointer went down and came back up over the button, as a native button acts (a press dragged
        // off it does nothing, and a window the button opens is not sent behind by the release).
        let hit = ui.clickedHash(h) || ui.activatedByKey(h);
        ui.access(h, AccessRole.Button, label.bytes());
        ui.label(label, Text.of().color(ui.tone(SLATE_100)));
        ui.close();
        return hit;
    }

    /// ClayWind_Checkbox: toggles `value` when clicked.
    public fn checkbox(ui: borrow mut Ui, id: StringView, label: StringView, value: borrow mut bool) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.registerFocusable(h); // Tab reaches it, and Space or Enter flips it
        let focused = ui.hasFocus(h);
        ui.open(
            Style.row().idHash(h).gap(space(2.0)).alignXY(AxisAlign.Start, AxisAlign.Center).cursor(Cursor.Pointer)
                .rounded(Radius.Sm).isFocused(focused).focus(Style.of().ring(2.0, BLUE_400, 2.0)),
        );
        if (ui.pressedOn(h) || ui.activatedByKey(h)) {
            value = !value;
            changed = true;
        }
        let node = ui.access(h, AccessRole.Checkbox, label.bytes());
        ui.accessFlag(node, ACCESS_CHECKED, value);
        ui.open(
            Style.box().size(Size.fixed(18.0)).bg(
                if (value) BLUE_500 else ui.tone(SLATE_700),
            ).rounded(Radius.Sm).center()
                .border(1.0, ui.tone(SLATE_500)),
        );
        if (value) {
            ui.open(Style.box().size(Size.fixed(14.0)).icon(ICON_CHECK, WHITE, 0.0));
            ui.close();
        }
        ui.close();
        ui.label(label, Text.of().color(ui.tone(SLATE_200)));
        ui.close();
        return changed;
    }

    /// The text field's shared frame style (minH keeps it one line tall while empty).
    fn fieldStyle(ui: borrow Ui, h: u32, focused: bool) -> Style =>
        Style.box().idHash(h).w(Size.grow()).px(space(3.0)).py(space(2.0))
            .minH(
                18.0 + 2.0 * space(2.0),
            ).bg(ui.tone(SLATE_800)).rounded(Radius.Md).cursor(Cursor.Text).isFocused(focused)
            .border(1.0, ui.tone(SLATE_600)).focus(Style.of().border(2.0, BLUE_400));

    /// ClayWind_TextInput: edits at the end (type, Backspace a grapheme cluster); Enter leaves the field.
    public fn textInput(ui: borrow mut Ui, id: StringView, buf: SliceMut<u8>, len: borrow mut usize) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h);
        let focused = ui.hasFocus(h);
        var changed = false;
        ui.open(Controls.fieldStyle(ui, h, focused));
        if (ui.pressedOn(h)) {
            ui.setFocus(h);
        } else if (ui.hasFocus(h) && ui.releasedOutside(h)) {
            ui.leaveFocus(h); // a click or a tap anywhere else leaves the field (on a phone, that hides the keyboard)
        }
        if (focused) {
            loop {
                let c = ui.nextChar();
                if (c == 0) {
                    break;
                }
                if (typeable(c)) {
                    let at = len;
                    if (insertChar(buf, mut len, at, c) > 0) {
                        changed = true;
                    }
                }
            }
            if (ui.keyHit(Key.Backspace) && len > 0) {
                len = graphemeBefore(buf[0..len], len);
                changed = true;
            }
            if (ui.keyPressed(Key.Enter)) {
                ui.clearFocus();
            }
        }
        let node = ui.access(h, AccessRole.TextField, id.bytes());
        ui.accessValue(node, buf[0..len]);
        ui.accessCaret(node, len, len); // it edits at its end
        ui.open(Style.row().alignXY(AxisAlign.Start, AxisAlign.Center));
        if (len > 0) {
            ui.labelBytes(buf[0..len], Text.of().color(ui.tone(SLATE_100)));
        }
        // A blinking caret at the end (about 2 Hz) while focused.
        if (focused && (truncate<u64>((ui.time() * 2.0).floor()) & 1) == 0) {
            ui.open(Style.box().w(Size.fixed(2.0)).h(Size.fixed(18.0)).bg(ui.tone(SLATE_200)));
            ui.close();
        }
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_Dropdown: a trigger showing `items[selected]`; when `open`, a floating list (click outside closes).
    public fn dropdown(
        ui: borrow mut Ui,
        id: StringView,
        items: Slice<StringView>,
        selected: borrow mut usize,
        open: borrow mut bool,
    ) -> bool {
        let h = hashId(id);
        let pop = subId(id, "pop", -1);
        var changed = false;
        ui.open(
            Style.box().idHash(h).w(Size.grow()).px(space(3.0)).py(space(2.0)).bg(ui.tone(SLATE_800)).rounded(Radius.Md)
                .cursor(Cursor.Pointer).border(1.0, ui.tone(SLATE_600)).hover(Style.of().bg(ui.tone(SLATE_700))),
        );
        if (ui.pressedOn(h)) {
            open = !open;
        }
        let node = ui.access(h, AccessRole.Dropdown, id.bytes());
        if (selected < items.length) {
            ui.accessValue(node, items[selected].bytes());
        }
        ui.accessFlag(node, ACCESS_EXPANDED, open);
        ui.open(Style.row().w(Size.grow()).alignXY(AxisAlign.Start, AxisAlign.Center));
        if (selected < items.length) {
            ui.label(items[selected], Text.of().color(ui.tone(SLATE_100)));
        }
        ui.open(Style.box().w(Size.grow()));
        ui.close();
        ui.open(Style.box().size(Size.fixed(14.0)).icon(ICON_CHEVRON_DOWN, ui.tone(SLATE_400), 0.0));
        ui.close();
        ui.close();
        if (open) {
            // A floating list below the trigger, layered above everything.
            ui.open(Style.box().idHash(pop).absolute().top(38.0).z(200).w(Size.fixed(200.0)).h(Size.fit()).maxH(220.0)
                .bg(ui.tone(SLATE_900)).rounded(Radius.Md).border(
                1.0,
                ui.tone(SLATE_600),
            ).scroll(ScrollAxis.Vertical).p(space(1.0)));
            // The open list's choices are a menu's items to a screen reader (CeeSafe ADR 0207).
            let menu = subId(id, "menu", 0);
            ui.open(Style.column().idHash(menu).w(Size.grow()).gap(space(1.0)));
            let _ = ui.access(menu, AccessRole.Menu, "".bytes());
            for (i in 0..items.length) {
                let row = subId(id, "", truncate<i64>(i));
                let isSelected = i == selected;
                var style = Style.box().idHash(row).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm)
                    .cursor(Cursor.Pointer).bg(if (isSelected) BLUE_600 else NONE);
                if (!isSelected) {
                    style = style.hover(Style.of().bg(ui.tone(SLATE_700)));
                }
                ui.open(style);
                if (ui.pressedOn(row)) {
                    selected = i;
                    open = false;
                    changed = true;
                }
                let choice = ui.access(row, AccessRole.MenuItem, items[i].bytes());
                ui.accessFlag(choice, ACCESS_SELECTED, isSelected);
                ui.label(items[i], Text.of().color(ui.tone(SLATE_100)));
                ui.close();
            }
            ui.close();
            ui.close();
        }
        ui.close();
        // A click anywhere outside the trigger or the list closes it.
        if (open && ui.pressedOutside(h, pop)) {
            open = false;
        }
        return changed;
    }

    /// ClayWind_Listbox: a scrolling single-selection list `height` tall.
    public fn listbox(
        ui: borrow mut Ui,
        id: StringView,
        items: Slice<StringView>,
        selected: borrow mut usize,
        height: SizingAxis,
    ) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h); // a Tab stop: Up and Down choose the row
        let focused = ui.hasFocus(h);
        var changed = false;
        if (focused && items.length > 0) {
            if (ui.keyHit(Key.Down) && selected + 1 < items.length) {
                selected += 1;
                changed = true;
            } else if (ui.keyHit(Key.Up) && selected > 0 && selected <= items.length) {
                selected -= 1;
                changed = true;
            }
        }
        ui.open(
            Style.box().idHash(h).w(Size.grow()).h(height).bg(
                ui.tone(SLATE_800),
            ).rounded(Radius.Md).scroll(ScrollAxis.Vertical)
                .border(1.0, if (focused) BLUE_500 else ui.tone(SLATE_600)).p(space(1.0)),
        );
        // The rows are a list's items to a screen reader: "3 of 12" (CeeSafe ADR 0207).
        let list = subId(id, "list", 0);
        ui.open(Style.column().idHash(list).w(Size.grow()).gap(space(1.0)));
        let listNode = ui.access(list, AccessRole.List, "".bytes());
        ui.accessFlag(listNode, ACCESS_FOCUSED, focused && selected >= items.length);
        for (i in 0..items.length) {
            let row = subId(id, "", truncate<i64>(i));
            let isSelected = i == selected;
            var style = Style.box().idHash(row).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm)
                .cursor(Cursor.Pointer).bg(if (isSelected) BLUE_600 else NONE);
            if (!isSelected) {
                style = style.hover(Style.of().bg(ui.tone(SLATE_700)));
            }
            ui.open(style);
            if (ui.pressedOn(row)) {
                selected = i;
                changed = true;
                ui.setFocus(h);
            }
            let node = ui.access(row, AccessRole.ListItem, items[i].bytes());
            ui.accessFlag(node, ACCESS_SELECTED, i == selected);
            ui.accessFlag(node, ACCESS_FOCUSED, focused && i == selected); // what a screen reader is on
            ui.label(items[i], Text.of().color(if (isSelected) WHITE else ui.tone(SLATE_200)));
            ui.close();
        }
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_ListboxMulti: each row toggles its own `selected[i]`.
    public fn listboxMulti(
        ui: borrow mut Ui,
        id: StringView,
        items: Slice<StringView>,
        selected: SliceMut<bool>,
        height: SizingAxis,
    ) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(
            Style.box().idHash(h).w(Size.grow()).h(height).bg(
                ui.tone(SLATE_800),
            ).rounded(Radius.Md).scroll(ScrollAxis.Vertical)
                .border(1.0, ui.tone(SLATE_600)).p(space(1.0)),
        );
        // The rows are a list's items to a screen reader: "3 of 12" (CeeSafe ADR 0207).
        let list = subId(id, "list", 0);
        ui.open(Style.column().idHash(list).w(Size.grow()).gap(space(1.0)));
        let _ = ui.access(list, AccessRole.List, "".bytes());
        for (i in 0..items.length) {
            let row = subId(id, "", truncate<i64>(i));
            let on = i < selected.length && selected[i];
            ui.registerFocusable(row); // each row a Tab stop, as a checkbox is; Space or Enter flips it
            var style = Style.box().idHash(row).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm)
                .cursor(Cursor.Pointer).bg(if (on) BLUE_600 else NONE).isFocused(ui.hasFocus(row)).focus(
                Style.of().ring(2.0, BLUE_400, 2.0),
            );
            if (!on) {
                style = style.hover(Style.of().bg(ui.tone(SLATE_700)));
            }
            ui.open(style);
            if ((ui.pressedOn(row) || ui.activatedByKey(row)) && i < selected.length) {
                selected[i] = !selected[i];
                changed = true;
            }
            let nowOn = i < selected.length && selected[i];
            let node = ui.access(row, AccessRole.ListItem, items[i].bytes());
            ui.accessFlag(node, ACCESS_SELECTED, nowOn);
            ui.label(items[i], Text.of().color(if (nowOn) WHITE else ui.tone(SLATE_200)));
            ui.close();
        }
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_Slider: press on the track to capture; the value follows the pointer until release.
    public fn slider(ui: borrow mut Ui, id: StringView, value: borrow mut f32, min: f32, max: f32, width: f32) -> bool {
        let h = hashId(id);
        var changed = false;
        let track = ui.boxOfHash(h); // the previous frame's track
        let p = ui.pointer();
        if (p.pressed && ui.overHash(h)) {
            ui.capture(h);
        }
        if (p.released && ui.captured() == h) {
            ui.capture(0);
        }
        match (track) {
            Some(bb) => {
                if (ui.captured() == h && p.down && bb.w > 0.0) {
                    let t = Math.clamp((p.position.x - bb.x) / bb.w, 0.0, 1.0);
                    let next = min + t * (max - min);
                    if (next != value) {
                        value = next;
                        changed = true;
                    }
                }
            }
            null => {}
        }
        // A screen reader moves it a tenth of its range at a step.
        let steps = ui.accessStep(h);
        if (steps != 0 && max > min) {
            let next = Math.clamp(value + round<f32>(steps as f64) * (max - min) / 10.0, min, max);
            if (next != value) {
                value = next;
                changed = true;
            }
        }
        let frac = if (max > min) Math.clamp((value - min) / (max - min), 0.0, 1.0) else 0.0;
        ui.open(
            Style.box().idHash(h).w(
                Size.fixed(width),
            ).h(Size.fixed(16.0)).bg(ui.tone(SLATE_700)).rounded(Radius.Xl).cursor(Cursor.Pointer),
        );
        let node = ui.access(h, AccessRole.Slider, id.bytes());
        ui.accessRange(node, min, max, value);
        ui.open(Style.box().w(Size.fixed(frac * width)).h(Size.grow()).bg(BLUE_500).rounded(Radius.Xl));
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_Radio: one of `items`.
    public fn radio(ui: borrow mut Ui, id: StringView, items: Slice<StringView>, selected: borrow mut usize) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(Style.column().idHash(h).gap(space(2.0)));
        for (i in 0..items.length) {
            let row = subId(id, "", truncate<i64>(i));
            ui.registerFocusable(row); // each option a Tab stop; Space or Enter selects it
            let focused = ui.hasFocus(row);
            ui.open(
                Style.row().idHash(row).gap(space(2.0)).alignXY(
                    AxisAlign.Start,
                    AxisAlign.Center,
                ).cursor(Cursor.Pointer).rounded(Radius.Sm).isFocused(focused)
                    .focus(Style.of().ring(2.0, BLUE_400, 2.0)),
            );
            if (ui.pressedOn(row) || ui.activatedByKey(row)) {
                selected = i;
                changed = true;
            }
            let node = ui.access(row, AccessRole.Radio, items[i].bytes());
            ui.accessFlag(node, ACCESS_CHECKED, i == selected);
            ui.open(Style.box().size(Size.fixed(18.0)).rounded(Radius.Xl).center().border(2.0, ui.tone(SLATE_500)));
            if (i == selected) {
                ui.open(Style.box().size(Size.fixed(8.0)).bg(BLUE_500).rounded(Radius.Xl));
                ui.close();
            }
            ui.close();
            ui.label(items[i], Text.of().color(ui.tone(SLATE_200)));
            ui.close();
        }
        ui.close();
        return changed;
    }

    /// ClayWind_Tabs: a row of tabs; `active` is the open one.
    public fn tabs(ui: borrow mut Ui, id: StringView, items: Slice<StringView>, active: borrow mut usize) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(Style.row().idHash(h).gap(space(1.0)));
        let _ = ui.access(h, AccessRole.TabList, "".bytes()); // "tab 2 of 4" (CeeSafe ADR 0207)
        // The open tab is the bar's Tab stop; with the focus on it, Left and Right open the one beside it.
        let n = items.length;
        if (n > 0 && active < n && ui.hasFocus(subId(id, "", truncate<i64>(active)))) {
            let step = if (ui.keyHit(Key.Right)) 1 else if (ui.keyHit(Key.Left)) n - 1 else 0;
            if (step != 0) {
                active = (active + step) % n;
                changed = true;
                ui.setFocus(subId(id, "", truncate<i64>(active)));
            }
        }
        for (i in 0..items.length) {
            let tab = subId(id, "", truncate<i64>(i));
            let on = i == active;
            if (on) {
                ui.registerFocusable(tab);
            }
            var style = Style.box().idHash(tab).px(space(3.0)).py(space(2.0)).roundedT(Radius.Md).cursor(Cursor.Pointer)
                .bg(if (on) ui.tone(SLATE_700) else NONE).isFocused(ui.hasFocus(tab)).focus(
                Style.of().ring(2.0, BLUE_400, 2.0),
            );
            if (!on) {
                style = style.hover(Style.of().bg(ui.tone(SLATE_800)));
            }
            ui.open(style);
            if (ui.pressedOn(tab)) {
                active = i;
                changed = true;
                ui.setFocus(tab);
            }
            let node = ui.access(tab, AccessRole.Tab, items[i].bytes());
            ui.accessFlag(node, ACCESS_SELECTED, i == active);
            ui.label(items[i], Text.of().color(if (on) ui.tone(SLATE_100) else ui.tone(SLATE_400)));
            ui.close();
        }
        ui.close();
        return changed;
    }

    /// ClayWind_ContextMenu: while `open`, a menu fixed to the window at (x, y); returns the chosen index, else null.
    /// (The caller opens it, typically on a secondary press: `ui.secondaryPressedOn(id)`.)
    public fn contextMenu(
        ui: borrow mut Ui,
        id: StringView,
        items: Slice<StringView>,
        open: borrow mut bool,
        x: f32,
        y: f32,
    ) -> usize? {
        let all = [true; 1];
        return Controls.contextMenuWith(mut ui, id, items, all[0..0], mut open, x, y);
    }

    /// `contextMenu` with items that can be disabled: item i is enabled when `enabled` has no i-th entry or it is
    /// true. A disabled item is drawn dimmed, takes no hover, cannot be chosen, and says so to a screen reader.
    public fn contextMenuWith(
        ui: borrow mut Ui,
        id: StringView,
        items: Slice<StringView>,
        enabled: Slice<bool>,
        open: borrow mut bool,
        x: f32,
        y: f32,
    ) -> usize? {
        if (!open) {
            return null;
        }
        let h = hashId(id);
        var chosen: usize? = null;
        ui.open(
            Style.box().idHash(h).fixed().left(x).top(y).z(300).bg(ui.tone(SLATE_900)).p(space(1.0)).rounded(Radius.Md)
                .border(1.0, ui.tone(SLATE_600)),
        );
        let menu = subId(id, "menu", 0);
        ui.open(Style.column().idHash(menu).w(Size.fixed(180.0)));
        let _ = ui.access(menu, AccessRole.Menu, "".bytes()); // its items, "2 of 5" (CeeSafe ADR 0207)
        for (i in 0..items.length) {
            let row = subId(id, "", truncate<i64>(i));
            let on = i >= enabled.length || enabled[i];
            let look = Style.box().idHash(row).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm);
            ui.open(if (on) look.cursor(Cursor.Pointer).hover(Style.of().bg(BLUE_600)) else look);
            if (on && ui.pressedOn(row)) {
                chosen = i;
                open = false;
            }
            let node = ui.access(row, AccessRole.MenuItem, items[i].bytes());
            ui.accessFlag(node, ACCESS_DISABLED, !on);
            ui.label(items[i], Text.of().color(ui.tone(if (on) SLATE_100 else SLATE_500)));
            ui.close();
        }
        ui.close();
        ui.close();
        if (open && ui.pressedOutside(h, 0)) {
            open = false;
        }
        return chosen;
    }

    /// A text editor's or field's menu, on a secondary press over it: Cut, Copy, Paste, Delete and Select All. Cut,
    /// Copy and Delete are enabled with a selection (`selects`), Paste when the clipboard had text when the host last
    /// looked (`Ui.clipboardHasText`); a choice runs the action its shortcut does ("cut", "copy", "paste", "delete",
    /// "select-all"), which the focused editor or field acts on the next frame. Whether something was chosen.
    public fn editMenu(
        ui: borrow mut Ui,
        id: StringView,
        open: borrow mut bool,
        x: f32,
        y: f32,
        selects: bool,
    ) -> bool {
        let items = ["Cut", "Copy", "Paste", "Delete", "Select All"];
        let actions = ["cut", "copy", "paste", "delete", "select-all"];
        let enabled = [selects, selects, ui.clipboardHasText(), selects, true];
        match (Controls.contextMenuWith(mut ui, id, items[..], enabled[..], mut open, x, y)) {
            Some(i) => {
                ui.dispatch(actions[i]);
                return true;
            }
            null => { return false; }
        }
    }

    /// ClayWind_Tooltip: a floating tip beside the pointer while `targetId` is hovered.
    public fn tooltip(ui: borrow mut Ui, targetId: StringView, text: StringView) {
        if (!ui.overHash(hashId(targetId))) {
            return;
        }
        let m = ui.pointer().position;
        ui.open(Style.box().id("cw-tip").fixed().left(m.x + 14.0).top(m.y + 16.0).z(400).px(space(2.0)).py(space(1.0))
            .bg(ui.tone(SLATE_950)).rounded(Radius.Sm).border(1.0, ui.tone(SLATE_600)));
        ui.label(text, Text.of().color(ui.tone(SLATE_100)));
        ui.close();
    }

    /// ClayWind_SpinInput: -/value/+ buttons, and Up/Down while focused, within [min, max] by `step`.
    public fn spinInput(
        ui: borrow mut Ui,
        id: StringView,
        value: borrow mut i32,
        min: i32,
        max: i32,
        step: i32,
    ) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h);
        let focused = ui.hasFocus(h);
        var changed = false;
        let dec = subId(id, "dec", -1);
        let inc = subId(id, "inc", -1);
        ui.open(Style.row().idHash(h).gap(space(1.0)).alignXY(AxisAlign.Start, AxisAlign.Center).p(space(1.0))
            .rounded(Radius.Md).isFocused(focused).border(1.0, ui.tone(SLATE_600)).focus(
            Style.of().border(2.0, BLUE_400),
        ));
        if (ui.pressedOn(h)) {
            ui.setFocus(h);
        }
        // A screen reader's step is the field's own.
        let asked = value + ui.accessStep(h) * step;
        if (asked != value && asked >= min && asked <= max) {
            value = asked;
            changed = true;
        }
        let node = ui.access(h, AccessRole.Slider, id.bytes());
        ui.accessRange(node, round<f32>(min as f64), round<f32>(max as f64), round<f32>(value as f64));
        var spoken = [0u8; 24]; // a count is said as it is written, not as a share of its range
        var said = TextWriter.create(mut spoken[..]);
        said.signed(value as i64);
        ui.accessValue(node, said.written());
        ui.open(
            Style.box().idHash(dec).size(
                Size.fixed(22.0),
            ).bg(ui.tone(SLATE_700)).rounded(Radius.Sm).cursor(Cursor.Pointer).center()
                .icon(ICON_MINUS, ui.tone(SLATE_100), 0.0).hover(Style.of().bg(ui.tone(SLATE_600))),
        );
        if (ui.pressedOn(dec) && value - step >= min) {
            value -= step;
            changed = true;
        }
        ui.close();
        ui.open(Style.box().w(Size.fixed(44.0)).h(Size.fixed(22.0)).center());
        var digits = [0u8; 24];
        var w = TextWriter.create(mut digits[..]);
        w.signed(value as i64);
        ui.labelBytes(w.written(), Text.of().color(ui.tone(SLATE_100)));
        ui.close();
        ui.open(
            Style.box().idHash(inc).size(
                Size.fixed(22.0),
            ).bg(ui.tone(SLATE_700)).rounded(Radius.Sm).cursor(Cursor.Pointer).center()
                .icon(ICON_PLUS, ui.tone(SLATE_100), 0.0).hover(Style.of().bg(ui.tone(SLATE_600))),
        );
        if (ui.pressedOn(inc) && value + step <= max) {
            value += step;
            changed = true;
        }
        ui.close();
        ui.close();
        if (focused) {
            if (ui.keyHit(Key.Up) && value + step <= max) {
                value += step;
                changed = true;
            }
            if (ui.keyHit(Key.Down) && value - step >= min) {
                value -= step;
                changed = true;
            }
        }
        return changed;
    }

    /// ClayWind_TextInputEx: a text field with a caller-owned caret (Left/Right/Home/End move it, Backspace/Delete and
    /// typing edit at it). It measures the text before the caret to place it, so it takes the text metrics.
    public fn textInputEx<M: TextMetrics>(
        ui: borrow mut Ui,
        metrics: borrow M,
        id: StringView,
        buf: SliceMut<u8>,
        len: borrow mut usize,
        caret: borrow mut usize,
    ) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h);
        let focused = ui.hasFocus(h);
        var changed = false;
        if (caret > len) {
            caret = len;
        }
        ui.open(Controls.fieldStyle(ui, h, focused));
        let node = ui.access(h, AccessRole.TextField, id.bytes());
        ui.accessValue(node, buf[0..len]);
        ui.accessCaret(node, caret, caret);
        if (ui.pressedOn(h)) {
            ui.setFocus(h);
        } else if (ui.hasFocus(h) && ui.releasedOutside(h)) {
            ui.leaveFocus(h); // a click or a tap anywhere else leaves the field (on a phone, that hides the keyboard)
        }
        if (focused) {
            loop {
                let c = ui.nextChar();
                if (c == 0) {
                    break;
                }
                if (typeable(c)) {
                    let added = insertChar(buf, mut len, caret, c);
                    if (added > 0) {
                        caret += added;
                        changed = true;
                    }
                }
            }
            // Backspace, Delete and the arrows take a whole grapheme cluster: an accented letter, a flag, an emoji
            // sequence.
            if (ui.keyHit(Key.Backspace) && caret > 0) {
                let from = graphemeBefore(buf[0..len], caret);
                removeBytes(buf, mut len, from, caret);
                caret = from;
                changed = true;
            }
            if (ui.keyHit(Key.Delete) && caret < len) {
                let to = graphemeEnd(buf[0..len], caret);
                removeBytes(buf, mut len, caret, to);
                changed = true;
            }
            if (ui.keyHit(Key.Left) && caret > 0) {
                caret = graphemeBefore(buf[0..len], caret);
            }
            if (ui.keyHit(Key.Right) && caret < len) {
                caret = graphemeEnd(buf[0..len], caret);
            }
            if (ui.keyPressed(Key.Home)) {
                caret = 0;
            }
            if (ui.keyPressed(Key.End)) {
                caret = len;
            }
            if (ui.keyPressed(Key.Enter)) {
                ui.clearFocus();
            }
        }
        if (len > 0) {
            ui.labelBytes(buf[0..len], Text.of().color(ui.tone(SLATE_100)));
        }
        // The caret, absolutely placed at the measured width of buf[0..caret), past the padding.
        if (focused && (truncate<u64>((ui.time() * 2.0).floor()) & 1) == 0) {
            let cx = metrics.measure(buf[0..caret], TextConfig.of(18.0)).w;
            ui.open(
                Style.box().absolute().passthrough().left(
                    space(3.0) + cx,
                ).top(space(2.0)).w(Size.fixed(2.0)).h(Size.fixed(18.0)).bg(ui.tone(SLATE_200)),
            );
            ui.close();
        }
        ui.close();
        return changed;
    }
}

/// Whether a typed character goes into a text field: anything printable (not a C0 or C1 control, DEL or a
/// surrogate).
fn typeable(c: u32) -> bool => c >= 0x20 && c != 0x7F && !(c >= 0x80 && c < 0xA0) && !(c >= 0xD800 && c <= 0xDFFF) &&
    c <= 0x10FFFF;

/// Inserts `c` as UTF-8 at byte `at` of `buf[0..len]`, moving the rest right: the bytes added, 0 when it does not
/// fit.
fn insertChar(buf: SliceMut<u8>, len: borrow mut usize, at: usize, c: u32) -> usize {
    var bytes = [0u8; 4];
    let n = encodeUtf8(c, mut bytes);
    if (len + n > buf.length) {
        return 0;
    }
    var k: usize = len + n;
    while (k > at + n) {
        k -= 1;
        buf[k] = buf[k - n];
    }
    for (j in 0..n) {
        buf[at + j] = bytes[j];
    }
    len += n;
    return n;
}

/// Removes bytes `from` to `to` of `buf[0..len]`, moving the rest left.
fn removeBytes(buf: SliceMut<u8>, len: borrow mut usize, from: usize, to: usize) {
    let gone = to - from;
    for (k in to..len) {
        buf[k - gone] = buf[k];
    }
    len -= gone;
}
