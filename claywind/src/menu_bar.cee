// SPDX-License-Identifier: MIT
// A menu bar ClayWind draws, for a host whose system has none to give (X11) or an app that wants its own: the menus
// an app describes to a MenuBuilder (menus.cee), kept in a MenuModel, shown as a row of titles; a click opens one,
// its items show their actions' key bindings, and choosing an item triggers its action on the next frame (as a
// native menu's item would). A click elsewhere or Escape closes it.

/// What a MenuModel holds of each part: a menu's title, an item, or a separator.
const MENU_TITLE: u8 = 0;
const MENU_ITEM: u8 = 1;
const MENU_SEPARATOR: u8 = 2;
/// Controls.menuBar's `open`: the open menu's index + 1 in the low bits, and whether moving over its title opened it.
const MENU_INDEX: usize = 0xFFFF;
const MENU_HOVERED: usize = 0x10000;

/// What a part of a MenuModel is.
public enum MenuPartKind {
    /// A menu's title: the items after it, to the next title, are its.
    Menu,
    /// An item, which triggers an action.
    Item,
    /// A line between groups of items.
    Separator,
}

/// One part of a menu description: its kind, its title (in the model's text), its action.
struct MenuPart {
    kind: u8;
    start: usize;
    length: usize;
    action: u32;
}

/// Menus described to a MenuBuilder, kept (titles copied) for Controls.menuBar: up to 96 parts and 2,048 bytes of
/// titles; what does not fit is left out.
public struct MenuModel {
    text: [u8; 2048];
    textLength: usize;
    parts: [MenuPart; 96];
    count: usize;

    public fn create() -> MenuModel => MenuModel {
        text: [0u8; 2048],
        textLength: 0,
        parts: [MenuPart { kind: 0, start: 0, length: 0, action: 0 }; 96],
        count: 0,
    };

    /// Whether it holds any menu.
    public fn isEmpty(borrow this) -> bool => this.count == 0;

    fn add(borrow mut this, kind: u8, title: StringView, action: u32) {
        let bytes = title.bytes();
        if (this.count == 96 || this.textLength + bytes.length > 2048) {
            return;
        }
        let start = this.textLength;
        for (i in 0..bytes.length) {
            this.text[start + i] = bytes[i];
        }
        this.textLength += bytes.length;
        this.parts[this.count] = MenuPart { kind: kind, start: start, length: bytes.length, action: action };
        this.count += 1;
    }

    fn title(borrow this, k: usize) -> Slice<u8> =>
        this.text[this.parts[k].start..this.parts[k].start + this.parts[k].length];

    /// How many parts it holds (menus' titles, items and separators, in order): for a host that builds the system's
    /// menus from it.
    public fn partCount(borrow this) -> usize => this.count;

    /// What part `k` is.
    public fn partKind(borrow this, k: usize) -> MenuPartKind =>
        if (this.parts[k].kind == MENU_TITLE) MenuPartKind.Menu
            else if (this.parts[k].kind == MENU_ITEM) MenuPartKind.Item
            else MenuPartKind.Separator;

    /// Part `k`'s title (empty for a separator).
    public fn partTitle(borrow this, k: usize) -> Slice<u8> => this.title(k);

    /// Item `k`'s action, as its name's hash (hashId): what Platform.nextChosenAction gives when it is chosen.
    public fn partAction(borrow this, k: usize) -> u32 => this.parts[k].action;
}

impl MenuBuilder for MenuModel {
    fn menu(borrow mut this, title: StringView) {
        this.add(MENU_TITLE, title, 0);
    }
    fn item(borrow mut this, title: StringView, action: StringView) {
        this.add(MENU_ITEM, title, hashId(action));
    }
    fn separator(borrow mut this) {
        this.add(MENU_SEPARATOR, "", 0);
    }
}

/// A key binding as a menu shows it: "⌘⇧S" where the secondary modifier is Command (macOS), else "Ctrl+Shift+S".
fn writeBinding(w: borrow mut TextWriter, b: KeyBinding, mac: bool) {
    if (mac) {
        if (b.modifiers.control) {
            w.text("⌃");
        }
        if (b.modifiers.alt) {
            w.text("⌥");
        }
        if (b.modifiers.shift) {
            w.text("⇧");
        }
        if (b.modifiers.command) {
            w.text("⌘");
        }
    } else {
        if (b.modifiers.control) {
            w.text("Ctrl+");
        }
        if (b.modifiers.alt) {
            w.text("Alt+");
        }
        if (b.modifiers.shift) {
            w.text("Shift+");
        }
        if (b.modifiers.command) {
            w.text("Win+");
        }
    }
    match (b.key) {
        Some(k) => { w.text(keyLabel(k)); }
        null => {
            let c = if (b.character >= 'a' && b.character <= 'z') b.character - 32 else b.character;
            var utf8 = [0u8; 4];
            let n = encodeUtf8(c, mut utf8);
            w.bytes(utf8[0..n]);
        }
    }
}

/// A named key's label in a menu.
fn keyLabel(k: Key) -> StringView => match (k) {
    Key.Escape => "Esc",
    Key.Enter => "Enter",
    Key.Tab => "Tab",
    Key.Backspace => "Backspace",
    Key.Delete => "Delete",
    Key.Left => "Left",
    Key.Right => "Right",
    Key.Up => "Up",
    Key.Down => "Down",
    Key.Home => "Home",
    Key.End => "End",
    Key.PageUp => "PgUp",
    Key.PageDown => "PgDn",
    _ => "?",
};

impl Controls {
    /// A menu bar drawn by ClayWind from `model`: a row of the menus' titles; a press opens one (`open` is 0 when
    /// none is open; the caller keeps it between frames), whose items show their actions' key bindings and, chosen, trigger their action on
    /// the next frame (Ui.dispatch). A click outside, or Escape, closes it.
    public fn menuBar(ui: borrow mut Ui, id: StringView, model: borrow MenuModel, open: borrow mut usize) {
        let bar = hashId(id);
        let mac = ui.usesCommand();
        ui.open(
            Style.row().idHash(bar).w(Size.grow()).px(space(2.0)).bg(ui.tone(SLATE_900)).border(
                1.0,
                ui.tone(SLATE_700),
            ),
        );
        let _ = ui.access(bar, AccessRole.MenuBar, "".bytes()); // its menus, "2 of 4" (CeeSafe ADR 0207)
        var menuIndex: usize = 0;
        var pop: u32 = 0;
        var k: usize = 0;
        while (k < model.count) {
            if (model.parts[k].kind != MENU_TITLE) {
                k += 1;
                continue;
            }
            menuIndex += 1;
            let h = subId(id, "menu", truncate<i64>(menuIndex));
            let isOpen = (open & MENU_INDEX) == menuIndex;
            ui.open(Style.box().idHash(h).px(space(3.0)).py(space(1.0)).rounded(Radius.Sm).cursor(Cursor.Pointer)
                .bg(if (isOpen) ui.tone(SLATE_700) else NONE).hover(Style.of().bg(ui.tone(SLATE_700))));
            // As a system's menu bar: a press on a title opens its menu, or closes it if a press opened it; with a menu
            // open, moving over another title opens that one, and a press there keeps it open.
            if (ui.pressedOn(h)) {
                open = if (isOpen && (open & MENU_HOVERED) == 0) 0 else menuIndex;
            } else if (open != 0 && !isOpen && ui.overHash(h)) {
                open = menuIndex | MENU_HOVERED;
            }
            let title = ui.access(h, AccessRole.MenuItem, model.title(k));
            ui.accessFlag(title, ACCESS_EXPANDED, (open & MENU_INDEX) == menuIndex);
            ui.labelBytes(model.title(k), Text.of().color(ui.tone(SLATE_100)));
            k += 1;
            if ((open & MENU_INDEX) == menuIndex) {
                pop = subId(id, "pop", truncate<i64>(menuIndex));
                ui.open(
                    Style.column().idHash(pop).absolute().top(30.0).z(300).w(Size.fixed(240.0)).bg(ui.tone(SLATE_900))
                        .rounded(Radius.Md).border(1.0, ui.tone(SLATE_600)).p(space(1.0)),
                );
                let _ = ui.access(pop, AccessRole.Menu, model.title(k - 1)); // its items (ADR 0207)
            }
            // The menu's items.
            while (k < model.count && model.parts[k].kind != MENU_TITLE) {
                if ((open & MENU_INDEX) == menuIndex) {
                    let part = model.parts[k];
                    if (part.kind == MENU_SEPARATOR) {
                        ui.open(Style.box().w(Size.grow()).h(Size.fixed(1.0)).my(space(1.0)).bg(ui.tone(SLATE_700)));
                        ui.close();
                    } else {
                        let row = subId(id, "item", truncate<i64>(k));
                        ui.open(Style.row().idHash(row).w(Size.grow()).px(space(3.0)).py(space(1.5)).rounded(Radius.Sm)
                            .cursor(Cursor.Pointer).hover(
                            Style.of().bg(BLUE_600),
                        ).alignXY(AxisAlign.Start, AxisAlign.Center));
                        if (ui.clickedHash(row)) {
                            ui.dispatchNext(part.action);
                            open = 0;
                        }
                        ui.access(row, AccessRole.MenuItem, model.title(k));
                        ui.labelBytes(model.title(k), Text.of().color(ui.tone(SLATE_100)));
                        ui.open(Style.box().w(Size.grow()));
                        ui.close();
                        match (ui.bindingForHash(part.action)) {
                            Some(b) => {
                                var shortcut = [0u8; 48];
                                var w = TextWriter.create(mut shortcut[..]);
                                writeBinding(mut w, b, mac);
                                ui.labelBytes(w.written(), Text.of().color(ui.tone(SLATE_400)));
                            }
                            null => {}
                        }
                        ui.close();
                    }
                }
                k += 1;
            }
            if ((open & MENU_INDEX) == menuIndex) {
                ui.close();
            }
            ui.close();
        }
        ui.close();
        if (open != 0 && (ui.keyPressed(Key.Escape) || ui.pressedOutside(bar, pop))) {
            open = 0;
        }
    }
}
