// SPDX-License-Identifier: MIT
// Long text: a line index over a UTF-8 document, and a view (Controls.textView) that lays out only the lines on
// screen. A 100,000-line document costs a frame what a page of it does: the lines above and below the view are
// spacers of their height, not elements.

/// Indexes the lines of `text` into `starts`: line k begins at byte `starts[k]` (a line ends at its newline, which
/// it does not include; a final line without one ends with the text). The number of lines, or null when `starts`
/// has no room for them all. An empty text is one empty line.
public fn indexLines(text: Slice<u8>, starts: SliceMut<u32>) -> usize? {
    if (starts.length == 0) {
        return null;
    }
    starts[0] = 0;
    var n: usize = 1;
    for (i in 0..text.length) {
        if (text[i] == '\n') {
            if (n >= starts.length) {
                return null;
            }
            starts[n] = truncate<u32>(i + 1);
            n += 1;
        }
    }
    return n;
}

/// Line `k` of `text` indexed by `starts` (of `count` lines), without its newline (or a CR before it).
public fn lineOf<region a>(text: Slice<a, u8>, starts: Slice<u32>, count: usize, k: usize) -> Slice<a, u8> {
    if (k >= count) {
        return text[0..0];
    }
    let from = (starts[k] as usize).min(text.length);
    var to = if (k + 1 < count) (starts[k + 1] as usize) - 1 else text.length;
    to = to.max(from).min(text.length);
    if (to > from && text[to - 1] == '\r') {
        to -= 1;
    }
    return text[from..to];
}

/// The line holding byte `offset` of a text indexed by `starts` (of `count` lines).
public fn lineAt(starts: Slice<u32>, count: usize, offset: usize) -> usize {
    var lo: usize = 0;
    var hi = count;
    while (hi - lo > 1) {
        let mid = lo + (hi - lo) / 2;
        if ((starts[mid] as usize) <= offset) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// The lines a view shows: the first and one past the last, with `extra` lines either side so a scroll of a few
/// lines draws nothing new at the edges.
fn visibleLines(offsetY: f32, viewH: f32, lineH: f32, count: usize, extra: usize) -> [usize; 2] {
    let top = (0.0 - offsetY).max(0.0);
    let first = truncate<usize>((top / lineH).floor().max(0.0));
    let shown = truncate<usize>((viewH / lineH).ceil().max(1.0));
    let from = if (first > extra) first - extra else 0;
    let to = (first + shown + extra).min(count);
    return [from.min(count), to];
}

impl Controls {
    /// ClayWind_TextView: a scrolling view of a long text indexed by `starts` and `count` (indexLines), laid out a
    /// screenful at a time. Lines do not wrap and each is `look`'s line height tall (its font size × 1.4 when it
    /// has none); `gutter` numbers them. Only the lines in view and a few around them become elements, so its cost
    /// does not grow with the text.
    public fn textView(
        ui: borrow mut Ui,
        id: StringView,
        text: Slice<u8>,
        starts: Slice<u32>,
        count: usize,
        look: Text,
        gutter: bool,
    ) {
        let config = look.config();
        let lineH =
            if (config.lineHeight > 0.0) config.lineHeight
                else (if (config.fontSize > 0.0) config.fontSize else 16.0) * 1.4;
        let viewH = match (ui.boxOf(id)) {
            Some(b) => b.h,
            null => ui.screenSize().h,
        };
        let lines = visibleLines(ui.scrollOffset(id).y, viewH, lineH, count, 4);
        let digits = if (count >= 100000) 6 else if (count >= 10000) 5 else if (count >= 1000) 4 else 3;
        let gutterW = round<f32>(digits) * (if (config.fontSize > 0.0) config.fontSize else 16.0) * 0.62 + 12.0;
        ui.open(Style.column().id(id).w(Size.grow()).h(Size.grow()).scroll(ScrollAxis.Both).bg(SLATE_900));
        // The lines above the view, as their height.
        ui.open(Style.box().w(Size.fixed(1.0)).h(Size.fixed(round<f32>(lines[0]) * lineH)));
        ui.close();
        let line = look.wrap(TextWrap.None).leading(lineH);
        for (k in lines[0]..lines[1]) {
            ui.open(Style.row().h(Size.fixed(lineH)).alignXY(AxisAlign.Start, AxisAlign.Center));
            if (gutter) {
                var number = [0u8; 12];
                var w = TextWriter.create(mut number[..]);
                w.decimal((k + 1) as u64);
                ui.open(Style.box().w(Size.fixed(gutterW)).pr(12.0).alignXY(AxisAlign.End, AxisAlign.Center));
                ui.labelBytes(w.written(), line.color(SLATE_500));
                ui.close();
            }
            ui.labelBytes(lineOf(text, starts, count, k), line);
            ui.close();
        }
        // The lines below it.
        ui.open(Style.box().w(Size.fixed(1.0)).h(Size.fixed(round<f32>(count - lines[1]) * lineH)));
        ui.close();
        ui.close();
    }
}

/// The end of line `k` (before its newline, or a CR before that), as a byte offset into the text.
fn lineEnd(text: Slice<u8>, starts: Slice<u32>, count: usize, k: usize) -> usize =>
    (starts[k] as usize) + lineOf(text, starts, count, k).length;

/// The grapheme boundary of `line` whose caret is the next one to the right (`right`) or left of the caret at
/// `at`, as drawn in `config`; `at` when none is (the line's edge). As a text field's arrows (visualStep).
fn lineStep<M: TextMetrics>(metrics: borrow M, line: Slice<u8>, config: TextConfig, at: usize, right: bool) -> usize {
    let here = metrics.caretX(line, config, at);
    var best = at;
    var bestAhead: f32 = 0.0;
    var b: usize = 0;
    loop {
        if (b != at) {
            let x = metrics.caretX(line, config, b);
            let ahead = if (right) x - here else here - x;
            if (ahead > 0.25) {
                let nearer = (if (b > at) b - at else at - b) < (if (best > at) best - at else at - best);
                if (best == at || ahead < bestAhead - 0.25 || ((ahead - bestAhead).abs() <= 0.25 && nearer)) {
                    best = b;
                    bestAhead = ahead;
                }
            }
        }
        if (b >= line.length) {
            return best;
        }
        b = graphemeEnd(line, b);
    }
}

/// The view's measures: its line height and the gutter's width (0 without one).
fn viewMeasures(config: TextConfig, count: usize, gutter: bool) -> [f32; 2] {
    let size = if (config.fontSize > 0.0) config.fontSize else 16.0;
    let lineH = if (config.lineHeight > 0.0) config.lineHeight else size * 1.4;
    let digits = if (count >= 100000) 6 else if (count >= 10000) 5 else if (count >= 1000) 4 else 3;
    let gutterW = if (gutter) round<f32>(digits) * size * 0.62 + 12.0 else 0.0;
    return [lineH, gutterW];
}

/// The most rows a line wraps into; past them, its last row holds the rest.
const MAX_ROWS: usize = 64;

/// Where line `line`, set in `config`, wraps at `width`: each row's first byte into `out` (`out[0]` is 0); how many
/// rows (at least one). Rows break at UAX #14's opportunities, as far into the line as fits (spaces at a row's end do
/// not count); a word wider than a row breaks between grapheme clusters. Without `wrap`, one row.
fn wrapRows<M: TextMetrics>(
    metrics: borrow M,
    config: TextConfig,
    line: Slice<u8>,
    wrap: bool,
    width: f32,
    out: SliceMut<u32>,
) -> usize {
    out[0] = 0;
    if (!wrap || width <= 0.0 || line.length == 0 || metrics.measure(line, config).w <= width) {
        return 1;
    }
    var breaks = [0u8; 4096];
    var scratch = [0u32; 8192];
    let known = line.length <= 4096 && lineBreaks(line, mut breaks[0..line.length], mut scratch[0..line.length * 2]);
    var rows: usize = 1;
    var start: usize = 0;
    while (rows < out.length.min(MAX_ROWS)) {
        if (metrics.measure(trimEnd(line, start, line.length), config).w <= width) {
            break;
        }
        // The break opportunities after start, in order; the last whose row fits, by halving.
        var lo = start;
        var best = start;
        var hiEnd = line.length;
        if (known) {
            // Binary search over byte positions, moved to the nearest opportunity at or before each probe.
            var a = start + 1;
            var b = hiEnd;
            while (a < b) {
                let mid = a + (b - a) / 2;
                var at = mid;
                while (at > start && breaks[at] == BREAK_NONE) {
                    at -= 1;
                }
                if (at <= start) {
                    a = mid + 1;
                    continue;
                }
                if (metrics.measure(trimEnd(line, start, at), config).w <= width) {
                    best = best.max(at);
                    a = mid + 1;
                } else {
                    b = at;
                }
            }
            lo = best;
        }
        if (lo <= start) {
            // No opportunity fits: as many grapheme clusters as fit, at least one.
            var at = graphemeEnd(line, start);
            loop {
                let next = graphemeEnd(line, at);
                if (next >= line.length || next == at || metrics.measure(line[start..next], config).w > width) {
                    break;
                }
                at = next;
            }
            lo = at;
        }
        if (lo >= line.length) {
            break;
        }
        out[rows] = truncate<u32>(lo);
        rows += 1;
        start = lo;
    }
    return rows;
}

/// `line[from..to]` without the spaces at its end.
fn trimEnd<region a>(line: Slice<a, u8>, from: usize, to: usize) -> Slice<a, u8> {
    var end = to;
    while (end > from && (line[end - 1] == ' ' || line[end - 1] == '\t')) {
        end -= 1;
    }
    return line[from..end];
}

/// The rows line `k` takes as the cache knows it: its count once measured, else one.
fn cachedRows(rows: Slice<u16>, k: usize) -> usize => if (k < rows.length && rows[k] > 0) rows[k] as usize else 1;

/// The top of line `k`, in rows from the text's top.
fn rowsBefore(rows: Slice<u16>, k: usize) -> usize {
    if (rows.length == 0) {
        return k;
    }
    var n: usize = 0;
    for (j in 0..k.min(rows.length)) {
        n += cachedRows(rows, j);
    }
    return n + k - k.min(rows.length);
}

/// The line holding row `row` (from the text's top) of `count` lines, and the row within it.
fn lineOfRow(rows: Slice<u16>, count: usize, row: usize) -> [usize; 2] {
    if (rows.length == 0) {
        let k = row.min(if (count > 0) count - 1 else 0);
        return [k, row - k];
    }
    var top: usize = 0;
    for (k in 0..count) {
        let n = cachedRows(rows, k);
        if (row < top + n || k + 1 == count) {
            return [k, (row - top).min(n - 1)];
        }
        top += n;
    }
    return [0, 0];
}

/// A line's rows as laid out now, its count stored in the cache.
struct LineRows {
    starts: [u32; 64];
    count: usize;
}

fn layRows<M: TextMetrics>(
    metrics: borrow M,
    config: TextConfig,
    line: Slice<u8>,
    wrap: bool,
    width: f32,
    rows: SliceMut<u16>,
    k: usize,
) -> LineRows {
    var r = LineRows { starts: [0u32; 64], count: 0 };
    r.count = wrapRows(metrics, config, line, wrap, width, mut r.starts[..]);
    if (k < rows.length) {
        rows[k] = truncate<u16>(r.count);
    }
    return r;
}

/// How far right a row of a wrapped line sits: a right-to-left line's rows meet at the right (UAX #9 P2, the line
/// being the paragraph), as a text field's text does; 0 otherwise, and for lines that do not wrap.
fn rowShift<M: TextMetrics>(
    metrics: borrow M,
    config: TextConfig,
    line: Slice<u8>,
    row: Slice<u8>,
    wrap: bool,
    width: f32,
) -> f32 {
    if (!wrap || !bidiParagraphRtl(line)) {
        return 0.0;
    }
    return (width - metrics.measure(row, config).w).max(0.0);
}

/// The row of `r` that byte `local` of its line is in: a caret at a row's start is in that row.
fn rowOf(r: borrow LineRows, local: usize) -> usize {
    var row: usize = 0;
    for (k in 1..r.count) {
        if ((r.starts[k] as usize) <= local) {
            row = k;
        }
    }
    return row;
}

/// Row `row` of `line` laid out as `r`: its first byte and one past its last.
fn rowRange(r: borrow LineRows, line: Slice<u8>, row: usize) -> [usize; 2] {
    let from = r.starts[row] as usize;
    let to = if (row + 1 < r.count) r.starts[row + 1] as usize else line.length;
    return [from, to];
}

impl Controls {
    /// A text view (as textView: a long text indexed by `starts` and `count`, laid out a screenful at a time) whose
    /// text can be selected and copied, but not changed. `edit`'s caret and anchor are byte offsets into `text`.
    /// The pointer places the caret and a drag selects (a double click a word, a triple click a line; Shift
    /// extends); with the focus, the arrows move the caret as the text is drawn and across lines, Up and Down keep
    /// its place across, Home and End go to the line's ends, Page Up and Page Down move a view's height, the word
    /// modifier (Option on macOS, Control elsewhere) moves by words, Shift extends, and Copy and Select All act on
    /// the selection. The view scrolls to keep the caret in sight. Lines do not wrap. It measures text to place the
    /// caret, so it takes the text metrics.
    public fn selectableTextView<M: TextMetrics>(
        ui: borrow mut Ui,
        metrics: borrow M,
        id: StringView,
        text: Slice<u8>,
        starts: Slice<u32>,
        count: usize,
        look: Text,
        gutter: bool,
        edit: borrow mut TextEdit,
    ) {
        var none = [0u16; 1];
        var width: f32 = 0.0;
        var goal: f32 = -1.0;
        Controls.textViewOf(
            mut ui,
            metrics,
            id,
            text,
            starts,
            count,
            look,
            gutter,
            mut edit,
            false,
            mut none[0..0],
            mut width,
            mut goal,
        );
    }

    /// selectableTextView's work; an `editable` one also reports its caret to the host (the input method and a
    /// phone's keyboard follow it). With `rows` (one per line, the cache of how many rows each wraps into) and
    /// `look` wrapping words, lines wrap at the view's width; `wrapWidth` is the width the cache is for, and a new
    /// width clears it.
    fn textViewOf<M: TextMetrics>(
        ui: borrow mut Ui,
        metrics: borrow M,
        id: StringView,
        text: Slice<u8>,
        starts: Slice<u32>,
        count: usize,
        look: Text,
        gutter: bool,
        edit: borrow mut TextEdit,
        editable: bool,
        rows: SliceMut<u16>,
        wrapWidth: borrow mut f32,
        goalX: borrow mut f32,
    ) {
        let h = hashId(id);
        ui.registerFocusable(h);
        let config0 = look.config();
        let measures = viewMeasures(config0, count, gutter);
        let lineH = measures[0];
        let gutterW = measures[1];
        let wrap = config0.wrapsWords() && rows.length >= count && count > 0;
        let line = look.wrap(TextWrap.None).leading(lineH);
        let config = line.config();
        edit.caret = edit.caret.min(text.length);
        edit.anchor = edit.anchor.min(text.length);
        let box = ui.boxOfHash(h);
        let scroll = ui.scrollOffset(id);
        // The width rows wrap at: the view's, less the gutter and a caret's room. A new width clears the cache.
        let width = match (box) {
            Some(b) => (b.w - gutterW - 4.0).max(1.0),
            null => 0.0,
        };
        // The cache of rows per line: the text's lines long when wrapping, else empty.
        let limit = if (wrap) count else 0;
        if (wrap && width != wrapWidth) {
            for (k in 0..count) {
                rows[k] = 0;
            }
            wrapWidth = width;
        }
        // The lines in view are measured first, so that what the pointer and the keys find this frame (a new width
        // or an edit cleared the cache) is where it is drawn.
        if (wrap) {
            let viewTop = (0.0 - scroll.y).max(0.0);
            let viewHeight = match (box) {
                Some(b) => b.h,
                null => 0.0,
            };
            let lastRow = truncate<usize>(((viewTop + viewHeight) / lineH).ceil()) + 1;
            var k = lineOfRow(rows[0..limit], count, truncate<usize>((viewTop / lineH).floor()))[0];
            var rowAt = rowsBefore(rows[0..limit], k);
            while (k < count && rowAt <= lastRow) {
                rowAt += layRows(
                    metrics,
                    config,
                    lineOf(text, starts, count, k),
                    wrap,
                    width,
                    mut rows[0..limit],
                    k,
                ).count;
                k += 1;
            }
        }
        // Where a point in the view lands: its row (clamped to the text's), then the nearest caret in it.
        let p = ui.pointer();
        var pointed: usize? = null;
        match (box) {
            Some(b) => {
                if (count > 0) {
                    let contentY = p.position.y - b.y - scroll.y;
                    let row = truncate<usize>((contentY / lineH).floor().max(0.0));
                    let at = lineOfRow(rows[0..limit], count, row);
                    let k = at[0];
                    let lineText = lineOf(text, starts, count, k);
                    let r = layRows(metrics, config, lineText, wrap, width, mut rows[0..limit], k);
                    let range = rowRange(r, lineText, at[1].min(r.count - 1));
                    let rowText = lineText[range[0]..range[1]];
                    let shift = rowShift(metrics, config, lineText, rowText, wrap, width);
                    let x = p.position.x - b.x - scroll.x - gutterW - shift;
                    let inRow = offsetAtIn(metrics, rowText, config, x);
                    pointed = Some((starts[k] as usize) + range[0] + inRow);
                }
            }
            null => {}
        }
        var moved = false;
        if (ui.pressedOn(h)) {
            ui.setFocus(h);
            ui.capture(h);
            goalX = -1.0;
            match (pointed) {
                Some(at) => {
                    edit.caret = at;
                    if (!ui.shiftDown()) {
                        edit.anchor = at;
                    }
                    if (ui.pressCount() == 2) {
                        let w = wordAround(text, at);
                        edit.anchor = w[0];
                        edit.caret = w[1];
                    } else if (ui.pressCount() >= 3) {
                        let k = lineAt(starts, count, at);
                        edit.anchor = starts[k] as usize;
                        edit.caret = if (k + 1 < count) starts[k + 1] as usize else text.length;
                    }
                }
                null => {}
            }
        } else if (ui.hasFocus(h) && ui.releasedOutside(h)) {
            ui.leaveFocus(h);
        } else if (ui.captured() == h && p.down && ui.pressCount() < 2) {
            match (pointed) {
                Some(at) => {
                    edit.caret = at;
                    moved = true;
                }
                null => {}
            }
        }
        if (p.released && ui.captured() == h) {
            ui.capture(0);
        }
        let viewH = match (box) {
            Some(b) => b.h,
            null => ui.screenSize().h,
        };
        if (ui.hasFocus(h) && count > 0) {
            if (ui.commanded(EditCommand.SelectAll)) {
                edit.anchor = 0;
                edit.caret = text.length;
            }
            if (ui.commanded(EditCommand.Copy) && edit.selects()) {
                ui.copyText(text[edit.from()..edit.to()]);
            }
            let shift = ui.shiftDown();
            let k = lineAt(starts, count, edit.caret);
            let lineStart = starts[k] as usize;
            let lineText = lineOf(text, starts, count, k);
            let local = (edit.caret - lineStart).min(lineText.length);
            let r = layRows(metrics, config, lineText, wrap, width, mut rows[0..limit], k);
            let row = rowOf(r, local);
            let range = rowRange(r, lineText, row);
            let rowText = lineText[range[0]..range[1]];
            let inRow = local - range[0];
            var target: usize? = null;
            for (right in [false, true]) {
                if (!ui.keyHit(if (right) Key.Right else Key.Left)) {
                    continue;
                }
                if (ui.wordModifierDown()) {
                    let forward = right != bidiParagraphRtl(lineText);
                    target = Some(if (forward) wordForward(text, edit.caret) else wordBackward(text, edit.caret));
                } else if (!shift && edit.selects()) {
                    target = Some(if (right) edit.to() else edit.from());
                } else {
                    let step = lineStep(metrics, rowText, config, inRow, right);
                    let forward = right != bidiParagraphRtl(lineText);
                    if (step != inRow) {
                        target = Some(lineStart + range[0] + step);
                    } else if (forward && row + 1 < r.count) {
                        // At a wrapped row's end: on into the next row (its start is this row's end).
                        let next = rowRange(r, lineText, row + 1);
                        target = Some(
                            lineStart + next[0] + graphemeEnd(lineText[next[0]..next[1]], 0).min(next[1] - next[0]),
                        );
                    } else if (!forward && row > 0) {
                        target = Some(lineStart + graphemeBefore(lineText[0..range[0]], range[0]));
                    } else if (forward && k + 1 < count) {
                        // At the line's edge: on to the next line's start, or back to the end of the one before,
                        // as the line reads.
                        target = Some(starts[k + 1] as usize);
                    } else if (!forward && k > 0) {
                        target = Some(lineEnd(text, starts, count, k - 1));
                    }
                }
            }
            // Up, Down, Page Up and Page Down move by rows on the screen, keeping the caret's place across.
            let page = truncate<usize>((viewH / lineH).floor().max(1.0));
            var steps: usize = 0;
            var down = false;
            if (ui.keyHit(Key.Up)) {
                steps = 1;
            } else if (ui.keyHit(Key.Down)) {
                steps = 1;
                down = true;
            } else if (ui.keyHit(Key.PageUp)) {
                steps = page;
            } else if (ui.keyHit(Key.PageDown)) {
                steps = page;
                down = true;
            }
            if (steps > 0) {
                // The place across that Up and Down keep: the one they started from, through shorter rows.
                let here = rowShift(
                    metrics,
                    config,
                    lineText,
                    rowText,
                    wrap,
                    width,
                ) + metrics.caretX(rowText, config, inRow);
                let goal: f32 = goalX;
                let x = if (goal >= 0.0) goal else here;
                goalX = x;
                var kk = k;
                var rr = row;
                var rowsHere = r.count;
                for (s in 0..steps) {
                    let _ = s;
                    if (down) {
                        if (rr + 1 < rowsHere) {
                            rr += 1;
                        } else if (kk + 1 < count) {
                            kk += 1;
                            rr = 0;
                            rowsHere = layRows(
                                metrics,
                                config,
                                lineOf(text, starts, count, kk),
                                wrap,
                                width,
                                mut rows[0..limit],
                                kk,
                            ).count;
                        }
                    } else {
                        if (rr > 0) {
                            rr -= 1;
                        } else if (kk > 0) {
                            kk -= 1;
                            rowsHere = layRows(
                                metrics,
                                config,
                                lineOf(text, starts, count, kk),
                                wrap,
                                width,
                                mut rows[0..limit],
                                kk,
                            ).count;
                            rr = rowsHere - 1;
                        }
                    }
                }
                let other = lineOf(text, starts, count, kk);
                let lr = layRows(metrics, config, other, wrap, width, mut rows[0..limit], kk);
                let span = rowRange(lr, other, rr.min(lr.count - 1));
                let otherRow = other[span[0]..span[1]];
                let otherShift = rowShift(metrics, config, other, otherRow, wrap, width);
                var landed = span[0] + offsetAtIn(metrics, otherRow, config, x - otherShift);
                // Not past a wrapped row's end: that place is the next row's start.
                if (rr + 1 < lr.count && landed >= span[1] && span[1] > span[0]) {
                    landed = span[0] + graphemeBefore(other[span[0]..span[1]], span[1] - span[0]);
                }
                target = Some((starts[kk] as usize) + landed);
            }
            if (ui.keyPressed(Key.Home)) {
                target = Some(lineStart);
            }
            if (ui.keyPressed(Key.End)) {
                target = Some(lineStart + lineText.length);
            }
            match (target) {
                Some(t) => {
                    edit.caret = t;
                    if (!shift) {
                        edit.anchor = t;
                    }
                    moved = true;
                    if (steps == 0) {
                        goalX = -1.0; // another move: Up and Down start again from where the caret is
                    }
                }
                null => {}
            }
        }
        // The caret's line and row, laid out.
        let caretLine = if (count > 0) lineAt(starts, count, edit.caret) else 0;
        var caretRow: usize = 0;
        var caretRowTop: usize = 0;
        if (count > 0) {
            let lineText = lineOf(text, starts, count, caretLine);
            let r = layRows(metrics, config, lineText, wrap, width, mut rows[0..limit], caretLine);
            caretRow = rowOf(r, edit.caret - (starts[caretLine] as usize));
            caretRowTop = rowsBefore(rows[0..limit], caretLine) + caretRow;
        }
        // The caret moved: the view scrolls just enough to show its row and place.
        match (box) {
            Some(b) => {
                if (moved && count > 0) {
                    let top = round<f32>(caretRowTop) * lineH;
                    let shownTop = -scroll.y;
                    var dy: f32 = 0.0;
                    if (top < shownTop) {
                        dy = shownTop - top;
                    } else if (top + lineH > shownTop + b.h) {
                        dy = shownTop + b.h - (top + lineH);
                    }
                    let lineText = lineOf(text, starts, count, caretLine);
                    let r = layRows(metrics, config, lineText, wrap, width, mut rows[0..limit], caretLine);
                    let range = rowRange(r, lineText, caretRow);
                    let local = edit.caret - (starts[caretLine] as usize);
                    let rowText = lineText[range[0]..range[1]];
                    let shift = rowShift(metrics, config, lineText, rowText, wrap, width);
                    let x = gutterW + shift + metrics.caretX(rowText, config, local - range[0]);
                    let shownLeft = -scroll.x;
                    var dx: f32 = 0.0;
                    if (x < shownLeft + gutterW) {
                        dx = shownLeft + gutterW - x;
                    } else if (x + 2.0 > shownLeft + b.w) {
                        dx = shownLeft + b.w - (x + 2.0);
                    }
                    if (dx != 0.0 || dy != 0.0) {
                        ui.scrollBy(id, dx, dy);
                    }
                }
            }
            null => {}
        }
        // The rows in view: from the row at the top, a few either side, line by line.
        let shownTop = (0.0 - ui.scrollOffset(id).y).max(0.0);
        let firstRow = truncate<usize>((shownTop / lineH).floor().max(0.0));
        let fromRow = if (firstRow > 4) firstRow - 4 else 0;
        let lastRow = firstRow + truncate<usize>((viewH / lineH).ceil().max(1.0)) + 4;
        let start = if (count > 0) lineOfRow(rows[0..limit], count, fromRow)[0] else 0;
        let focused = ui.hasFocus(h);
        let blink = (truncate<u64>((ui.time() * 2.0).floor()) & 1) == 0;
        // Clipped both ways, so that no row's width can widen the view (wrapped rows fit it, and the view stays as
        // wide as its parent gives it).
        ui.open(Style.column().id(id).w(Size.grow()).h(Size.grow()).scroll(ScrollAxis.Both).bg(SLATE_900));
        let above = rowsBefore(rows[0..limit], start);
        ui.open(Style.box().w(Size.fixed(1.0)).h(Size.fixed(round<f32>(above) * lineH)));
        ui.close();
        var rowAt = above;
        var k = start;
        while (k < count && rowAt <= lastRow) {
            let lineStart = starts[k] as usize;
            let lineText = lineOf(text, starts, count, k);
            let lineStop = lineStart + lineText.length;
            let r = layRows(metrics, config, lineText, wrap, width, mut rows[0..limit], k);
            for (row in 0..r.count) {
                let range = rowRange(r, lineText, row);
                let rowText = lineText[range[0]..range[1]];
                let rowStart = lineStart + range[0];
                let rowStop = lineStart + range[1];
                let lastOfLine = row + 1 == r.count;
                // A wrapping view's rows are as wide as the view, whatever their text: no row widens it, not even on the
                // first frame, before it has a width and its lines are unwrapped (a point wide then: a fixed width of 0
                // is the engine's "no maximum"), so it is as wide as its parent gives it, even inside a clipping parent,
                // which leaves an overflowing child as it is.
                let rowStyle = Style.row().h(Size.fixed(lineH)).alignXY(AxisAlign.Start, AxisAlign.Center);
                ui.open(if (wrap) rowStyle.w(Size.fixed((gutterW + width).max(1.0))) else rowStyle);
                if (gutter) {
                    ui.open(Style.box().w(Size.fixed(gutterW)).pr(12.0).alignXY(AxisAlign.End, AxisAlign.Center));
                    if (row == 0) {
                        var number = [0u8; 12];
                        var w = TextWriter.create(mut number[..]);
                        w.decimal((k + 1) as u64);
                        ui.labelBytes(w.written(), line.color(SLATE_500));
                    }
                    ui.close();
                }
                let shift = rowShift(metrics, config, lineText, rowText, wrap, width);
                ui.open(Style.box().h(Size.fixed(lineH)).ml(shift).alignXY(AxisAlign.Start, AxisAlign.Center));
                // The selection on this row, behind its text: where its characters are drawn, and on a line's last
                // row the line break after them as a narrow box when the selection runs on.
                if (edit.selects() && edit.from() <= rowStop && edit.to() > rowStart) {
                    var spans = [TextSpan { left: 0.0, right: 0.0 }; 8];
                    let a = edit.from().max(rowStart) - rowStart;
                    let b = edit.to().min(rowStop) - rowStart;
                    var n = metrics.spans(rowText, config, a, b, mut spans[..]);
                    if (lastOfLine && edit.to() > lineStop) {
                        let end = metrics.measure(rowText, config).w;
                        let size = if (config.fontSize > 0.0) config.fontSize else 16.0;
                        n = addTextSpan(mut spans[..], n, end, end + size * 0.4);
                    }
                    for (s in 0..n) {
                        let span = spans[s];
                        ui.open(Style.box().absolute().passthrough().left(span.left).top(0.0)
                            .w(Size.fixed(span.right - span.left)).h(Size.fixed(lineH)).bg(0x3B82F666));
                        ui.close();
                    }
                }
                let caretHere = focused && k == caretLine && row == caretRow;
                // An editable view's caret row shows the input method's composition at the caret while it
                // composes: spliced in, underlined, the caret where the input method has it.
                let composing = editable && caretHere && ui.composition().length > 0;
                var spliced = [0u8; 4096];
                var shownText = rowText;
                var caretAt = if (caretHere && edit.caret >= rowStart) edit.caret - rowStart else 0;
                if (composing) {
                    let comp = ui.composition();
                    let before = caretAt.min(4096);
                    let n = comp.length.min(4096 - before);
                    let after = (rowText.length - before).min(4096 - before - n);
                    for (i in 0..before) {
                        spliced[i] = rowText[i];
                    }
                    for (i in 0..n) {
                        spliced[before + i] = comp[i];
                    }
                    for (i in 0..after) {
                        spliced[before + n + i] = rowText[before + i];
                    }
                    shownText = spliced[0..before + n + after];
                    let u0 = metrics.caretX(shownText, config, before);
                    let u1 = metrics.caretX(shownText, config, before + n);
                    ui.open(Style.box().absolute().passthrough().left(u0.min(u1)).top(lineH - 2.0)
                        .w(Size.fixed((u1 - u0).abs())).h(Size.fixed(1.0)).bg(SLATE_100));
                    ui.close();
                    caretAt = before + ui.compositionCaret().min(n);
                }
                ui.labelBytes(shownText, line);
                if (caretHere) {
                    let x = metrics.caretX(shownText, config, caretAt);
                    if (blink || composing) {
                        ui.open(Style.box().absolute().passthrough().left(x).top(0.0).w(Size.fixed(2.0))
                            .h(Size.fixed(lineH)).bg(SLATE_200));
                        ui.close();
                    }
                    match (box) {
                        Some(b) => {
                            if (editable) {
                                let shown = ui.scrollOffset(id);
                                ui.reportCaret(Rect {
                                    x: b.x + shown.x + gutterW + shift + x,
                                    y: b.y + shown.y + round<f32>(rowAt) * lineH,
                                    w: 2.0,
                                    h: lineH,
                                });
                            }
                        }
                        null => {}
                    }
                }
                ui.close();
                ui.close();
                rowAt += 1;
            }
            k += 1;
        }
        // The rows below, as the cache knows them.
        var below: usize = 0;
        for (j in k..count) {
            below += cachedRows(rows[0..limit], j);
        }
        ui.open(Style.box().w(Size.fixed(1.0)).h(Size.fixed(round<f32>(below) * lineH)));
        ui.close();
        ui.close();
    }
}

/// Replaces bytes [`from`, `to`) of `buf[0..len]` with `insert`, the tail moved once. False when it does not fit
/// `buf` (nothing changes then).
fn spliceBytes(buf: SliceMut<u8>, len: borrow mut usize, from: usize, to: usize, insert: Slice<u8>) -> bool {
    let removed = to - from;
    let n: usize = len;
    if (n - removed + insert.length > buf.length) {
        return false;
    }
    if (insert.length > removed) {
        let grow = insert.length - removed;
        var i = n;
        while (i > to) {
            i -= 1;
            buf[i + grow] = buf[i];
        }
    } else if (insert.length < removed) {
        let shrink = removed - insert.length;
        for (i in to..n) {
            buf[i - shrink] = buf[i];
        }
    }
    for (i in 0..insert.length) {
        buf[from + i] = insert[i];
    }
    len = n - removed + insert.length;
    return true;
}

/// Indexes the lines of `text` into `starts` again from line `first` on (the lines before it unchanged), as
/// indexLines does: the number of lines, or null when `starts` has no room for them all.
public fn reindexLines(text: Slice<u8>, starts: SliceMut<u32>, first: usize) -> usize? {
    if (starts.length == 0) {
        return null;
    }
    if (first == 0) {
        return indexLines(text, starts);
    }
    var n = first;
    let from = starts[first - 1] as usize;
    for (i in from..text.length) {
        if (text[i] == '\n') {
            if (n >= starts.length) {
                return null;
            }
            starts[n] = truncate<u32>(i + 1);
            n += 1;
        }
    }
    return n;
}

/// How many line breaks `bytes` holds.
fn newlines(bytes: Slice<u8>) -> usize {
    var n: usize = 0;
    for (b in bytes) {
        if (b == '\n') {
            n += 1;
        }
    }
    return n;
}

/// A text editor's undo history (textEditorWithUndo), kept in a caller-owned buffer of records: each edit's place,
/// the bytes it removed and inserted, and the caret before it. The records before `used` can be undone; those from
/// `used` to `end` were undone and can be redone, until the next edit. A run of typing is one record, ended by a
/// space, a line break or a move of the caret, so Undo takes back a word. When the buffer is full the oldest records
/// go.
public struct TextHistory {
    used: usize;
    end: usize;
    /// Where the caret is after the record being typed (it may be joined), or none.
    typingAt: usize?;

    public fn create() -> TextHistory => TextHistory { used: 0, end: 0, typingAt: null };

    /// Whether there is an edit to undo, or one to redo.
    public fn canUndo(borrow this) -> bool => this.used > 0;
    public fn canRedo(borrow this) -> bool => this.end > this.used;
}

/// A record's header: from, removed length, inserted length, caret before, anchor before (u32 each), then the
/// removed and inserted bytes, then the record's whole length (u32), so records are walked back from the end.
const RECORD_HEAD: usize = 20;

fn putU32(store: SliceMut<u8>, at: usize, v: usize) {
    let x = truncate<u32>(v);
    store[at] = truncate<u8>(x);
    store[at + 1] = truncate<u8>(x >> 8);
    store[at + 2] = truncate<u8>(x >> 16);
    store[at + 3] = truncate<u8>(x >> 24);
}

fn getU32(store: Slice<u8>, at: usize) -> usize =>
    ((store[at] as u32) |
        ((store[at + 1] as u32) << 8) | ((store[at + 2] as u32) << 16) | ((store[at + 3] as u32) << 24)) as usize;

/// Drops the oldest record of `store`, moving the rest down.
fn dropOldest(store: SliceMut<u8>, state: borrow mut TextHistory) {
    if (state.end == 0) {
        return;
    }
    let size = RECORD_HEAD + getU32(store, 4) + getU32(store, 8) + 4;
    for (i in size..state.end) {
        store[i - size] = store[i];
    }
    state.end -= size;
    state.used = if (state.used >= size) state.used - size else 0;
}

/// Records an edit about to be made: bytes [`from`, `from + removed.length`) become `inserted`, the selection
/// before it `caret` and `anchor`. A typed character right after the record being typed joins it.
fn record(
    store: SliceMut<u8>,
    state: borrow mut TextHistory,
    from: usize,
    removed: Slice<u8>,
    inserted: Slice<u8>,
    caret: usize,
    anchor: usize,
    typed: bool,
) {
    if (store.length == 0) {
        return;
    }
    // A run of typing goes on until a space or a line break, which ends it.
    let ends = inserted.length == 1 && (inserted[0] == ' ' || inserted[0] == '\n');
    state.end = state.used; // what was undone cannot be redone after a new edit
    let joins = typed && removed.length == 0 && state.typingAt == Some(from) && state.used >= RECORD_HEAD + 4;
    if (joins) {
        let size = getU32(store, state.used - 4);
        let start = state.used - size;
        if (state.used + inserted.length <= store.length) {
            // Over the old trailer: the new bytes, then the trailer again.
            let at = state.used - 4;
            for (i in 0..inserted.length) {
                store[at + i] = inserted[i];
            }
            putU32(store, start + 8, getU32(store, start + 8) + inserted.length);
            putU32(store, at + inserted.length, size + inserted.length);
            state.used += inserted.length;
            state.end = state.used;
            state.typingAt = if (ends) null else Some(from + inserted.length);
            return;
        }
    }
    let size = RECORD_HEAD + removed.length + inserted.length + 4;
    if (size > store.length) {
        // An edit larger than the whole history: nothing before it can be undone across it.
        state.used = 0;
        state.end = 0;
        state.typingAt = null;
        return;
    }
    while (state.used + size > store.length) {
        dropOldest(store, mut state);
    }
    let at = state.used;
    putU32(store, at, from);
    putU32(store, at + 4, removed.length);
    putU32(store, at + 8, inserted.length);
    putU32(store, at + 12, caret);
    putU32(store, at + 16, anchor);
    for (i in 0..removed.length) {
        store[at + RECORD_HEAD + i] = removed[i];
    }
    for (i in 0..inserted.length) {
        store[at + RECORD_HEAD + removed.length + i] = inserted[i];
    }
    putU32(store, at + size - 4, size);
    state.used += size;
    state.end = state.used;
    state.typingAt = if (typed && removed.length == 0 && !ends) Some(from + inserted.length) else null;
}

/// A text editor's document, all in caller-owned memory: the text (`buf`, its first `len` bytes), the index of its
/// lines (`starts`, the first `count`), how many rows each line wraps into (`rows`, at least one per line; empty for
/// lines that do not wrap), the caret and the selection (`edit`, byte offsets into the text), and the undo history
/// (`history`, its size the history's; empty for none). The editor keeps them in step; an edit with no room in
/// `buf` or `starts` is not made.
public struct TextDocument<region r> {
    public buf: SliceMut<r, u8>;
    public len: usize;
    public starts: SliceMut<r, u32>;
    public count: usize;
    public rows: SliceMut<r, u16>;
    public edit: TextEdit;
    public history: SliceMut<r, u8>;
    public undo: TextHistory;
    /// The width the rows were counted at (the editor keeps it; a program that makes its document again each frame
    /// over the same memory carries it over, with `len`, `count`, `edit` and `undo`).
    public wrapWidth: f32;
    /// The place across (from the view's text edge) that Up and Down keep while they move the caret through
    /// shorter lines; negative when there is none (any other move forgets it). Carried over as `wrapWidth` is.
    public goalX: f32;

    /// A document of `buf`'s first `len` bytes, its lines indexed into `starts`.
    public fn over(
        buf: SliceMut<r, u8>,
        len: usize,
        starts: SliceMut<r, u32>,
        rows: SliceMut<r, u16>,
        history: SliceMut<r, u8>,
    ) -> TextDocument<r> {
        let n = len.min(buf.length);
        let count = indexLines(buf[0..n], starts) ?? 0;
        return TextDocument {
            buf: buf,
            len: n,
            starts: starts,
            count: count,
            rows: rows,
            edit: TextEdit.at(0),
            history: history,
            undo: TextHistory.create(),
            wrapWidth: 0.0,
            goalX: -1.0,
        };
    }

    /// The text.
    public fn text(borrow this) -> Slice<u8> => this.buf[0..this.len];
}

impl Controls {
    /// A text editor over `doc` (TextDocument): a selectableTextView (the caret, the selection, the keys and the
    /// pointer as there) that changes its text. Typing and Paste replace the selection, Enter starts a new line,
    /// Backspace and Delete take the selection or a grapheme cluster (at a line's edge, the line break, joining the
    /// lines), Cut takes the selection, and with a history Undo and Redo (secondary-Z, secondary-Shift-Z,
    /// Control-Y by default) take edits back a word of typing at a time and make them again. When `look` wraps words
    /// and `doc` has rows, lines wrap at the view's width, and Up, Down and the page keys move by rows on the
    /// screen. An input method's composition shows underlined at the caret. Whether the text changed.
    public fn textEditor<M: TextMetrics>(
        ui: borrow mut Ui,
        metrics: borrow M,
        id: StringView,
        doc: borrow mut TextDocument,
        look: Text,
        gutter: bool,
    ) -> bool {
        let h = hashId(id);
        doc.len = doc.len.min(doc.buf.length);
        if (doc.count == 0 || doc.count > doc.starts.length) {
            doc.count = indexLines(doc.buf[0..doc.len], doc.starts) ?? 0;
        }
        doc.edit.caret = doc.edit.caret.min(doc.len);
        doc.edit.anchor = doc.edit.anchor.min(doc.len);
        doc.undo.used = doc.undo.used.min(doc.history.length);
        doc.undo.end = doc.undo.end.min(doc.history.length).max(doc.undo.used);
        let countBefore = doc.count;
        var changed = false;
        if (ui.hasFocus(h) && doc.count > 0) {
            if (ui.commanded(EditCommand.Undo)) {
                changed = undoIn(
                    doc.buf,
                    mut doc.len,
                    doc.starts,
                    mut doc.count,
                    mut doc.edit,
                    doc.history,
                    mut doc.undo,
                ) ||
                    changed;
            }
            if (ui.commanded(EditCommand.Redo)) {
                changed = redoIn(
                    doc.buf,
                    mut doc.len,
                    doc.starts,
                    mut doc.count,
                    mut doc.edit,
                    doc.history,
                    mut doc.undo,
                ) ||
                    changed;
            }
            if (ui.commanded(EditCommand.Cut) && doc.edit.selects()) {
                ui.copyText(doc.buf[doc.edit.from()..doc.edit.to()]);
                changed = replaceIn(
                    doc.buf, mut doc.len, doc.starts, mut doc.count, mut doc.edit, "".bytes(), doc.history, mut doc.undo,
                    false,
                ) || changed;
            }
            if (ui.commanded(EditCommand.Paste)) {
                var pasted = [0u8; 4096];
                let text = ui.pastedText();
                let n = text.length.min(4096);
                for (i in 0..n) {
                    pasted[i] = text[i];
                }
                changed = replaceIn(
                    doc.buf, mut doc.len, doc.starts, mut doc.count, mut doc.edit, pasted[0..n], doc.history, mut doc.undo,
                    false,
                ) || changed;
            }
            loop {
                let c = ui.nextChar();
                if (c == 0) {
                    break;
                }
                if (!typeable(c)) {
                    continue;
                }
                var bytes = [0u8; 4];
                let n = encodeUtf8(c, mut bytes);
                changed = replaceIn(
                    doc.buf, mut doc.len, doc.starts, mut doc.count, mut doc.edit, bytes[0..n], doc.history, mut doc.undo,
                    true,
                ) || changed;
            }
            if (ui.keyHit(Key.Enter)) {
                changed = replaceIn(
                    doc.buf, mut doc.len, doc.starts, mut doc.count, mut doc.edit, "\n".bytes(), doc.history, mut doc.undo,
                    true,
                ) || changed;
            }
            if (ui.keyHit(Key.Backspace) && (doc.edit.selects() || doc.edit.caret > 0)) {
                if (!doc.edit.selects()) {
                    doc.edit.anchor = stepBack(doc.buf[0..doc.len], doc.starts[0..doc.count], doc.edit.caret);
                }
                changed = replaceIn(
                    doc.buf, mut doc.len, doc.starts, mut doc.count, mut doc.edit, "".bytes(), doc.history, mut doc.undo,
                    false,
                ) || changed;
            }
            if (ui.keyHit(Key.Delete) && (doc.edit.selects() || doc.edit.caret < doc.len)) {
                if (!doc.edit.selects()) {
                    doc.edit.anchor = stepOn(doc.buf[0..doc.len], doc.starts[0..doc.count], doc.edit.caret);
                }
                changed = replaceIn(
                    doc.buf, mut doc.len, doc.starts, mut doc.count, mut doc.edit, "".bytes(), doc.history, mut doc.undo,
                    false,
                ) || changed;
            }
        }
        if (changed) {
            doc.goalX = -1.0;
        }
        // An edit moves the lines after it: their rows are counted again (the line count may have changed).
        if (changed && doc.rows.length > 0) {
            let first = if (countBefore != doc.count) 0 else lineAt(
                doc.starts[0..doc.count],
                doc.count,
                doc.edit.from(),
            );
            for (k in first..doc.count.min(doc.rows.length)) {
                doc.rows[k] = 0;
            }
        }
        Controls.textViewOf(
            mut ui,
            metrics,
            id,
            doc.buf[0..doc.len],
            doc.starts[0..doc.count],
            doc.count,
            look,
            gutter,
            mut doc.edit,
            true,
            doc.rows,
            mut doc.wrapWidth,
            mut doc.goalX,
        );
        return changed;
    }
}

/// The selection of `buf[0..len]` replaced by `insert`, the caret after it and nothing selected, the index
/// following, the edit recorded in `history` (`typed`: a typed character, which may join a run of typing); whether
/// anything changed (false too when the text or its index has no room for it).
fn replaceIn(
    buf: SliceMut<u8>,
    len: borrow mut usize,
    starts: SliceMut<u32>,
    count: borrow mut usize,
    edit: borrow mut TextEdit,
    insert: Slice<u8>,
    history: SliceMut<u8>,
    state: borrow mut TextHistory,
    typed: bool,
) -> bool {
    let from = edit.from();
    let to = edit.to();
    if (from == to && insert.length == 0) {
        return false;
    }
    let lines = count - newlines(buf[from..to]) + newlines(insert);
    if (lines > starts.length || len - (to - from) + insert.length > buf.length) {
        return false;
    }
    record(history, mut state, from, buf[from..to], insert, edit.caret, edit.anchor, typed);
    let _ = spliceBytes(buf, mut len, from, to, insert);
    let first = lineAt(starts[0..count], count, from) + 1;
    count = reindexLines(buf[0..len], starts, first) ?? count;
    edit.caret = from + insert.length;
    edit.anchor = edit.caret;
    return true;
}

/// Undoes the last edit of `history`: its inserted bytes become the removed ones again, and the selection is as it
/// was before it. False when there is none, or no room to put the text back.
fn undoIn(
    buf: SliceMut<u8>,
    len: borrow mut usize,
    starts: SliceMut<u32>,
    count: borrow mut usize,
    edit: borrow mut TextEdit,
    history: SliceMut<u8>,
    state: borrow mut TextHistory,
) -> bool {
    if (state.used < RECORD_HEAD + 4) {
        return false;
    }
    let size = getU32(history, state.used - 4);
    let at = state.used - size;
    let from = getU32(history, at);
    let removed = getU32(history, at + 4);
    let inserted = getU32(history, at + 8);
    let back = history[at + RECORD_HEAD..at + RECORD_HEAD + removed];
    let lines = count - newlines(buf[from..from + inserted]) + newlines(back);
    if (from + inserted > len || lines > starts.length || !spliceBytes(buf, mut len, from, from + inserted, back)) {
        return false;
    }
    let first = lineAt(starts[0..count], count, from) + 1;
    count = reindexLines(buf[0..len], starts, first) ?? count;
    edit.caret = getU32(history, at + 12).min(len);
    edit.anchor = getU32(history, at + 16).min(len);
    state.used = at;
    state.typingAt = null;
    return true;
}

/// Makes the edit after `history`'s undone ones again. False when there is none, or no room for it.
fn redoIn(
    buf: SliceMut<u8>,
    len: borrow mut usize,
    starts: SliceMut<u32>,
    count: borrow mut usize,
    edit: borrow mut TextEdit,
    history: SliceMut<u8>,
    state: borrow mut TextHistory,
) -> bool {
    if (state.end < state.used + RECORD_HEAD + 4) {
        return false;
    }
    let at = state.used;
    let from = getU32(history, at);
    let removed = getU32(history, at + 4);
    let inserted = getU32(history, at + 8);
    let again = history[at + RECORD_HEAD + removed..at + RECORD_HEAD + removed + inserted];
    let lines = count - newlines(buf[from..from + removed]) + newlines(again);
    if (from + removed > len || lines > starts.length || !spliceBytes(buf, mut len, from, from + removed, again)) {
        return false;
    }
    let first = lineAt(starts[0..count], count, from) + 1;
    count = reindexLines(buf[0..len], starts, first) ?? count;
    edit.caret = from + inserted;
    edit.anchor = edit.caret;
    state.used = at + RECORD_HEAD + removed + inserted + 4;
    state.typingAt = null;
    return true;
}

/// Where Backspace takes the text back to from byte `at`: the start of the grapheme cluster before it in its line,
/// or at a line's start the line break before (a CR LF whole).
fn stepBack(text: Slice<u8>, starts: Slice<u32>, at: usize) -> usize {
    let k = lineAt(starts, starts.length, at);
    let lineStart = starts[k] as usize;
    if (at > lineStart) {
        return lineStart + graphemeBefore(text[lineStart..at], at - lineStart);
    }
    if (at >= 2 && text[at - 1] == '\n' && text[at - 2] == '\r') {
        return at - 2;
    }
    return at - 1;
}

/// Where Delete takes the text on to from byte `at`: the end of the grapheme cluster after it in its line, or at a
/// line's end past the line break (a CR LF whole).
fn stepOn(text: Slice<u8>, starts: Slice<u32>, at: usize) -> usize {
    let k = lineAt(starts, starts.length, at);
    let stop = lineEnd(text, starts, starts.length, k);
    if (at < stop) {
        return (at + graphemeEnd(text[at..stop], 0)).min(stop);
    }
    if (text[at] == '\r' && at + 1 < text.length && text[at + 1] == '\n') {
        return at + 2;
    }
    return at + 1;
}
