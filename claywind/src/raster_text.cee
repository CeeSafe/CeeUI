// SPDX-License-Identifier: MIT
// Text as glyphs: a run's UTF-8 becomes positioned glyphs, each from the run's font or, for a character it lacks,
// the first font of the fallback chain that has it (Raster.setFallbacks). Measuring, drawing and a GPU backend
// (Raster.shapeRun) walk the same glyphs, so what is measured is what is drawn.
//
// The pen moves in the run's own font's units: a fallback glyph's advance is converted to them. A run in one font
// is therefore placed by the same arithmetic as before fallbacks existed, which is ThorVG's.

/// A glyph of a shaped run (Raster.shapeRun).
public struct ShapedGlyph {
    /// The loaded font it is drawn from (an index for Raster.rasterizeGlyph), and its glyph id there.
    public font: u32;
    public glyph: u32;
    /// Where its origin goes: pixels right of the run's start, kerning and letter spacing applied, and pixels below
    /// the baseline (a mark GPOS raised is negative).
    public x: f32;
    public y: f32;
    /// The byte offset in the run's UTF-8 of the character it draws (a ligature's first).
    public cluster: usize;
    /// How far it moves the pen, in pixels (its advance, kerning and letter spacing applied; a mark's is usually
    /// none). Its place less the pen before it is its offset: a layout that keeps its own pen (advancing it glyph
    /// by glyph, as CosmoFonts and HarfBuzz's clients do) places it at pen + offset and moves by this.
    public advance: f32;
}

/// What Raster.shapeRun shaped.
public struct ShapedRun {
    /// The baseline's distance below the run's top, in pixels: the run's own font's ascent.
    public ascent: f32;
    /// The pen after the last glyph, in pixels: the run's width.
    public width: f32;
    /// How many glyphs it wrote (more glyphs than `out` holds are left out, but still measured).
    public count: usize;
}

/// The previous glyph's font, for a mark that stays with it.
struct ShapeCursor {
    at: usize;
    pen: f32;
    previousSlot: usize;
    previousGlyph: u32;
    hasPrevious: bool;
}

/// One glyph as the shaper places it.
struct StepGlyph {
    slot: usize;
    glyph: u32;
    /// The glyph's origin, in the run's font's units: right of the run's start, and up from the baseline.
    pen: f32;
    rise: f32;
    cluster: usize;
    /// How far it moves the pen (in the run's font's units), and whether it is in a right-to-left run.
    advance: f32;
    rtl: bool;
}

fn emptyStep() -> StepGlyph =>
    StepGlyph { slot: 0, glyph: 0, pen: 0.0, rise: 0.0, cluster: 0, advance: 0.0, rtl: false };

/// What shaping a line came to: the pen after it (the run's font's units) and how many glyphs it made.
struct ShapeTotals {
    pen: f32;
    glyphs: usize;
}

/// Characters with no glyph and no width: zero-width spaces and joiners, directional marks, variation selectors,
/// the byte order mark, the soft hyphen, and C0 controls (a newline ends nothing here: lines are split before).
fn ignorable(cp: u32) -> bool =>
    cp < 0x20 || cp == 0x7F || cp == 0xAD || cp == 0x34F || (cp >= 0x180B && cp <= 0x180F) ||
        (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x202A && cp <= 0x202E) || (cp >= 0x2060 && cp <= 0x206F) ||
        cp == 0xFEFF || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0xE0000 && cp <= 0xE0FFF);

/// Whether `cp` may begin an emoji sequence: an Extended_Pictographic character, a regional indicator (a flag's
/// half), or a keycap's digit, # or *.
fn mayStartEmoji(cp: u32) -> bool =>
    (cp >= 0x30 && cp <= 0x39) || cp == 0x23 || cp == 0x2A || (cp >= 0x1F1E6 && cp <= 0x1F1FF) ||
        (cp >= 0xA9 && isPictographic(cp));

/// Whether `utf8[from..to]` (the rest of a grapheme cluster) has what makes an emoji sequence: VS16, ZWJ, the
/// combining keycap, a skin-tone modifier, a regional indicator or a tag character.
fn hasEmojiComponent(utf8: Slice<u8>, from: usize, to: usize) -> bool {
    var i = from;
    while (i < to) {
        let c = decodeUtf8(utf8, i);
        let cp = c[0];
        if (cp == 0xFE0F || cp == 0x200D || cp == 0x20E3 || (cp >= 0x1F3FB && cp <= 0x1F3FF) ||
            (cp >= 0x1F1E6 && cp <= 0x1F1FF) || (cp >= 0xE0020 && cp <= 0xE007F)) {
            return true;
        }
        i += c[1] as usize;
    }
    return false;
}

/// Combining marks (general category Mn, Mc, Me), which stay in the font of the character they mark when it has
/// them.
fn combining(cp: u32) -> bool {
    let gc = gcOf(unicodeProps(cp));
    return gc == GC_MN || gc == GC_MC || gc == GC_ME;
}

/// The OpenType script tag for a run whose first strong character is `cp` ('DFLT' and 'latn' are tried after).
fn scriptTag(cp: u32) -> u32 {
    if (cp >= 0x370 && cp <= 0x3FF) {
        return 0x6772656B; // grek
    }
    if (cp >= 0x400 && cp <= 0x52F) {
        return 0x6379726C; // cyrl
    }
    if (cp >= 0x590 && cp <= 0x5FF) {
        return 0x68656272; // hebr
    }
    if ((cp >= 0x600 && cp <= 0x6FF) || (cp >= 0x750 && cp <= 0x77F) || (cp >= 0x8A0 && cp <= 0x8FF) ||
        (cp >= 0xFB50 && cp <= 0xFDFF) || (cp >= 0xFE70 && cp <= 0xFEFF)) {
        return 0x61726162; // arab
    }
    if (cp >= 0x900 && cp <= 0xD7F) {
        return indicScriptTag(cp); // dev2, bng2, gur2, gjr2, ory2, tml2, tel2, knd2, mlm2
    }
    if (cp >= 0xE00 && cp <= 0xE7F) {
        return 0x74686169; // thai
    }
    if ((cp >= 0x1100 && cp <= 0x11FF) || (cp >= 0xAC00 && cp <= 0xD7AF)) {
        return 0x68616E67; // hang
    }
    if (cp >= 0x3040 && cp <= 0x30FF) {
        return 0x6B616E61; // kana
    }
    if ((cp >= 0x4E00 && cp <= 0x9FFF) || (cp >= 0x3400 && cp <= 0x4DBF) || (cp >= 0x20000 && cp <= 0x2FFFF)) {
        return 0x68616E69; // hani
    }
    return 0x6C61746E; // latn
}

// The features shaped by default: GSUB's (ccmp, locl, rlig, liga, clig, calt, in one stage), and GPOS's (curs, kern,
// mark, mkmk, dist; kern only for a font without a legacy kern table, which is what ThorVG kerns by, so Latin text
// keeps its pixels).
const SUBST_TAGS: [u32; 6] = [0x63636D70, 0x6C6F636C, 0x726C6967, 0x6C696761, 0x636C6967, 0x63616C74];
const SUBST_MASKS: [u32; 6] = [1, 1, 1, 1, 1, 1];
const SUBST_STAGES: [u32; 6] = [0, 0, 0, 0, 0, 0];
const POS_TAGS: [u32; 5] = [0x63757273, 0x6B65726E, 0x6D61726B, 0x6D6B6D6B, 0x64697374];
const POS_TAGS_NO_KERN: [u32; 4] = [0x63757273, 0x6D61726B, 0x6D6B6D6B, 0x64697374];
const POS_MASKS: [u32; 5] = [1, 1, 1, 1, 1];

// Arabic's GSUB features, in HarfBuzz's stages: ccmp and locl; then the joining forms isol, fina, medi and init, each
// a stage of its own and each only on the letters in that form; rlig; then calt, rclt, liga, clig and mset.
const ARABIC_SUBST_TAGS: [u32; 12] = [
    0x63636D70, 0x6C6F636C, 0x69736F6C, 0x66696E61, 0x6D656469, 0x696E6974, 0x726C6967, 0x63616C74, 0x72636C74,
    0x6C696761, 0x636C6967, 0x6D736574,
];
const ARABIC_SUBST_MASKS: [u32; 12] = [1, 1, FEAT_ISOL, FEAT_FINA, FEAT_MEDI, FEAT_INIT, 1, 1, 1, 1, 1, 1];
const ARABIC_SUBST_STAGES: [u32; 12] = [0, 0, 1, 2, 3, 4, 5, 6, 6, 6, 6, 6];
const SCRIPT_ARABIC: u32 = 0x61726162;

// Joining_Type, as unicode_data.cee packs it.
const JT_U: u32 = 0;
const JT_C: u32 = 1;
const JT_D: u32 = 2;
const JT_L: u32 = 3;
const JT_R: u32 = 4;
const JT_T: u32 = 5;

/// `cp`'s Joining_Type (below U+0600 every character is non-joining, or transparent if it is a mark).
fn joiningType(cp: u32) -> u32 {
    if (cp < 0x600) {
        return if (cp >= 0x300 && combining(cp)) JT_T else JT_U;
    }
    return joiningOf(unicodeProps(cp));
}

/// Arabic joining (ArabicShaping.txt's rules), a character at a time: which form each joining letter takes.
struct Joining {
    /// Whether the last character that is not transparent joins to what follows, and was joined to what preceded.
    joinsNext: bool;
    joinedPrevious: bool;
    /// The buffer index of that character's glyph, while its form may still change; -1 otherwise.
    glyph: i32;
}

/// The next character, of Joining_Type `jt` and with glyph `at` in `b` (-1 for none): it joins the one before if
/// both sides allow, which turns that one's form from isol or fina to init or medi; its own form is fina or isol.
fn join(j: borrow mut Joining, jt: u32, at: i32, b: borrow mut LayoutBuffer) {
    if (jt == JT_T) {
        return;
    }
    let joins = j.joinsNext && (jt == JT_D || jt == JT_R || jt == JT_C);
    if (joins && j.glyph >= 0) {
        let k = truncate<usize>(j.glyph);
        b.g[k].mask = FEAT_ALL | (if (j.joinedPrevious) FEAT_MEDI else FEAT_INIT);
    }
    let letter = jt == JT_D || jt == JT_R || jt == JT_L;
    if (letter && at >= 0) {
        let k = truncate<usize>(at);
        b.g[k].mask = FEAT_ALL | (if (joins) FEAT_FINA else FEAT_ISOL);
    }
    j.joinsNext = jt == JT_D || jt == JT_L || jt == JT_C;
    j.joinedPrevious = joins;
    j.glyph = if (letter) at else -1;
}

/// The code points a line's bidi pass resolves at once; a longer line is resolved in pieces this long.
const BIDI_CAPACITY: usize = 1024;

/// A line's bidi levels, its directional runs (byte ranges and levels) and their visual order.
struct BidiBuffer {
    levels: [u8; BIDI_CAPACITY];
    scratch: [u32; BIDI_CAPACITY * BIDI_SCRATCH];
    runStart: [usize; BIDI_CAPACITY];
    runEnd: [usize; BIDI_CAPACITY];
    runLevel: [u8; BIDI_CAPACITY];
    order: [u32; BIDI_CAPACITY];
}

fn emptyBidiBuffer() -> BidiBuffer => BidiBuffer {
    levels: [0u8; BIDI_CAPACITY],
    scratch: [0u32; BIDI_CAPACITY * BIDI_SCRATCH],
    runStart: [0usize; BIDI_CAPACITY],
    runEnd: [0usize; BIDI_CAPACITY],
    runLevel: [0u8; BIDI_CAPACITY],
    order: [0u32; BIDI_CAPACITY],
};

/// Whether `utf8` has right-to-left text or controls (R, AL, RLE, RLO, RLI, FSI), without which every level is even
/// and the line reads left to right.
fn needsBidi(utf8: Slice<u8>) -> bool {
    var i: usize = 0;
    while (i < utf8.length) {
        if (utf8[i] < 0x80) {
            i += 1;
            continue;
        }
        let cp = decodeUtf8(utf8, i);
        let c = bidiClass(cp[0]);
        if (c == BIDI_R || c == BIDI_AL || c == BIDI_RLE || c == BIDI_RLO || c == BIDI_RLI || c == BIDI_FSI) {
            return true;
        }
        i += cp[1] as usize;
    }
    return false;
}

impl<region r> Raster<r> {
    /// The fonts tried, in order, for a character a run's font lacks (font ids, as `loadFont` took them); up to 24.
    /// A character no font has is drawn as the run's font's missing-glyph box.
    public fn setFallbacks(borrow mut this, ids: Slice<u32>) {
        this.fallbackCount = 0;
        for (id in ids) {
            let added = this.addFallback(id);
        }
    }

    /// Adds font `id` to the end of the fallback chain; false when the chain is full.
    public fn addFallback(borrow mut this, id: u32) -> bool {
        if (this.fallbackCount >= 24) {
            return false;
        }
        this.fallbacks[this.fallbackCount] = id;
        this.fallbackCount += 1;
        return true;
    }

    /// How many fonts are loaded (at most 32).
    public fn fontCount(borrow this) -> usize => this.fonts.length();

    /// Whether a run in font `fontId` has a glyph for `cp`, from its font or the fallback chain; characters that take
    /// no glyph count as covered.
    public fn covers(borrow this, fontId: u32, cp: u32) -> bool {
        if (ignorable(cp)) {
            return true;
        }
        let primary = match (this.slotIndex(fontId)) {
            Some(k) => k,
            null => { return false; }
        };
        let cur = ShapeCursor { at: 0, pen: 0.0, previousSlot: 0, previousGlyph: 0, hasPrevious: false };
        return this.fontFor(primary, cur, cp)[1] != 0;
    }

    /// Whether loaded font `k` draws in colour (bitmaps, or COLR layers).
    fn isColorSlot(borrow this, k: usize) -> bool {
        let slot = this.fonts.get(k);
        return slot.strikeCount > 0 || slot.info.colr != 0;
    }

    /// The colour font an emoji `cp` in a run in font `primary` comes from: the run's own if it draws in colour,
    /// else the first of the fallback chain that does and has it.
    fn emojiFont(borrow this, primary: usize, cp: u32) -> usize? {
        if (this.isColorSlot(primary) && this.glyphIn(primary, cp) != 0) {
            return primary;
        }
        for (f in 0..this.fallbackCount) {
            for (k in 0..this.fonts.length()) {
                if (this.fonts.get(k).id == this.fallbacks[f] && this.isColorSlot(k) && this.glyphIn(k, cp) != 0) {
                    return k;
                }
            }
        }
        return null;
    }

    /// Whether a run in font `fontId` has `cp` in a colour font (for an emoji sequence), its own or a fallback.
    public fn coversInColor(borrow this, fontId: u32, cp: u32) -> bool {
        return match (this.slotIndex(fontId)) {
            Some(k) => this.emojiFont(k, cp) != null,
            null => false,
        };
    }

    /// The index of the loaded font `id`, falling back to font 0's (thorvg_backend.c's cw_fontFor).
    fn slotIndex(borrow this, id: u32) -> usize? {
        var fallback: usize? = null;
        for (k in 0..this.fonts.length()) {
            let slot = this.fonts.get(k);
            if (slot.id == id) {
                return k;
            }
            if (slot.id == 0) {
                fallback = k;
            }
        }
        return fallback;
    }

    /// The glyph of `cp` in loaded font `k`, or 0 when it has none.
    fn glyphIn(borrow this, k: usize, cp: u32) -> u32 {
        let slot = this.fonts.get(k);
        let g = glyphIndex(this.fontPool[slot.offset..slot.offset + slot.size], slot.info, cp);
        return if (g == INVALID_GLYPH) 0 else g;
    }

    /// The font and glyph for `cp` in a run in font `primary`: a mark stays in the font of the glyph before it if
    /// that font has it; otherwise the run's font, then the fallback chain; the run's missing-glyph box when none
    /// has it.
    fn fontFor(borrow this, primary: usize, cur: borrow ShapeCursor, cp: u32) -> [u32; 2] {
        if (combining(cp) && cur.hasPrevious) {
            let g = this.glyphIn(cur.previousSlot, cp);
            if (g != 0) {
                return [truncate<u32>(cur.previousSlot), g];
            }
        }
        let g = this.glyphIn(primary, cp);
        if (g != 0) {
            return [truncate<u32>(primary), g];
        }
        for (f in 0..this.fallbackCount) {
            for (k in 0..this.fonts.length()) {
                if (this.fonts.get(k).id == this.fallbacks[f] && k != primary) {
                    let fg = this.glyphIn(k, cp);
                    if (fg != 0) {
                        return [truncate<u32>(k), fg];
                    }
                }
            }
        }
        return [truncate<u32>(primary), 0];
    }

    /// Shapes one line of `utf8` in a run in font `primary`, in visual order: its directional runs (UAX #9, the line
    /// as its own paragraph) left to right, each run's stretches of characters that one font draws (the run's, or a
    /// fallback's) through that font's GSUB and GPOS. `spacing` scales every advance (letter spacing). Glyphs from
    /// the `skip`-th on go into `out` as far as it reaches.
    fn shapeLine(
        borrow this,
        primary: usize,
        utf8: Slice<u8>,
        spacing: f32,
        skip: usize,
        out: SliceMut<StepGlyph>,
    ) -> ShapeTotals {
        var guard = this.layout.write();
        let b = guard.data();
        var t = ShapeTotals { pen: 0.0, glyphs: 0 };
        if (!needsBidi(utf8)) {
            t.pen = this.shapeSpan(
                b,
                primary,
                utf8,
                0,
                utf8.length,
                false,
                true,
                0.0,
                spacing,
                0,
                skip,
                out,
                mut t.glyphs,
            );
            return t;
        }
        var bidiGuard = this.bidi.write();
        let bb = bidiGuard.data();
        var start: usize = 0;
        while (start < utf8.length) {
            // A piece of at most BIDI_CAPACITY code points, resolved as a paragraph.
            var end = start;
            var n: usize = 0;
            while (end < utf8.length && n < BIDI_CAPACITY) {
                end += decodeUtf8(utf8, end)[1] as usize;
                n += 1;
            }
            let para = bidiLevels(utf8[start..end], -1, mut bb.levels[0..n], mut bb.scratch[..]);
            // Its level runs (a character X9 removes goes with the one before it), then L2 on them.
            var runs: usize = 0;
            var at = start;
            var previous: u8 = if (para > 0) 1 else 0;
            for (k in 0..n) {
                var l = bb.levels[k];
                if (l == BIDI_REMOVED) {
                    l = previous;
                }
                if (runs == 0 || l != bb.runLevel[runs - 1]) {
                    bb.runStart[runs] = at;
                    bb.runLevel[runs] = l;
                    runs += 1;
                }
                at += decodeUtf8(utf8, at)[1] as usize;
                bb.runEnd[runs - 1] = at;
                previous = l;
            }
            let ordered = bidiVisualOrder(bb.runLevel[0..runs], mut bb.order[0..runs]);
            for (v in 0..ordered) {
                let r = bb.order[v] as usize;
                let from = bb.runStart[r];
                let to = bb.runEnd[r];
                if ((bb.runLevel[r] & 1) == 0) {
                    t.pen += this.shapeSpan(
                        b,
                        primary,
                        utf8,
                        from,
                        to,
                        false,
                        true,
                        t.pen,
                        spacing,
                        0,
                        skip,
                        out,
                        mut t.glyphs,
                    );
                } else {
                    // Right to left: measured first, then laid from its right edge leftwards.
                    var none = [emptyStep(); 1];
                    var count: usize = 0;
                    let width = this.shapeSpan(
                        b,
                        primary,
                        utf8,
                        from,
                        to,
                        true,
                        false,
                        0.0,
                        spacing,
                        0,
                        0,
                        mut none[0..0],
                        mut count,
                    );
                    let placed = this.shapeSpan(
                        b,
                        primary,
                        utf8,
                        from,
                        to,
                        true,
                        true,
                        t.pen + width,
                        spacing,
                        count,
                        skip,
                        out,
                        mut t.glyphs,
                    );
                    t.pen += width;
                }
            }
            start = end;
        }
        return t;
    }

    /// Shapes `utf8[from..to]`, one direction's run of a line: each stretch of characters that one font draws through
    /// that font's GSUB and GPOS. Left to right, glyphs go right from `origin`; right to left (`rtl`: characters
    /// with a mirrored form take it), leftwards from `origin`, its right edge. The glyphs are counted in `made`; when
    /// `emit`, those from the `skip`-th on also go into `out` as far as it reaches, in visual order (right to left,
    /// the run's `glyphs` glyphs, as a pass without `emit` counted them, reversed). The run's width, in the run's
    /// font's units.
    fn shapeSpan(
        borrow this,
        b: borrow mut LayoutBuffer,
        primary: usize,
        utf8: Slice<u8>,
        from: usize,
        to: usize,
        rtl: bool,
        emit: bool,
        origin: f32,
        spacing: f32,
        glyphs: usize,
        skip: usize,
        out: SliceMut<StepGlyph>,
        made: borrow mut usize,
    ) -> f32 {
        let primaryUpem = this.fonts.get(primary).info.unitsPerEm;
        var pen: f32 = 0.0;
        var joining = Joining { joinsNext: false, joinedPrevious: false, glyph: -1 };
        let first: usize = made;
        var j: usize = 0;
        var cur = ShapeCursor { at: from, pen: 0.0, previousSlot: 0, previousGlyph: 0, hasPrevious: false };
        while (cur.at < to) {
            // A stretch of characters in one font, up to the buffer's size.
            b.count = 0;
            b.nextLig = 1;
            var slot: usize = 0;
            var script: u32 = 0;
            joining.glyph = -1;
            while (cur.at < to && b.count < LAYOUT_CAPACITY) {
                let cp = decodeUtf8(utf8, cur.at);
                // An emoji sequence (ZWJ, skin tone, flag, keycap, VS16) goes whole into a colour font that has its
                // first character, joiners and selectors included, for that font's ligatures to form it.
                let next = cur.at + cp[1] as usize;
                if (next < to && utf8[next] >= 0x80 && mayStartEmoji(cp[0])) {
                    let end = graphemeEnd(utf8[0..to], cur.at);
                    if (end > next && hasEmojiComponent(utf8, next, end)) {
                        match (this.emojiFont(primary, cp[0])) {
                            Some(k) => {
                                if (b.count > 0 && (k != slot || b.count + (end - cur.at) > LAYOUT_CAPACITY)) {
                                    break;
                                }
                                slot = k;
                                if (script == 0) {
                                    script = scriptTag(cp[0]);
                                }
                                var at = cur.at;
                                while (at < end && b.count < LAYOUT_CAPACITY) {
                                    let c = decodeUtf8(utf8, at);
                                    let eg = this.glyphIn(k, c[0]);
                                    if (eg != 0) {
                                        var g = emptyLayoutGlyph();
                                        g.glyph = eg;
                                        g.cluster = at;
                                        g.mask = FEAT_ALL;
                                        g.hidden = ignorable(c[0]);
                                        b.g[b.count] = g;
                                        b.count += 1;
                                        cur.previousGlyph = eg;
                                    }
                                    at += c[1] as usize;
                                }
                                cur.previousSlot = k;
                                cur.hasPrevious = true;
                                cur.at = end;
                                continue;
                            }
                            null => {}
                        }
                    }
                }
                // In Indic text a joiner or non-joiner stays, as a glyph: it decides half forms and conjuncts.
                if ((cp[0] == 0x200C || cp[0] == 0x200D) && b.count > 0 && b.g[b.count - 1].cp >= 0x900 &&
                    b.g[b.count - 1].cp <= 0xD7F) {
                    var g = emptyLayoutGlyph();
                    g.glyph = this.glyphIn(slot, cp[0]);
                    g.cp = cp[0];
                    g.cluster = cur.at;
                    g.mask = FEAT_ALL;
                    b.g[b.count] = g;
                    b.count += 1;
                    cur.at += cp[1] as usize;
                    continue;
                }
                if (ignorable(cp[0])) {
                    // No glyph, but a joiner (ZWJ) or non-joiner (ZWNJ) still decides how its neighbours join.
                    join(mut joining, joiningType(cp[0]), -1, b);
                    cur.at += cp[1] as usize;
                    continue;
                }
                let c = if (rtl) bidiMirror(cp[0]) else cp[0];
                let pick = this.fontFor(primary, cur, c);
                let k = pick[0] as usize;
                if (b.count > 0 && k != slot) {
                    break;
                }
                slot = k;
                if (script == 0 && !combining(c) && c > 0x40) {
                    script = scriptTag(c);
                }
                var g = emptyLayoutGlyph();
                g.glyph = pick[1];
                g.cp = c;
                g.cluster = cur.at;
                g.mask = FEAT_ALL;
                b.g[b.count] = g;
                join(mut joining, joiningType(cp[0]), truncate<i32>(b.count), b);
                b.count += 1;
                cur.previousSlot = k;
                cur.previousGlyph = pick[1];
                cur.hasPrevious = true;
                cur.at += cp[1] as usize;
            }
            if (b.count == 0) {
                continue;
            }
            let fs = this.fonts.get(slot);
            let d = this.fontPool[fs.offset..fs.offset + fs.size];
            let info = fs.info;
            // The lookup cache knows a run by its font (its pool offset), script and kerning.
            let key = ((fs.offset as u64) << 32) | (script as u64);
            let arabic = script == SCRIPT_ARABIC;
            // The constants bound to locals, to be sliced.
            let arabicTags = ARABIC_SUBST_TAGS;
            let arabicMasks = ARABIC_SUBST_MASKS;
            let arabicStages = ARABIC_SUBST_STAGES;
            let plainTags = SUBST_TAGS;
            let plainMasks = SUBST_MASKS;
            let plainStages = SUBST_STAGES;
            let substTags = if (arabic) arabicTags[..] else plainTags[..];
            let substMasks = if (arabic) arabicMasks[..] else plainMasks[..];
            let substStages = if (arabic) arabicStages[..] else plainStages[..];
            if (isIndicTag(script)) {
                layoutRunIndic(d, info, key, script, b);
            } else if (info.kern != 0) {
                layoutRun(
                    d,
                    info,
                    key,
                    script,
                    substTags,
                    substMasks,
                    substStages,
                    POS_TAGS_NO_KERN[..],
                    POS_MASKS[0..4],
                    rtl,
                    b,
                );
            } else {
                layoutRun(
                    d,
                    info,
                    key,
                    script,
                    substTags,
                    substMasks,
                    substStages,
                    POS_TAGS[..],
                    POS_MASKS[..],
                    rtl,
                    b,
                );
            }
            // Advances and kerning in the run's font's units.
            let units = if (slot == primary) 1.0 else primaryUpem / info.unitsPerEm;
            for (k in 0..b.count) {
                let g = b.g[k];
                if (g.hidden) {
                    continue;
                }
                var kernX: f32 = 0.0;
                if (info.kern != 0 && k > 0) {
                    kernX = kerning(d, info, b.g[k - 1].glyph, g.glyph) * units;
                }
                let advance = (g.xAdvance * units + kernX) * spacing;
                var x =
                    if (rtl) origin - pen - advance + g.xOffset * units else origin + pen + kernX + g.xOffset * units;
                var y = g.yOffset * units;
                if (g.attachTo >= 0 && truncate<usize>(g.attachTo) < k) {
                    let base = b.g[truncate<usize>(g.attachTo)];
                    // A mark follows its base across the line, not up and down (HarfBuzz propagates only the
                    // offset along the line to attached marks).
                    x = base.placedX + g.attachX * units + g.xOffset * units;
                    y = g.attachY * units + g.yOffset * units;
                }
                b.g[k].placedX = x;
                b.g[k].placedY = y;
                let at = if (rtl && emit && j < glyphs) first + glyphs - 1 - j else first + j;
                if (emit && at >= skip && at - skip < out.length) {
                    out[at - skip] = StepGlyph {
                        slot: slot,
                        glyph: g.glyph,
                        pen: x,
                        rise: y,
                        cluster: g.cluster,
                        advance: advance,
                        rtl: rtl,
                    };
                }
                j += 1;
                made += 1;
                pen += advance;
            }
        }
        return pen;
    }

    /// The natural width of one line of `utf8` (no newlines) in font `primary`, in its units, and its glyph count.
    fn lineUnits(borrow this, primary: usize, utf8: Slice<u8>) -> [f32; 2] {
        var none = [emptyStep(); 1];
        let t = this.shapeLine(primary, utf8, 1.0, 0, mut none[0..0]);
        return [t.pen, round<f32>(t.glyphs)];
    }

    /// Letter spacing as a factor on every advance (ThorVG's): the natural width plus `letterSpacing` per glyph,
    /// over the natural width.
    fn spacingFactor(borrow this, primary: usize, utf8: Slice<u8>, size: f32, letterSpacing: f32) -> f32 {
        if (letterSpacing <= 0.0) {
            return 1.0;
        }
        let line = this.lineUnits(primary, utf8);
        let natural = line[0] * size / this.fonts.get(primary).info.unitsPerEm;
        return if (natural > 0.0) (natural + letterSpacing * line[1]) / natural else 1.0;
    }

    /// The width of `utf8` in `config`'s font at its size (ClayWind_Thorvg_MeasureText): its glyphs' advances and
    /// kerning, as drawn, plus letter spacing after every glyph; a newline starts a new line, and the widest counts.
    /// Without a font, half an em per byte.
    fn measureWidth(borrow this, utf8: Slice<u8>, fontId: u32, fontSize: f32, letterSpacing: f32) -> f32 {
        let size = if (fontSize > 0.0) fontSize else 16.0;
        let primary = match (this.slotIndex(fontId)) {
            Some(k) => k,
            null => { return 0.5 * size * round<f32>(utf8.length); }
        };
        let scale = size / this.fonts.get(primary).info.unitsPerEm;
        var widest: f32 = 0.0;
        var start: usize = 0;
        for (i in 0..utf8.length + 1) {
            if (i == utf8.length || utf8[i] == '\n') {
                let line = this.lineUnits(primary, utf8[start..i]);
                widest = widest.max(line[0] * scale + letterSpacing * line[1]);
                start = i + 1;
            }
        }
        return widest;
    }

    /// Where a caret before byte `offset` of one line `utf8` in font `fontId` at `fontSize` goes, in pixels from the
    /// line's left edge, by the glyphs as drawn: at the left edge of the glyph of the first cluster at or after
    /// `offset` in a left-to-right run, at its right edge in a right-to-left one; after the last character, past
    /// the glyph of the last cluster on the side the line's reading direction ends on.
    public fn caretAt(
        borrow this,
        utf8: Slice<u8>,
        fontId: u32,
        fontSize: f32,
        letterSpacing: f32,
        offset: usize,
    ) -> f32 {
        let primary = match (this.slotIndex(fontId)) {
            Some(k) => k,
            null => { return 0.5 * fontSize * round<f32>(offset.min(utf8.length)); }
        };
        let scale = fontSize / this.fonts.get(primary).info.unitsPerEm;
        let spacing = this.spacingFactor(primary, utf8, fontSize, letterSpacing);
        var chunk = [emptyStep(); 64];
        var done: usize = 0;
        var bestCluster: usize = 0xFFFFFFFF;
        var bestX: f32 = 0.0;
        var lastCluster: usize = 0;
        var lastX: f32 = 0.0;
        var any = false;
        loop {
            let totals = this.shapeLine(primary, utf8, spacing, done, mut chunk[..]);
            let n = (totals.glyphs - done).min(64);
            for (k in 0..n) {
                let g = chunk[k];
                let left = g.pen;
                let right = g.pen + g.advance;
                if (g.cluster >= offset && g.cluster < bestCluster) {
                    bestCluster = g.cluster;
                    bestX = if (g.rtl) right else left;
                }
                if (!any || g.cluster >= lastCluster) {
                    lastCluster = g.cluster;
                    lastX = if (g.rtl) left else right;
                    any = true;
                }
            }
            done += n;
            if (n == 0 || done >= totals.glyphs) {
                if (bestCluster != 0xFFFFFFFF) {
                    return bestX * scale;
                }
                return if (any) lastX * scale else 0.0;
            }
        }
    }

    /// Shapes one line of `utf8` in font `fontId` at `fontSize` pixels per em, as `Command.Text` draws it: its glyphs
    /// into `out` (the font each is from, its id, where it goes), with `letterSpacing` spread as `drawText` spreads
    /// it. Null without a font.
    public fn shapeRun(
        borrow this,
        utf8: Slice<u8>,
        fontId: u32,
        fontSize: f32,
        letterSpacing: f32,
        out: SliceMut<ShapedGlyph>,
    ) -> ShapedRun? {
        let primary = match (this.slotIndex(fontId)) {
            Some(k) => k,
            null => { return null; }
        };
        let size = if (fontSize > 0.0) fontSize else 16.0;
        let info = this.fonts.get(primary).info;
        let scale = size / info.unitsPerEm;
        let spacing = this.spacingFactor(primary, utf8, size, letterSpacing);
        var chunk = [emptyStep(); 64];
        var written: usize = 0;
        var totals = ShapeTotals { pen: 0.0, glyphs: 0 };
        loop {
            totals = this.shapeLine(primary, utf8, spacing, written, mut chunk[..]);
            let n = (totals.glyphs - written).min(64);
            for (k in 0..n) {
                if (written + k < out.length) {
                    let g = chunk[k];
                    out[written + k] = ShapedGlyph {
                        font: truncate<u32>(g.slot),
                        glyph: g.glyph,
                        x: g.pen * scale,
                        y: 0.0 - g.rise * scale,
                        cluster: g.cluster,
                        advance: g.advance * scale,
                    };
                }
            }
            written += n;
            if (written >= totals.glyphs || written >= out.length) {
                break;
            }
        }
        return ShapedRun { ascent: info.ascent * scale, width: totals.pen * scale, count: written.min(out.length) };
    }

    /// Glyph `glyph` of loaded font `font` (a ShapedGlyph's) at `size` pixels per em, alone in a `width` × `height`
    /// cell with its origin at (`x`, `baseline`), as coverage bytes into `out`: what `drawText` draws for it. False
    /// when there is no such font or `out` is too small.
    public fn rasterizeGlyph(
        borrow mut this,
        font: u32,
        glyph: u32,
        size: f32,
        x: f32,
        baseline: f32,
        width: usize,
        height: usize,
        out: SliceMut<u8>,
    ) -> bool {
        let k = font as usize;
        if (k >= this.fonts.length() || out.length < width * height) {
            return false;
        }
        var outline = emptyOutline();
        let slot = this.fonts.get(k);
        let scale = size / slot.info.unitsPerEm;
        {
            let d = this.fontPool[slot.offset..slot.offset + slot.size];
            let decoded = decodeGlyph(d, slot.info, glyph, 0.0, 0.0, 1, mut outline);
        }
        let savedRatio = this.ratio;
        let savedWidth = idx(this.width);
        let savedHeight = idx(this.height);
        if (!this.resize(width, height)) {
            return false;
        }
        this.ratio = 1.0;
        this.begin(Color.rgba(0, 0, 0, 0));
        beginPath(mut this);
        appendOutline(mut this, outline, x, baseline, scale);
        fillPath(mut this, solidPaint(Color.rgba(255, 255, 255, 255)), FillTarget.Layer);
        this.finish();
        for (p in 0..width * height) {
            out[p] = truncate<u8>(this.pool[p] >> 24);
        }
        this.ratio = savedRatio;
        let restored = this.resize(savedWidth, savedHeight);
        return true;
    }
}

/// Command.Text (tvgb_text): the run's glyphs filled as one path, on the baseline at the run's font's ascent below
/// the box's top; a newline takes no glyph (lines are split before).
fn drawText(r: borrow mut Raster, area: Rect, run: TextRun, utf8: Slice<u8>) {
    if (utf8.length == 0 || run.color.a == 0) {
        return;
    }
    let primary = match (r.slotIndex(run.fontId)) {
        Some(k) => k,
        null => { return; }
    };
    let size = if (run.fontSize > 0.0) run.fontSize else 16.0;
    let info = r.fonts.get(primary).info;
    let scale = size / info.unitsPerEm;
    let spacing = r.spacingFactor(primary, utf8, size, run.letterSpacing);
    let originX = area.x;
    let originY = area.y + info.ascent * scale;
    beginPath(mut r);
    // The glyphs a chunk at a time: shaping borrows the raster, drawing changes it.
    var chunk = [emptyStep(); 64];
    var done: usize = 0;
    loop {
        let totals = r.shapeLine(primary, utf8, spacing, done, mut chunk[..]);
        let n = (totals.glyphs - done).min(64);
        for (k in 0..n) {
            let g = chunk[k];
            let slot = r.fonts.get(g.slot);
            // A colour glyph: a bitmap drawn as an image, or COLR layers filled in their colours.
            let glyphX = originX + g.pen * scale;
            let glyphY = originY - g.rise * scale;
            if (slot.strikeCount > 0) {
                match (r.colorBitmap(truncate<u32>(g.slot), g.glyph, size, r.ratio)) {
                    Some(c) => {
                        fillPath(mut r, solidPaint(run.color), FillTarget.Layer);
                        drawImage(
                            mut r,
                            Rect { x: glyphX + c.x, y: glyphY + c.y, w: c.w, h: c.h },
                            Color.rgba(255, 255, 255, 255),
                            Corners.all(0.0),
                            c.handle,
                        );
                        beginPath(mut r);
                    }
                    null => {}
                }
                continue;
            }
            if (slot.info.colr != 0) {
                let layers = colrLayers(r.fontPool[slot.offset..slot.offset + slot.size], slot.info, g.glyph);
                match (layers) {
                    Some(l) => {
                        fillPath(mut r, solidPaint(run.color), FillTarget.Layer);
                        fillColrLayers(mut r, g.slot, l, glyphX, glyphY, size / slot.info.unitsPerEm, run.color);
                        beginPath(mut r);
                        continue;
                    }
                    null => {}
                }
            }
            var outline = emptyOutline();
            {
                let d = r.fontPool[slot.offset..slot.offset + slot.size];
                // The run's own glyphs are offset in font units, as they always were; a fallback's by its origin.
                let ox = if (g.slot == primary) g.pen else 0.0;
                let oy = if (g.slot == primary) 0.0 - g.rise else 0.0;
                let decoded = decodeGlyph(d, slot.info, g.glyph, ox, oy, 1, mut outline);
            }
            // Flush a long run before the path buffer fills.
            if (r.pointCount + outline.ptCount * 24 > r.points.length) {
                fillPath(mut r, solidPaint(run.color), FillTarget.Layer);
                beginPath(mut r);
            }
            if (g.slot == primary) {
                appendOutline(mut r, outline, originX, originY, scale);
            } else {
                appendOutline(
                    mut r,
                    outline,
                    originX + g.pen * scale,
                    originY - g.rise * scale,
                    size / slot.info.unitsPerEm,
                );
            }
        }
        done += n;
        if (n == 0 || done >= totals.glyphs) {
            break;
        }
    }
    fillPath(mut r, solidPaint(run.color), FillTarget.Layer);
}
