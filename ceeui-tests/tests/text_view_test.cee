// SPDX-License-Identifier: MIT
// A long text that can be selected: Controls.selectableTextView, driven by a scripted platform over the
// mixed-direction fake font (10 points a character; see bidi_edit_test), its lines 20 points tall.

import ceeui;

struct Doc {
    text: Vector<u8>;
    starts: [u32; 1100];
    count: usize;
    edit: TextEdit;
    /// An edit command the host gives in the next frame (after begin, as a host does).
    command: EditCommand?;
}

fn docOf(text: StringView) -> Doc {
    var d = Doc { text: Vector<u8>.create(), starts: [0u32; 1100], count: 0, edit: TextEdit.at(0), command: null };
    for (b in text.bytes()) {
        d.text.push(b);
    }
    d.count = indexLines(d.text.view(), mut d.starts[..]) ?? 0;
    return d;
}

fn viewFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform, doc: borrow mut Doc) -> Result<void, TestFailure> {
    let metrics = MixedAdvance { unused: 0 };
    ui.begin(mut platform);
    match (doc.command) {
        Some(c) => { ui.editCommand(c); }
        null => {}
    }
    doc.command = null;
    ui.open(Style.column().w(Size.fixed(300.0)).h(Size.fixed(200.0)));
    let look = Text.of().size(14.0).leading(20.0);
    Controls.selectableTextView(
        mut ui,
        metrics,
        "doc",
        doc.text.view(),
        doc.starts[..],
        doc.count,
        look,
        false,
        mut doc.edit,
    );
    ui.close();
    let ok = finish(mut ui, mut platform);
    platform.pressed = 0;
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    return ok;
}

/// A press and release at (x, y) in the view's text (from its top left, before any scroll).
fn clickDoc(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut Doc,
    x: f32,
    y: f32,
) -> Result<void, TestFailure> {
    let box = ui.boxOf("doc")!;
    platform.pointerState.position = Vec2 { x: box.x + x, y: box.y + y };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    viewFrame(mut ui, mut platform, mut doc)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    return viewFrame(mut ui, mut platform, mut doc);
}

fn key(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut Doc,
    k: Key,
) -> Result<usize, TestFailure> {
    platform.pressed = 1u64 << (keyIndex(k) as u64);
    viewFrame(mut ui, mut platform, mut doc)?;
    return Ok(doc.edit.caret);
}

@test
fn aTextViewIsSelectedWithThePointer() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    // Lines start at bytes 0 ("first line"), 11 ("second") and 18 ("third one").
    var doc = docOf("first line\nsecond\nthird one");
    viewFrame(mut ui, mut platform, mut doc)?;
    // A click on the second line, after "sec": the caret at byte 14, and the view has the focus.
    clickDoc(mut ui, mut platform, mut doc, 31.0, 30.0)?;
    Check.isTrue(ui.hasFocusNamed("doc"), "the view has the focus")?;
    Check.equalU64(14, doc.edit.caret as u64)?;
    // A drag to the third line, after "thi": the selection runs across the newline.
    let box = ui.boxOf("doc")!;
    platform.pointerState.position = Vec2 { x: box.x + 9.0, y: box.y + 10.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    viewFrame(mut ui, mut platform, mut doc)?;
    platform.pointerState.position = Vec2 { x: box.x + 31.0, y: box.y + 50.0 };
    viewFrame(mut ui, mut platform, mut doc)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    viewFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(doc.edit.anchor == 1 && doc.edit.caret == 21, "from after f to after thi")?;
    doc.command = Some(EditCommand.Copy);
    viewFrame(mut ui, mut platform, mut doc)?;
    let copied = ui.copiedText()!;
    Check.isTrue(copied.length == 20 && copied[9] == '\n', "Copy takes the text across both newlines")?;
    // A triple click selects the line, its newline too.
    for (k in 0..3) {
        let _ = k;
        clickDoc(mut ui, mut platform, mut doc, 15.0, 30.0)?;
    }
    return Check.isTrue(doc.edit.from() == 11 && doc.edit.to() == 18, "the second line and its newline");
}

@test
fn aTextViewsCaretMovesWithTheKeys() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = docOf("first line\nsecond\nthird one");
    viewFrame(mut ui, mut platform, mut doc)?;
    clickDoc(mut ui, mut platform, mut doc, 101.0, 10.0)?;
    Check.equalU64(10, doc.edit.caret as u64)?; // the end of the first line
    // Right at a line's end goes on to the next line's start; Left back to the end before.
    Check.equalU64(11, key(mut ui, mut platform, mut doc, Key.Right)? as u64)?;
    Check.equalU64(10, key(mut ui, mut platform, mut doc, Key.Left)? as u64)?;
    // Down keeps the caret's place across: from x 100 on the first line to the second's end (x 60), then x 60 on
    // the third ("third " ends at 60).
    Check.equalU64(17, key(mut ui, mut platform, mut doc, Key.Down)? as u64)?;
    Check.equalU64(24, key(mut ui, mut platform, mut doc, Key.Down)? as u64)?;
    Check.equalU64(18, key(mut ui, mut platform, mut doc, Key.Home)? as u64)?;
    Check.equalU64(27, key(mut ui, mut platform, mut doc, Key.End)? as u64)?;
    // Shift extends: Up from the end of the text selects back to the second line.
    platform.down = 1u64 << (keyIndex(Key.LeftShift) as u64);
    key(mut ui, mut platform, mut doc, Key.Up)?;
    platform.down = 0;
    return Check.isTrue(doc.edit.anchor == 27 && doc.edit.caret == 17, "Shift-Up selected from the end back");
}

@test
fn aTextViewScrollsToItsCaret() -> Result<void, TestFailure> {
    var storage = heap(4194304);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(256));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    // 1000 lines of "line"; the view shows ten (200 points of 20).
    var text = String.create();
    for (k in 0..1000) {
        let _ = k;
        text.append("line\n");
    }
    var doc = docOf(text.view());
    viewFrame(mut ui, mut platform, mut doc)?;
    clickDoc(mut ui, mut platform, mut doc, 5.0, 5.0)?;
    Check.equalU64(0, doc.edit.caret as u64)?;
    // Three Page Downs: the caret is 30 lines down, and the view scrolled so that its line shows.
    for (k in 0..3) {
        let _ = k;
        key(mut ui, mut platform, mut doc, Key.PageDown)?;
    }
    Check.equalU64(150, doc.edit.caret as u64)?;
    viewFrame(mut ui, mut platform, mut doc)?;
    let y = ui.scrollOffset("doc").y;
    Check.isTrue(y <= -420.0 && y >= -600.0, "line 30 (600 to 620) is in the view")?;
    // Select All takes the whole text.
    doc.command = Some(EditCommand.SelectAll);
    viewFrame(mut ui, mut platform, mut doc)?;
    return Check.isTrue(doc.edit.from() == 0 && doc.edit.to() == 5000, "everything is selected");
}

struct EditorDoc {
    buf: [u8; 128];
    len: usize;
    starts: [u32; 8];
    count: usize;
    edit: TextEdit;
    command: EditCommand?;
    paste: bool;
    /// An input method composing "にほ" (its caret after both) in the next frames.
    composing: bool;
    history: [u8; 256];
    state: TextHistory;
    rows: [u16; 8];
    /// Whether the editor's lines wrap (its look's wrap), as by default.
    nowrap: bool;
    /// Whether the editor's parent clips (and so leaves an overflowing child as it is).
    clipped: bool;
    /// The document's place across for Up and Down, carried from frame to frame.
    goal: f32;
    /// A rich document: a mark for each byte, and the mark typing takes.
    rich: bool;
    marks: [u8; 128];
    typing: u8;
    /// A mark given to the selection (or to typing) in the next frame, before the editor runs.
    markWanted: u8?;
}

fn editorOf(text: StringView) -> EditorDoc {
    var d = EditorDoc {
        buf: [0u8; 128],
        len: 0,
        starts: [0u32; 8],
        count: 0,
        edit: TextEdit.at(0),
        command: null,
        paste: false,
        composing: false,
        history: [0u8; 256],
        state: TextHistory.create(),
        rows: [0u16; 8],
        nowrap: false,
        clipped: false,
        goal: -1.0,
        rich: false,
        marks: [0u8; 128],
        typing: 0,
        markWanted: null,
    };
    let b = text.bytes();
    for (i in 0..b.length) {
        d.buf[i] = b[i];
    }
    d.len = b.length;
    return d;
}

fn editorFrame(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut EditorDoc,
) -> Result<bool, TestFailure> {
    let metrics = MixedAdvance { unused: 0 };
    ui.begin(mut platform);
    match (doc.command) {
        Some(c) => { ui.editCommand(c); }
        null => {}
    }
    doc.command = null;
    if (doc.paste) {
        ui.paste("x\ny".bytes());
        doc.paste = false;
    }
    if (doc.composing) {
        ui.setComposition("\u{306B}\u{307B}".bytes(), 6);
    }
    let parent = Style.column().w(Size.fixed(300.0)).h(Size.fixed(200.0));
    ui.open(if (doc.clipped) parent.clip() else parent);
    let look = if (doc.nowrap) Text.of().size(14.0).leading(20.0).wrap(
        TextWrap.None,
    ) else Text.of().size(14.0).leading(20.0);
    // The document over the test's arrays, its state carried from frame to frame.
    var d = if (doc.rich) TextDocument.styled(
        mut doc.buf[..],
        doc.len,
        mut doc.marks[..],
        mut doc.starts[..],
        mut doc.rows[..],
        mut doc.history[..],
    ) else TextDocument.over(mut doc.buf[..], doc.len, mut doc.starts[..], mut doc.rows[..], mut doc.history[..]);
    d.typing = doc.typing;
    d.edit = doc.edit;
    d.undo = doc.state;
    d.goalX = doc.goal;
    match (doc.markWanted) {
        Some(m) => { let _ = d.setMark(m); }
        null => {}
    }
    doc.markWanted = null;
    let changed = Controls.textEditor(mut ui, metrics, "ed", mut d, look, false);
    doc.typing = d.typing;
    doc.len = d.len;
    doc.count = d.count;
    doc.edit = d.edit;
    doc.state = d.undo;
    doc.goal = d.goalX;
    ui.close();
    finish(mut ui, mut platform)?;
    platform.pressed = 0;
    platform.typedCount = 0;
    platform.typedRead = 0;
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    return Ok(changed);
}

fn isText(doc: borrow EditorDoc, want: StringView) -> bool {
    let w = want.bytes();
    if (doc.len != w.length) {
        return false;
    }
    for (i in 0..w.length) {
        if (doc.buf[i] != w[i]) {
            return false;
        }
    }
    return true;
}

/// An editor holding `text`, focused by a click at its start.
fn focusedEditor(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    text: StringView,
) -> Result<EditorDoc, TestFailure> {
    var doc = editorOf(text);
    editorFrame(mut ui, mut platform, mut doc)?;
    let box = ui.boxOf("ed")!;
    platform.pointerState.position = Vec2 { x: box.x + 1.0, y: box.y + 5.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(ui.hasFocusNamed("ed"), "the editor has the focus")?;
    return Ok(doc);
}

fn editKey(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut EditorDoc,
    k: Key,
) -> Result<bool, TestFailure> {
    platform.pressed = 1u64 << (keyIndex(k) as u64);
    return editorFrame(mut ui, mut platform, mut doc);
}

@test
fn anEditorTypesAndBreaksLines() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = focusedEditor(mut ui, mut platform, "")?;
    Check.equalU64(1, doc.count as u64)?;
    typeChars(mut platform, "ab");
    Check.isTrue(editorFrame(mut ui, mut platform, mut doc)?, "typing changes the text")?;
    let entered = editKey(mut ui, mut platform, mut doc, Key.Enter)?;
    Console.writeLine(if (entered) "yes" else "no");
    typeChars(mut platform, "cd");
    Console.writeLine(platform.typedCount);
    let typed = editorFrame(mut ui, mut platform, mut doc)?;
    Console.writeLine("]");
    Check.isTrue(isText(doc, "ab\ncd") && doc.edit.caret == 5, "two lines, the caret at the end")?;
    Check.isTrue(doc.count == 2 && doc.starts[1] == 3, "the index has the second line")?;
    // Backspace at the second line's start joins the lines; Delete at a line's end too.
    doc.edit = TextEdit.at(3);
    editKey(mut ui, mut platform, mut doc, Key.Backspace)?;
    Check.isTrue(isText(doc, "abcd") && doc.count == 1 && doc.edit.caret == 2, "Backspace joined the lines")?;
    editKey(mut ui, mut platform, mut doc, Key.Enter)?;
    doc.edit = TextEdit.at(2);
    editKey(mut ui, mut platform, mut doc, Key.Delete)?;
    Check.isTrue(isText(doc, "abcd") && doc.count == 1, "Delete joined them")?;
    // Backspace inside a line takes a grapheme cluster.
    doc.edit = TextEdit.at(4);
    editKey(mut ui, mut platform, mut doc, Key.Backspace)?;
    return Check.isTrue(isText(doc, "abc") && doc.edit.caret == 3, "Backspace took d");
}

@test
fn anEditorPastesAndCutsAcrossLines() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = focusedEditor(mut ui, mut platform, "one\ntwo")?;
    // Paste "x\ny" over "ne\ntw": "ox\nyo", two lines.
    doc.edit = TextEdit { anchor: 1, caret: 6 };
    doc.paste = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "ox\nyo") && doc.count == 2 && doc.edit.caret == 4, "the paste replaced the selection")?;
    // Cut the line break and what is around it: one line, and the clipboard has it.
    doc.edit = TextEdit { anchor: 1, caret: 4 };
    doc.command = Some(EditCommand.Cut);
    editorFrame(mut ui, mut platform, mut doc)?;
    let cut = ui.copiedText()!;
    Check.isTrue(cut.length == 3 && cut[1] == '\n', "Cut copied x, the break and y")?;
    return Check.isTrue(isText(doc, "oo") && doc.count == 1, "and took them out");
}

@test
fn anEditorRefusesWhatHasNoRoom() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    // Seven line breaks: eight lines, as many as the index holds. One more Enter has no room.
    var doc = focusedEditor(mut ui, mut platform, "a\nb\nc\nd\ne\nf\ng\nh")?;
    Check.equalU64(8, doc.count as u64)?;
    doc.edit = TextEdit.at(1);
    Check.isTrue(!editKey(mut ui, mut platform, mut doc, Key.Enter)?, "no ninth line")?;
    Check.isTrue(isText(doc, "a\nb\nc\nd\ne\nf\ng\nh"), "the text is as it was")?;
    // Typing up to the buffer's 128 bytes (16 a frame, as the fake platform holds), and no further.
    for (k in 0..8) {
        let _ = k;
        typeChars(mut platform, "xxxxxxxxxxxxxxxx");
        editorFrame(mut ui, mut platform, mut doc)?;
    }
    return Check.equalU64(128, doc.len as u64);
}

@test
fn anEditorShowsTheInputMethodsComposition() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = focusedEditor(mut ui, mut platform, "abcd\nef")?;
    doc.edit = TextEdit.at(2);
    doc.composing = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    // The caret's line is drawn with the composition spliced in at the caret; the text itself is unchanged.
    var shown = false;
    for (k in 0..ui.commandCount()) {
        let command = ui.commandAt(k);
        match (command) {
            Command.Text(_, _) => {
                let t = ui.textOf(command);
                if (t.length == 10 && t[0] == 'a' && t[2] == 0xE3 && t[8] == 'c') {
                    shown = true;
                }
            }
            _ => {}
        }
    }
    Check.isTrue(shown, "ab, the composition, cd")?;
    Check.isTrue(isText(doc, "abcd\nef"), "nothing is typed until the input method commits")?;
    // The caret reported to the input method is after the composition: x 2 + 6 bytes of 10 points in the fake font.
    let area = ui.textInputArea();
    let box = ui.boxOf("ed")!;
    return expect("the caret after the composition", area.x - box.x, 80.0);
}

fn command(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut EditorDoc,
    c: EditCommand,
) -> Result<bool, TestFailure> {
    doc.command = Some(c);
    return editorFrame(mut ui, mut platform, mut doc);
}

@test
fn anEditorUndoesAWordAtATime() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = focusedEditor(mut ui, mut platform, "")?;
    typeChars(mut platform, "hello ");
    editorFrame(mut ui, mut platform, mut doc)?;
    typeChars(mut platform, "world");
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "hello world"), "typed")?;
    // A run of typing is one edit, ended by its space: Undo takes back "world", then "hello ".
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    Check.isTrue(isText(doc, "hello ") && doc.edit.caret == 6, "Undo took back world")?;
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    Check.isTrue(isText(doc, "") && !doc.state.canUndo(), "and hello")?;
    Check.isTrue(!command(mut ui, mut platform, mut doc, EditCommand.Undo)?, "nothing more to undo")?;
    // Redo makes them again.
    command(mut ui, mut platform, mut doc, EditCommand.Redo)?;
    command(mut ui, mut platform, mut doc, EditCommand.Redo)?;
    Check.isTrue(isText(doc, "hello world") && doc.edit.caret == 11 && !doc.state.canRedo(), "Redo twice")?;
    // An edit after an Undo ends what could be redone.
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    typeChars(mut platform, "there");
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "hello there") && !doc.state.canRedo(), "no Redo after a new edit")?;
    // Control-Z (the default binding off macOS) undoes too.
    platform.strokes[0] = Keystroke {
        key: null,
        character: 'z',
        modifiers: Modifiers { shift: false, control: true, alt: false, command: false },
    };
    platform.strokeCount = 1;
    platform.strokeRead = 0;
    editorFrame(mut ui, mut platform, mut doc)?;
    platform.strokeCount = 0;
    platform.strokeRead = 0;
    return Check.isTrue(isText(doc, "hello "), "Control-Z undid there");
}

@test
fn anEditorUndoesDeletesAndPastesWithTheirSelection() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = focusedEditor(mut ui, mut platform, "one\ntwo")?;
    // Backspace at the second line's start joins the lines; Undo splits them again, the caret where it was.
    doc.edit = TextEdit.at(4);
    editKey(mut ui, mut platform, mut doc, Key.Backspace)?;
    Check.isTrue(isText(doc, "onetwo") && doc.count == 1, "joined")?;
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    Check.isTrue(isText(doc, "one\ntwo") && doc.count == 2 && doc.edit.caret == 4, "split again")?;
    // A paste over a selection: Undo brings the selection back, selected.
    doc.edit = TextEdit { anchor: 1, caret: 6 };
    doc.paste = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "ox\nyo"), "pasted")?;
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    return Check.isTrue(
        isText(doc, "one\ntwo") && doc.edit.anchor == 1 && doc.edit.caret == 6,
        "the selection is back",
    );
}

@test
fn aSmallHistoryKeepsTheLatestEdits() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = focusedEditor(mut ui, mut platform, "")?;
    // Twelve words, each its own record of 33 bytes (28 of head and trail, "abcd " typed into it): 256 bytes keep
    // the last seven.
    for (k in 0..12) {
        let _ = k;
        typeChars(mut platform, "abcd ");
        editorFrame(mut ui, mut platform, mut doc)?;
    }
    Check.equalU64(60, doc.len as u64)?;
    var undone: u64 = 0;
    loop {
        if (!command(mut ui, mut platform, mut doc, EditCommand.Undo)?) {
            break;
        }
        undone += 1;
    }
    Check.equalU64(7, undone)?;
    return Check.equalU64(25, doc.len as u64);
}

/// The y of each Text command whose text starts with `first`, in order.
fn rowsStarting(ui: borrow Ui, first: u8, out: borrow mut Vector<f32>) {
    out.clear();
    for (k in 0..ui.commandCount()) {
        let command = ui.commandAt(k);
        match (command) {
            Command.Text(r, _) => {
                let t = ui.textOf(command);
                if (t.length > 0 && t[0] == first) {
                    out.push(r.y);
                }
            }
            _ => {}
        }
    }
}

/// Thirteen words of four letters: six a row fit the view's 296 points (a word and its space are 50).
fn longLine() -> StringView => "aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj kkkk llll mmmm\nshort";

@test
fn anEditorWrapsLongLinesIntoRows() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = focusedEditor(mut ui, mut platform, longLine())?;
    editorFrame(mut ui, mut platform, mut doc)?;
    // Three rows: aaaa..ffff (bytes 0 to 30), gggg..llll (30 to 60), mmmm; "short" one.
    Check.isTrue(doc.rows[0] == 3 && doc.rows[1] == 1, "the long line takes three rows")?;
    var ys = Vector<f32>.create();
    rowsStarting(ui, 'g', mut ys);
    Check.equalU64(1, ys.length as u64)?;
    let second = ys[0];
    rowsStarting(ui, 'a', mut ys);
    expect("the second row is a row below the first", second - ys[0], 20.0)?;
    rowsStarting(ui, 's', mut ys);
    expect("the next line is under the three rows", ys[0] - second, 40.0)?;
    // Down and Up move by rows, keeping the caret's place across.
    doc.edit = TextEdit.at(2);
    let firstDown = editCaret(mut ui, mut platform, mut doc, Key.Down)?;
    Console.write(" rows ");
    Console.write(" focused ");
    Check.equalU64(32, firstDown as u64)?;
    Check.equalU64(62, editCaret(mut ui, mut platform, mut doc, Key.Down)? as u64)?;
    Check.equalU64(67, editCaret(mut ui, mut platform, mut doc, Key.Down)? as u64)?;
    Check.equalU64(62, editCaret(mut ui, mut platform, mut doc, Key.Up)? as u64)?;
    Check.equalU64(32, editCaret(mut ui, mut platform, mut doc, Key.Up)? as u64)?;
    // Right from a row's last character: its end is the next row's start, then on into that row.
    doc.edit = TextEdit.at(29);
    Check.equalU64(30, editCaret(mut ui, mut platform, mut doc, Key.Right)? as u64)?;
    Check.equalU64(31, editCaret(mut ui, mut platform, mut doc, Key.Right)? as u64)?;
    Check.equalU64(30, editCaret(mut ui, mut platform, mut doc, Key.Left)? as u64)?;
    Check.equalU64(29, editCaret(mut ui, mut platform, mut doc, Key.Left)? as u64)?;
    // A click on the second row, 25 points in: between g and g, byte 32 or so of the line.
    let box = ui.boxOf("ed")!;
    platform.pointerState.position = Vec2 { x: box.x + 21.0, y: box.y + 30.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    return Check.equalU64(32, doc.edit.caret as u64);
}

@test
fn anEditorWithoutWrappingKeepsALineOneRow() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = editorOf(longLine());
    doc.nowrap = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    var ys = Vector<f32>.create();
    rowsStarting(ui, 'a', mut ys);
    Check.equalU64(1, ys.length as u64)?;
    rowsStarting(ui, 'g', mut ys);
    return Check.equalU64(0, ys.length as u64);
}

fn editCaret(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut EditorDoc,
    k: Key,
) -> Result<usize, TestFailure> {
    editKey(mut ui, mut platform, mut doc, k)?;
    return Ok(doc.edit.caret);
}

@test
fn anEditorInAClippingParentWrapsAtItsWidth() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    // A clipping parent leaves an overflowing child as it is: the editor's unwrapped first frame must not make it as
    // wide as its longest line, or it would wrap at that width ever after.
    var doc = editorOf(longLine());
    doc.clipped = true;
    for (k in 0..4) {
        let _ = k;
        editorFrame(mut ui, mut platform, mut doc)?;
    }
    Check.isTrue(ui.boxOf("ed")!.w <= 300.0, "the editor is no wider than its parent")?;
    return Check.isTrue(doc.rows[0] == 3, "the long line wraps into three rows");
}

@test
fn upAndDownKeepTheCaretsPlaceThroughShortLines() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    // Lines at 0 ("long line here"), 15 ("ab") and 18 ("another longer").
    var doc = focusedEditor(mut ui, mut platform, "long line here\nab\nanother longer")?;
    doc.edit = TextEdit.at(12);
    // Down through "ab" (the caret at its end, 17) and on to the third line at the place it started from (x 120).
    Check.equalU64(17, editCaret(mut ui, mut platform, mut doc, Key.Down)? as u64)?;
    Check.equalU64(30, editCaret(mut ui, mut platform, mut doc, Key.Down)? as u64)?;
    Check.equalU64(17, editCaret(mut ui, mut platform, mut doc, Key.Up)? as u64)?;
    Check.equalU64(12, editCaret(mut ui, mut platform, mut doc, Key.Up)? as u64)?;
    // Another move forgets the place: from "ab"'s start, Down goes to the third line's start.
    doc.edit = TextEdit.at(15);
    editKey(mut ui, mut platform, mut doc, Key.Home)?;
    return Check.equalU64(18, editCaret(mut ui, mut platform, mut doc, Key.Down)? as u64);
}
