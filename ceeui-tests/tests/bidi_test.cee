// SPDX-License-Identifier: MIT
// The bidirectional algorithm against Unicode's own test files (BidiTest.txt, BidiCharacterTest.txt from
// https://www.unicode.org/Public/<version>/ucd/), in the directory CEEUI_UCD names; skipped without it. And a
// few cases that always run.

import ceeui;

const CLASS_NAMES: [StringView; 23] = [
    "L", "R", "AL", "EN", "ES", "ET", "AN", "CS", "NSM", "BN", "B", "S", "WS", "ON", "LRE", "LRO", "RLE", "RLO", "PDF",
    "LRI", "RLI", "FSI", "PDI",
];

/// Whether `token` spells `name`.
fn spells(token: Slice<u8>, name: StringView) -> bool {
    let b = name.bytes();
    if (b.length != token.length) {
        return false;
    }
    for (k in 0..b.length) {
        if (b[k] != token[k]) {
            return false;
        }
    }
    return true;
}

fn isSpace(b: u8) -> bool => b == ' ' || b == '\t';

/// The tokens of `line` (split at spaces and tabs) as (start, end) pairs into `out`; how many.
fn tokens(line: Slice<u8>, out: borrow mut [usize; 512]) -> usize {
    var n: usize = 0;
    var i: usize = 0;
    while (i < line.length && n < 256) {
        while (i < line.length && isSpace(line[i])) {
            i += 1;
        }
        if (i >= line.length) {
            break;
        }
        let start = i;
        while (i < line.length && !isSpace(line[i])) {
            i += 1;
        }
        out[n * 2] = start;
        out[n * 2 + 1] = i;
        n += 1;
    }
    return n;
}

fn hexValue(t: Slice<u8>) -> u32 {
    var v: u32 = 0;
    for (d in t) {
        v = v * 16 + (if (d <= '9') (d - '0') as u32 else if (d >= 'a') (d - 'a') as u32 + 10 else (d - 'A') as u32 + 10);
    }
    return v;
}

fn decimalValue(t: Slice<u8>) -> u32 {
    var v: u32 = 0;
    for (d in t) {
        v = v * 10 + (d - '0') as u32;
    }
    return v;
}

/// Levels as the test files spell them ("x" for none) from the tokens of `text` into `out`; how many.
fn parseLevels(text: Slice<u8>, out: borrow mut [u8; 256]) -> usize {
    var tk = [0usize; 512];
    let n = tokens(text, mut tk);
    for (k in 0..n) {
        let t = text[tk[k * 2]..tk[k * 2 + 1]];
        out[k] = if (t.length == 1 && t[0] == 'x') BIDI_REMOVED else truncate<u8>(decimalValue(t));
    }
    return n;
}

fn parseNumbers(text: Slice<u8>, out: borrow mut [u32; 256]) -> usize {
    var tk = [0usize; 512];
    let n = tokens(text, mut tk);
    for (k in 0..n) {
        out[k] = decimalValue(text[tk[k * 2]..tk[k * 2 + 1]]);
    }
    return n;
}

/// The position of the first `b` in `s` from `from`, or `s.length`.
fn find(s: Slice<u8>, from: usize, b: u8) -> usize {
    var i = from;
    while (i < s.length && s[i] != b) {
        i += 1;
    }
    return i;
}

/// Whether `levels` (n) and their visual order match the expected ones.
fn agrees(levels: borrow [u8; 256], n: usize, want: borrow [u8; 256], order: borrow [u32; 256], m: usize) -> bool {
    for (k in 0..n) {
        if (levels[k] != want[k]) {
            return false;
        }
    }
    var got = [0u32; 256];
    let count = bidiVisualOrder(levels[0..n], mut got[..]);
    if (count != m) {
        return false;
    }
    for (k in 0..m) {
        if (got[k] != order[k]) {
            return false;
        }
    }
    return true;
}

@test
fn bidiPassesBidiTest() -> Result<void, TestFailure> {
    let file = ucdFile("BidiTest.txt");
    if (file.length == 0) {
        Console.writeLine("  (CEEUI_UCD not set or BidiTest.txt missing: skipped)");
        return Ok();
    }
    let text = file.view();
    var want = [0u8; 256];
    var wantCount: usize = 0;
    var order = [0u32; 256];
    var orderCount: usize = 0;
    var classes = [0u8; 256];
    var levels = [0u8; 256];
    var scratch = [0u32; 256 * BIDI_SCRATCH];
    var tk = [0usize; 512];
    var cases: u32 = 0;
    var failed: u32 = 0;
    var at: usize = 0;
    while (at < text.length) {
        let end = find(text, at, '\n');
        let line = text[at..end];
        at = end + 1;
        if (line.length == 0 || line[0] == '#') {
            continue;
        }
        if (line[0] == '@') {
            let colon = find(line, 0, ':');
            if (colon >= line.length) {
                continue;
            }
            if (spells(line[0..colon], "@Levels")) {
                wantCount = parseLevels(line[colon + 1..], mut want);
            } else if (spells(line[0..colon], "@Reorder")) {
                orderCount = parseNumbers(line[colon + 1..], mut order);
            }
            continue;
        }
        let semi = find(line, 0, ';');
        if (semi >= line.length) {
            continue;
        }
        let n = tokens(line[0..semi], mut tk);
        for (k in 0..n) {
            let t = line[tk[k * 2]..tk[k * 2 + 1]];
            for (c in 0usize..23) {
                if (spells(t, CLASS_NAMES[c])) {
                    classes[k] = truncate<u8>(c);
                }
            }
        }
        let bits = decimalValue(line[semi + 1..find(line, semi + 1, '#')].trim());
        for (b in 0usize..3) {
            if ((bits & (1u32 << truncate<u32>(b))) == 0) {
                continue;
            }
            let direction: i32 = if (b == 0) -1 else if (b == 1) 0 else 1;
            cases += 1;
            let para = bidiResolveClasses(classes[0..n], direction, mut levels[0..n], mut scratch[..]);
            if (para < 0 || n != wantCount || !agrees(levels, n, want, order, orderCount)) {
                failed += 1;
                if (failed <= 10) {
                    Console.write("  BidiTest: ");
                    Console.write(StringView.fromUtf8(line)!);
                    Console.write("  direction ");
                    Console.write(direction);
                    Console.write("  got");
                    for (k in 0..n) {
                        Console.write(" ");
                        if (levels[k] == BIDI_REMOVED) {
                            Console.write("x");
                        } else {
                            Console.write(levels[k] as u32);
                        }
                    }
                    Console.writeLine("");
                }
            }
        }
    }
    Console.write("  ");
    Console.write(cases - failed);
    Console.write(" of ");
    Console.write(cases);
    Console.writeLine(" BidiTest.txt cases pass");
    return Check.isTrue(failed == 0, "every BidiTest.txt case passes");
}

@test
fn bidiPassesBidiCharacterTest() -> Result<void, TestFailure> {
    let file = ucdFile("BidiCharacterTest.txt");
    if (file.length == 0) {
        Console.writeLine("  (CEEUI_UCD not set or BidiCharacterTest.txt missing: skipped)");
        return Ok();
    }
    let text = file.view();
    var want = [0u8; 256];
    var order = [0u32; 256];
    var levels = [0u8; 256];
    var scratch = [0u32; 256 * BIDI_SCRATCH];
    var utf8 = [0u8; 1024];
    var tk = [0usize; 512];
    var cases: u32 = 0;
    var failed: u32 = 0;
    var at: usize = 0;
    while (at < text.length) {
        let end = find(text, at, '\n');
        let line = text[at..end];
        at = end + 1;
        if (line.length == 0 || line[0] == '#') {
            continue;
        }
        // code points; direction; paragraph level; levels; order
        var f = [0usize; 6];
        f[0] = 0;
        var fields: usize = 1;
        var i: usize = 0;
        while (i < line.length && fields < 6) {
            if (line[i] == ';') {
                f[fields] = i + 1;
                fields += 1;
            }
            i += 1;
        }
        if (fields < 5) {
            continue;
        }
        let n = tokens(line[0..f[1] - 1], mut tk);
        var w: usize = 0;
        for (k in 0..n) {
            var b = [0u8; 4];
            let len = encodeUtf8(hexValue(line[tk[k * 2]..tk[k * 2 + 1]]), mut b);
            for (j in 0..len) {
                utf8[w + j] = b[j];
            }
            w += len;
        }
        let dir = decimalValue(line[f[1]..f[2] - 1].trim());
        let direction: i32 = if (dir == 2) -1 else truncate<i32>(dir);
        let wantPara = decimalValue(line[f[2]..f[3] - 1].trim());
        let wantCount = parseLevels(line[f[3]..f[4] - 1], mut want);
        let orderCount = parseNumbers(line[f[4]..], mut order);
        cases += 1;
        let para = bidiLevels(utf8[0..w], direction, mut levels[0..n], mut scratch[..]);
        if (para != truncate<i32>(wantPara) || n != wantCount || !agrees(levels, n, want, order, orderCount)) {
            failed += 1;
            if (failed <= 10) {
                Console.write("  BidiCharacterTest: ");
                Console.write(StringView.fromUtf8(line)!);
                Console.write("  got ");
                Console.write(para);
                Console.write(";");
                for (k in 0..n) {
                    Console.write(" ");
                    if (levels[k] == BIDI_REMOVED) {
                        Console.write("x");
                    } else {
                        Console.write(levels[k] as u32);
                    }
                }
                Console.writeLine("");
            }
        }
    }
    Console.write("  ");
    Console.write(cases - failed);
    Console.write(" of ");
    Console.write(cases);
    Console.writeLine(" BidiCharacterTest.txt cases pass");
    return Check.isTrue(failed == 0, "every BidiCharacterTest.txt case passes");
}

@test
fn bidiOrdersMixedText() -> Result<void, TestFailure> {
    // "abc", Hebrew alef bet gimel, "123": the Hebrew reads right to left, and the number after it goes with it.
    let text = "abc אבג 123";
    var levels = [0u8; 16];
    var scratch = [0u32; 16 * BIDI_SCRATCH];
    let para = bidiLevels(text.bytes(), -1, mut levels[..], mut scratch[..]);
    var order = [0u32; 16];
    let m = bidiVisualOrder(levels[0..11], mut order[..]);
    let expected = [0u32, 1, 2, 3, 8, 9, 10, 7, 6, 5, 4];
    var same = m == 11;
    for (k in 0..11) {
        if (order[k] != expected[k]) {
            same = false;
        }
    }
    // A right-to-left paragraph mirrors its brackets.
    return Check.isTrue(para == 0 && same && bidiMirror(0x28) == 0x29 && bidiMirror(0x5D0) == 0x5D0,
        "mixed text orders by UAX #9");
}
