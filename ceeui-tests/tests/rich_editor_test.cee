// SPDX-License-Identifier: MIT
// A rich document's marks (TextDocument.styled): a look for each byte that typing, marking, Undo and Redo keep in
// step with the text. Driven through the editor of text_view_test.

import ceeui;

/// The marks of `doc`'s text, as digits ("0012").
fn marksAre(doc: borrow EditorDoc, want: StringView) -> bool {
    let w = want.bytes();
    if (doc.len != w.length) {
        return false;
    }
    for (i in 0..w.length) {
        if (doc.marks[i] != w[i] - '0') {
            return false;
        }
    }
    return true;
}

fn richEditor(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    text: StringView,
) -> Result<EditorDoc, TestFailure> {
    var doc = focusedEditor(mut ui, mut platform, text)?;
    doc.rich = true;
    return Ok(doc);
}

@test
fn typingTakesTheTypingMark() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = richEditor(mut ui, mut platform, "")?;
    typeChars(mut platform, "ab");
    editorFrame(mut ui, mut platform, mut doc)?;
    // With nothing selected, a mark is for what is typed next.
    doc.markWanted = 2;
    typeChars(mut platform, "cd");
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "abcd") && marksAre(doc, "0022"), "abcd marked 0022")?;
    // A line break and a paste take it too.
    doc.paste = true;
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "abcdx\ny") && marksAre(doc, "0022222"), "pasted in the typing mark")?;
    // Deleting takes the marks with the bytes.
    editKey(mut ui, mut platform, mut doc, Key.Home)?;
    editKey(mut ui, mut platform, mut doc, Key.Up)?;
    editKey(mut ui, mut platform, mut doc, Key.Delete)?;
    return Check.isTrue(isText(doc, "bcdx\ny") && marksAre(doc, "022222"), "one byte and its mark gone");
}

@test
fn markingASelectionIsUndone() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = richEditor(mut ui, mut platform, "plain words")?;
    // "words" selected and marked 1, then "ai" of "plain" marked 3.
    doc.edit = TextEdit { caret: 11, anchor: 6 };
    doc.markWanted = 1;
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(marksAre(doc, "00000011111"), "words marked")?;
    doc.edit = TextEdit { caret: 4, anchor: 2 };
    doc.markWanted = 3;
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(marksAre(doc, "00330011111"), "ai marked")?;
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    Check.isTrue(marksAre(doc, "00000011111") && isText(doc, "plain words"), "the second marking undone")?;
    Check.isTrue(doc.edit.caret == 4 && doc.edit.anchor == 2, "its selection back")?;
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    Check.isTrue(marksAre(doc, "00000000000"), "both undone")?;
    command(mut ui, mut platform, mut doc, EditCommand.Redo)?;
    command(mut ui, mut platform, mut doc, EditCommand.Redo)?;
    return Check.isTrue(marksAre(doc, "00330011111") && isText(doc, "plain words"), "and made again");
}

@test
fn undoingAnEditBringsBackItsMarks() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = richEditor(mut ui, mut platform, "one two")?;
    doc.edit = TextEdit { caret: 7, anchor: 4 };
    doc.markWanted = 2;
    editorFrame(mut ui, mut platform, mut doc)?;
    // "two" (marked 2) typed over in mark 1: Undo brings it back in its own.
    doc.edit = TextEdit { caret: 7, anchor: 4 };
    doc.markWanted = 1;
    editorFrame(mut ui, mut platform, mut doc)?;
    doc.markWanted = null;
    // The selection marked 1 as well (setMark marks a selection); typed over now, in mark 1.
    doc.edit = TextEdit { caret: 7, anchor: 4 };
    typeChars(mut platform, "six");
    editorFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "one six") && marksAre(doc, "0000111"), "typed over")?;
    // Undo takes the typing back (one record: the word), then the marking.
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    Check.isTrue(isText(doc, "one two") && marksAre(doc, "0000111"), "two back, as it was marked then")?;
    command(mut ui, mut platform, mut doc, EditCommand.Undo)?;
    Check.isTrue(marksAre(doc, "0000222"), "its first marking back")?;
    command(mut ui, mut platform, mut doc, EditCommand.Redo)?;
    command(mut ui, mut platform, mut doc, EditCommand.Redo)?;
    return Check.isTrue(isText(doc, "one six") && marksAre(doc, "0000111"), "redone, marks and all");
}

/// Metrics in which a byte is half its font size wide, so a run in a bigger look is wider.
struct SizeAdvance {
    unused: u8;
}

impl TextMetrics for SizeAdvance {
    fn measure(borrow this, utf8: Slice<u8>, config: TextConfig) -> Dims =>
        Dims { w: round<f32>(utf8.length) * config.fontSize * 0.5, h: config.fontSize * 1.25 };
    fn baseline(borrow this, config: TextConfig) -> f32 => config.fontSize * 0.8;
}

/// A frame of a rich editor whose mark 1 is 20 points (10 a byte) and the rest 14 (7 a byte).
fn richFrame(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut EditorDoc,
) -> Result<bool, TestFailure> {
    let metrics = SizeAdvance { unused: 0 };
    ui.begin(mut platform);
    ui.open(Style.column().w(Size.fixed(300.0)).h(Size.fixed(200.0)));
    let look = Text.of().size(14.0).leading(20.0);
    let looks = [look, Text.of().size(20.0).leading(20.0).color(ROSE_400)];
    var d = TextDocument.styled(
        mut doc.buf[..],
        doc.len,
        mut doc.marks[..],
        mut doc.starts[..],
        mut doc.rows[..],
        mut doc.history[..],
    );
    d.typing = doc.typing;
    d.edit = doc.edit;
    d.undo = doc.state;
    d.goalX = doc.goal;
    match (doc.markWanted) {
        Some(m) => { let _ = d.setMark(m); }
        null => {}
    }
    doc.markWanted = null;
    let changed = Controls.richEditor(mut ui, metrics, "ed", mut d, look, looks[..], false);
    doc.typing = d.typing;
    doc.len = d.len;
    doc.count = d.count;
    doc.edit = d.edit;
    doc.state = d.undo;
    doc.goal = d.goalX;
    ui.close();
    // Laid out with the same metrics the editor measured with.
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    Check.isTrue(ok, "the frame fits")?;
    platform.pressed = 0;
    platform.typedCount = 0;
    platform.typedRead = 0;
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    return Ok(changed);
}

/// A rich editor holding "aaBBcc" with "BB" in mark 1, focused.
fn markedEditor(ui: borrow mut Ui, platform: borrow mut FakePlatform) -> Result<EditorDoc, TestFailure> {
    var doc = editorOf("aaBBcc");
    doc.rich = true;
    doc.marks[2] = 1;
    doc.marks[3] = 1;
    richFrame(mut ui, mut platform, mut doc)?;
    ui.setFocus(hashId("ed"));
    richFrame(mut ui, mut platform, mut doc)?;
    return Ok(doc);
}

@test
fn aRichEditorDrawsEachRunInItsLook() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = markedEditor(mut ui, mut platform)?;
    // Three text commands: "aa" at 14, "BB" at 20, "cc" at 14, side by side.
    var xs = [0.0f32; 4];
    var sizes = [0.0f32; 4];
    var n: usize = 0;
    let tree = ui.layout();
    for (i in 0..tree.commandCount()) {
        match (tree.command(i)) {
            Command.Text(area, run) => {
                if (n < 4) {
                    xs[n] = area.x;
                    sizes[n] = run.fontSize;
                    n += 1;
                }
            }
            _ => {}
        }
    }
    Check.equalU64(3, n as u64)?;
    Check.isTrue(sizes[0] == 14.0 && sizes[1] == 20.0 && sizes[2] == 14.0, "each run in its size")?;
    Check.isTrue((xs[1] - xs[0] - 14.0).abs() < 0.5 && (xs[2] - xs[1] - 20.0).abs() < 0.5, "side by side")?;
    // End puts the caret after all three: 14 + 20 + 14.
    let box = ui.boxOf("ed")!;
    editKeyRich(mut ui, mut platform, mut doc, Key.End)?;
    Check.equalU64(6, doc.edit.caret as u64)?;
    let caret = ui.textInputArea();
    return Check.isTrue((caret.x - box.x - 48.0).abs() < 0.5, "the caret after the runs' widths");
}

fn editKeyRich(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    doc: borrow mut EditorDoc,
    k: Key,
) -> Result<bool, TestFailure> {
    platform.pressed = 1u64 << (keyIndex(k) as u64);
    return richFrame(mut ui, mut platform, mut doc);
}

@test
fn aRichEditorPlacesTheCaretByItsRuns() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var doc = markedEditor(mut ui, mut platform)?;
    // 26 across is 12 into "BB" (14 to 34, 10 a byte): the caret after its first B.
    let box = ui.boxOf("ed")!;
    platform.pointerState.position = Vec2 { x: box.x + 26.0, y: box.y + 5.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    richFrame(mut ui, mut platform, mut doc)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    richFrame(mut ui, mut platform, mut doc)?;
    Check.equalU64(3, doc.edit.caret as u64)?;
    // There typing takes the mark of the byte before the caret: a B's.
    Check.equalU64(1, doc.typing as u64)?;
    typeChars(mut platform, "x");
    richFrame(mut ui, mut platform, mut doc)?;
    Check.isTrue(isText(doc, "aaBxBcc") && marksAre(doc, "0011100"), "typed in B's mark")?;
    // Moved back into "aa", typing is plain again.
    editKeyRich(mut ui, mut platform, mut doc, Key.Home)?;
    editKeyRich(mut ui, mut platform, mut doc, Key.Right)?;
    return Check.equalU64(0, doc.typing as u64);
}

/// A frame of an editor 300 by 100 over `buf`'s first `len` bytes, whose scroll offset it returns.
fn scrollFrame(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    buf: borrow mut [u8; 1024],
    len: usize,
) -> Result<f32, TestFailure> {
    let metrics = SizeAdvance { unused: 0 };
    var starts = [0u32; 64];
    var rows = [0u16; 64];
    var history = [0u8; 512];
    ui.begin(mut platform);
    ui.open(Style.column().w(Size.fixed(300.0)).h(Size.fixed(100.0)));
    let look = Text.of().size(14.0).leading(20.0);
    let looks = [look];
    var d = TextDocument.over(mut buf[..], len, mut starts[..], mut rows[..], mut history[..]);
    // In a clipping column, as the demo's editor is (for its rounded corners).
    ui.open(Style.column().w(Size.grow()).h(Size.grow()).rounded(Radius.Md).clip());
    let _ = Controls.richEditor(mut ui, metrics, "ed", mut d, look, looks[..], false);
    ui.close();
    ui.close();
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    Check.isTrue(ok, "the frame fits")?;
    platform.pointerState.wheel = Vec2.zero();
    return Ok(ui.scrollOffset("ed").y);
}

@test
fn theWheelScrollsALongDocument() -> Result<void, TestFailure> {
    var storage = heap(4194304);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(256))!;
    var platform = platformAt(400.0, 300.0, 50.0, 50.0);
    var buf = [0u8; 1024];
    var len: usize = 0;
    for (k in 0..40) {
        buf[len] = 'a' + truncate<u8>(k % 26);
        buf[len + 1] = '\n';
        len += 2;
    }
    for (f in 0..3) {
        let _ = scrollFrame(mut ui, mut platform, mut buf, len)?;
    }
    platform.pointerState.wheel = Vec2 { x: 0.0, y: -3.0 };
    let _ = scrollFrame(mut ui, mut platform, mut buf, len)?;
    let after = scrollFrame(mut ui, mut platform, mut buf, len)?;
    return Check.isTrue(after < 0.0, "three notches down scroll a 40-line document in a 100-point editor");
}

@test
fn aDragInTheEditorSelectsRatherThanScrolls() -> Result<void, TestFailure> {
    var storage = heap(4194304);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(256))!;
    var platform = platformAt(400.0, 300.0, 50.0, 30.0);
    var buf = [0u8; 1024];
    var len: usize = 0;
    for (k in 0..40) {
        buf[len] = 'a' + truncate<u8>(k % 26);
        buf[len + 1] = '\n';
        len += 2;
    }
    for (f in 0..3) {
        let _ = scrollFrame(mut ui, mut platform, mut buf, len)?;
    }
    // Press, then drag 60 points down over three frames: a mouse's drag in a text view selects (Style.noDragScroll).
    platform.pointerState.down = true;
    platform.pointerState.pressed = true;
    let _ = scrollFrame(mut ui, mut platform, mut buf, len)?;
    platform.pointerState.pressed = false;
    for (step in 1..4) {
        platform.pointerState.position = Vec2 { x: 50.0, y: 30.0 + round<f32>(step) * 20.0 };
        let _ = scrollFrame(mut ui, mut platform, mut buf, len)?;
    }
    let offset = scrollFrame(mut ui, mut platform, mut buf, len)?;
    return Check.isTrue(offset == 0.0, "a drag in the editor did not scroll it");
}
