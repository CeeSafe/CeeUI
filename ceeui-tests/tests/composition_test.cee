// SPDX-License-Identifier: MIT
// A word the input method is still composing when the focus moves to another text field (a phone's keyboard composes
// until a space or a tap elsewhere): it stays in the field it was typed in, and the host is told to end the
// composition, so that it is not committed again into the new field. Found on a Sunmi V2: a user name typed, then a
// tap on the password field, left the user name empty.

import ceeui;

struct Form {
    name: [u8; 64];
    nameLen: usize;
    nameEdit: TextEdit;
    pass: [u8; 64];
    passLen: usize;
    passEdit: TextEdit;
}

fn form(ui: borrow mut Ui, f: borrow mut Form) {
    let metrics = FixedAdvance { unused: 0 };
    ui.open(Style.column().id("root").w(Size.grow()).h(Size.grow()).p(space(4.0)).gap(space(3.0)));
    Controls.textField(mut ui, metrics, "name", mut f.name[..], mut f.nameLen, mut f.nameEdit);
    Controls.passwordField(mut ui, metrics, "pass", mut f.pass[..], mut f.passLen, mut f.passEdit);
    ui.close();
}

/// One frame: the host's composition given first (as the desktop platform's editInto does), then the form.
fn formFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform, f: borrow mut Form, composing: StringView)
    -> Result<void, TestFailure> {
    ui.begin(mut platform);
    ui.setComposition(composing.bytes(), composing.length);
    form(mut ui, mut f);
    let metrics = FixedAdvance { unused: 0 };
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    platform.clock += 1.0 / 60.0;
    return Check.isTrue(ok, "frame fits");
}

fn tapOn(ui: borrow mut Ui, platform: borrow mut FakePlatform, f: borrow mut Form, name: StringView,
    composing: StringView) -> Result<void, TestFailure> {
    let b = ui.boxOf(name)!;
    platform.pointerState.position = Vec2 { x: b.x + b.w / 2.0, y: b.y + b.h / 2.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    formFrame(mut ui, mut platform, mut f, composing)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    return formFrame(mut ui, mut platform, mut f, composing);
}

fn textIs(bytes: Slice<u8>, want: StringView) -> bool {
    let w = want.bytes();
    if (bytes.length != w.length) {
        return false;
    }
    for (i in 0..w.length) {
        if (bytes[i] != w[i]) {
            return false;
        }
    }
    return true;
}

@test
fn aComposedWordStaysInTheFieldItWasTypedIn() -> Result<void, TestFailure> {
    var storage = [0u8; 1048576];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(600.0, 400.0, -1.0, -1.0);
    var f = Form {
        name: [0u8; 64],
        nameLen: 0,
        nameEdit: TextEdit.at(0),
        pass: [0u8; 64],
        passLen: 0,
        passEdit: TextEdit.at(0),
    };
    formFrame(mut ui, mut platform, mut f, "")?;

    // The user name field focused, and the keyboard composing "admin" there (shown, not yet committed).
    tapOn(mut ui, mut platform, mut f, "name", "")?;
    Check.isTrue(ui.hasFocusNamed("name"), "the name field has the focus")?;
    formFrame(mut ui, mut platform, mut f, "admin")?;
    Check.isTrue(f.nameLen == 0 && ui.composition().length == 5, "the word is composing, not yet the field's")?;

    // A press on the password field, the keyboard still composing: the focus moves at the press, and at that frame's
    // end the word is the name field's to take and the host is told to end the composition.
    let b = ui.boxOf("pass")!;
    platform.pointerState.position = Vec2 { x: b.x + b.w / 2.0, y: b.y + b.h / 2.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    formFrame(mut ui, mut platform, mut f, "admin")?;
    Check.isTrue(ui.hasFocusNamed("pass"), "the password field has the focus")?;
    Check.isTrue(ui.textFocusMovedBetweenFields(), "the host is told to end the composition")?;
    Check.isTrue(ui.composition().length == 0, "the composition ended with the move")?;
    // The host ended it (text input off and on), so the window's composition is empty from the next frame on.
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    formFrame(mut ui, mut platform, mut f, "")?;
    Check.isTrue(textIs(f.name[0..f.nameLen], "admin"), "the user name kept the word typed in it")?;
    Check.isTrue(f.passLen == 0, "the password field got nothing of it")?;
    Check.isTrue(!ui.textFocusMovedBetweenFields(), "said once")?;
    formFrame(mut ui, mut platform, mut f, "")?;
    Check.isTrue(textIs(f.name[0..f.nameLen], "admin") && f.passLen == 0, "and taken once")?;
    return Ok();
}
