// SPDX-License-Identifier: MIT
// Popups and context menus: kept inside the window (moved left at the right edge, above the point at the bottom),
// transparent the first frame they are open, closed by a choice, a press outside or Escape; menu items that are
// disabled or destructive. Uses ui_test.cee's FakePlatform, platformAt and finish.

import ceeui;

const ITEMS: [StringView; 3] = ["Reply", "Copy", "Delete"];

/// One frame of a 400 by 300 window holding the menu `id` at (x, y), with the second item disabled and the third
/// destructive; the index chosen.
fn menuFrame(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    open: borrow mut bool,
    x: f32,
    y: f32,
) -> Result<usize?, TestFailure> {
    ui.begin(mut platform);
    ui.open(Style.box().w(Size.fixed(400.0)).h(Size.fixed(300.0)));
    var chosen: usize? = null;
    if (Controls.popup(mut ui, "menu", mut open, x, y)) {
        ui.open(Style.column().id("items").minW(120.0));
        for (k in 0usize..3) {
            if (Controls.menuItem(mut ui, "menu", k, ITEMS[k], k != 1, k == 2)) {
                chosen = Some(k);
                open = false;
            }
        }
        Controls.menuSeparator(mut ui);
        ui.close();
        Controls.popupEnd(mut ui, "menu", mut open);
    }
    ui.close();
    finish(mut ui, mut platform)?;
    return Ok(chosen);
}

@test
fn aPopupStaysInsideTheWindow() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var open = true;
    // Asked for near the bottom right corner: the first frame it is transparent, the next inside the window.
    let _ = menuFrame(mut ui, mut platform, mut open, 380.0, 280.0)?;
    Check.isTrue(ui.needsFrame(), "another frame is asked for")?;
    let _ = menuFrame(mut ui, mut platform, mut open, 380.0, 280.0)?;
    let b = ui.boxOf("menu")!;
    Check.isTrue(b.x + b.w <= 400.0 - 8.0 + 0.5, "moved left of the right edge")?;
    Check.isTrue(b.y + b.h <= 280.0 + 0.5, "above the point")?;
    Check.isTrue(b.x >= 8.0 - 0.5 && b.y >= 8.0 - 0.5, "inside the top left margin")?;
    Check.isTrue(b.w >= 120.0, "at least as wide as asked")?;
    for (k in 0usize..3) {
        let item = ui.boxOfHash(menuItemId("menu", k))!;
        Console.write("  item ");
        Console.write(k as u64);
        Console.write(" y ");
        Console.write(truncate<u64>(item.y));
        Console.write(" bottom ");
        Console.write(truncate<u64>(item.y + item.h));
        Console.write(" popup ");
        Console.write(truncate<u64>(b.y));
        Console.write("..");
        Console.writeLine(truncate<u64>(b.y + b.h));
        Check.isTrue(item.y >= b.y && item.y + item.h <= b.y + b.h + 0.5, "each item inside the popup")?;
    }
    // Asked for in the middle: where it was asked.
    open = false;
    let _ = menuFrame(mut ui, mut platform, mut open, 0.0, 0.0)?;
    open = true;
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    let m = ui.boxOf("menu")!;
    Check.isTrue(m.x > 99.5 && m.x < 100.5 && m.y > 59.5 && m.y < 60.5, "at the point when it fits")?;
    return Ok();
}

@test
fn aMenuIsChosenOrClosed() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var open = true;
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    let copy = ui.boxOfHash(subIdOf("menu", 1))!;
    let delete = ui.boxOfHash(subIdOf("menu", 2))!;
    // The disabled item is not chosen, and the menu stays open.
    platform.pointerState = Pointer.at(Vec2 { x: copy.x + 4.0, y: copy.y + 4.0 });
    platform.pointerState.down = true;
    platform.pointerState.pressed = true;
    Check.isTrue(menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)? is null, "a disabled item is not chosen")?;
    platform.pointerState = Pointer.at(Vec2 { x: copy.x + 4.0, y: copy.y + 4.0 });
    platform.pointerState.released = true;
    Check.isTrue(menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)? is null, "nor when released on")?;
    Check.isTrue(open, "and the menu stays")?;
    // The destructive item is chosen, and the menu closes.
    platform.pointerState = Pointer.at(Vec2 { x: delete.x + 4.0, y: delete.y + 4.0 });
    platform.pointerState.down = true;
    platform.pointerState.pressed = true;
    Check.isTrue(menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)? is null, "the press alone chooses nothing")?;
    platform.pointerState = Pointer.at(Vec2 { x: delete.x + 4.0, y: delete.y + 4.0 });
    platform.pointerState.released = true;
    match (menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?) {
        Some(k) => { Check.equalU64(2, k as u64)?; }
        null => { return Check.isTrue(false, "Delete is chosen"); }
    }
    Check.isTrue(!open, "a choice closes it")?;
    // A press outside closes it.
    open = true;
    platform.pointerState = Pointer.at(Vec2 { x: 390.0, y: 290.0 });
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    platform.pointerState.down = true;
    platform.pointerState.pressed = true;
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    Check.isTrue(!open, "a press outside closes it")?;
    // Escape closes it.
    open = true;
    platform.pointerState = Pointer.at(Vec2 { x: -1.0, y: -1.0 });
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    platform.pressed = 1u64 << (keyIndex(Key.Escape) as u64);
    let _ = menuFrame(mut ui, mut platform, mut open, 100.0, 60.0)?;
    platform.pressed = 0;
    Check.isTrue(!open, "Escape closes it")?;
    return Ok();
}

/// The id of item `k` of the menu `menu`, as Controls.menuItem makes it.
fn subIdOf(menu: StringView, k: usize) -> u32 => menuItemId(menu, k);

@test
fn aFitParentHoldsItsChildrensMargins() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(16));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    ui.begin(mut platform);
    ui.open(Style.column().id("fitColumn"));
    ui.open(Style.box().w(Size.fixed(50.0)).h(Size.fixed(10.0)));
    ui.close();
    ui.open(Style.box().w(Size.fixed(50.0)).h(Size.fixed(1.0)).my(4.0).mx(3.0));
    ui.close();
    ui.close();
    ui.open(Style.row().id("fitRow"));
    ui.open(Style.box().w(Size.fixed(20.0)).h(Size.fixed(10.0)).mx(5.0).my(2.0));
    ui.close();
    ui.close();
    finish(mut ui, mut platform)?;
    let column = ui.boxOf("fitColumn")!;
    Check.isTrue(column.h > 18.5 && column.h < 19.5, "the column holds its child's top and bottom margins: 10 + 1 + 8")?;
    Check.isTrue(column.w > 55.5 && column.w < 56.5, "and its left and right: 50 + 6")?;
    let row = ui.boxOf("fitRow")!;
    Check.isTrue(row.w > 29.5 && row.w < 30.5 && row.h > 13.5 && row.h < 14.5, "a row too: 20 + 10 by 10 + 4")?;
    return Ok();
}

@test
fn aPopupHoldsItsSeparators() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(32));
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    var open = true;
    for (frame in 0..3) {
        ui.begin(mut platform);
        ui.open(Style.box().w(Size.fixed(400.0)).h(Size.fixed(300.0)));
        if (Controls.popup(mut ui, "sep", mut open, 50.0, 20.0)) {
            ui.open(Style.column().id("sepItems").minW(120.0));
            let _ = Controls.menuItem(mut ui, "sep", 0, "One", true, false);
            Controls.menuSeparator(mut ui);
            let _ = Controls.menuItem(mut ui, "sep", 1, "Two", true, false);
            Controls.menuSeparator(mut ui);
            let _ = Controls.menuItem(mut ui, "sep", 2, "Three", true, true);
            ui.close();
            Controls.popupEnd(mut ui, "sep", mut open);
        }
        ui.close();
        finish(mut ui, mut platform)?;
    }
    let popup = ui.boxOf("sep")!;
    let column = ui.boxOf("sepItems")!;
    let last = ui.boxOfHash(menuItemId("sep", 2))!;
    Console.write("  popup ");
    Console.write(truncate<u64>(popup.y));
    Console.write("+");
    Console.write(truncate<u64>(popup.h));
    Console.write(" column +");
    Console.write(truncate<u64>(column.h));
    Console.write(" last ");
    Console.write(truncate<u64>(last.y));
    Console.write("+");
    Console.writeLine(truncate<u64>(last.h));
    Check.isTrue(last.y + last.h <= column.y + column.h + 0.5, "the column holds its last item")?;
    return Check.isTrue(column.y + column.h <= popup.y + popup.h + 0.5, "the popup holds its column");
}
