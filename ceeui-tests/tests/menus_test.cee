// Menus made of actions (menus.cee): an item's shortcut is its action's key binding, as the platform spells it, and
// a chosen item triggers its action as the binding would. The demo's menus and their actions.

import ceeui;
import ceeui_demo;

@test
fn aMenuShowsTheActionsBinding() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(16))!;
    Check.isTrue(ui.bind("secondary-shift-s", "save-as", ""), "binds")?;
    Check.isTrue(ui.bind("f5", "refresh", "editor"), "binds in a context")?;
    ui.setSecondaryIsCommand(true);
    let mac = ui.bindingFor("save-as")!;
    Check.isTrue(mac.character == 's' && mac.key == null, "the character")?;
    Check.isTrue(mac.modifiers.command && mac.modifiers.shift && !mac.modifiers.control, "Command on macOS")?;
    ui.setSecondaryIsCommand(false);
    let other = ui.bindingFor("save-as")!;
    Check.isTrue(other.modifiers.control && !other.modifiers.command, "Control elsewhere")?;
    Check.isTrue(ui.bindingFor("refresh") == null, "a binding in a key context is no menu shortcut")?;
    return Check.isTrue(ui.bindingFor("nothing") == null, "an action without a binding has none");
}

@test
fn aChosenItemTriggersItsAction() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(16))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    platform.chosen = hashId("save-as");
    ui.begin(mut platform);
    Check.isTrue(ui.action("save-as"), "the chosen item's action is triggered")?;
    finish(mut ui, mut platform)?;
    ui.begin(mut platform);
    Check.isTrue(!ui.action("save-as"), "once")?;
    finish(mut ui, mut platform)?;
    // A built-in action chosen from a menu is its edit command.
    platform.chosen = hashId("paste");
    ui.begin(mut platform);
    Check.isTrue(ui.commanded(EditCommand.Paste), "Edit > Paste pastes")?;
    return finish(mut ui, mut platform);
}

/// A MenuBuilder that counts what it is given and keeps the first menu's title and the last item's action.
struct Recorder {
    menus: u32;
    items: u32;
    separators: u32;
    firstMenu: u32;
    lastAction: u32;
}

impl MenuBuilder for Recorder {
    fn menu(borrow mut this, title: StringView) {
        if (this.menus == 0) {
            this.firstMenu = hashId(title);
        }
        this.menus += 1;
    }
    fn item(borrow mut this, title: StringView, action: StringView) {
        this.items += 1;
        this.lastAction = hashId(action);
    }
    fn separator(borrow mut this) {
        this.separators += 1;
    }
}

@test
fn theDemoDescribesItsMenus() -> Result<void, TestFailure> {
    var r = Recorder { menus: 0, items: 0, separators: 0, firstMenu: 0, lastAction: 0 };
    demoMenu(mut r);
    Check.equalU64(4, r.menus as u64)?;
    Check.equalU64(11, r.items as u64)?;
    Check.equalU64(2, r.separators as u64)?;
    Check.isTrue(r.firstMenu == hashId("File") && r.lastAction == hashId("open-inspector"), "File first")?;
    return Ok();
}

/// One demo frame on `platform`.
fn demoStep(ui: borrow mut Ui, platform: borrow mut FakePlatform, app: borrow mut DemoApp) -> Result<void, TestFailure> {
    let metrics = MetricMeasure { unused: 0 };
    ui.begin(mut platform);
    demoFrame(mut ui, mut app, metrics);
    return Check.isTrue(ui.endFrame(mut platform, metrics).isOk(), "the frame fits");
}

@test
fn theDemoAnswersItsMenus() -> Result<void, TestFailure> {
    var storage = heap(8388608);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(2048))!;
    var platform = platformAt(1024.0, 640.0, -1.0, -1.0);
    var app = DemoApp.create();
    demoStep(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.bindingFor("save-as") != null, "the demo binds its menus' actions")?;
    // View > Effects.
    platform.chosen = hashId("show-effects");
    demoStep(mut ui, mut platform, mut app)?;
    Check.equalU64(2, app.activeNav as u64)?;
    // File > Open… asks the host only when the host shows file dialogs.
    platform.chosen = hashId("open-file");
    demoStep(mut ui, mut platform, mut app)?;
    Check.isTrue(app.takeFileRequest() == null, "no dialogs, no request")?;
    app.setOpensFiles(true);
    platform.chosen = hashId("open-file");
    demoStep(mut ui, mut platform, mut app)?;
    let asked = match (app.takeFileRequest()) {
        Some(FileRequest.Open) => true,
        _ => false,
    };
    Check.isTrue(asked && app.takeFileRequest() == null, "Open… asks for a file, once")?;
    app.fileOpened("/tmp/notes/readme.txt".bytes(), 12345);
    demoStep(mut ui, mut platform, mut app)?;
    return Check.isTrue(ui.boxOf("sidebar") != null, "the sidebar shows the outcome");
}

/// A click at (x, y): a frame with the pointer there, one pressed, one released.
fn clickAt(ui: borrow mut Ui, platform: borrow mut FakePlatform, app: borrow mut DemoApp, x: f32, y: f32) -> Result<void, TestFailure> {
    platform.pointerState.position = Vec2 { x: x, y: y };
    demoStep(mut ui, mut platform, mut app)?;
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    demoStep(mut ui, mut platform, mut app)?;
    platform.pointerState.pressed = false;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    demoStep(mut ui, mut platform, mut app)?;
    platform.pointerState.released = false;
    return Ok();
}

@test
fn aDrawnMenuBarTriggersItsItems() -> Result<void, TestFailure> {
    var storage = heap(8388608);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(2048))!;
    var platform = platformAt(1024.0, 640.0, -1.0, -1.0);
    var app = DemoApp.create();
    app.setDrawsMenuBar(true);
    app.setOpensFiles(true);
    demoStep(mut ui, mut platform, mut app)?;
    demoStep(mut ui, mut platform, mut app)?;
    let bar = ui.boxOf("menubar")!;
    Check.isTrue(bar.w > 900.0 && bar.y < 1.0, "the bar spans the window's top")?;
    // File, then its first item, Open…: the action fires on the frame after the click.
    clickAt(mut ui, mut platform, mut app, bar.x + 30.0, bar.y + bar.h / 2.0)?;
    clickAt(mut ui, mut platform, mut app, bar.x + 40.0, bar.y + 52.0)?;
    demoStep(mut ui, mut platform, mut app)?;
    let asked = match (app.takeFileRequest()) {
        Some(FileRequest.Open) => true,
        _ => false,
    };
    Check.isTrue(asked, "File > Open… in the drawn bar asks the host for a file")?;
    // File open, a click on View opens View (moving over it switched to it, and the press keeps it open), and its
    // Effects item shows the Effects page.
    clickAt(mut ui, mut platform, mut app, bar.x + 30.0, bar.y + bar.h / 2.0)?;
    let file = ui.boxOf("menubar")!;
    clickAt(mut ui, mut platform, mut app, file.x + 160.0, file.y + file.h / 2.0)?;
    clickAt(mut ui, mut platform, mut app, file.x + 170.0, file.y + 52.0 + 30.0 * 2.0)?;
    demoStep(mut ui, mut platform, mut app)?;
    return Check.equalU64(2, app.activeNav as u64);
}
