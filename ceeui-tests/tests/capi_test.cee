// SPDX-License-Identifier: MIT
// ceeui-capi's recorded frames (frame.cee): a host's calls recorded into a Frame and replayed into a Ui, driven by a
// scripted platform. The host here is CeeSafe code making the calls a C frame function makes through ceeui.h.

import ceeui;
import ceeui_capi;

/// The host's state, as a C program keeps it.
struct Host {
    count: i32;
    dark: bool;
    /// What the controls' calls returned in the last frame.
    added: bool;
    flipped: bool;
    /// How many times the checkbox's call reported a change.
    flips: i32;
}

/// The host's frame function: a heading, a counter's button, a theme checkbox, and a panel it forgets to end.
fn hostFrame(f: borrow mut Frame, host: borrow mut Host) {
    f.heading("Counter".bytes());
    f.row(8.0);
    host.added = f.button("add".bytes(), "Add one".bytes());
    if (host.added) {
        host.count += 1;
    }
    host.flipped = f.checkbox("dark".bytes(), "Dark".bytes(), mut host.dark);
    if (host.flipped) {
        host.flips += 1;
    }
    f.end();
    f.panel();
    f.label("left open: replay closes it".bytes());
}

/// One frame: the host's calls recorded, replayed into the Ui, laid out; then the input's one-frame edges consumed.
fn frameOnce(ui: borrow mut Ui, platform: borrow mut FakePlatform, f: borrow mut Frame, host: borrow mut Host)
    -> Result<void, TestFailure> {
    f.begin(ui.isDarkMode());
    hostFrame(mut f, mut host);
    ui.begin(mut platform);
    ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()).p(space(4.0)).gap(space(3.0)));
    let metrics = FixedAdvance { unused: 0 };
    replay(mut ui, mut f, metrics);
    ui.close();
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    platform.clock += 1.0 / 60.0;
    return Check.isTrue(ok, "frame fits");
}

/// A press and release at the centre of `name`'s box, a frame each.
fn clickOn(ui: borrow mut Ui, platform: borrow mut FakePlatform, f: borrow mut Frame, host: borrow mut Host,
    name: StringView) -> Result<void, TestFailure> {
    let b = ui.boxOf(name)!;
    platform.pointerState.position = Vec2 { x: b.x + b.w / 2.0, y: b.y + b.h / 2.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    frameOnce(mut ui, mut platform, mut f, mut host)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    return frameOnce(mut ui, mut platform, mut f, mut host);
}

@test
fn capiFramesReplayAndReportControls() -> Result<void, TestFailure> {
    var storage = Vector<u8>.create();
    let _ = storage.resize(1048576, 0);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128))!;
    var platform = platformAt(800.0, 600.0, -1.0, -1.0);
    var f = Frame.create();
    var host = Host { count: 0, dark: false, added: false, flipped: false, flips: 0 };

    // The first frame lays the controls out; nothing was done with them yet.
    frameOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(ui.boxOf("add")!.w > 0.0 && ui.boxOf("dark")!.w > 0.0, "the host's controls are laid out")?;
    Check.isTrue(!host.added && !host.flipped && host.count == 0, "no control fired before any input")?;
    Check.isTrue(f.count() == 7 && !f.isFull(), "the frame recorded the host's seven calls")?;

    // A click on the button: the replay sees it, asks for a frame, and the host's next call returns true, once.
    clickOn(mut ui, mut platform, mut f, mut host, "add")?;
    Check.isTrue(ui.needsFrame(), "a control that fired asks for the next frame")?;
    frameOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(host.added && host.count == 1, "the button's call returned true in the next frame")?;
    Check.isTrue(ui.needsFrame(), "and that frame asks for one more, to show what the host changed")?;
    frameOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(!host.added && host.count == 1, "and only in that frame")?;

    // A click on the checkbox (which flips on the press): the host's bool takes the new state, and the call says it
    // changed, once.
    clickOn(mut ui, mut platform, mut f, mut host, "dark")?;
    frameOnce(mut ui, mut platform, mut f, mut host)?;
    frameOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(host.dark, "the checkbox set the host's bool")?;
    Check.isTrue(host.flips == 1, "the checkbox's call reported the change once")?;
    // And back.
    clickOn(mut ui, mut platform, mut f, mut host, "dark")?;
    frameOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(!host.dark && host.flips == 2, "a second click turns it off")?;
    return Ok();
}

/// A host with a text field over its own buffer, as a C program keeps it.
struct FieldHost {
    text: [u8; 8];
    length: usize;
    edits: i32;
    presses: i32;
}

fn capiFieldFrame(f: borrow mut Frame, host: borrow mut FieldHost) {
    if (f.textField("name".bytes(), "Name".bytes(), mut host.text[..], mut host.length)) {
        host.edits += 1;
    }
    if (f.button("go".bytes(), "Go".bytes())) {
        host.presses += 1;
    }
}

/// One frame of the field host, with what the fake platform was given this frame (keys typed, a key pressed).
fn capiFieldOnce(ui: borrow mut Ui, platform: borrow mut FakePlatform, f: borrow mut Frame, host: borrow mut FieldHost)
    -> Result<void, TestFailure> {
    f.begin(ui.isDarkMode());
    capiFieldFrame(mut f, mut host);
    ui.begin(mut platform);
    ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()).p(space(4.0)));
    let metrics = FixedAdvance { unused: 0 };
    replay(mut ui, mut f, metrics);
    ui.close();
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    platform.pressed = 0;
    platform.typedCount = 0;
    platform.typedRead = 0;
    platform.clock += 1.0 / 60.0;
    return Check.isTrue(ok, "frame fits");
}

@test
fn capiTextFieldEditsTheHostsBuffer() -> Result<void, TestFailure> {
    var storage = Vector<u8>.create();
    let _ = storage.resize(1048576, 0);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(800.0, 600.0, -1.0, -1.0);
    var f = Frame.create();
    var host = FieldHost { text: [0u8; 8], length: 2, edits: 0, presses: 0 };
    host.text[0] = 72; // "Hi"
    host.text[1] = 105;

    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(ui.boxOf("name")!.w > 0.0, "the field is laid out")?;
    Check.isTrue(host.edits == 0 && host.length == 2, "the host's text is untouched before any input")?;

    // Focus the field with a click, then type: the host's next call takes the text into its buffer, once.
    let b = ui.boxOf("name")!;
    platform.pointerState.position = Vec2 { x: b.x + b.w - 4.0, y: b.y + b.h / 2.0 };
    // Pressed and released within one frame, as a quick click often is.
    platform.pointerState.pressed = true;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    platform.typed[0] = 33; // "!"
    platform.typedCount = 1;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(ui.needsFrame(), "an edited field asks for the next frame")?;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(host.length == 3 && host.text[..3] == "Hi!".bytes(), "the typed text reached the host's buffer")?;
    Check.isTrue(host.edits == 1, "the call reported the change once")?;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(host.edits == 1, "and only in that frame")?;

    // The host changes its buffer itself: the field shows the host's text, and the call does not call it an edit.
    host.text[0] = 79; // "O"
    host.length = 1;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(host.length == 1 && host.text[0] == 79 && host.edits == 1, "the host's own change stands")?;

    // Typing past the buffer (8 bytes): the text is cut at a character to fit; a two-byte character that would not
    // fit whole is left out.
    platform.pressed = 1u64 << (keyIndex(Key.End) as u64);
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    let more: [u32; 7] = [97, 98, 99, 100, 101, 102, 233]; // "abcdef" and é (two bytes)
    for (i in 0..7) {
        platform.typed[i] = more[i];
    }
    platform.typedCount = 7;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(host.length == 7 && host.text[..7] == "Oabcdef".bytes(), "cut at a character to fit the buffer")?;

    // With the field focused and just edited, one click on a button presses it (and takes the focus from the field).
    platform.pressed = 1u64 << (keyIndex(Key.Backspace) as u64);
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    let g = ui.boxOf("go")!;
    platform.pointerState.position = Vec2 { x: g.x + g.w / 2.0, y: g.y + g.h / 2.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    capiFieldOnce(mut ui, mut platform, mut f, mut host)?;
    Check.isTrue(host.presses == 1, "one click on the button after typing presses it")?;
    return Ok();
}
