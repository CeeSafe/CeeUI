// ceeui-fonts: fallback fonts found among the system's own. Skipped where Arial is missing.

import ceeui;
import ceeui_fonts;

@test
fn systemFontsSupplyWhatTheLoadedOnesLack() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(100, 40);
    c.imagePixels = 4;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    Check.isTrue(!ras.covers(0, 0x4E2D), "Arial alone has no 中")?;
    var fonts = SystemFonts.create();
    // Latin needs nothing, and nothing is scanned for it.
    Check.equalU64(0, fonts.supply(mut ras, "Hello".bytes(), 0) as u64)?;
    Check.equalU64(0, fonts.faceCount() as u64)?;
    let added = fonts.supply(mut ras, "中文".bytes(), 0);
    Check.isTrue(fonts.faceCount() > 0, "the catalog is built once a character is missing")?;
    Check.equalU64(1, added as u64)?;
    Check.isTrue(ras.covers(0, 0x4E2D) && ras.covers(0, 0x6587), "中 and 文 now come from a system font")?;
    // Asked again, nothing more is loaded; a private-use character is never looked for.
    Check.equalU64(0, fonts.supply(mut ras, "中文\u{E000}".bytes(), 0) as u64)?;
    return Check.isTrue(!ras.covers(0, 0xE000), "private use stays the missing-glyph box");
}

@test
fn emojiComeInColourFromTheSystemsEmojiFont() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(120, 60);
    c.imagePixels = 262144;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var fonts = SystemFonts.create();
    let text = "a\u{1F600}";
    let loaded = fonts.supply(mut ras, text.bytes(), 0);
    if (!ras.covers(0, 0x1F600)) {
        Console.writeLine("  (no emoji font on this system: skipped)");
        return Ok();
    }
    Check.equalU64(1, loaded as u64)?;
    // Its bitmap is read from the font's file once the frame needs it, and only once.
    Check.equalU64(1, fonts.supplyBitmaps(mut ras, text.bytes(), 0, 40.0, 0.0) as u64)?;
    Check.equalU64(0, fonts.supplyBitmaps(mut ras, text.bytes(), 0, 40.0, 0.0) as u64)?;
    let run = TextRun {
        start: 0,
        length: text.length,
        color: Color.hex(0x000000ff),
        fontId: 0,
        fontSize: 40.0,
        letterSpacing: 0.0,
        lineHeight: 0.0,
    };
    ras.begin(Color.rgba(255, 255, 255, 255));
    ras.draw(Command.Text(Rect { x: 4.0, y: 4.0, w: 110.0, h: 52.0 }, run), text.bytes());
    ras.finish();
    // The smiling face is yellow: some pixel is strongly yellow, which black text never is.
    var yellow = 0;
    for (y in 0usize..60) {
        for (x in 0usize..120) {
            let p = ras.pixelAt(x, y);
            if (p.r > 200 && p.g > 150 && p.b < 90) {
                yellow += 1;
            }
        }
    }
    return Check.isTrue(yellow > 50, "the emoji is drawn in its own colours");
}

@test
fn emojiSequencesBecomeOneGlyph() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(120, 60);
    c.imagePixels = 262144;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var fonts = SystemFonts.create();
    let loaded = fonts.supply(mut ras, "\u{1F600}".bytes(), 0);
    if (!ras.coversInColor(0, 0x1F600)) {
        Console.writeLine("  (no colour emoji font on this system: skipped)");
        return Ok();
    }
    // A skin tone, a flag, a ZWJ family, a keycap and a red heart (VS16): each one colour glyph.
    let sequences: [StringView; 5] = [
        "\u{1F44D}\u{1F3FD}",
        "\u{1F1EF}\u{1F1F5}",
        "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}",
        "1\u{FE0F}\u{20E3}",
        "\u{2764}\u{FE0F}",
    ];
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0, advance: 0.0 }; 8];
    for (k in 0usize..5) {
        let text = sequences[k];
        let more = fonts.supply(mut ras, text.bytes(), 0);
        let run = ras.shapeRun(text.bytes(), 0, 40.0, 0.0, mut out[..])!;
        if (run.count != 1) {
            Console.write("  sequence ");
            Console.write(k as u64);
            Console.write(" shaped to ");
            Console.write(run.count as u64);
            Console.writeLine(" glyphs");
        }
        Check.equalU64(1, run.count as u64)?;
        Check.isTrue(ras.isBitmapFont(out[0].font) || ras.isColrGlyph(out[0].font, out[0].glyph), "in colour")?;
    }
    return Ok();
}

@test
fn colourGlyphsMakeRoomForNewOnes() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(64, 64);
    // Room for the program's image and only a few emoji at a time.
    c.imagePixels = 2048;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    Check.isTrue(ras.addImage(5, 4, 4), "the program's image fits")?;
    for (y in 0usize..4) {
        for (x in 0usize..4) {
            ras.setImagePixel(5, x, y, 0x11223344);
        }
    }
    var fonts = SystemFonts.create();
    let loaded = fonts.supply(mut ras, "\u{1F600}".bytes(), 0);
    if (!ras.coversInColor(0, 0x1F600)) {
        Console.writeLine("  (no colour emoji font on this system: skipped)");
        return Ok();
    }
    // Twelve emoji, one after another: they cannot all be kept, so older ones go.
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0, advance: 0.0 }; 2];
    for (k in 0u32..12) {
        var bytes = [0u8; 4];
        let n = encodeUtf8(0x1F600 + k, mut bytes);
        let supplied = fonts.supplyBitmaps(mut ras, bytes[0..n], 0, 20.0, 0.0);
        let run = ras.shapeRun(bytes[0..n], 0, 20.0, 0.0, mut out[..])!;
        Check.isTrue(ras.colorBitmap(out[0].font, out[0].glyph, 20.0, 1.0) != null, "the newest emoji is there")?;
    }
    // The program's image kept its pixels through the clearing.
    let pixels = ras.imagePixels(5)!;
    var same = pixels.length == 16;
    for (p in pixels) {
        same = same && p == 0x11223344;
    }
    return Check.isTrue(same, "the program's image is untouched");
}

@test
fn aHeartWithItsSelectorIsAsWideAsAnyEmoji() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(120, 60);
    c.imagePixels = 262144;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var fonts = SystemFonts.create();
    let _ = fonts.supply(mut ras, "\u{1F600}".bytes(), 0);
    if (!ras.coversInColor(0, 0x1F600)) {
        Console.writeLine("  (no colour emoji font on this system: skipped)");
        return Ok();
    }
    // Marivil's reactions: the heart alone carries VS16, and was drawn in a button three times as wide.
    let reactions: [StringView; 6] = ["\u{1F44D}", "\u{2764}\u{FE0F}", "\u{1F602}", "\u{1F62E}", "\u{1F622}", "\u{1F64F}"];
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0, advance: 0.0 }; 8];
    var widths = [0.0f32; 6];
    for (k in 0usize..6) {
        let _ = fonts.supply(mut ras, reactions[k].bytes(), 0);
        let m = ras.measure(reactions[k].bytes(), TextConfig.of(16.0));
        widths[k] = m.w;
        let run = ras.shapeRun(reactions[k].bytes(), 0, 16.0, 0.0, mut out[..])!;
        Console.write("  reaction ");
        Console.write(k as u64);
        Console.write(" measures ");
        Console.write(truncate<u64>(m.w * 100.0));
        Console.write("/100, glyphs ");
        Console.writeLine(run.count as u64);
    }
    for (k in 0usize..6) {
        Check.isTrue(widths[k] > widths[0] * 0.8 && widths[k] < widths[0] * 1.25, "as wide as a thumbs-up")?;
    }
    return Ok();
}

@test
fn aHeartButtonIsAsWideAsTheOthers() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(400, 100);
    c.imagePixels = 262144;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var fonts = SystemFonts.create();
    let reactions: [StringView; 6] = ["\u{1F44D}", "\u{2764}\u{FE0F}", "\u{1F602}", "\u{1F62E}", "\u{1F622}", "\u{1F64F}"];
    for (k in 0usize..6) {
        let _ = fonts.supply(mut ras, reactions[k].bytes(), 0);
    }
    if (!ras.coversInColor(0, 0x1F600)) {
        Console.writeLine("  (no colour emoji font on this system: skipped)");
        return Ok();
    }
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(400.0, 100.0, -1.0, -1.0);
    let names: [StringView; 6] = ["rx0", "rx1", "rx2", "rx3", "rx4", "rx5"];
    ui.begin(mut platform);
    ui.open(Style.row().w(Size.fixed(400.0)).gap(4.0));
    for (k in 0usize..6) {
        let _ = Controls.button(mut ui, names[k], reactions[k]);
    }
    ui.close();
    Check.isTrue(ui.endFrame(mut platform, ras) is Ok(_), "frame fits")?;
    let thumb = ui.boxOf("rx0")!.w;
    for (k in 0usize..6) {
        let w = ui.boxOf(names[k])!.w;
        Console.write("  button ");
        Console.write(k as u64);
        Console.write(" is ");
        Console.writeLine(truncate<u64>(w));
        Check.isTrue(w > thumb * 0.8 && w < thumb * 1.25, "as wide as the thumbs-up's")?;
    }
    return Ok();
}

/// Marivil's action bar for a text message with a link, at the Moto's width: the reactions, then its words.
fn actionBarFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform, ras: borrow Raster) -> Result<void, TestFailure> {
    let reactions: [StringView; 6] = ["\u{1F44D}", "\u{2764}\u{FE0F}", "\u{1F602}", "\u{1F62E}", "\u{1F622}", "\u{1F64F}"];
    let names: [StringView; 6] = ["rx0", "rx1", "rx2", "rx3", "rx4", "rx5"];
    ui.begin(mut platform);
    ui.open(Style.column().w(Size.fixed(411.0)).h(Size.fixed(300.0)));
    ui.open(Style.row().id("actions").w(Size.grow()).px(space(3.0)).pt(space(3.0)).gap(space(2.0)).wrap()
        .alignXY(AxisAlign.Start, AxisAlign.Center));
    for (k in 0usize..6) {
        let _ = Controls.button(mut ui, names[k], reactions[k]);
    }
    let _ = Controls.button(mut ui, "reply", "Reply");
    let _ = Controls.button(mut ui, "star", "Star");
    let _ = Controls.button(mut ui, "share", "Share");
    let _ = Controls.button(mut ui, "openLink", "Open link");
    let _ = Controls.button(mut ui, "forward", "Forward");
    let _ = Controls.button(mut ui, "deleteMine", "Delete for me");
    let _ = Controls.button(mut ui, "letGo", "Close");
    ui.close();
    ui.close();
    return Check.isTrue(ui.endFrame(mut platform, ras) is Ok(_), "frame fits");
}

@test
fn aWrappedRowGivesEachButtonItsOwnWidth() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(411, 300);
    c.imagePixels = 262144;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var fonts = SystemFonts.create();
    let _ = fonts.supply(mut ras, "\u{1F44D}\u{2764}\u{FE0F}\u{1F602}\u{1F62E}\u{1F622}\u{1F64F}".bytes(), 0);
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(411.0, 300.0, -1.0, -1.0);
    actionBarFrame(mut ui, mut platform, ras)?;
    actionBarFrame(mut ui, mut platform, ras)?;
    let names: [StringView; 8] = ["rx0", "rx1", "rx2", "rx3", "rx4", "rx5", "reply", "openLink"];
    for (k in 0usize..8) {
        let b = ui.boxOf(names[k])!;
        Console.write("  ");
        Console.write(names[k]);
        Console.write(" x ");
        Console.write(truncate<u64>(b.x));
        Console.write(" y ");
        Console.write(truncate<u64>(b.y));
        Console.write(" w ");
        Console.writeLine(truncate<u64>(b.w));
    }
    let thumb = ui.boxOf("rx0")!.w;
    Check.isTrue(ui.boxOf("rx1")!.w < thumb * 1.25, "the heart's button is as wide as the thumbs-up's")?;
    return Ok();
}

@test
fn androidsFontsGiveTheHeartAnEmojisWidth() -> Result<void, TestFailure> {
    // Android's own fonts (DroidSans.ttf, NotoColorEmoji.ttf from /system/fonts), from CEEUI_ANDROID_FONTS.
    let dir = match (Environment.variable("CEEUI_ANDROID_FONTS")) {
        Some(d) => d,
        null => {
            Console.writeLine("  (CEEUI_ANDROID_FONTS not set: skipped)");
            return Ok();
        }
    };
    var droidPath = String.create();
    let _ = droidPath.append(dir);
    let _ = droidPath.append("/DroidSans.ttf");
    var emojiPath = String.create();
    let _ = emojiPath.append(dir);
    let _ = emojiPath.append("/NotoColorEmoji.ttf");
    let droid = readFile(droidPath.view());
    let emoji = readFile(emojiPath.view());
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(411, 300);
    c.imagePixels = 2097152;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c);
    Check.isTrue(ras.loadFont(0, droid.view()) && ras.loadFont(5, emoji.view()) && ras.addFallback(5), "fonts load")?;
    let reactions: [StringView; 6] = ["\u{1F44D}", "\u{2764}\u{FE0F}", "\u{1F602}", "\u{1F62E}", "\u{1F622}", "\u{1F64F}"];
    for (k in 0usize..6) {
        let m = ras.measure(reactions[k].bytes(), TextConfig.of(22.0));
        Console.write("  measure ");
        Console.write(k as u64);
        Console.write(" = ");
        Console.writeLine(truncate<u64>(m.w * 100.0));
    }
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(411.0, 300.0, -1.0, -1.0);
    let names: [StringView; 6] = ["rx0", "rx1", "rx2", "rx3", "rx4", "rx5"];
    for (frame in 0..2) {
        ui.begin(mut platform);
        ui.open(Style.row().gap(4.0));
        for (k in 0usize..6) {
            ui.open(Style.box().id(names[k]).px(8.0).py(4.0));
            ui.label(reactions[k], Text.of().size(22.0));
            ui.close();
        }
        ui.close();
        Check.isTrue(ui.endFrame(mut platform, ras) is Ok(_), "frame fits")?;
    }
    for (k in 0usize..6) {
        Console.write("  cell ");
        Console.write(k as u64);
        Console.write(" w ");
        Console.writeLine(truncate<u64>(ui.boxOf(names[k])!.w));
    }
    let thumb = ui.boxOf("rx0")!.w;
    return Check.isTrue(ui.boxOf("rx1")!.w < thumb * 1.25, "the heart's cell is as wide as the thumbs-up's");
}

@test
fn lineBreaksMarkNothingInsideACharacterOfReusedMarks() -> Result<void, TestFailure> {
    // The marks hold what an earlier text left (a break at every byte); a heart with VS16 (six bytes) has its only
    // break at its end, which has no entry: none inside, at bytes 1 to 5.
    var marks = [BREAK_ALLOWED; 16];
    var scratch = [0u32; 64];
    let heart = "\u{2764}\u{FE0F}";
    Check.isTrue(lineBreaks(heart.bytes(), mut marks[..], mut scratch[..]), "it fits")?;
    for (k in 0usize..6) {
        Check.isTrue(marks[k] == BREAK_NONE, "no break inside the heart")?;
    }
    return Ok();
}
