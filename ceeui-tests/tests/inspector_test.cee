// SPDX-License-Identifier: MIT
// The layout inspector (Ui.setInspecting): the element under the pointer described from the last frame, an overlay
// that the pointer passes through, and nothing at all while it is off.

import ceeui;

fn inspectFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform) -> Result<void, TestFailure> {
    ui.begin(mut platform);
    ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()).p(space(4.0)).gap(space(2.0)));
    ui.open(
        Style.row().id("card").w(Size.fixed(200.0)).h(Size.fixed(80.0)).p(space(3.0)).bg(SLATE_800).rounded(Radius.Md),
    );
    ui.label("Hello", Text.of().size(16.0));
    ui.close();
    ui.close();
    return finish(mut ui, mut platform);
}

@test
fn theInspectorDescribesTheElementUnderThePointer() -> Result<void, TestFailure> {
    var storage = heap(2097152);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(128))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    inspectFrame(mut ui, mut platform)?;
    let card = ui.boxOf("card")!;
    // Off, it adds nothing: the frame has the same commands with the pointer over the card.
    platform.pointerState.position = Vec2 { x: card.x + 150.0, y: card.y + 60.0 };
    inspectFrame(mut ui, mut platform)?;
    let plain = ui.commandCount();
    Check.isTrue(ui.inspectedElement() == null, "nothing inspected while it is off")?;
    ui.setInspecting(true);
    inspectFrame(mut ui, mut platform)?;
    inspectFrame(mut ui, mut platform)?;
    let info = ui.inspectedElement()!;
    Check.equalU64(hashId("card") as u64, info.id as u64)?;
    Check.isTrue(!info.isText && !info.column && info.children == 1, "a row with one child")?;
    Check.isTrue(info.width.kind == SizingKind.Fixed && info.width.min == 200.0, "fixed 200 wide")?;
    Check.isTrue(info.padding.left == 12.0 && info.radius > 0.0 && info.background.a == 255, "its look")?;
    Check.isTrue(ui.commandCount() > plain, "the overlay is drawn")?;
    // The overlay lies over the card, yet the pointer is still over the card, not the overlay.
    Check.isTrue(ui.overHash(hashId("card")), "the card is under the pointer")?;
    Check.isTrue(!ui.overHash(INSPECTOR_ID), "the overlay is not")?;
    // Over the label, the label: its text and size.
    platform.pointerState.position = Vec2 { x: card.x + 16.0, y: card.y + 20.0 };
    inspectFrame(mut ui, mut platform)?;
    inspectFrame(mut ui, mut platform)?;
    let text = ui.inspectedElement()!;
    Check.isTrue(text.isText && text.fontSize == 16.0 && text.textLength == 5 && text.text[0] == 'H', "the label")?;
    // Its shortcut turns it off.
    ui.setInspecting(false);
    inspectFrame(mut ui, mut platform)?;
    return Check.equalU64(plain as u64, ui.commandCount() as u64);
}
