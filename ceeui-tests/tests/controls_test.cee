// SPDX-License-Identifier: MIT
// The controls driven by a scripted platform, ported from tests/platform_test.c: a button, a text field with a
// caret, a slider and a spin input, frame by frame, asserting the caller-owned state.

import ceeui;

/// The C test's fixed-advance "font": 0.6 em per glyph, as tall as the font size, baseline at 0.8 em.
struct FixedAdvance {
    unused: u8;
}

impl TextMetrics for FixedAdvance {
    fn measure(borrow this, utf8: Slice<u8>, config: TextConfig) -> Dims => Dims {
        w: 0.6 * config.fontSize * round<f32>(utf8.length),
        h: config.fontSize,
    };
    fn baseline(borrow this, config: TextConfig) -> f32 => 0.8 * config.fontSize;
}

/// The caller-owned state the controls edit.
struct App {
    saveHit: bool;
    name: [u8; 32];
    nameLen: usize;
    nameCaret: usize;
    volume: f32;
    qty: i32;
}

fn showcase(ui: borrow mut Ui, app: borrow mut App) {
    let metrics = FixedAdvance { unused: 0 };
    ui.open(Style.column().id("root").w(Size.grow()).h(Size.grow()).p(space(4.0)).gap(space(3.0)));
    app.saveHit = Controls.button(mut ui, "save", "Save");
    Controls.textInputEx(mut ui, metrics, "name", mut app.name[..], mut app.nameLen, mut app.nameCaret);
    Controls.slider(mut ui, "vol", mut app.volume, 0.0, 1.0, 200.0);
    Controls.spinInput(mut ui, "qty", mut app.qty, 0, 10, 1);
    ui.close();
}

/// One frame, then the one-frame input edges are consumed (as the C test's frame()).
fn step(ui: borrow mut Ui, platform: borrow mut FakePlatform, app: borrow mut App) -> Result<void, TestFailure> {
    ui.begin(mut platform);
    showcase(mut ui, mut app);
    let metrics = FixedAdvance { unused: 0 };
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    platform.pressed = 0;
    platform.typedCount = 0;
    platform.typedRead = 0;
    platform.clock += 1.0 / 60.0;
    return Check.isTrue(ok, "frame fits");
}

fn press(platform: borrow mut FakePlatform, k: Key) {
    platform.pressed = 1u64 << (keyIndex(k) as u64);
}

fn typeChars(platform: borrow mut FakePlatform, text: StringView) {
    let b = text.bytes();
    for (i in 0..b.length) {
        platform.typed[i] = b[i] as u32;
    }
    platform.typedCount = b.length;
}

/// Types code points (any, as a keyboard or an input method delivers them).
fn typeCodepoints(platform: borrow mut FakePlatform, cps: Slice<u32>) {
    for (i in 0..cps.length) {
        platform.typed[i] = cps[i];
    }
    platform.typedCount = cps.length;
}

fn centerOf(ui: borrow Ui, name: StringView) -> Vec2 {
    let b = ui.boxOf(name)!;
    return Vec2 { x: b.x + b.w / 2.0, y: b.y + b.h / 2.0 };
}

fn heightOf(ui: borrow Ui, name: StringView) -> f32 => ui.boxOf(name)!.h;

fn nameIs(app: borrow App, want: StringView) -> bool {
    let w = want.bytes();
    if (app.nameLen != w.length) {
        return false;
    }
    for (i in 0..w.length) {
        if (app.name[i] != w[i]) {
            return false;
        }
    }
    return true;
}

fn isCursor(c: Cursor, pointer: bool) -> bool => match (c) {
    Cursor.Pointer => pointer,
    Cursor.Default => !pointer,
    Cursor.Text => false,
};

fn click(ui: borrow mut Ui, platform: borrow mut FakePlatform, app: borrow mut App) -> Result<void, TestFailure> {
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    step(mut ui, mut platform, mut app)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    return step(mut ui, mut platform, mut app);
}

@test
fn controlsDrivenByAScriptedPlatform() -> Result<void, TestFailure> {
    var storage = [0u8; 1048576];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(800.0, 600.0, -1.0, -1.0);
    var app = App { saveHit: false, name: [0u8; 32], nameLen: 0, nameCaret: 0, volume: 0.25, qty: 3 };

    // Frame 1 lays out so element boxes exist.
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.boxOf("save")!.w > 0.0 && ui.boxOf("name")!.w > 0.0, "controls laid out")?;
    let emptyHeight = heightOf(ui, "name");
    Check.isTrue(isCursor(platform.cursor, false), "cursor reset to default each frame")?;

    // Hover the button: the pointer cursor is requested; nothing is clicked yet.
    platform.pointerState.position = centerOf(ui, "save");
    step(mut ui, mut platform, mut app)?;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(isCursor(platform.cursor, true), "hovering a cursor-pointer element sets the pointer cursor")?;
    Check.isTrue(!app.saveHit, "button not hit without a click")?;

    // Click the button: it acts when the pointer comes back up over it, as a native button does.
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(!app.saveHit, "the press alone does not act")?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(app.saveHit, "the button reports the click")?;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(!app.saveHit, "a button hit is a one-frame event")?;
    // A press dragged off the button before it comes up does nothing.
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    step(mut ui, mut platform, mut app)?;
    platform.pointerState.position = Vec2 { x: 790.0, y: 590.0 };
    step(mut ui, mut platform, mut app)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(!app.saveHit, "a press dragged off the button is no click")?;

    // Click into the text field, type, edit at the caret.
    platform.pointerState.position = centerOf(ui, "name");
    step(mut ui, mut platform, mut app)?;
    click(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("name"), "clicking the text field focuses it")?;
    typeChars(mut platform, "Hi");
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(nameIs(app, "Hi") && app.nameCaret == 2, "typed text lands in the caller's buffer")?;
    step(mut ui, mut platform, mut app)?;
    expect("an empty field keeps its one-line height", heightOf(ui, "name"), emptyHeight)?;
    press(mut platform, Key.Left);
    step(mut ui, mut platform, mut app)?;
    typeChars(mut platform, "-");
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(nameIs(app, "H-i") && app.nameCaret == 2, "insert at the caret after Left")?;
    press(mut platform, Key.Backspace);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(nameIs(app, "Hi") && app.nameCaret == 1, "backspace at the caret")?;
    // Any character goes in as UTF-8; Backspace, Left and Delete take whole grapheme clusters.
    press(mut platform, Key.End);
    step(mut ui, mut platform, mut app)?;
    let typed = [0x65u32, 0x301, 0x4E2D];
    typeCodepoints(mut platform, typed[..]);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(nameIs(app, "Hie\u{301}中") && app.nameCaret == 8, "e, a combining acute and 中 as UTF-8")?;
    press(mut platform, Key.Backspace);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(nameIs(app, "Hie\u{301}") && app.nameCaret == 5, "Backspace takes 中's three bytes")?;
    press(mut platform, Key.Left);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(app.nameCaret == 2, "Left steps over e and its accent together")?;
    press(mut platform, Key.Delete);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(nameIs(app, "Hi") && app.nameCaret == 2, "Delete takes the accented e whole")?;
    press(mut platform, Key.Enter);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(!ui.hasFocusNamed("name"), "Enter clears focus")?;

    // Tab cycling: the first Tab focuses the first registered focusable (the Save button), the next the text field.
    press(mut platform, Key.Tab);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("save"), "Tab focuses the first focusable control, the button")?;
    press(mut platform, Key.Tab);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("name"), "Tab moves to the text field")?;
    press(mut platform, Key.Tab);
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("qty"), "Tab moves to the next control (the spin input)")?;
    press(mut platform, Key.Up);
    step(mut ui, mut platform, mut app)?;
    Check.equalU64(4, truncate<u64>(app.qty))?;
    platform.down = 1u64 << (keyIndex(Key.LeftShift) as u64);
    press(mut platform, Key.Tab);
    step(mut ui, mut platform, mut app)?;
    platform.down = 0;
    Check.isTrue(ui.hasFocusNamed("name"), "Shift-Tab moves focus back")?;

    // Slider drag: press on the track at 75% and the value follows the pointer while held.
    let vb = ui.boxOf("vol")!;
    platform.pointerState.position = Vec2 { x: vb.x + vb.w * 0.75, y: vb.y + vb.h / 2.0 };
    step(mut ui, mut platform, mut app)?;
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(app.volume > 0.7 && app.volume < 0.8, "the slider follows the pointer")?;
    platform.pointerState.position.x = vb.x + vb.w * 0.5;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(app.volume > 0.45 && app.volume < 0.55, "the slider keeps capturing while held")?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    step(mut ui, mut platform, mut app)?;
    platform.pointerState.position.x = vb.x;
    step(mut ui, mut platform, mut app)?;
    Check.isTrue(app.volume > 0.45 && app.volume < 0.55, "the slider releases capture on release")?;

    // The spin input's + button.
    platform.pointerState.position = centerOf(ui, "qty~inc");
    step(mut ui, mut platform, mut app)?;
    click(mut ui, mut platform, mut app)?;
    Check.equalU64(5, truncate<u64>(app.qty))?;

    // Caret measurement goes through the metrics the frame uses.
    let m = FixedAdvance { unused: 0 };
    let hello = "Hello";
    expect("fixed-advance width", m.measure(hello.bytes(), TextConfig.of(20.0)).w, 60.0)?;
    return Ok();
}

@test
fn choiceControlsSelectAndClose() -> Result<void, TestFailure> {
    var storage = [0u8; 1048576];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(128));
    var p = platformAt(800.0, 600.0, -1.0, -1.0);
    let metrics = FixedAdvance { unused: 0 };
    let sizes: [StringView; 3] = ["Small", "Medium", "Large"];
    let tabNames: [StringView; 3] = ["One", "Two", "Three"];
    var picked: usize = 0;
    var open = false;
    var tab: usize = 0;
    var radioPick: usize = 0;
    var checked = false;
    for (frame in 0..12) {
        ui.begin(mut p);
        ui.open(Style.column().id("root").w(Size.grow()).h(Size.grow()).p(16.0).gap(12.0));
        Controls.tabs(mut ui, "tabs", tabNames[..], mut tab);
        Controls.checkbox(mut ui, "chk", "Check me", mut checked);
        Controls.radio(mut ui, "rad", sizes[..], mut radioPick);
        ui.open(Style.box().id("dd-wrap").w(Size.fixed(200.0)));
        Controls.dropdown(mut ui, "dd", sizes[..], mut picked, mut open);
        ui.close();
        ui.close();
        let ok = match (ui.endFrame(mut p, metrics)) {
            Ok() => true,
            Err(_) => false,
        };
        Check.isTrue(ok, "frame fits")?;
        p.pointerState.pressed = false;
        // Script: click the second tab, the checkbox, the third radio, open the dropdown, pick "Large".
        let target: StringView = match (frame) {
            1 => "tabs~1",
            3 => "chk",
            5 => "rad~2",
            7 => "dd",
            9 => "dd~2",
            _ => "",
        };
        if (target.length > 0) {
            p.pointerState.position = centerOf(ui, target);
            p.pointerState.pressed = true;
        }
    }
    Check.equalU64(1, tab as u64)?;
    Check.isTrue(checked, "the checkbox toggled")?;
    Check.equalU64(2, radioPick as u64)?;
    Check.equalU64(2, picked as u64)?;
    return Check.isTrue(!open, "choosing an item closes the dropdown");
}

/// One frame of a dropdown with a clickable row right below it, which its open list covers (an invoice list under
/// its search's type, in the IPos port); whether the row was clicked.
fn dropdownOverRow(
    ui: borrow mut Ui,
    p: borrow mut FakePlatform,
    picked: borrow mut usize,
    open: borrow mut bool,
) -> Result<bool, TestFailure> {
    let metrics = FixedAdvance { unused: 0 };
    let kinds: [StringView; 2] = ["Sales Invoice", "Sales Return"];
    ui.begin(mut p);
    ui.open(Style.column().id("root").w(Size.grow()).h(Size.grow()).p(16.0).gap(12.0));
    ui.open(Style.box().id("dd-wrap").w(Size.grow()));
    Controls.dropdown(mut ui, "kind", kinds[..], mut picked, mut open);
    ui.close();
    ui.open(Style.column().id("list").w(Size.grow()).h(Size.grow()).scroll(ScrollAxis.Vertical));
    ui.open(Style.box().id("row").w(Size.grow()).h(Size.fixed(60.0)));
    let hit = ui.clicked("row");
    let _ = ui.access(hashId("row"), AccessRole.ListItem, "Row".bytes());
    ui.close();
    ui.close();
    ui.close();
    let ok = match (ui.endFrame(mut p, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    p.pointerState.pressed = false;
    p.pointerState.released = false;
    p.clock += 1.0 / 60.0;
    Check.isTrue(ok, "frame fits")?;
    return Ok(hit);
}

/// An open dropdown's list takes the click on its item: the row it covers is not clicked, whichever comes first.
@test
fn anOpenDropdownTakesTheClickFromWhatItCovers() -> Result<void, TestFailure> {
    var storage = [0u8; 1048576];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(128));
    var p = platformAt(800.0, 600.0, -1.0, -1.0);
    var picked: usize = 0;
    var open = false;
    var rowHit = dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    // Open it: a press and a release on the trigger.
    p.pointerState.position = centerOf(ui, "kind");
    p.pointerState.pressed = true;
    p.pointerState.down = true;
    rowHit = rowHit || dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    p.pointerState.down = false;
    p.pointerState.released = true;
    rowHit = rowHit || dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    Check.isTrue(open, "the dropdown opened")?;
    // Its second item lies over the row.
    let item = centerOf(ui, "kind~1");
    let row = ui.boxOf("row")!;
    Check.isTrue(row.contains(item), "the item covers the row")?;
    // To a screen reader too: the item is read before the row, but is of a higher layer, so the point is its.
    var itemLayer: u32 = 0;
    var rowLayer: u32 = 99;
    var itemFirst = false;
    for (i in 0..ui.accessCount()) {
        let node = ui.accessAt(i);
        if (node.id == hashId("row")) {
            rowLayer = node.layer;
        }
        if (node.id == hashId("kind~1")) {
            itemLayer = node.layer;
            itemFirst = rowLayer == 99;
        }
    }
    Check.equalU64(0, rowLayer as u64)?;
    Check.isTrue(itemLayer > 0, "the open list's item is above the page")?;
    Check.isTrue(itemFirst, "the item is read before the row")?;
    p.pointerState.position = item;
    p.pointerState.pressed = true;
    p.pointerState.down = true;
    rowHit = rowHit || dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    p.pointerState.down = false;
    p.pointerState.released = true;
    rowHit = rowHit || dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    Check.equalU64(1, picked as u64)?;
    Check.isTrue(!open, "choosing an item closes the dropdown")?;
    Check.isTrue(!rowHit, "the row under the list is not clicked")?;
    // Again with each click's press and release in one frame, as a quick click (or a script's) reaches a host.
    picked = 0;
    p.pointerState.position = centerOf(ui, "kind");
    p.pointerState.pressed = true;
    p.pointerState.released = true;
    rowHit = dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    rowHit = rowHit || dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    Check.isTrue(open, "a quick click opens the dropdown")?;
    p.pointerState.position = centerOf(ui, "kind~1");
    p.pointerState.pressed = true;
    p.pointerState.released = true;
    rowHit = rowHit || dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    rowHit = rowHit || dropdownOverRow(mut ui, mut p, mut picked, mut open)?;
    Check.equalU64(1, picked as u64)?;
    Check.isTrue(!open, "a quick click on an item closes the dropdown")?;
    return Check.isTrue(!rowHit, "a quick click on the list does not reach the row");
}

/// A frame of the showcase in which a hit of Save focuses the name field again, as a chat's Send button keeps its
/// line; whether the name field had the focus while the frame was built, and whether Save was hit.
fn stepKeeping(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    app: borrow mut App,
    keep: bool,
) -> Result<[bool; 2], TestFailure> {
    ui.begin(mut platform);
    showcase(mut ui, mut app);
    let focusedInFrame = ui.hasFocusNamed("name");
    let hit = app.saveHit;
    if (hit && keep) {
        ui.setFocus(hashId("name"));
    }
    let metrics = FixedAdvance { unused: 0 };
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    platform.clock += 1.0 / 60.0;
    Check.isTrue(ok, "frame fits")?;
    return Ok([focusedInFrame, hit]);
}

/// A tap away from a text field leaves it, which puts a phone's keyboard away: when the tap ends, not when it
/// starts, or the page would move under the finger and the button tapped would miss its click; and at the frame's
/// end, so a button that focuses the field again keeps it without a frame out of focus (the keyboard would blink).
@test
fn aTapElsewhereLeavesATextFieldWhenItEnds() -> Result<void, TestFailure> {
    var storage = [0u8; 1048576];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(128));
    var platform = platformAt(800.0, 600.0, -1.0, -1.0);
    var app = App { saveHit: false, name: [0u8; 32], nameLen: 0, nameCaret: 0, volume: 0.25, qty: 3 };
    step(mut ui, mut platform, mut app)?;
    for (keep in [false, true]) {
        platform.pointerState.position = centerOf(ui, "name");
        click(mut ui, mut platform, mut app)?;
        Check.isTrue(ui.hasFocusNamed("name"), "a click focuses the field")?;
        // The press on the button: the field keeps the focus, and nothing is hit yet.
        platform.pointerState.position = centerOf(ui, "save");
        platform.pointerState.pressed = true;
        platform.pointerState.down = true;
        let pressed = stepKeeping(mut ui, mut platform, mut app, keep)?;
        Check.isTrue(pressed[0] && !pressed[1] && ui.hasFocusNamed("name"), "the press leaves the focus where it was")?;
        // The release: the button is hit in a frame where the field still had the focus.
        platform.pointerState.down = false;
        platform.pointerState.released = true;
        let released = stepKeeping(mut ui, mut platform, mut app, keep)?;
        Check.isTrue(released[0] && released[1], "the button is hit while the field is still focused")?;
        Check.isTrue(ui.hasFocusNamed("name") == keep, "the field is left at the frame's end, unless focused again")?;
        let after = stepKeeping(mut ui, mut platform, mut app, keep)?;
        Check.isTrue(after[0] == keep, "and stays so in the next frame")?;
    }
    return Ok();
}

/// The colour the text `label` is drawn in, this frame.
fn inkOf(ui: borrow Ui, label: StringView) -> Color? {
    for (k in 0..ui.commandCount()) {
        let command = ui.commandAt(k);
        match (command) {
            Command.Text(_, run) => {
                if (ui.textOf(command) == label.bytes()) {
                    return run.color;
                }
            }
            _ => {}
        }
    }
    return null;
}

fn sameColor(c: Color?, hex: u32) -> bool => match (c) {
    Some(v) => {
        let want = Color.hex(hex);
        v.r == want.r && v.g == want.g && v.b == want.b
    }
    null => false,
};

/// A frame of a checkbox and a button in the theme `dark`.
fn themedFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform, dark: bool) -> Result<void, TestFailure> {
    ui.setDarkMode(dark);
    ui.begin(mut platform);
    ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()));
    var on = false;
    let _ = Controls.checkbox(mut ui, "sub", "Subscribe", mut on);
    let _ = Controls.button(mut ui, "go", "Go");
    ui.close();
    let metrics = FixedAdvance { unused: 0 };
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    return Check.isTrue(ok, "frame fits");
}

@test
fn controlsTakeTheTheme() -> Result<void, TestFailure> {
    var storage = Vector<u8>.create();
    let _ = storage.resize(1048576, 0);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(800.0, 600.0, -1.0, -1.0);

    themedFrame(mut ui, mut platform, true)?;
    Check.isTrue(sameColor(inkOf(ui, "Subscribe"), SLATE_200), "dark: a checkbox's label is light")?;
    Check.isTrue(sameColor(inkOf(ui, "Go"), SLATE_100), "dark: a button's label is light")?;
    themedFrame(mut ui, mut platform, false)?;
    Check.isTrue(sameColor(inkOf(ui, "Subscribe"), SLATE_800), "light: a checkbox's label is dark")?;
    Check.isTrue(sameColor(inkOf(ui, "Go"), SLATE_900), "light: a button's label is dark")?;
    Check.isTrue(ui.tone(BLUE_500) == BLUE_500 && ui.tone(SLATE_500) == SLATE_500, "blues and the middle slate stay")?;
    return Ok();
}

/// One frame of a page as ceeui-capi's examples lay it out: a heading row, a caption that wraps, a panel below.
fn wrapFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform) -> Result<void, TestFailure> {
    ui.begin(mut platform);
    ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()).p(space(6.0)).gap(space(3.0)));
    ui.open(Style.row().w(Size.grow()).gap(12.0).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label("CeeUI from Swift", Text.of().size(22.0).bold());
    ui.close();
    ui.label("Each frame is laid out by a Swift closure; CeeUI draws it.", Text.of().wrap(TextWrap.Words));
    ui.open(Style.column().id("panel").w(Size.grow()).p(space(4.0)));
    ui.label("Pressed 0 times", Text.of());
    ui.close();
    ui.close();
    let metrics = FixedAdvance { unused: 0 };
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    return Check.isTrue(ok, "frame fits");
}

/// The bottom of the lowest line of text whose first bytes are `start`.
fn textBottom(ui: borrow Ui, start: StringView) -> f32 {
    var bottom: f32 = 0.0;
    var inside = false;
    for (k in 0..ui.commandCount()) {
        let command = ui.commandAt(k);
        match (command) {
            Command.Text(r, _) => {
                let t = ui.textOf(command);
                if (t.length >= start.length && t[0..start.length] == start.bytes()) {
                    inside = true;
                } else if (inside && t.length > 0 && t[0] == 'P') {
                    inside = false;
                }
                if (inside) {
                    bottom = bottom.max(r.y + r.h);
                }
            }
            _ => {}
        }
    }
    return bottom;
}

@test
fn wrappedTextHasItsHeightOnTheFirstFrame() -> Result<void, TestFailure> {
    var storage = Vector<u8>.create();
    let _ = storage.resize(1048576, 0);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(520.0, 520.0, -1.0, -1.0);
    wrapFrame(mut ui, mut platform)?;
    let first = ui.boxOf("panel")!.y;
    let bottom = textBottom(ui, "Each");
    wrapFrame(mut ui, mut platform)?;
    let second = ui.boxOf("panel")!.y;
    Check.isTrue(first >= bottom, "the panel starts below the caption's last line on the first frame")?;
    Check.isTrue(first == second, "and where it is on the next")?;
    return Ok();
}

/// The keyboard alone: a frame of a field, a button and a checkbox, with what the platform was given this frame.
struct KeyApp {
    text: [u8; 16];
    length: usize;
    edit: TextEdit;
    presses: i32;
    on: bool;
}

fn keyFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform, app: borrow mut KeyApp) -> Result<void, TestFailure> {
    ui.begin(mut platform);
    ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()).gap(8.0));
    let metrics = FixedAdvance { unused: 0 };
    let _ = Controls.textField(mut ui, metrics, "name", mut app.text[..], mut app.length, mut app.edit);
    if (Controls.button(mut ui, "go", "Go")) {
        app.presses += 1;
    }
    let _ = Controls.checkbox(mut ui, "sub", "Subscribe", mut app.on);
    ui.close();
    let ok = match (ui.endFrame(mut platform, metrics)) {
        Ok() => true,
        Err(_) => false,
    };
    platform.pressed = 0;
    platform.typedCount = 0;
    platform.typedRead = 0;
    platform.clock += 1.0 / 60.0;
    return Check.isTrue(ok, "frame fits");
}

@test
fn theKeyboardAloneReachesAndWorksEveryControl() -> Result<void, TestFailure> {
    var storage = Vector<u8>.create();
    let _ = storage.resize(1048576, 0);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(800.0, 600.0, -1.0, -1.0);
    var app = KeyApp { text: [0u8; 16], length: 0, edit: TextEdit.at(0), presses: 0, on: false };
    keyFrame(mut ui, mut platform, mut app)?;

    // Tab from nothing focuses the field, then the button, then the checkbox, then the field again.
    press(mut platform, Key.Tab);
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("name"), "Tab focuses the field first")?;
    press(mut platform, Key.Tab);
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("go"), "then the button")?;

    // Enter, then Space, press the focused button, once each.
    press(mut platform, Key.Enter);
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(app.presses == 1, "Enter presses the focused button")?;
    typeChars(mut platform, " ");
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(app.presses == 2, "and Space")?;
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(app.presses == 2, "once each")?;

    press(mut platform, Key.Tab);
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("sub"), "Tab reaches the checkbox")?;
    typeChars(mut platform, " ");
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(app.on, "Space ticks the focused checkbox")?;
    press(mut platform, Key.Enter);
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(!app.on && app.presses == 2, "Enter unticks it, and presses no button")?;

    press(mut platform, Key.Tab);
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.hasFocusNamed("name"), "and Tab comes round to the field")?;
    return Ok();
}

/// A text field's own edit menu, as a system's has: a secondary press (on a phone, a long press) opens it over the
/// field, and a choice acts on the field, which keeps the focus (a phone keeps its keyboard).
@test
fn aTextFieldsMenuOpensOnASecondaryPressAndActs() -> Result<void, TestFailure> {
    var storage = Vector<u8>.create();
    let _ = storage.resize(1048576, 0);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64));
    var platform = platformAt(800.0, 600.0, -1.0, -1.0);
    var app = KeyApp { text: [0u8; 16], length: 0, edit: TextEdit.at(0), presses: 0, on: false };
    for (i in 0..11) {
        app.text[i] = "hello world".bytes()[i];
    }
    app.length = 11;
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(ui.boxOf("ceeui-field-menu") == null, "no menu at first")?;

    // A secondary press over the field: it takes the focus, and its menu opens where the press was.
    let field = ui.boxOf("name")!;
    platform.pointerState.position = Vec2 { x: field.x + 20.0, y: field.y + field.h / 2.0 };
    platform.pointerState.secondaryPressed = true;
    keyFrame(mut ui, mut platform, mut app)?;
    platform.pointerState.secondaryPressed = false;
    keyFrame(mut ui, mut platform, mut app)?;
    let menu = match (ui.boxOf("ceeui-field-menu")) {
        Some(b) => b,
        null => { return Check.fail("the field's menu opens"); }
    };
    Check.isTrue(ui.hasFocusNamed("name"), "with the field focused")?;
    Check.isTrue(menu.x >= field.x + 19.0 && menu.y >= field.y, "at the press")?;

    // Select All, the last of its five items: the field selects everything, and keeps the focus after the release.
    platform.pointerState.position = Vec2 { x: menu.x + 40.0, y: menu.y + menu.h - 12.0 };
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    keyFrame(mut ui, mut platform, mut app)?;
    platform.pointerState.pressed = false;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    keyFrame(mut ui, mut platform, mut app)?;
    platform.pointerState.released = false;
    keyFrame(mut ui, mut platform, mut app)?;
    Check.isTrue(app.edit.from() == 0 && app.edit.to() == 11, "Select All selected the field's text")?;
    Check.isTrue(ui.hasFocusNamed("name"), "and the field kept the focus")?;
    // The choice is made at the release (as a button's click), and the menu closes then: boxOf still gives its box
    // for the frame after, as it gives any element's from the frame before.
    keyFrame(mut ui, mut platform, mut app)?;
    return Check.isTrue(ui.boxOf("ceeui-field-menu") == null, "and the menu closed");
}
