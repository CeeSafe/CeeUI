// claywind-fonts: fallback fonts found among the system's own. Skipped where Arial is missing.

import claywind;
import claywind_fonts;

@test
fn systemFontsSupplyWhatTheLoadedOnesLack() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(100, 40);
    c.imagePixels = 4;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    Check.isTrue(!ras.covers(0, 0x4E2D), "Arial alone has no 中")?;
    var fonts = SystemFonts.create();
    // Latin needs nothing, and nothing is scanned for it.
    Check.equalU64(0, fonts.supply(mut ras, "Hello".bytes(), 0) as u64)?;
    Check.equalU64(0, fonts.faceCount() as u64)?;
    let added = fonts.supply(mut ras, "中文".bytes(), 0);
    Check.isTrue(fonts.faceCount() > 0, "the catalog is built once a character is missing")?;
    Check.equalU64(1, added as u64)?;
    Check.isTrue(ras.covers(0, 0x4E2D) && ras.covers(0, 0x6587), "中 and 文 now come from a system font")?;
    // Asked again, nothing more is loaded; a private-use character is never looked for.
    Check.equalU64(0, fonts.supply(mut ras, "中文\u{E000}".bytes(), 0) as u64)?;
    return Check.isTrue(!ras.covers(0, 0xE000), "private use stays the missing-glyph box");
}

@test
fn emojiComeInColourFromTheSystemsEmojiFont() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(120, 60);
    c.imagePixels = 262144;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var fonts = SystemFonts.create();
    let text = "a\u{1F600}";
    let loaded = fonts.supply(mut ras, text.bytes(), 0);
    if (!ras.covers(0, 0x1F600)) {
        Console.writeLine("  (no emoji font on this system: skipped)");
        return Ok();
    }
    Check.equalU64(1, loaded as u64)?;
    // Its bitmap is read from the font's file once the frame needs it, and only once.
    Check.equalU64(1, fonts.supplyBitmaps(mut ras, text.bytes(), 0, 40.0, 0.0) as u64)?;
    Check.equalU64(0, fonts.supplyBitmaps(mut ras, text.bytes(), 0, 40.0, 0.0) as u64)?;
    let run = TextRun {
        start: 0,
        length: text.length,
        color: Color.hex(0x000000ff),
        fontId: 0,
        fontSize: 40.0,
        letterSpacing: 0.0,
        lineHeight: 0.0,
    };
    ras.begin(Color.rgba(255, 255, 255, 255));
    ras.draw(Command.Text(Rect { x: 4.0, y: 4.0, w: 110.0, h: 52.0 }, run), text.bytes());
    ras.finish();
    // The smiling face is yellow: some pixel is strongly yellow, which black text never is.
    var yellow = 0;
    for (y in 0usize..60) {
        for (x in 0usize..120) {
            let p = ras.pixelAt(x, y);
            if (p.r > 200 && p.g > 150 && p.b < 90) {
                yellow += 1;
            }
        }
    }
    return Check.isTrue(yellow > 50, "the emoji is drawn in its own colours");
}

@test
fn emojiSequencesBecomeOneGlyph() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(120, 60);
    c.imagePixels = 262144;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var fonts = SystemFonts.create();
    let loaded = fonts.supply(mut ras, "\u{1F600}".bytes(), 0);
    if (!ras.coversInColor(0, 0x1F600)) {
        Console.writeLine("  (no colour emoji font on this system: skipped)");
        return Ok();
    }
    // A skin tone, a flag, a ZWJ family, a keycap and a red heart (VS16): each one colour glyph.
    let sequences: [StringView; 5] = [
        "\u{1F44D}\u{1F3FD}",
        "\u{1F1EF}\u{1F1F5}",
        "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}",
        "1\u{FE0F}\u{20E3}",
        "\u{2764}\u{FE0F}",
    ];
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 8];
    for (k in 0usize..5) {
        let text = sequences[k];
        let more = fonts.supply(mut ras, text.bytes(), 0);
        let run = ras.shapeRun(text.bytes(), 0, 40.0, 0.0, mut out[..])!;
        if (run.count != 1) {
            Console.write("  sequence ");
            Console.write(k as u64);
            Console.write(" shaped to ");
            Console.write(run.count as u64);
            Console.writeLine(" glyphs");
        }
        Check.equalU64(1, run.count as u64)?;
        Check.isTrue(ras.isBitmapFont(out[0].font) || ras.isColrGlyph(out[0].font, out[0].glyph), "in colour")?;
    }
    return Ok();
}

@test
fn colourGlyphsMakeRoomForNewOnes() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(134217728);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(64, 64);
    // Room for the program's image and only a few emoji at a time.
    c.imagePixels = 2048;
    c.fontBytes = 100663296;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    Check.isTrue(ras.addImage(5, 4, 4), "the program's image fits")?;
    for (y in 0usize..4) {
        for (x in 0usize..4) {
            ras.setImagePixel(5, x, y, 0x11223344);
        }
    }
    var fonts = SystemFonts.create();
    let loaded = fonts.supply(mut ras, "\u{1F600}".bytes(), 0);
    if (!ras.coversInColor(0, 0x1F600)) {
        Console.writeLine("  (no colour emoji font on this system: skipped)");
        return Ok();
    }
    // Twelve emoji, one after another: they cannot all be kept, so older ones go.
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 2];
    for (k in 0u32..12) {
        var bytes = [0u8; 4];
        let n = encodeUtf8(0x1F600 + k, mut bytes);
        let supplied = fonts.supplyBitmaps(mut ras, bytes[0..n], 0, 20.0, 0.0);
        let run = ras.shapeRun(bytes[0..n], 0, 20.0, 0.0, mut out[..])!;
        Check.isTrue(ras.colorBitmap(out[0].font, out[0].glyph, 20.0, 1.0) != null, "the newest emoji is there")?;
    }
    // The program's image kept its pixels through the clearing.
    let pixels = ras.imagePixels(5)!;
    var same = pixels.length == 16;
    for (p in pixels) {
        same = same && p == 0x11223344;
    }
    return Check.isTrue(same, "the program's image is untouched");
}
