// The Ui layer: Tailwind option mapping (renderer.h ParseComponentOptions), state variants, clicks, cursor,
// scrolling, breakpoints/theme/@container, and transitions (claywind_transition.h, incl. the C test's numbers).

import claywind;

/// A scripted platform: tests set the pointer, keys, typed characters and clock between frames.
struct FakePlatform {
    /// The screen's safe area, as the platform reports it (none unless a test sets it).
    safe: Insets;
    size: Dims;
    pointerState: Pointer;
    dt: f32;
    clock: f64;
    cursor: Cursor;
    /// Bit `keyIndex(k)` per key.
    down: u64;
    pressed: u64;
    /// Typed characters for this frame, read front to back.
    typed: [u32; 16];
    typedCount: usize;
    typedRead: usize;
    /// Keystrokes for this frame, read front to back.
    strokes: [Keystroke; 4];
    strokeCount: usize;
    strokeRead: usize;
    /// An action chosen outside the frame (a menu item's), as its hash; 0 for none. Taken once.
    chosen: u32;
    /// Files dragged from the system over the window, as the platform reports them.
    files: FileDrag?;
    /// Touches for this frame, read front to back (gestures_test.cee).
    touches: [Touch; 16];
    touchCount: usize;
    touchRead: usize;
}

impl Platform for FakePlatform {
    fn fileDrag(borrow this) -> FileDrag? => this.files;
    fn nextTouch(borrow mut this) -> Touch? {
        if (this.touchRead >= this.touchCount) {
            return null;
        }
        let t = this.touches[this.touchRead];
        this.touchRead += 1;
        return t;
    }
    fn nextChosenAction(borrow mut this) -> u32 {
        let c = this.chosen;
        this.chosen = 0;
        return c;
    }
    fn screenSize(borrow this) -> Dims => this.size;
    fn safeArea(borrow this) -> Insets => this.safe;
    fn frameTime(borrow this) -> f32 => this.dt;
    fn time(borrow this) -> f64 => this.clock;
    fn pointer(borrow this) -> Pointer => this.pointerState;
    fn keyDown(borrow this, key: Key) -> bool => (this.down >> (keyIndex(key) as u64)) & 1 == 1;
    fn keyPressed(borrow this, key: Key) -> bool => (this.pressed >> (keyIndex(key) as u64)) & 1 == 1;
    fn keyRepeated(borrow this, key: Key) -> bool => false;
    fn nextChar(borrow mut this) -> u32 {
        if (this.typedRead >= this.typedCount) {
            return 0;
        }
        let c = this.typed[this.typedRead];
        this.typedRead += 1;
        return c;
    }
    fn setCursor(borrow mut this, cursor: Cursor) {
        this.cursor = cursor;
    }
    fn nextKeystroke(borrow mut this) -> Keystroke? {
        if (this.strokeRead >= this.strokeCount) {
            return null;
        }
        let s = this.strokes[this.strokeRead];
        this.strokeRead += 1;
        return s;
    }
}

fn platformAt(w: f32, h: f32, x: f32, y: f32) -> FakePlatform => FakePlatform {
    size: Dims { w: w, h: h },
    safe: Insets.zero(),
    pointerState: Pointer.at(Vec2 { x: x, y: y }),
    dt: 0.016,
    clock: 0.0,
    cursor: Cursor.Default,
    down: 0,
    pressed: 0,
    typed: [0u32; 16],
    typedCount: 0,
    typedRead: 0,
    strokes: [Keystroke { key: null, character: 0, modifiers: Modifiers.none() }; 4],
    strokeCount: 0,
    strokeRead: 0,
    chosen: 0,
    files: null,
    touches: [Touch { id: 0, phase: TouchPhase.Began, position: Vec2.zero(), time: 0.0 }; 16],
    touchCount: 0,
    touchRead: 0,
};

fn finish(ui: borrow mut Ui, platform: borrow mut FakePlatform) -> Result<void, TestFailure> {
    let measure = ClayMeasure { unused: 0 };
    let ok = match (ui.endFrame(mut platform, measure)) {
        Ok() => true,
        Err(_) => false,
    };
    return Check.isTrue(ok, "frame fits");
}

/// The background color of the first Fill whose box starts at (x, y).
fn fillAt(ui: borrow Ui, x: f32, y: f32) -> Color? {
    let tree = ui.layout();
    for (i in 0..tree.commandCount()) {
        match (tree.command(i)) {
            Command.Fill(area, color, _) => {
                if ((area.x - x).abs() < 0.5 && (area.y - y).abs() < 0.5) {
                    return color;
                }
            }
            _ => {}
        }
    }
    return null;
}

fn button(ui: borrow mut Ui) {
    ui.open(Style.row().id("btn").size(Size.fixed(100.0)).bg(SLATE_800)
        .hover(Style.of().bg(BLUE_500))
        .active(Style.of().bg(BLUE_700))
        .cursor(Cursor.Pointer));
    ui.close();
}

@test
fn tailwindOptionsMapToTheEngine() -> Result<void, TestFailure> {
    // Shadow preset, rounded, ring, position + inset, gap-x/gap-y by direction, items/justify by direction.
    let d = Style.row().shadow(ShadowSize.Lg).rounded(Radius.Md).ring(2.0, BLUE_400, 3.0).baseDecl();
    expect("shadow-lg offsetY", d.shadow.offsetY, 10.0)?;
    expect("shadow-lg blur", d.shadow.blur, 16.0)?;
    Check.equalU64(70, d.shadow.color.a as u64)?;
    expect("rounded-md", d.cornerRadius.bottomLeft, 6.0)?;
    expect("ring width", d.ring.width, 2.0)?;

    let abs = Style.box().absolute().right(8.0).bottom(4.0).z(10).baseDecl();
    let anchored = match (abs.floating.element) {
        AttachPoint.RightBottom => true,
        _ => false,
    };
    Check.isTrue(anchored, "right/bottom anchor the bottom-right corner")?;
    expect("offset x inward", abs.floating.offset.x, -8.0)?;
    expect("offset y inward", abs.floating.offset.y, -4.0)?;
    let fixedTopRight = Style.box().fixed().inset(true, false).baseDecl();
    let toRoot = match (fixedTopRight.floating.attachTo) {
        AttachTo.Root => true,
        _ => false,
    };
    Check.isTrue(toRoot, "fixed attaches to the root")?;

    let r = Style.row().gapX(5.0).gapY(9.0).baseDecl();
    expect("row gap-x is the in-line gap", r.layout.childGap, 5.0)?;
    expect("row gap-y is the line gap", r.layout.childGapCross, 9.0)?;
    let c = Style.column().gapX(5.0).gapY(9.0).baseDecl();
    expect("column gap-y is the in-line gap", c.layout.childGap, 9.0)?;
    expect("column gap-x is the line gap", c.layout.childGapCross, 5.0)?;

    let j = Style.column().justify(Justify.Between).items(Items.Center).baseDecl();
    let mainOk = match (j.layout.alignY) {
        AxisAlign.Between => true,
        _ => false,
    };
    let crossOk = match (j.layout.alignX) {
        AxisAlign.Center => true,
        _ => false,
    };
    Check.isTrue(mainOk && crossOk, "a column justifies along y and aligns items along x")?;

    // Gradient direction -> CSS angle, via -> three stops at the midpoint.
    let g = Style.row().gradient(GradientDir.ToBottomRight, INDIGO_600, VIOLET_500).via(PINK_500).baseDecl().gradient;
    Check.isTrue(g.useAngle && g.angle == 135.0, "to-br is 135 degrees")?;
    Check.equalU64(3, g.stopCount as u64)?;
    expect("via at the midpoint", g.stops[1].position, 0.5)?;

    // Text: bold uses the bold face at the 18px base size; the default ink is light gray.
    let t = Text.of().font(TEXT_XL).bold().config();
    Check.equalU64(FONT_BOLD as u64, t.fontId as u64)?;
    expect("bold size", t.fontSize, 18.0)?;
    let plain = Text.of().font(TEXT_XL).config();
    expect("text-xl size", plain.fontSize, 22.0)?;
    Check.equalU64(229, plain.color.r as u64)?;
    return Ok();
}

@test
fn hoverActiveAndCursor() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 50.0, 50.0);
    // Frame 1: nothing laid out yet, so nothing is hovered.
    ui.begin(mut platform);
    button(mut ui);
    finish(mut ui, mut platform)?;
    Check.isTrue(fillAt(ui, 0.0, 0.0)!.same(Color.hex(SLATE_800)), "first frame: base color")?;
    // Frame 2: the pointer is over the last frame's box -> hover.
    ui.begin(mut platform);
    button(mut ui);
    finish(mut ui, mut platform)?;
    Check.isTrue(fillAt(ui, 0.0, 0.0)!.same(Color.hex(BLUE_500)), "hover color")?;
    let pointerCursor = match (platform.cursor) {
        Cursor.Pointer => true,
        _ => false,
    };
    Check.isTrue(pointerCursor, "hovering asks for the pointer cursor")?;
    // Frame 3: pressed -> active wins over hover.
    platform.pointerState.down = true;
    platform.pointerState.pressed = true;
    ui.begin(mut platform);
    button(mut ui);
    finish(mut ui, mut platform)?;
    Check.isTrue(fillAt(ui, 0.0, 0.0)!.same(Color.hex(BLUE_700)), "active color")?;
    // Frame 4: released over it -> clicked, back to hover.
    platform.pointerState.down = false;
    platform.pointerState.pressed = false;
    platform.pointerState.released = true;
    ui.begin(mut platform);
    button(mut ui);
    let clicked = ui.clicked("btn");
    finish(mut ui, mut platform)?;
    Check.isTrue(clicked, "press + release over the button is a click")?;
    // Frame 5: pointer away -> base color, default cursor, no click.
    platform.pointerState.released = false;
    platform.pointerState.position = Vec2 { x: 300.0, y: 250.0 };
    ui.begin(mut platform);
    button(mut ui);
    let again = ui.clicked("btn");
    finish(mut ui, mut platform)?;
    Check.isFalse(again, "no click without a release")?;
    Check.isTrue(fillAt(ui, 0.0, 0.0)!.same(Color.hex(SLATE_800)), "base color again")?;
    let defaultCursor = match (platform.cursor) {
        Cursor.Default => true,
        _ => false,
    };
    return Check.isTrue(defaultCursor, "cursor resets when nothing asks");
}

@test
fn disabledAndGroupVariants() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 20.0, 20.0);
    for (frame in 0..2) {
        ui.begin(mut platform);
        ui.open(Style.row().id("card").size(Size.fixed(200.0)).p(10.0).bg(SLATE_900));
        // Disabled: hover is suppressed and the disabled variant applies.
        ui.open(Style.row().id("off").size(Size.fixed(50.0)).bg(EMERALD_600).hover(Style.of().bg(EMERALD_500))
            .isDisabled(true).disabled(Style.of().bg(SLATE_700)));
        ui.close();
        // group-hover: changes while "card" (the parent) is hovered, though the pointer is not over it.
        ui.open(
            Style.row().id("badge").size(Size.fixed(20.0)).bg(SLATE_400).groupHover("card", Style.of().bg(PINK_500)),
        );
        ui.close();
        ui.close();
        finish(mut ui, mut platform)?;
    }
    Check.isTrue(fillAt(ui, 10.0, 10.0)!.same(Color.hex(SLATE_700)), "disabled overrides hover")?;
    return Check.isTrue(fillAt(ui, 60.0, 10.0)!.same(Color.hex(PINK_500)), "group-hover applies");
}

fn scrollList(ui: borrow mut Ui) {
    ui.open(Style.column().id("list").w(Size.fixed(100.0)).h(Size.fixed(50.0)).scroll(ScrollAxis.Vertical));
    for (i in 0..10) {
        ui.open(Style.row().size(Size.fixed(20.0)).bg(SLATE_800));
        ui.close();
    }
    ui.close();
}

@test
fn wheelAndDragScrolling() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 10.0, 10.0);
    // Frames 1-2 learn the container's size (50) and content (200).
    for (f in 0..2) {
        ui.begin(mut platform);
        scrollList(mut ui);
        finish(mut ui, mut platform)?;
    }
    // One wheel notch down scrolls 10 per unit (Clay): -1 * 10 * ... Clay adds wheel.y * 10.
    platform.pointerState.wheel = Vec2 { x: 0.0, y: -3.0 };
    ui.begin(mut platform);
    scrollList(mut ui);
    finish(mut ui, mut platform)?;
    expect("wheel scrolls by 10 per unit", ui.scrollOffset("list").y, -30.0)?;
    platform.pointerState.wheel = Vec2.zero();
    // Far past the end clamps to -(content - size) = -150.
    platform.pointerState.wheel = Vec2 { x: 0.0, y: -100.0 };
    ui.begin(mut platform);
    scrollList(mut ui);
    finish(mut ui, mut platform)?;
    expect("clamped to the content", ui.scrollOffset("list").y, -150.0)?;
    platform.pointerState.wheel = Vec2.zero();
    // The children move with the offset: the first child is at y = -150.
    let tree = ui.layout();
    var firstChildY: f32 = 0.0;
    var fills: usize = 0;
    for (i in 0..tree.commandCount()) {
        match (tree.command(i)) {
            Command.Fill(area, _, _) => {
                if (fills == 0) {
                    firstChildY = area.y;
                }
                fills += 1;
            }
            _ => {}
        }
    }
    Check.isTrue(fills < 10, "off-screen children are culled")?;
    ui.scrollToTop("list");
    expect("scrollToTop", ui.scrollOffset("list").y, 0.0)?;
    // Drag: press at y=40, move to y=10 -> content follows the pointer by -30.
    platform.pointerState.position = Vec2 { x: 10.0, y: 40.0 };
    platform.pointerState.down = true;
    platform.pointerState.pressed = true;
    ui.begin(mut platform);
    scrollList(mut ui);
    finish(mut ui, mut platform)?;
    platform.pointerState.pressed = false;
    platform.pointerState.position = Vec2 { x: 10.0, y: 10.0 };
    ui.begin(mut platform);
    scrollList(mut ui);
    finish(mut ui, mut platform)?;
    expect("drag scrolls with the pointer", ui.scrollOffset("list").y, -30.0)?;
    let unused = firstChildY;
    return Ok();
}

@test
fn breakpointsThemeAndContainers() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(1100.0, 600.0, -1.0, -1.0);
    ui.begin(mut platform);
    let lg = match (ui.breakpoint()) {
        Breakpoint.Lg => true,
        _ => false,
    };
    Check.isTrue(lg, "1100px is lg")?;
    expect("no container before its first layout", ui.containerWidth("panel"), 0.0)?;
    ui.open(Style.column().id("panel").w(Size.percent(0.5)).h(Size.fixed(40.0)));
    ui.close();
    finish(mut ui, mut platform)?;
    ui.begin(mut platform);
    expect("@container reads last frame's width", ui.containerWidth("panel"), 550.0)?;
    finish(mut ui, mut platform)?;
    ui.setDarkMode(true);
    Check.equalU64(SLATE_900 as u64, ui.theme(SLATE_900, WHITE) as u64)?;
    return Ok();
}

fn isCompact(c: SizeClass) -> bool => match (c) {
    SizeClass.Compact => true,
    SizeClass.Regular => false,
};

/// A phone's screen (roadmap P4 step 4): the safe area keeps content clear of the system's bars while the root's
/// background fills the screen, and the size classes follow the screen as it turns.
@test
fn safeAreaAndSizeClasses() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(402.0, 874.0, -1.0, -1.0);
    platform.safe = Insets { left: 0.0, top: 62.0, right: 0.0, bottom: 34.0 };
    for (frame in 0..2) {
        ui.begin(mut platform);
        ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()).p(8.0).safe(ui.safeArea()));
        ui.open(Style.box().id("content").w(Size.grow()).h(Size.grow()));
        ui.close();
        ui.close();
        finish(mut ui, mut platform)?;
    }
    Check.isTrue(isCompact(ui.widthClass()), "an upright phone's width is compact")?;
    Check.isTrue(!isCompact(ui.heightClass()), "an upright phone's height is regular")?;
    let page = ui.boxOfHash(hashId("page")) ?? Rect.zero();
    expect("the page fills the screen", page.h, 874.0)?;
    let content = ui.boxOfHash(hashId("content")) ?? Rect.zero();
    expect("the content starts below the status bar", content.y, 70.0)?;
    expect("the content ends above the home indicator", content.y + content.h, 832.0)?;
    expect("the content is as wide as the screen allows", content.w, 386.0)?;
    // On its side: the insets move to the sides, and the classes swap.
    platform.size = Dims { w: 874.0, h: 402.0 };
    platform.safe = Insets { left: 62.0, top: 0.0, right: 62.0, bottom: 20.0 };
    for (frame in 0..2) {
        ui.begin(mut platform);
        ui.open(Style.column().id("page").w(Size.grow()).h(Size.grow()).safe(ui.safeArea().sides()));
        ui.open(Style.box().id("content").w(Size.grow()).h(Size.grow()));
        ui.close();
        ui.close();
        finish(mut ui, mut platform)?;
    }
    Check.isTrue(!isCompact(ui.widthClass()), "a phone on its side is regular in width")?;
    Check.isTrue(isCompact(ui.heightClass()), "a phone on its side is compact in height")?;
    let turned = ui.boxOfHash(hashId("content")) ?? Rect.zero();
    expect("the sides alone are kept clear", turned.x, 62.0)?;
    expect("the content is between the sides", turned.w, 750.0)?;
    expect("a bar may reach the bottom edge itself", turned.h, 402.0)?;
    return Ok();
}

// ---- transitions: claywind_transition.h's test_transition, case for case ----------------------------------------

fn bgDecl(color: u32) -> Decl {
    var d = Decl.of();
    d.background = Color.hex(color);
    return d;
}

fn red(d: Decl) -> f32 => round<f32>(d.background.r as u32);
fn blue(d: Decl) -> f32 => round<f32>(d.background.b as u32);

@test
fn transitionsEaseAndSettle() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = Transitions.create(memory, 64)!;
    let RED: u32 = 0xFF0000FF;
    let BLUE: u32 = 0x0000FFFF;
    let colLin = TransitionSpec.colorsOnly().durationMs(1000.0).easing(Ease.Linear);
    var d = bgDecl(RED);
    t.apply(101, colLin, 0.0, mut d);
    expect("snap bg.r", red(d), 255.0)?;
    expect("snap bg.b", blue(d), 0.0)?;
    d = bgDecl(BLUE);
    t.apply(101, colLin, 0.5, mut d);
    expect("mid bg.r", red(d), 127.5)?;
    expect("mid bg.b", blue(d), 127.5)?;
    d = bgDecl(BLUE);
    t.apply(101, colLin, 0.5, mut d);
    expect("end bg.b", blue(d), 255.0)?;
    d = bgDecl(BLUE);
    t.apply(101, colLin, 0.5, mut d);
    expect("hold bg.b", blue(d), 255.0)?;

    let colOut = TransitionSpec.colorsOnly().durationMs(1000.0).easing(Ease.Out);
    d = bgDecl(RED);
    t.apply(102, colOut, 0.0, mut d);
    d = bgDecl(BLUE);
    t.apply(102, colOut, 0.5, mut d);
    expect("ease-out bg.b", blue(d), 191.25)?;
    expect("ease-out bg.r", red(d), 63.75)?;

    let xf = TransitionSpec.transformOnly().durationMs(1000.0).easing(Ease.Linear);
    d = Decl.of();
    t.apply(103, xf, 0.0, mut d);
    expect("snap scale", d.layout.scale, 1.0)?;
    d = Decl.of();
    d.layout.scale = 2.0;
    t.apply(103, xf, 0.5, mut d);
    expect("mid scale", d.layout.scale, 1.5)?;
    d = Decl.of();
    d.layout.scale = 2.0;
    t.apply(103, xf, 0.5, mut d);
    expect("end scale", d.layout.scale, 2.0)?;

    let op = TransitionSpec.opacityOnly().durationMs(1000.0).easing(Ease.Linear);
    d = Decl.of();
    t.apply(104, op, 0.0, mut d);
    expect("snap opacity", d.layout.opacity, 1.0)?;
    d = Decl.of();
    d.layout.opacity = 0.5;
    t.apply(104, op, 0.5, mut d);
    expect("mid opacity", d.layout.opacity, 0.75)?;
    d = bgDecl(RED);
    d.layout.opacity = 0.5;
    t.apply(104, op, 0.5, mut d);
    expect("bg untouched by opacity spec", red(d), 255.0)?;

    let del = TransitionSpec.colorsOnly().durationMs(1000.0).delayMs(500.0).easing(Ease.Linear);
    d = bgDecl(RED);
    t.apply(106, del, 0.0, mut d);
    d = bgDecl(BLUE);
    t.apply(106, del, 0.5, mut d);
    expect("delay holds start (b)", blue(d), 0.0)?;
    expect("delay holds start (r)", red(d), 255.0)?;
    d = bgDecl(BLUE);
    t.apply(106, del, 0.5, mut d);
    expect("post-delay midpoint", blue(d), 127.5)?;
    return Ok();
}

@test
fn hoverTransitionsThroughTheUi() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 10.0, 10.0);
    platform.dt = 0.05;
    let RED: u32 = 0xFF0000FF;
    let BLUE: u32 = 0x0000FFFF;
    var blues = [0.0f32; 6];
    for (frame in 0..6usize) {
        ui.begin(mut platform);
        ui.open(Style.row().id("t").size(Size.fixed(40.0)).bg(RED).hover(Style.of().bg(BLUE))
            .transition(TransitionSpec.colorsOnly().durationMs(200.0).easing(Ease.Linear)));
        ui.close();
        finish(mut ui, mut platform)?;
        blues[frame] = round<f32>(fillAt(ui, 0.0, 0.0)!.b as u32);
    }
    // Frame 0 snaps to red (nothing hovered yet); hover starts on frame 1 and eases over 4 frames of 50ms.
    expect("frame 0 red", blues[0], 0.0)?;
    expect("frame 1 a quarter", blues[1], 63.75)?;
    expect("frame 2 half", blues[2], 127.5)?;
    expect("frame 4 settled", blues[4], 255.0)?;
    return Ok();
}

@test
fn runningOutOfRoomIsReported() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(4))!;
    var platform = platformAt(100.0, 100.0, -1.0, -1.0);
    ui.begin(mut platform);
    for (i in 0..10) {
        ui.open(Style.row());
        ui.close();
    }
    let measure = ClayMeasure { unused: 0 };
    let failed = match (ui.endFrame(mut platform, measure)) {
        Ok() => false,
        Err(_) => true,
    };
    return Check.isTrue(failed, "too many elements for the capacity");
}

fn documentView(ui: borrow mut Ui, text: Slice<u8>, starts: Slice<u32>, count: usize) {
    ui.open(Style.column().w(Size.fixed(400.0)).h(Size.fixed(300.0)));
    Controls.textView(ui, "doc", text, starts, count, Text.of().size(16.0).leading(20.0), false);
    ui.close();
}

@test
fn aHundredThousandLinesCostAScreenful() -> Result<void, TestFailure> {
    // "line 0" to "line 99999", one a line.
    var text = heap(1300000);
    var w = TextWriter.create(mut text.viewMut());
    for (k in 0u64..100000) {
        w.text("line ");
        w.decimal(k);
        w.byte('\n');
    }
    let length = w.written().length;
    var starts = u32s(100001);
    let count = indexLines(text.view()[0..length], mut starts.viewMut())!;
    Check.equalU64(100001, count as u64)?; // the empty line after the last newline
    let firstLine = lineOf(text.view()[0..length], starts.view(), count, 0);
    Check.isTrue(firstLine.length == 6, "line 0 has no newline")?;
    Check.equalU64(50000, lineAt(starts.view(), count, (starts[50000] as usize) + 3) as u64)?;
    var storage = heap(4194304);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(256))!;
    var platform = platformAt(400.0, 300.0, 10.0, 10.0);
    for (f in 0..2) {
        ui.begin(mut platform);
        documentView(mut ui, text.view()[0..length], starts.view(), count);
        finish(mut ui, mut platform)?;
    }
    // Scrolled to line 50000 (20 points a line).
    ui.scrollBy("doc", 0.0, -1000000.0);
    let started = Clock.monotonicNanos();
    ui.begin(mut platform);
    documentView(mut ui, text.view()[0..length], starts.view(), count);
    finish(mut ui, mut platform)?;
    let ms = round<f64>(Clock.monotonicNanos() - started) / 1000000.0;
    Console.write("  a frame of the 100,000-line view: ");
    Console.write(ms);
    Console.writeLine(" ms");
    expect("scrolled", ui.scrollOffset("doc").y, -1000000.0)?;
    // Only a screenful of lines are elements, and the one at the top is line 50000.
    let tree = ui.layout();
    var texts: usize = 0;
    var top = false;
    for (i in 0..tree.commandCount()) {
        let c = tree.command(i);
        match (c) {
            Command.Text(area, _) => {
                texts += 1;
                let bytes = ui.textOf(c);
                if (area.y >= -1.0 && area.y < 19.0) {
                    top = bytes.length == 10 && bytes[5] == '5' && bytes[9] == '0';
                }
            }
            _ => {}
        }
    }
    Check.isTrue(texts > 10 && texts < 40, "a screenful of lines is drawn")?;
    // Laid out by the screenful, a frame takes well under a millisecond here; a frame that walked every line would
    // take hundreds.
    Check.isTrue(ms < 50.0, "a frame does not walk the whole document")?;
    return Check.isTrue(top, "line 50000 is at the top");
}

/// One frame of a text field, with `setup` run between begin and the field (the host's edit commands).
fn fieldFrame(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    buf: SliceMut<u8>,
    len: borrow mut usize,
    edit: borrow mut TextEdit,
    command: u32,
) -> Result<void, TestFailure> {
    ui.begin(mut platform);
    if (command == 1) {
        ui.editCommand(EditCommand.Copy);
    } else if (command == 2) {
        ui.editCommand(EditCommand.Cut);
    } else if (command == 3) {
        ui.paste("there".bytes());
    } else if (command == 4) {
        ui.editCommand(EditCommand.SelectAll);
    } else if (command == 5) {
        ui.setComposition("にほ".bytes(), 3);
    }
    let measure = ClayMeasure { unused: 0 };
    ui.open(Style.column().w(Size.fixed(300.0)).h(Size.fixed(100.0)));
    let changed = Controls.textField(mut ui, measure, "field", buf, mut len, mut edit);
    ui.close();
    platform.typedCount = 0;
    platform.typedRead = 0;
    platform.pressed = 0;
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    return finish(mut ui, mut platform);
}

@test
fn textFieldSelectsCopiesCutsAndPastes() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 20.0, 15.0);
    var buf = [0u8; 64];
    var len: usize = 0;
    var edit = TextEdit.at(0);
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    // A click focuses it; then "hello world" is typed.
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    let typed = "hello world";
    for (k in 0..typed.length) {
        platform.typed[k] = typed.bytes()[k] as u32;
    }
    platform.typedCount = typed.length;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    Check.isTrue(len == 11 && edit.caret == 11, "typed at the caret")?;
    // Shift+Left five times selects "world"; Copy takes it.
    platform.down = 1u64 << (keyIndex(Key.LeftShift) as u64);
    for (k in 0..5) {
        platform.pressed = 1u64 << (keyIndex(Key.Left) as u64);
        fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    }
    platform.down = 0;
    Check.isTrue(edit.from() == 6 && edit.to() == 11, "Shift+Left selects")?;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 1)?;
    let copied = ui.copiedText()!;
    Check.isTrue(copied.length == 5 && copied[0] == 'w', "Copy takes the selection")?;
    // Cut removes it; Paste puts "there" at the caret.
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 2)?;
    Check.isTrue(len == 6 && ui.copiedText()!.length == 5, "Cut takes and removes it")?;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 3)?;
    Check.isTrue(len == 11 && buf[6] == 't' && edit.caret == 11, "Paste inserts at the caret")?;
    // Select All, then typing replaces everything.
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 4)?;
    platform.typed[0] = 'x' as u32;
    platform.typedCount = 1;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    Check.isTrue(len == 1 && buf[0] == 'x', "typing replaces the selection")?;
    // An input method's composition: the field wants text input and reports its caret past the composed text.
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 5)?;
    Check.isTrue(ui.wantsTextInput(), "a focused field wants text input")?;
    let area = ui.textInputArea();
    let box = ui.boxOf("field")!;
    // 10 points a byte here: "x" and the 3 bytes of the composition before its caret, past the padding.
    return Check.isTrue((area.x - box.x - space(3.0) - 40.0).abs() < 0.5, "the caret is after the composed text");
}

@test
fn doubleClickSelectsAWordAndTripleClickEverything() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 20.0, 15.0);
    var buf = [0u8; 64];
    let start = "hello world";
    for (k in 0..start.length) {
        buf[k] = start.bytes()[k];
    }
    var len = start.length;
    var edit = TextEdit.at(0);
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    let box = ui.boxOf("field")!;
    // Inside "world" (10 points a byte here): byte 8, past the padding.
    platform.pointerState.position = Vec2 { x: box.x + space(3.0) + 85.0, y: box.y + 10.0 };
    for (click in 1..4) {
        platform.clock += 0.1;
        platform.pointerState.pressed = true;
        platform.pointerState.down = true;
        fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
        platform.pointerState.down = false;
        platform.pointerState.released = true;
        fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
        if (click == 1) {
            Check.isTrue(!edit.selects() && edit.caret == 8 || edit.caret == 9, "a click places the caret")?;
        } else if (click == 2) {
            Check.isTrue(edit.from() == 6 && edit.to() == 11, "a double click selects the word")?;
        } else {
            Check.isTrue(edit.from() == 0 && edit.to() == 11, "a triple click selects everything")?;
        }
    }
    // A press a second later starts counting again.
    platform.clock += 1.0;
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    return Check.isTrue(!edit.selects(), "a slow click is a single click");
}

struct Counter {
    clicks: u32;
}

fn counterFrame(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    counter: borrow mut Model<Counter>,
    bump: bool,
) -> Result<void, TestFailure> {
    ui.begin(mut platform);
    if (bump) {
        counter.update(mut ui, (c) => { c.clicks += 1; });
    }
    var label = [0u8; 16];
    var w = TextWriter.create(mut label[..]);
    w.decimal(counter.get().clicks as u64);
    ui.open(Style.column().w(Size.fixed(200.0)).h(Size.fixed(100.0)));
    ui.labelBytes(w.written(), Text.of());
    ui.close();
    let r = finish(mut ui, mut platform);
    platform.pointerState.pressed = false;
    platform.pointerState.released = false;
    return r;
}

@test
fn framesRunOnlyWhenSomethingChanges() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 10.0, 10.0);
    var counter = Model<Counter>.of(Counter { clicks: 0 });
    // The first frame sees the pointer arrive; the next has nothing new and the window can sleep.
    counterFrame(mut ui, mut platform, mut counter, false)?;
    counterFrame(mut ui, mut platform, mut counter, false)?;
    Check.isTrue(!ui.needsFrame() && ui.frameDelay() == null, "nothing changed: no frame is due")?;
    // The pointer moves: a frame, and the one after it settles.
    platform.pointerState.position = Vec2 { x: 30.0, y: 20.0 };
    counterFrame(mut ui, mut platform, mut counter, false)?;
    Check.isTrue(ui.needsFrame(), "a pointer move runs the next frame")?;
    counterFrame(mut ui, mut platform, mut counter, false)?;
    Check.isTrue(!ui.needsFrame(), "then it is idle again")?;
    // A model changed: the frame that shows it runs.
    counterFrame(mut ui, mut platform, mut counter, true)?;
    Check.isTrue(
        ui.needsFrame() && counter.version() == 1 && counter.get().clicks == 1,
        "a model change asks for a frame",
    )?;
    counterFrame(mut ui, mut platform, mut counter, false)?;
    Check.isTrue(!ui.needsFrame(), "and only one")?;
    return Ok();
}

@test
fn aFocusedFieldWakesForItsCaret() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 20.0, 15.0);
    var buf = [0u8; 16];
    var len: usize = 0;
    var edit = TextEdit.at(0);
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    platform.pointerState.pressed = true;
    platform.pointerState.down = true;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    platform.pointerState.down = false;
    platform.pointerState.released = true;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    platform.clock = 3.3;
    fieldFrame(mut ui, mut platform, mut buf[..], mut len, mut edit, 0)?;
    let delay = ui.frameDelay()!;
    // The caret next blinks at 3.5 s.
    return Check.isTrue((delay - 0.2).abs() < 0.001, "the next frame is due when the caret blinks");
}

/// One frame that asks for frames `a` and `b` seconds later (negative: not asked).
fn laterFrame(ui: borrow mut Ui, platform: borrow mut FakePlatform, a: f64, b: f64) -> Result<void, TestFailure> {
    ui.begin(mut platform);
    if (a >= 0.0) {
        ui.requestFrameAfter(a);
    }
    if (b >= 0.0) {
        ui.requestFrameAfter(b);
    }
    ui.open(Style.column().w(Size.fixed(200.0)).h(Size.fixed(100.0)));
    ui.close();
    return finish(mut ui, mut platform);
}

@test
fn aFrameAskedForLaterSetsTheDelay() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 10.0, 10.0);
    laterFrame(mut ui, mut platform, -1.0, -1.0)?;
    laterFrame(mut ui, mut platform, -1.0, -1.0)?;
    Check.isTrue(ui.frameDelay() == null && ui.frameDelayMs(77) == 77, "idle: no delay")?;
    // Two requests: the sooner wins, and it does not make the next frame run at once.
    laterFrame(mut ui, mut platform, 0.7, 0.4)?;
    Check.isTrue(!ui.needsFrame(), "a later frame is not due at once")?;
    Check.isTrue((ui.frameDelay()! - 0.4).abs() < 0.0001, "the sooner request sets the delay")?;
    Check.equalU64(400, ui.frameDelayMs(77) as u64)?;
    // A frame forgets the requests of the one before.
    laterFrame(mut ui, mut platform, -1.0, -1.0)?;
    return Check.isTrue(ui.frameDelay() == null, "a request lasts one frame");
}

/// A keystroke of character `c` with Command (when `command`) or Control.
fn stroke(c: u32, command: bool, control: bool, shift: bool) -> Keystroke =>
    Keystroke {
        key: null,
        character: c,
        modifiers: Modifiers { shift: shift, control: control, alt: false, command: command },
    };

/// One frame: an editor area (key context "editor") holding a focusable box; `strokes` pressed.
fn keymapFrame(
    ui: borrow mut Ui,
    platform: borrow mut FakePlatform,
    strokes: Slice<Keystroke>,
    focus: bool,
) -> Result<void, TestFailure> {
    for (k in 0..strokes.length) {
        platform.strokes[k] = strokes[k];
    }
    platform.strokeCount = strokes.length;
    platform.strokeRead = 0;
    ui.begin(mut platform);
    if (focus) {
        ui.setFocus(hashId("box"));
    }
    ui.open(Style.column().id("editor").w(Size.fixed(200.0)).h(Size.fixed(100.0)));
    ui.keyContext("editor");
    ui.registerFocusable(hashId("box"));
    ui.open(Style.box().id("box").w(Size.fixed(50.0)).h(Size.fixed(20.0)));
    ui.close();
    ui.close();
    return finish(mut ui, mut platform);
}

@test
fn keystrokesTriggerTheirActionsInContext() -> Result<void, TestFailure> {
    var storage = heap(1048576);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, 10.0, 10.0);
    ui.setSecondaryIsCommand(true);
    Check.isTrue(ui.bind("secondary-shift-p", "palette", ""), "a global binding")?;
    Check.isTrue(ui.bind("secondary-shift-p", "editor-palette", "editor"), "the same keys in the editor")?;
    Check.isTrue(ui.bind("ctrl-k", "kill", ""), "a Control binding")?;
    Check.isTrue(!ui.bind("hyper-q", "nothing", ""), "an unknown modifier does not parse")?;
    let none = [stroke(0, false, false, false); 1];
    let palette = [stroke('P', true, false, true); 1];
    // Nothing focused: the global binding.
    keymapFrame(mut ui, mut platform, palette[..], false)?;
    keymapFrame(mut ui, mut platform, palette[..], false)?;
    Check.isTrue(ui.action("palette") && !ui.action("editor-palette"), "unfocused, the global binding acts")?;
    // Focus inside the editor: next frame its binding wins.
    keymapFrame(mut ui, mut platform, none[0..0], true)?;
    keymapFrame(mut ui, mut platform, palette[..], false)?;
    Check.isTrue(ui.action("editor-palette") && !ui.action("palette"), "in the editor, its binding wins")?;
    // The defaults: Command-C is Copy (an edit command); Control-K is not Command-K.
    let copy = [stroke('c', true, false, false); 1];
    keymapFrame(mut ui, mut platform, copy[..], false)?;
    Check.isTrue(ui.action("copy") && ui.commanded(EditCommand.Copy), "secondary-c copies")?;
    let commandK = [stroke('k', true, false, false); 1];
    keymapFrame(mut ui, mut platform, commandK[..], false)?;
    Check.isTrue(!ui.action("kill"), "ctrl-k is not cmd-k")?;
    let controlK = [stroke('k', false, true, false); 1];
    keymapFrame(mut ui, mut platform, controlK[..], false)?;
    return Check.isTrue(ui.action("kill"), "ctrl-k");
}
