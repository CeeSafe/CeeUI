// SPDX-License-Identifier: MIT
// Snapshots for hot reload (snapshot.cee): values come back in the order written, a snapshot of another format or
// cut short gives defaults and is not intact, and the demo's state comes back whole.

import claywind;
import claywind_demo;

@test
fn snapshotValuesComeBack() -> Result<void, TestFailure> {
    var buffer = [0u8; 128];
    var w = SnapshotWriter.over(mut buffer[..], 3);
    w.u32(70000);
    w.bool(true);
    w.f32(0.25);
    w.u64(1u64 << 40);
    w.bytes("hello".bytes());
    Check.isTrue(w.fits(), "it fits")?;
    let n = w.written().length;
    var r = SnapshotReader.over(buffer[0..n], 3);
    Check.equalU64(70000, r.u32() as u64)?;
    Check.isTrue(r.bool() && r.f32() == 0.25 && r.u64() == 1u64 << 40, "the values")?;
    var word = [0u8; 8];
    Check.equalU64(5, r.bytesInto(mut word[..]) as u64)?;
    Check.isTrue(word[0] == 'h' && word[4] == 'o' && r.intact(), "the bytes, intact")?;
    // Another format, or cut short: defaults, not intact.
    var other = SnapshotReader.over(buffer[0..n], 4);
    Check.isTrue(other.u32() == 0 && !other.intact(), "another format reads as defaults")?;
    var short = SnapshotReader.over(buffer[0..12], 3);
    short.u32();
    short.bool();
    return Check.isTrue(!short.intact(), "a snapshot cut short is not intact");
}

@test
fn theDemosStateSurvivesAReload() -> Result<void, TestFailure> {
    var app = DemoApp.create();
    app.selectTab(1);
    app.selectControlsTab(4);
    app.clicks = 7;
    var saved = [0u8; 1024];
    var w = SnapshotWriter.over(mut saved[..], DEMO_STATE_VERSION);
    app.save(mut w);
    let n = w.written().length;
    var next = DemoApp.create();
    var r = SnapshotReader.over(saved[0..n], DEMO_STATE_VERSION);
    Check.isTrue(next.restore(mut r), "restored")?;
    Check.isTrue(next.activeNav == 1 && next.clicks == 7, "the page and the counter")?;
    // A snapshot of another format leaves the app as it was.
    var fresh = DemoApp.create();
    var stale = SnapshotReader.over(saved[0..n], DEMO_STATE_VERSION + 1);
    Check.isTrue(!fresh.restore(mut stale) && fresh.activeNav == 0 && fresh.clicks == 0, "a stale snapshot is ignored")?;
    // The same frame from both: the restored app shows the Drag tab, as the saved one did.
    var a = [0u8; 1024];
    var wa = SnapshotWriter.over(mut a[..], DEMO_STATE_VERSION);
    next.save(mut wa);
    return Check.isTrue(sameSaved(wa.written(), saved[0..n]), "saving the restored app gives the same snapshot");
}

fn sameSaved(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}
