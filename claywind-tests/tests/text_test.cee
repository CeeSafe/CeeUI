// Text as glyphs (raster_text.cee): strict UTF-8, font collections, the fallback chain, and measuring what is drawn.
// The font checks skip themselves where macOS's Arial and Arial Unicode are missing.

import claywind;

fn arialUnicodePath() -> StringView => "/System/Library/Fonts/Supplemental/Arial Unicode.ttf";

fn collectionPath() -> StringView => "/System/Library/Fonts/STHeiti Light.ttc";

@test
fn malformedUtf8IsOneReplacementPerByte() -> Result<void, TestFailure> {
    let stray = [0x80u8, 0x41];
    Check.equalU64(0xFFFD, decodeUtf8(stray[..], 0)[0] as u64)?;
    Check.equalU64(1, decodeUtf8(stray[..], 0)[1] as u64)?;
    let overlong = [0xC0u8, 0xAF];
    Check.equalU64(0xFFFD, decodeUtf8(overlong[..], 0)[0] as u64)?;
    let surrogate = [0xEDu8, 0xA0, 0x80];
    Check.equalU64(0xFFFD, decodeUtf8(surrogate[..], 0)[0] as u64)?;
    let cut = [0xE4u8, 0xB8];
    Check.equalU64(0xFFFD, decodeUtf8(cut[..], 0)[0] as u64)?;
    let beyond = [0xF4u8, 0x90, 0x80, 0x80];
    Check.equalU64(0xFFFD, decodeUtf8(beyond[..], 0)[0] as u64)?;
    let han = "中".bytes();
    Check.equalU64(0x4E2D, decodeUtf8(han, 0)[0] as u64)?;
    return Check.equalU64(3, decodeUtf8(han, 0)[1] as u64);
}

@test
fn collectionFacesParse() -> Result<void, TestFailure> {
    let file = readFile(collectionPath());
    if (file.length == 0) {
        Console.writeLine("  (STHeiti not found: skipped)");
        return Ok();
    }
    let d = file.view();
    Check.equalU64(2, fontFaceCount(d) as u64)?;
    let first = parseFontFace(d, 0)!;
    Check.isTrue(glyphIndex(d, first, 0x4E2D) != 0, "the first face maps 中")?;
    Check.isTrue(parseFontFace(d, 1) != null, "the second face parses")?;
    return Check.isTrue(parseFontFace(d, 2) == null, "there is no third face");
}

@test
fn fallbackGlyphsAreShapedMeasuredAndDrawn() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    let wide = readFile(arialUnicodePath());
    if (arial.length == 0 || wide.length == 0) {
        Console.writeLine("  (Arial or Arial Unicode not found: skipped)");
        return Ok();
    }
    var storage = heap(67108864);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(200, 60);
    c.imagePixels = 4;
    c.fontBytes = 33554432;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    Check.isTrue(ras.loadFont(16, wide.view()), "Arial Unicode loads")?;
    let chain = [16u32];
    ras.setFallbacks(chain[..]);
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 8];
    // "A中": the A from Arial, 中 from the fallback, after the A's advance (0.667 em at 20px = 13.34).
    let run = ras.shapeRun("A中".bytes(), 0, 20.0, 0.0, mut out[..])!;
    Check.equalU64(2, run.count as u64)?;
    Check.equalU64(0, out[0].font as u64)?;
    Check.equalU64(1, out[1].font as u64)?;
    Check.equalU64(1, out[1].cluster as u64)?;
    expect("中 after A", out[1].x, 13.33984375)?;
    // Measured as shaped: the width is the pen after the last glyph.
    let measured = ras.measure("A中".bytes(), TextConfig.of(20.0));
    expect("measure is the shaped width", measured.w, run.width)?;
    // Kerning is measured too: AV is narrower than A plus V.
    let av = ras.measure("AV".bytes(), TextConfig.of(20.0)).w;
    let a = ras.measure("A".bytes(), TextConfig.of(20.0)).w;
    let v = ras.measure("V".bytes(), TextConfig.of(20.0)).w;
    expect("A-V kerned by -152 units", av, a + v - 152.0 * 20.0 / 2048.0)?;
    // Letter spacing is per glyph, not per byte: 2 glyphs in 4 bytes.
    var spaced = TextConfig.of(20.0);
    spaced.letterSpacing = 3.0;
    expect("spacing per glyph", ras.measure("A中".bytes(), spaced).w, measured.w + 6.0)?;
    // Zero-width characters take no glyph; a character no font has is the run's missing-glyph box.
    let hidden = ras.shapeRun("a\u{200B}b".bytes(), 0, 20.0, 0.0, mut out[..])!;
    Check.equalU64(2, hidden.count as u64)?;
    let missing = ras.shapeRun("\u{E000}".bytes(), 0, 20.0, 0.0, mut out[..])!;
    Check.equalU64(1, missing.count as u64)?;
    Check.equalU64(0, out[0].glyph as u64)?;
    Check.equalU64(0, out[0].font as u64)?;
    // And the fallback glyph is drawn: ink where 中 is.
    ras.begin(Color.rgb(0, 0, 0));
    let run16 = TextRun {
        start: 0,
        length: 4,
        color: Color.rgb(255, 255, 255),
        fontId: 0,
        fontSize: 20.0,
        letterSpacing: 0.0,
        lineHeight: 0.0,
    };
    ras.draw(Command.Text(Rect { x: 0.0, y: 0.0, w: 100.0, h: 30.0 }, run16), "A中".bytes());
    ras.finish();
    var ink: u32 = 0;
    for (y in 0..30usize) {
        for (x in 14..34usize) {
            if (ras.pixelAt(x, y).r > 128) {
                ink += 1;
            }
        }
    }
    return Check.isTrue(ink > 30, "中 is drawn from the fallback font");
}

/// A CID-keyed CFF collection; CLAYWIND_CFF_FONT names another CFF font to look at.
fn cffPath() -> StringView => Environment.variable("CLAYWIND_CFF_FONT") ?? "/System/Library/Fonts/Hiragino Sans GB.ttc";

/// The raster's pixels as a binary PGM (its red channel) at `path`, for a person to look at.
fn writeGray(ras: borrow Raster, w: usize, h: usize, path: StringView) {
    var out = Vector<u8>.create();
    var header = [0u8; 32];
    var hw = TextWriter.create(mut header[..]);
    hw.text("P5\n");
    hw.decimal(w as u64);
    hw.byte(' ');
    hw.decimal(h as u64);
    hw.text("\n255\n");
    for (b in hw.written()) {
        out.push(b)!;
    }
    for (y in 0..h) {
        for (x in 0..w) {
            out.push(ras.pixelAt(x, y).r)!;
        }
    }
    match (File.create(path)) {
        Ok(f) => {
            var file = f;
            let ignored = file.write(out.view());
        }
        Err(_) => {}
    }
}

@test
fn cffOutlinesDraw() -> Result<void, TestFailure> {
    let file = readFile(cffPath());
    if (file.length == 0) {
        Console.writeLine("  (Hiragino Sans GB not found: skipped)");
        return Ok();
    }
    let d = file.view();
    let info = parseFontFace(d, 0)!;
    Check.isTrue(glyphIndex(d, info, 0x6C38) != 0, "永 is mapped")?;
    var storage = heap(67108864);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(320, 64);
    c.imagePixels = 4;
    c.fontBytes = 33554432;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFontFace(0, d, 0), "a CID-keyed CFF face loads")?;
    ras.begin(Color.rgb(0, 0, 0));
    let text = "永中AB的あ鬱";
    let run = TextRun {
        start: 0,
        length: text.length,
        color: Color.rgb(255, 255, 255),
        fontId: 0,
        fontSize: 48.0,
        letterSpacing: 0.0,
        lineHeight: 0.0,
    };
    ras.draw(Command.Text(Rect { x: 4.0, y: 4.0, w: 312.0, h: 56.0 }, run), text.bytes());
    ras.finish();
    match (Environment.variable("CLAYWIND_TEST_OUT")) {
        Some(p) => { writeGray(ras, 320, 64, p); }
        null => {}
    }
    // Ink in each of the first four glyphs' cells, and none far below the baseline.
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 8];
    let shaped = ras.shapeRun(text.bytes(), 0, 48.0, 0.0, mut out[..])!;
    for (k in 0usize..4) {
        let x0 = 4 + truncate<usize>(out[k].x);
        let x1 = if (k + 1 < shaped.count) 4 + truncate<usize>(out[k + 1].x) else 316;
        var ink: u32 = 0;
        for (y in 4..60usize) {
            for (x in x0..x1.min(320)) {
                if (ras.pixelAt(x, y).r > 128) {
                    ink += 1;
                }
            }
        }
        Check.isTrue(ink > 60, "every glyph has ink")?;
    }
    return Ok();
}

@test
fn marksSitOnTheirBases() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(8388608);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(64, 64);
    c.imagePixels = 4;
    c.fontBytes = 2097152;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 8];
    // e + COMBINING ACUTE: Arial's GPOS 'mark' puts the accent over the e, not after it.
    let run = ras.shapeRun("e\u{301}".bytes(), 0, 40.0, 0.0, mut out[..])!;
    Check.equalU64(2, run.count as u64)?;
    let e = ras.measure("e".bytes(), TextConfig.of(40.0)).w;
    Check.isTrue(out[1].x > out[0].x && out[1].x < out[0].x + e, "the accent is over the e")?;
    Check.equalU64(1, out[1].cluster as u64)?;
    expect("the accent takes no width", run.width, e)?;
    return Ok();
}

@test
fn rightToLeftRunsReadRightToLeft() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(8388608);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(64, 64);
    c.imagePixels = 4;
    c.fontBytes = 2097152;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 8];
    // "a", a space, then Hebrew alef bet: the a on the left, then bet, then alef at the right end.
    let run = ras.shapeRun("a \u{5D0}\u{5D1}".bytes(), 0, 40.0, 0.0, mut out[..])!;
    Check.equalU64(4, run.count as u64)?;
    Check.equalU64(0, out[0].cluster as u64)?;
    Check.equalU64(4, out[2].cluster as u64)?;
    Check.equalU64(2, out[3].cluster as u64)?;
    Check.isTrue(out[2].x < out[3].x, "bet is left of alef")?;
    expect("the width is the characters' own", run.width, ras.measure("a \u{5D0}\u{5D1}".bytes(), TextConfig.of(40.0)).w)?;
    // In a right-to-left run a bracket takes its mirrored glyph: "(" shows as ")".
    var close = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 2];
    let one = ras.shapeRun(")".bytes(), 0, 40.0, 0.0, mut close[..])!;
    let mixed = ras.shapeRun("\u{5D0}(\u{5D1})".bytes(), 0, 40.0, 0.0, mut out[..])!;
    Check.equalU64(4, mixed.count as u64)?;
    var opened = false;
    for (k in 0..4) {
        if (out[k].cluster == 2) {
            opened = out[k].glyph == close[0].glyph;
        }
    }
    Check.isTrue(opened, "the opening bracket draws as a closing one")?;
    // Visual order: ")", bet, "(", alef, so alef's cluster comes last.
    Check.equalU64(0, out[3].cluster as u64)?;
    return Ok();
}

@test
fn arabicLettersJoin() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(8388608);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(64, 64);
    c.imagePixels = 4;
    c.fontBytes = 2097152;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    if (!ras.covers(0, 0x628)) {
        Console.writeLine("  (this Arial has no Arabic: skipped)");
        return Ok();
    }
    var alone = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 2];
    let one = ras.shapeRun("\u{628}".bytes(), 0, 40.0, 0.0, mut alone[..])!;
    // beh beh beh, right to left: final, medial and initial forms. (Arial draws the final beh with the isolated
    // glyph, and the medial with the initial one.)
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 4];
    let run = ras.shapeRun("\u{628}\u{628}\u{628}".bytes(), 0, 40.0, 0.0, mut out[..])!;
    Check.equalU64(3, run.count as u64)?;
    Check.equalU64(4, out[0].cluster as u64)?;
    Check.equalU64(0, out[2].cluster as u64)?;
    Check.isTrue(out[1].glyph != alone[0].glyph && out[2].glyph != alone[0].glyph, "joined letters leave the isolated form")?;
    // A zero-width non-joiner keeps them apart: both isolated.
    let apart = ras.shapeRun("\u{628}\u{200C}\u{628}".bytes(), 0, 40.0, 0.0, mut out[..])!;
    Check.equalU64(2, apart.count as u64)?;
    Check.isTrue(out[0].glyph == alone[0].glyph && out[1].glyph == alone[0].glyph, "ZWNJ breaks the join")?;
    return Ok();
}

@test
fn nastaliqHangsLettersByCursiveAttachment() -> Result<void, TestFailure> {
    let nastaliq = readFile("/System/Library/Fonts/NotoNastaliq.ttc");
    if (nastaliq.length == 0) {
        Console.writeLine("  (Noto Nastaliq not found: skipped)");
        return Ok();
    }
    var storage = heap(8388608);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(64, 64);
    c.imagePixels = 4;
    c.fontBytes = 2097152;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, nastaliq.view()), "Noto Nastaliq loads")?;
    // "pakistan": its letters join, and Nastaliq sets each joined letter higher than the next.
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 16];
    let run = ras.shapeRun("\u{67E}\u{627}\u{6A9}\u{633}\u{62A}\u{627}\u{646}".bytes(), 0, 40.0, 0.0, mut out[..])!;
    var raised = false;
    for (k in 0..run.count) {
        if (out[k].y < -1.0) {
            raised = true;
        }
    }
    Check.isTrue(run.count >= 5, "the word shapes")?;
    Check.isTrue(raised, "cursive attachment raises the joined letters")?;
    return Ok();
}

@test
fn devanagariAndTamilShapeAsHarfBuzzDoes() -> Result<void, TestFailure> {
    let kohinoor = readFile("/System/Library/Fonts/Kohinoor.ttc");
    let tamil = readFile("/System/Library/Fonts/Supplemental/Tamil Sangam MN.ttc");
    if (kohinoor.length == 0 || tamil.length == 0) {
        Console.writeLine("  (Kohinoor or Tamil Sangam MN not found: skipped)");
        return Ok();
    }
    var storage = heap(67108864);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(16, 16);
    c.imagePixels = 4;
    c.fontBytes = 33554432;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, kohinoor.view()), "Kohinoor loads")?;
    Check.isTrue(ras.loadFont(1, tamil.view()), "Tamil Sangam MN loads")?;
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 16];
    // हिन्दी: the i-matra moves before its consonant, न् takes its half form; hb-shape's glyphs.
    let hindi = ras.shapeRun("हिन्दी".bytes(), 0, 1000.0, 0.0, mut out[..])!;
    let hindiGlyphs = [780u32, 83, 577, 29];
    Check.equalU64(4, hindi.count as u64)?;
    for (k in 0usize..4) {
        Check.equalU64(hindiGlyphs[k] as u64, out[k].glyph as u64)?;
    }
    // கொண்டு: the two-part o splits around its consonant (its left part first); hb-shape's glyphs.
    let word = ras.shapeRun("கொண்டு".bytes(), 1, 1000.0, 0.0, mut out[..])!;
    let tamilGlyphs = [1229u32, 445, 1225, 479, 517];
    Check.equalU64(5, word.count as u64)?;
    for (k in 0usize..5) {
        Check.equalU64(tamilGlyphs[k] as u64, out[k].glyph as u64)?;
    }
    return Ok();
}

@test
fn caretsFollowTheGlyphsAsDrawn() -> Result<void, TestFailure> {
    let arial = readFile(arialPath());
    if (arial.length == 0) {
        Console.writeLine("  (Arial not found: skipped)");
        return Ok();
    }
    var storage = heap(8388608);
    let memory = FixedBufferAllocator.over(mut storage.viewMut());
    var c = RasterCapacity.of(64, 64);
    c.imagePixels = 4;
    c.fontBytes = 2097152;
    var ras = Raster.create(memory, c)!;
    Check.isTrue(ras.loadFont(0, arial.view()), "Arial loads")?;
    let config = TextConfig.of(40.0);
    // Left to right, a caret goes after the text before it.
    let latin = "ab".bytes();
    expect("after a", ras.caretX(latin, config, 1), ras.measure("a".bytes(), config).w)?;
    // "a ", then Hebrew alef bet drawn right to left: before alef is the run's right edge, before bet is between
    // them (alef's left edge), and the end of the text is the run's left edge, after bet.
    let mixed = "a \u{5D0}\u{5D1}".bytes();
    var out = [ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0 }; 8];
    let run = ras.shapeRun(mixed, 0, 40.0, 0.0, mut out[..])!;
    let start = ras.caretX(mixed, config, 2);
    let middle = ras.caretX(mixed, config, 4);
    let end = ras.caretX(mixed, config, 6);
    expect("before alef: the right end", start, run.width)?;
    expect("before bet: alef's left edge", middle, out[3].x)?;
    expect("at the end: bet's left edge", end, out[2].x)?;
    return Check.isTrue(end < middle && middle < start, "carets in the Hebrew run go right to left");
}
