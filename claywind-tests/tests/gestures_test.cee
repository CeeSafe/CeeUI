// SPDX-License-Identifier: MIT
// Gestures (gestures.cee): a platform's touches as taps (and double taps), long presses, pans and pinches aimed at
// the elements under where each began; the pointer they make for controls (a tap clicks, a pan or pinch or long press
// does not, a long press is a secondary press); a pan scrolling the scroll container under it along its axis, and its
// release flinging it until it slows to a stop; a finger down stopping a fling; a cancelled touch undoing its gesture;
// after a touch, no pointer left hovering and no frame asked for.

import claywind;

/// What one frame saw.
struct Seen {
    clicked: bool;
    pressed: bool;
    secondary: bool;
    tap: Tap?;
    longPress: bool;
    pan: Pan?;
    pinch: Pinch?;
    listPan: bool;
    needsFrame: bool;
}

/// A button (0, 0, 100 × 100) above a list (0, 100, 100 × 50) of ten rows of 20.
fn scene(ui: borrow mut Ui) {
    ui.open(Style.column().w(Size.fixed(400.0)).h(Size.fixed(300.0)));
    ui.open(Style.row().id("btn").size(Size.fixed(100.0)).bg(SLATE_800));
    ui.close();
    ui.open(Style.column().id("list").w(Size.fixed(100.0)).h(Size.fixed(50.0)).scroll(ScrollAxis.Vertical));
    for (i in 0..10) {
        ui.open(Style.row().size(Size.fixed(20.0)).bg(SLATE_800));
        ui.close();
    }
    ui.close();
    ui.close();
}

fn touch(platform: borrow mut FakePlatform, id: u32, phase: TouchPhase, x: f32, y: f32) {
    platform.touches[platform.touchCount] = Touch {
        id: id,
        phase: phase,
        position: Vec2 { x: x, y: y },
        time: platform.clock,
    };
    platform.touchCount += 1;
}

/// Runs a frame with the touches queued, then advances the clock by the frame's time.
fn frame(ui: borrow mut Ui, platform: borrow mut FakePlatform) -> Result<Seen, TestFailure> {
    ui.begin(mut platform);
    scene(mut ui);
    var seen = Seen {
        clicked: ui.clicked("btn"),
        pressed: ui.pressed("btn"),
        secondary: ui.secondaryPressedOn(hashId("btn")),
        tap: ui.tapOn("btn"),
        longPress: ui.longPressOn("btn") != null,
        pan: ui.pan(),
        pinch: ui.pinchOn("btn"),
        listPan: ui.panOn("list") != null,
        needsFrame: false,
    };
    finish(mut ui, mut platform)?;
    platform.touchCount = 0;
    platform.touchRead = 0;
    platform.clock += platform.dt as f64;
    seen.needsFrame = ui.needsFrame();
    return Ok(seen);
}

fn setUp(ui: borrow mut Ui, platform: borrow mut FakePlatform) -> Result<void, TestFailure> {
    // Two frames learn the boxes, the list's size (50) and content (200).
    for (f in 0..2) {
        let _ = frame(mut ui, mut platform)?;
    }
    return Ok();
}

fn phaseIs(p: GesturePhase, want: u32) -> bool => match (p) {
    GesturePhase.Began => want == 0,
    GesturePhase.Changed => want == 1,
    GesturePhase.Ended => want == 2,
    GesturePhase.Cancelled => want == 3,
};

@test
fn tapsClickAndCount() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    setUp(mut ui, mut platform)?;
    touch(mut platform, 1, TouchPhase.Began, 50.0, 50.0);
    var seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.pressed, "a finger down presses the button")?;
    Check.isTrue(!seen.clicked && seen.tap == null, "no click or tap yet")?;
    touch(mut platform, 1, TouchPhase.Moved, 54.0, 52.0);
    touch(mut platform, 1, TouchPhase.Ended, 54.0, 52.0);
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.clicked, "a lift within the slop clicks")?;
    match (seen.tap) {
        Some(t) => {
            expect("a tap's place", t.position.x, 54.0)?;
            Check.isTrue(t.count == 1, "one tap")?;
        }
        null => { return Check.isTrue(false, "a tap"); }
    }
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(!seen.pressed && !seen.clicked, "after the lift, nothing is pressed or under the pointer")?;
    // A second tap soon after, near the first: a double tap. Begun and lifted within one frame, it still clicks.
    touch(mut platform, 2, TouchPhase.Began, 56.0, 50.0);
    touch(mut platform, 2, TouchPhase.Ended, 56.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.clicked, "a tap within one frame clicks")?;
    match (seen.tap) {
        Some(t) => { Check.isTrue(t.count == 2, "a double tap")?; }
        null => { return Check.isTrue(false, "the second tap"); }
    }
    // Long after: one again.
    platform.clock += 1.0;
    touch(mut platform, 3, TouchPhase.Began, 56.0, 50.0);
    touch(mut platform, 3, TouchPhase.Ended, 56.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.tap) {
        Some(t) => { Check.isTrue(t.count == 1, "a tap long after is a single tap")?; }
        null => { return Check.isTrue(false, "the third tap"); }
    }
    // A cancelled finger is no tap and no click.
    touch(mut platform, 4, TouchPhase.Began, 50.0, 50.0);
    let _ = frame(mut ui, mut platform)?;
    touch(mut platform, 4, TouchPhase.Cancelled, 50.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    return Check.isTrue(!seen.clicked && seen.tap == null, "a cancelled touch neither taps nor clicks");
}

@test
fn longPressIsASecondaryPress() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    setUp(mut ui, mut platform)?;
    touch(mut platform, 1, TouchPhase.Began, 50.0, 50.0);
    var seen = frame(mut ui, mut platform)?;
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(!seen.longPress && !seen.needsFrame, "not yet, and nothing to draw")?;
    match (ui.frameDelay()) {
        Some(d) => { Check.isTrue(d > 0.45 && d < 0.5, "a held finger asks for a frame at the long press's time")?; }
        null => { return Check.isTrue(false, "a frame asked for the long press"); }
    }
    platform.clock += 0.6;
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.longPress, "held half a second: a long press")?;
    Check.isTrue(seen.secondary, "a long press is a secondary press")?;
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(!seen.longPress, "it fires once")?;
    touch(mut platform, 1, TouchPhase.Ended, 50.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    return Check.isTrue(!seen.clicked && seen.tap == null, "its lift neither taps nor clicks");
}

@test
fn panPhasesAndNoClick() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    setUp(mut ui, mut platform)?;
    touch(mut platform, 1, TouchPhase.Began, 20.0, 50.0);
    var seen = frame(mut ui, mut platform)?;
    touch(mut platform, 1, TouchPhase.Moved, 25.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.pan == null && seen.pressed, "within the slop: still a press")?;
    touch(mut platform, 1, TouchPhase.Moved, 40.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.pan) {
        Some(p) => {
            Check.isTrue(phaseIs(p.phase, 0), "past the slop: a pan begins")?;
            expect("its translation", p.translation().x, 20.0)?;
            expect("its first delta, from where the finger came down", p.delta.x, 20.0)?;
        }
        null => { return Check.isTrue(false, "a pan"); }
    }
    Check.isTrue(!seen.pressed, "a pan cancels the press")?;
    touch(mut platform, 1, TouchPhase.Moved, 60.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.pan) {
        Some(p) => {
            Check.isTrue(phaseIs(p.phase, 1), "then it changes")?;
            expect("by the frame's move", p.delta.x, 20.0)?;
        }
        null => { return Check.isTrue(false, "the pan's change"); }
    }
    touch(mut platform, 1, TouchPhase.Ended, 60.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.pan) {
        Some(p) => { Check.isTrue(phaseIs(p.phase, 2), "and ends at the lift")?; }
        null => { return Check.isTrue(false, "the pan's end"); }
    }
    return Check.isTrue(!seen.clicked && seen.tap == null, "a pan is no click and no tap");
}

@test
fn panScrollsAndFlings() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    setUp(mut ui, mut platform)?;
    // A slow drag up the list: the content follows the finger, and its rest before the lift means no fling.
    touch(mut platform, 1, TouchPhase.Began, 50.0, 140.0);
    var seen = frame(mut ui, mut platform)?;
    touch(mut platform, 1, TouchPhase.Moved, 50.0, 125.0);
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.listPan, "the pan began on the list")?;
    expect("past the slop, the content follows the finger", ui.scrollOffset("list").y, -15.0)?;
    touch(mut platform, 1, TouchPhase.Moved, 50.0, 115.0);
    seen = frame(mut ui, mut platform)?;
    expect("and keeps following it", ui.scrollOffset("list").y, -25.0)?;
    platform.clock += 0.5;
    touch(mut platform, 1, TouchPhase.Ended, 50.0, 115.0);
    seen = frame(mut ui, mut platform)?;
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(!seen.needsFrame, "a finger that rested before lifting does not fling")?;
    expect("so the list stays", ui.scrollOffset("list").y, -25.0)?;
    // A quick flick down (back up the content): the list flings on after the lift, slows, and stops.
    touch(mut platform, 2, TouchPhase.Began, 50.0, 110.0);
    seen = frame(mut ui, mut platform)?;
    touch(mut platform, 2, TouchPhase.Moved, 50.0, 122.0);
    seen = frame(mut ui, mut platform)?;
    expect("the flick moves the content", ui.scrollOffset("list").y, -13.0)?;
    touch(mut platform, 2, TouchPhase.Ended, 50.0, 122.0);
    seen = frame(mut ui, mut platform)?;
    let atLift = ui.scrollOffset("list").y;
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.needsFrame, "a quick release flings: frames go on")?;
    Check.isTrue(ui.scrollOffset("list").y > atLift, "the fling moves the list on")?;
    var frames = 0;
    while (seen.needsFrame && frames < 600) {
        seen = frame(mut ui, mut platform)?;
        frames += 1;
    }
    Check.isTrue(!seen.needsFrame, "the fling stops")?;
    return expect("at the top, where the edge stopped it", ui.scrollOffset("list").y, 0.0);
}

@test
fn fingerStopsFlingAndAxesChoose() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    setUp(mut ui, mut platform)?;
    // A flick up the content: a fling that would run for a while.
    touch(mut platform, 1, TouchPhase.Began, 50.0, 145.0);
    var seen = frame(mut ui, mut platform)?;
    touch(mut platform, 1, TouchPhase.Moved, 50.0, 125.0);
    touch(mut platform, 1, TouchPhase.Ended, 50.0, 125.0);
    seen = frame(mut ui, mut platform)?;
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.needsFrame, "flinging")?;
    // A finger down stops it where it is.
    touch(mut platform, 2, TouchPhase.Began, 50.0, 130.0);
    seen = frame(mut ui, mut platform)?;
    let held = ui.scrollOffset("list").y;
    seen = frame(mut ui, mut platform)?;
    expect("a finger down stops the fling", ui.scrollOffset("list").y, held)?;
    touch(mut platform, 2, TouchPhase.Ended, 50.0, 130.0);
    seen = frame(mut ui, mut platform)?;
    // A sideways pan does not move a list that scrolls only up and down.
    touch(mut platform, 3, TouchPhase.Began, 20.0, 125.0);
    seen = frame(mut ui, mut platform)?;
    touch(mut platform, 3, TouchPhase.Moved, 70.0, 127.0);
    seen = frame(mut ui, mut platform)?;
    expect("a sideways pan leaves the list", ui.scrollOffset("list").y, held)?;
    touch(mut platform, 3, TouchPhase.Ended, 70.0, 127.0);
    seen = frame(mut ui, mut platform)?;
    return Ok();
}

@test
fn pinchScalesAndCancelsTheTap() -> Result<void, TestFailure> {
    var storage = [0u8; 524288];
    let memory = FixedBufferAllocator.over(mut storage);
    var ui = Ui.create(memory, UiCapacity.of(64))!;
    var platform = platformAt(400.0, 300.0, -1.0, -1.0);
    setUp(mut ui, mut platform)?;
    touch(mut platform, 1, TouchPhase.Began, 40.0, 50.0);
    var seen = frame(mut ui, mut platform)?;
    touch(mut platform, 2, TouchPhase.Began, 60.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.pinch) {
        Some(p) => {
            Check.isTrue(phaseIs(p.phase, 0), "a second finger begins a pinch on the button")?;
            expect("its center", p.center.x, 50.0)?;
            expect("at scale 1", p.scale, 1.0)?;
        }
        null => { return Check.isTrue(false, "a pinch"); }
    }
    Check.isTrue(!seen.pressed, "a pinch cancels the press")?;
    touch(mut platform, 1, TouchPhase.Moved, 30.0, 50.0);
    touch(mut platform, 2, TouchPhase.Moved, 70.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.pinch) {
        Some(p) => {
            Check.isTrue(phaseIs(p.phase, 1), "spreading changes it")?;
            expect("to twice the distance", p.scale, 2.0)?;
            expect("this frame's factor", p.scaleDelta, 2.0)?;
        }
        null => { return Check.isTrue(false, "the pinch's change"); }
    }
    touch(mut platform, 2, TouchPhase.Moved, 60.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.pinch) {
        Some(p) => {
            expect("pinching back", p.scale, 1.5)?;
            expect("by a factor of 3/4", p.scaleDelta, 0.75)?;
        }
        null => { return Check.isTrue(false, "the pinch's second change"); }
    }
    touch(mut platform, 2, TouchPhase.Ended, 60.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    match (seen.pinch) {
        Some(p) => { Check.isTrue(phaseIs(p.phase, 2), "a finger's lift ends it")?; }
        null => { return Check.isTrue(false, "the pinch's end"); }
    }
    // The first finger is still down, but no new gesture starts until every finger is up.
    touch(mut platform, 1, TouchPhase.Moved, 80.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    Check.isTrue(seen.pan == null, "no pan from the finger left over")?;
    touch(mut platform, 1, TouchPhase.Ended, 80.0, 50.0);
    seen = frame(mut ui, mut platform)?;
    return Check.isTrue(!seen.clicked && seen.tap == null, "a pinch is no click and no tap");
}
