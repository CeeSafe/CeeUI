// SPDX-License-Identifier: MIT
// Background work for a CeeUI UI (roadmap P3, step 3). A Task runs jobs on threads of their own. A job sends what
// it finds to the UI thread through its TaskSender, which wakes the window (ADR 0142's WindowWaker): a host asleep in
// Window.waitEvent runs a frame at once, and the frame takes the results with `poll`. Starting a job again cancels the
// one before: its sender stops delivering (`send` is false, `cancelled` true), and what it sent already is dropped, so
// the UI sees only the latest job's results. No thread outlives its Task: dropping the Task cancels its jobs and waits
// for them, so a job checks `cancelled` (or a `send`'s result) often.
//
//     var primes = Task<Found>.create(16, window.waker())!;
//     if (clicked(ui, "count")) {
//         primes.start(Box.create(move (out: borrow TaskSender<Found>) => { ... out.send(found); ... })!)!;
//     }
//     loop {
//         match (primes.poll(mut ui)) {
//             Some(found) => { app.found = found; }
//             null => { break; }
//         }
//     }

import ceeui;

/// A value a job sent, with the job's number.
struct Delivery<T> {
    job: u64;
    value: T;
}

/// What a job holds to send its results to the UI thread: a value at a time, each waking the window.
public struct TaskSender<T: Send> {
    channel: Channel<Delivery<T>>;
    waker: WindowWaker?;
    latest: Arc<AtomicU64>;
    job: u64;

    /// Whether the job was cancelled (another started, or the Task was dropped): it should stop.
    public fn cancelled(borrow this) -> bool => this.latest.get().load() != this.job;

    /// Sends `value` to the UI thread and wakes the window, waiting while the UI has not taken what came before
    /// (the Task's capacity). False, and nothing sent, once the job was cancelled.
    public fn send(borrow this, value: T) -> bool {
        if (this.cancelled()) {
            return false;
        }
        match (this.channel.send(Delivery { job: this.job, value: value })) {
            Ok() => {
                this.wake();
                return true;
            }
            Err(_) => { return false; }
        }
    }

    /// Wakes the window, if there is one.
    fn wake(borrow this) {
        match (this.waker) {
            Some(w) => { w.wake(); }
            null => {}
        }
    }
}

/// A job's thread, and whether the job has returned (so joining it does not wait).
struct Running {
    job: u64;
    done: Arc<AtomicU32>;
    thread: Thread<void>;
}

/// Background jobs whose results a UI shows: one at a time, the latest started.
public struct Task<T: Send> {
    channel: Channel<Delivery<T>>;
    waker: WindowWaker?;
    latest: Arc<AtomicU64>;
    jobs: Vector<Running>;

    /// A Task whose jobs can send `capacity` values ahead of the UI, waking the window of `waker` (null: a host
    /// without a window, which runs frames anyway).
    public fn create(capacity: usize, waker: WindowWaker?) -> Result<Task<T>, AllocError> {
        return Ok(Task {
            channel: Channel<Delivery<T>>.create(capacity)?,
            waker: waker,
            latest: Arc<AtomicU64>.create(AtomicU64.create(0))?,
            jobs: Vector<Running>.create(),
        });
    }

    /// Starts `job` on a thread of its own, cancelling the job before it. It gets the sender of its results; when
    /// it returns, the window is woken once more, so the UI sees it stop running.
    public fn start(borrow mut this, job: Box<dyn mut fn(borrow TaskSender<T>) + Send>) -> Result<void, SpawnError> {
        let number = this.latest.get().fetchAdd(1) + 1;
        let out = TaskSender {
            channel: this.channel.clone(),
            waker: this.waker,
            latest: this.latest.clone(),
            job: number,
        };
        let done = match (Arc<AtomicU32>.create(AtomicU32.create(0))) {
            Ok(d) => d,
            Err(_) => { return Err(SpawnError.Resources); }
        };
        let flag = done.clone();
        var run = job;
        let thread = Thread.spawn(move () => {
            run(out);
            flag.get().store(1);
            out.wake();
        })?;
        match (this.jobs.push(Running { job: number, done: done, thread: thread })) {
            Ok() => {}
            Err(_) => { return Err(SpawnError.Resources); }
        }
        return Ok();
    }

    /// Cancels the running job: it sends nothing more, and what it sent is dropped.
    public fn cancel(borrow mut this) {
        this.latest.get().fetchAdd(1);
    }

    /// Whether the latest job is still running.
    public fn running(borrow this) -> bool {
        let latest = this.latest.get().load();
        for (k in 0..this.jobs.length) {
            if (this.jobs[k].job == latest && this.jobs[k].done.get().load() == 0) {
                return true;
            }
        }
        return false;
    }

    /// The next value the latest job sent, or null when there is none now: call it until null in each frame. A value
    /// asks `ui` for another frame, to show what it changed. It also joins the jobs that returned.
    public fn poll(borrow mut this, ui: borrow mut Ui) -> T? {
        this.reap();
        let latest = this.latest.get().load();
        loop {
            match (this.channel.tryRecv()) {
                Some(d) => {
                    if (d.job == latest) {
                        ui.requestFrame();
                        return d.value;
                    }
                }
                null => { return null; }
            }
        }
    }

    /// Joins the jobs that have returned.
    fn reap(borrow mut this) {
        var k: usize = 0;
        while (k < this.jobs.length) {
            if (this.jobs[k].done.get().load() == 1) {
                let r = this.jobs.swapRemove(k);
                r.thread.join();
            } else {
                k += 1;
            }
        }
    }

    drop {
        // Cancel, release a job waiting to send, and wait for every job to return.
        this.latest.get().fetchAdd(1);
        this.channel.close();
        loop {
            match (this.jobs.pop()) {
                Some(r) => { r.thread.join(); }
                null => { break; }
            }
        }
    }
}
