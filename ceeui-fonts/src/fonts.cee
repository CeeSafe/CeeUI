// SPDX-License-Identifier: MIT
// The system's fonts for CeeUI, which reads no files itself. `SystemFonts` keeps a catalog of the faces
// in the OS's font folders, read only as far as choosing a fallback needs (each face's table directory, OS/2 and
// cmap), and `supply` loads into a Raster the faces that cover characters its fonts lack, adding them to its
// fallback chain. The catalog is built the first time a character is missing, so Latin-only text never scans.

import ceeui;

/// The code points the catalog keeps coverage for: planes 0 to 2 (emoji and the CJK extensions too), in blocks of
/// 256 code points.
const BLOCKS: usize = 768;

/// The font id of catalog face `k` once loaded: the same in every Raster it is loaded into.
const FIRST_ID: u32 = 64;

/// The largest cmap table read (a CJK font's is a few hundred kilobytes).
const MAX_CMAP: usize = 8388608;

/// A face in the system's fonts.
struct Face {
    path: String;
    face: u32;
    /// OS/2's weight class (400 regular) and whether it is italic.
    weight: u32;
    italic: bool;
    /// Sans-serif by its PANOSE serif style (OS/2): what a user interface wants.
    sans: bool;
    /// The file's size: of two faces that cover as much, the smaller costs less memory once loaded.
    size: usize;
    /// How many code points it maps in each block of 256 (ceeui's cmapCoverage).
    coverage: Vector<u16>;
    /// A colour-bitmap face (sbix or CBDT): loaded without its bitmaps, which are read as frames draw them.
    bitmap: bool;
    /// A colour face (sbix, CBDT or COLR): an emoji's first choice.
    color: bool;
}

/// A colour-bitmap face loaded into a Raster: where its bitmaps are in its file.
struct BitmapFace {
    id: u32;
    path: String;
    /// sbix: each strike's offset in the file and its pixels per em (empty for CBDT).
    strikeAt: Vector<usize>;
    strikePpem: Vector<u32>;
    /// CBDT's offset in the file, and the CBLC table that indexes it (0 and empty for sbix).
    cbdt: usize;
    cblc: Vector<u8>;
}

/// The system's fonts, as a catalog and a supplier of fallbacks.
public struct SystemFonts {
    faces: Vector<Face>;
    scanned: bool;
    /// Characters no system font has: not looked for again.
    hopeless: Vector<u32>;
    cmap: Vector<u8>;
    /// The faces loaded so far, into any Raster.
    public loaded: u32;
    /// Their files, in the order they were first loaded.
    files: Vector<String>;
    /// The colour-bitmap faces loaded, by font id.
    bitmaps: Vector<BitmapFace>;
    /// How long building the catalog took, in milliseconds (0 until it was built).
    public scanMs: f64;
}

fn readAt(file: borrow File, offset: usize, out: borrow mut Vector<u8>, length: usize) -> bool {
    out.clear();
    for (i in 0..length) {
        if (out.push(0).isErr()) {
            return false;
        }
    }
    var got: usize = 0;
    while (got < length) {
        let n = match (file.readAt(mut out.viewMut()[got..length], (offset + got) as u64)) {
            Ok(k) => k,
            Err(_) => { return false; }
        };
        if (n == 0) {
            return false;
        }
        got += n;
    }
    return true;
}

/// Reads `out.length` bytes at `offset` straight into `out`.
fn readInto(file: borrow File, offset: usize, out: SliceMut<u8>) -> bool {
    var got: usize = 0;
    while (got < out.length) {
        let n = match (file.readAt(mut out[got..out.length], (offset + got) as u64)) {
            Ok(k) => k,
            Err(_) => { return false; }
        };
        if (n == 0) {
            return false;
        }
        got += n;
    }
    return true;
}

fn u16be(d: Slice<u8>, at: usize) -> u32 => ((d[at] as u32) << 8) | (d[at + 1] as u32);

/// A signed 16-bit big-endian value, as a float.
fn i16be(d: Slice<u8>, at: usize) -> f32 {
    let v = u16be(d, at);
    return if (v >= 0x8000) round<f32>(v) - 65536.0 else round<f32>(v);
}

/// A signed byte, as a float.
fn i8f(b: u8) -> f32 => if (b >= 0x80) round<f32>(b as u32) - 256.0 else round<f32>(b as u32);

fn u32be(d: Slice<u8>, at: usize) -> u32 => (u16be(d, at) << 16) | u16be(d, at + 2);

/// Whether `name` ends in a font file extension: .ttf, .ttc, .otf or .otc, in any case.
fn fontFile(name: StringView) -> bool {
    let b = name.bytes();
    if (b.length < 4 || b[b.length - 4] != '.') {
        return false;
    }
    let x = b[b.length - 3] | 0x20;
    let y = b[b.length - 2] | 0x20;
    let z = b[b.length - 1] | 0x20;
    return (x == 't' && y == 't' && (z == 'f' || z == 'c')) || (x == 'o' && y == 't' && (z == 'f' || z == 'c'));
}

fn joined(dir: StringView, name: StringView) -> String? {
    var s = match (String.withCapacity(dir.length + 1 + name.length)) {
        Ok(x) => x,
        Err(_) => { return null; }
    };
    if (s.append(dir).isErr() || s.append("/").isErr() || s.append(name).isErr()) {
        return null;
    }
    return s;
}

impl SystemFonts {
    public fn create() -> SystemFonts => SystemFonts {
        faces: Vector<Face>.create(),
        scanned: false,
        hopeless: Vector<u32>.create(),
        cmap: Vector<u8>.create(),
        loaded: 0,
        files: Vector<String>.create(),
        bitmaps: Vector<BitmapFace>.create(),
        scanMs: 0.0,
    };

    /// How many different font files were loaded, and each one's path.
    public fn loadedFileCount(borrow this) -> usize => this.files.length;
    public fn loadedFile(borrow this, k: usize) -> StringView => this.files[k].view();

    /// How many faces the catalog holds (0 until a character was missing).
    public fn faceCount(borrow this) -> usize => this.faces.length;

    /// Loads into `raster` system faces for the characters of `utf8` that a run in font `fontId` has no glyph for,
    /// adding each to the fallback chain: how many it loaded (lay the frame out again when any were).
    public fn supply(borrow mut this, raster: borrow mut Raster, utf8: Slice<u8>, fontId: u32) -> u32 {
        var added: u32 = 0;
        var i: usize = 0;
        var previous: u32 = 0;
        while (i < utf8.length) {
            let cp = decodeUtf8(utf8, i);
            i += cp[1] as usize;
            // An emoji sequence (VS16, a keycap, ZWJ, a skin tone) after a character only a text font has: a colour
            // face for that character.
            let before = previous;
            previous = cp[0];
            let sequence =
                cp[0] == 0xFE0F || cp[0] == 0x20E3 || cp[0] == 0x200D || (cp[0] >= 0x1F3FB && cp[0] <= 0x1F3FF);
            if (sequence && before != 0 && !raster.coversInColor(
                fontId,
                before,
            ) && !this.isHopeless(before | 0x80000000)) {
                if (!this.scanned) {
                    this.scan();
                }
                var found = false;
                match (this.choose(before, true, raster.fontWeight(fontId))) {
                    Some(k) => {
                        if (this.faces[k].color) {
                            let id = FIRST_ID + truncate<u32>(k);
                            if (this.load(raster, k, id) && raster.addFallback(id)) {
                                added += 1;
                                this.loaded += 1;
                                found = raster.coversInColor(fontId, before);
                            }
                        }
                    }
                    null => {}
                }
                if (!found) {
                    let ignored = this.hopeless.push(before | 0x80000000);
                }
            }
            // A private-use character means something else in every font: none is looked for.
            let privateUse = (cp[0] >= 0xE000 && cp[0] <= 0xF8FF) || cp[0] >= 0xF0000;
            if (cp[0] < 0x80 || privateUse) {
                continue;
            }
            // Drawn already, but from a face of another weight (a bold run's Arabic from a regular face): a face of
            // the run's weight, when the system has one, loaded too (asked once a character and direction).
            let want = raster.fontWeight(fontId);
            match (raster.coveringWeight(fontId, cp[0])) {
                Some(w) => {
                    let off = if (w > want) w - want else want - w;
                    let asked = cp[0] | (if (want > w) 0x40000000u32 else 0x20000000u32);
                    if (off >= 200 && !this.isHopeless(asked)) {
                        let ignored = this.hopeless.push(asked);
                        if (!this.scanned) {
                            this.scan();
                        }
                        match (this.choose(cp[0], false, want)) {
                            Some(k) => {
                                let id = FIRST_ID + truncate<u32>(k);
                                let fw = this.faces[k].weight;
                                let nearer = (if (fw > want) fw - want else want - fw) < off;
                                if (nearer && !raster.hasFont(id) && this.load(
                                    raster,
                                    k,
                                    id,
                                ) && raster.addFallback(id)) {
                                    added += 1;
                                    this.loaded += 1;
                                }
                            }
                            null => {}
                        }
                    }
                    continue;
                }
                null => {}
            }
            if (this.isHopeless(cp[0])) {
                continue;
            }
            if (!this.scanned) {
                this.scan();
            }
            var done = false;
            match (this.choose(cp[0], false, want)) {
                Some(k) => {
                    let id = FIRST_ID + truncate<u32>(k);
                    if (this.load(raster, k, id) && raster.addFallback(id)) {
                        added += 1;
                        this.loaded += 1;
                        done = raster.covers(fontId, cp[0]);
                    }
                }
                null => {}
            }
            if (!done) {
                let ignored = this.hopeless.push(cp[0]);
            }
        }
        return added;
    }

    /// `supply` for every text run of `ui`'s laid-out frame.
    public fn supplyFrame(borrow mut this, raster: borrow mut Raster, ui: borrow Ui) -> u32 {
        var added: u32 = 0;
        for (k in 0..ui.commandCount()) {
            let command = ui.commandAt(k);
            match (command) {
                Command.Text(_, run) => { added += this.supply(raster, ui.textOf(command), run.fontId); }
                _ => {}
            }
        }
        for (k in 0..ui.commandCount()) {
            let command = ui.commandAt(k);
            match (command) {
                Command.Text(_, run) => {
                    let size = if (run.fontSize > 0.0) run.fontSize else 16.0;
                    added += this.supplyBitmaps(raster, ui.textOf(command), run.fontId, size, run.letterSpacing);
                }
                _ => {}
            }
        }
        return added;
    }

    /// Supplies `raster` the colour bitmaps that `utf8`, drawn in font `fontId` at `size` units per em (at the
    /// Raster's pixel ratio), takes from colour-bitmap faces and it lacks, read from their files: how many.
    public fn supplyBitmaps(
        borrow mut this,
        raster: borrow mut Raster,
        utf8: Slice<u8>,
        fontId: u32,
        size: f32,
        letterSpacing: f32,
    ) -> u32 {
        if (this.bitmaps.length == 0 || utf8.length == 0) {
            return 0;
        }
        var glyphs = Vector<ShapedGlyph>.create();
        for (i in 0..utf8.length) {
            if (glyphs.push(ShapedGlyph { font: 0, glyph: 0, x: 0.0, y: 0.0, cluster: 0, advance: 0.0 }).isErr()) {
                return 0;
            }
        }
        let run = match (raster.shapeRun(utf8, fontId, size, letterSpacing, mut glyphs.viewMut())) {
            Some(r) => r,
            null => { return 0; }
        };
        var added: u32 = 0;
        var png = Vector<u8>.create();
        var scratch = Vector<u8>.create();
        for (k in 0..run.count) {
            let g = glyphs[k];
            if (!raster.isBitmapFont(g.font)) {
                continue;
            }
            let strike = raster.bitmapStrike(g.font, size * raster.pixelRatio());
            if (raster.hasColorBitmap(g.font, g.glyph, strike)) {
                continue;
            }
            // The strike asked for, else the nearest that has the glyph (a bigger one first).
            var place: [f32; 3]? = null;
            for (b in 0..this.bitmaps.length) {
                let index = match (raster.fontIndex(this.bitmaps[b].id)) {
                    Some(i) => i,
                    null => 0xFFFFFFFF,
                };
                if (index == g.font) {
                    place = readNearestBitmap(borrow this.bitmaps[b], strike, g.glyph, mut png);
                }
            }
            let at = match (place) {
                Some(p) => p,
                null => {
                    let none = Vector<u8>.create();
                    let recorded = raster.addColorBitmap(
                        g.font,
                        g.glyph,
                        strike,
                        0,
                        none.view(),
                        0.0,
                        0.0,
                        mut scratch.viewMut(),
                    );
                    continue;
                }
            };
            let needed = match (imageInfo(png.view())) {
                Ok(info) => info.scratchBytes,
                Err(_) => 0,
            };
            while (scratch.length < needed) {
                if (scratch.push(0).isErr()) {
                    return added;
                }
            }
            let from = truncate<u32>(Math.round(at[2]));
            if (raster.addColorBitmap(g.font, g.glyph, strike, from, png.view(), at[0], at[1], mut scratch.viewMut())) {
                added += 1;
            }
        }
        return added;
    }

    fn isHopeless(borrow this, cp: u32) -> bool {
        for (h in this.hopeless) {
            if (h == cp) {
                return true;
            }
        }
        return false;
    }

    /// Catalog face `k` into `raster` as font `id` (the whole file: a collection's faces share its tables; a
    /// colour-bitmap face without its bitmaps).
    fn load(borrow mut this, raster: borrow mut Raster, k: usize, id: u32) -> bool {
        if (this.faces[k].bitmap) {
            return this.loadBitmapFace(raster, k, id);
        }
        let face = this.faces[k].face;
        let file = match (File.open(this.faces[k].path.view())) {
            Ok(f) => f,
            Err(_) => { return false; }
        };
        let length = match (file.length()) {
            Ok(n) => n as usize,
            Err(_) => { return false; }
        };
        var bytes = Vector<u8>.create();
        if (!readAt(file, 0, mut bytes, length)) {
            return false;
        }
        if (!raster.loadFontFace(id, bytes.view(), face)) {
            return false;
        }
        this.remember(k);
        return true;
    }

    /// Adds catalog face `k`'s file to the files loaded, once.
    fn remember(borrow mut this, k: usize) {
        var known = false;
        for (f in this.files) {
            known = known || f.view() == this.faces[k].path.view();
        }
        if (!known) {
            match (this.faces[k].path.clone()) {
                Ok(p) => { let ignored = this.files.push(p); }
                Err(_) => {}
            }
        }
    }

    /// Colour-bitmap face `k` into `raster` as font `id`: a font of its own tables but the bitmaps (sbix, CBDT),
    /// its strikes named to the Raster, and where its bitmaps are kept for `supplyBitmaps`.
    fn loadBitmapFace(borrow mut this, raster: borrow mut Raster, k: usize, id: u32) -> bool {
        let file = match (File.open(this.faces[k].path.view())) {
            Ok(f) => f,
            Err(_) => { return false; }
        };
        var head = Vector<u8>.create();
        if (!readAt(file, 0, mut head, 12)) {
            return false;
        }
        let faces = fontFaceCount(head.view());
        if (faces > 1 && !readAt(file, 0, mut head, 12 + (faces as usize) * 4)) {
            return false;
        }
        let at = match (faceDirectory(head.view(), this.faces[k].face)) {
            Some(a) => a,
            null => { return false; }
        };
        var dir = Vector<u8>.create();
        if (!readAt(file, at, mut dir, 12)) {
            return false;
        }
        let tables = u16be(dir.view(), 4) as usize;
        if (!readAt(file, at, mut dir, 12 + tables * 16)) {
            return false;
        }
        // The kept tables, in the directory's (sorted) order, each at a 4-byte boundary after the new directory.
        var kept: usize = 0;
        var total: usize = 0;
        for (t in 0..tables) {
            let r = 12 + t * 16;
            if (!isBitmapData(dir.view(), r)) {
                kept += 1;
                total += (u32be(dir.view(), r + 12) as usize + 3) & 0xFFFFFFFC;
            }
        }
        var font = Vector<u8>.create();
        let start = 12 + kept * 16;
        for (i in 0..start + total) {
            if (font.push(0).isErr()) {
                return false;
            }
        }
        for (i in 0..4) {
            font[i] = dir[i];
        }
        font[4] = truncate<u8>(kept >> 8);
        font[5] = truncate<u8>(kept);
        var next = start;
        var w: usize = 12;
        for (t in 0..tables) {
            let r = 12 + t * 16;
            if (isBitmapData(dir.view(), r)) {
                continue;
            }
            let offset = u32be(dir.view(), r + 8) as usize;
            let length = u32be(dir.view(), r + 12) as usize;
            for (i in 0..8) {
                font[w + i] = dir[r + i];
            }
            putU32(mut font, w + 8, next);
            putU32(mut font, w + 12, length);
            if (!readInto(file, offset, mut font.viewMut()[next..next + length])) {
                return false;
            }
            w += 16;
            next += (length + 3) & 0xFFFFFFFC;
        }
        if (!raster.loadFontFace(id, font.view(), 0)) {
            return false;
        }
        var b = BitmapFace {
            id: id,
            path: match (this.faces[k].path.clone()) {
                Ok(p) => p,
                Err(_) => { return false; }
            },
            strikeAt: Vector<usize>.create(),
            strikePpem: Vector<u32>.create(),
            cbdt: 0,
            cblc: Vector<u8>.create(),
        };
        var ppems = Vector<u32>.create();
        var bytes = Vector<u8>.create();
        match (findTable(dir.view(), ['s', 'b', 'i', 'x'])) {
            Some(t) => {
                if (readAt(file, t.offset, mut bytes, 8)) {
                    let strikes = (u32be(bytes.view(), 4) as usize).min(16);
                    if (readAt(file, t.offset, mut bytes, 8 + strikes * 4)) {
                        var offsets = Vector<usize>.create();
                        for (s in 0..strikes) {
                            let ignored = offsets.push(t.offset + u32be(bytes.view(), 8 + s * 4) as usize);
                        }
                        for (o in offsets) {
                            if (readAt(file, o, mut bytes, 4)) {
                                let ppem = u16be(bytes.view(), 0);
                                let a = b.strikeAt.push(o);
                                let p = b.strikePpem.push(ppem);
                                let q = ppems.push(ppem);
                            }
                        }
                    }
                }
            }
            null => {}
        }
        match (findTable(dir.view(), ['C', 'B', 'D', 'T'])) {
            Some(t) => { b.cbdt = t.offset; }
            null => {}
        }
        match (findTable(dir.view(), ['C', 'B', 'L', 'C'])) {
            Some(t) => {
                if (t.length >= 8 && readAt(file, t.offset, mut b.cblc, t.length)) {
                    let sizes = (u32be(b.cblc.view(), 4) as usize).min(16);
                    for (i in 0..sizes) {
                        let r = 8 + i * 48;
                        if (r + 48 <= b.cblc.length) {
                            let q = ppems.push(b.cblc[r + 45] as u32);
                        }
                    }
                }
            }
            null => {}
        }
        let named = raster.setBitmapStrikes(id, ppems.view());
        let ignored = this.bitmaps.push(b);
        this.remember(k);
        return true;
    }

    /// The face that best covers `cp` (see `better`; a colour face first when `color`), one whose cmap really maps
    /// it.
    /// The catalog face to draw `cp` with: in colour first when `color`, nearest `weight` (a run's font's).
    fn choose(borrow mut this, cp: u32, color: bool, weight: u32) -> usize? {
        let block = (cp >> 8) as usize;
        if (block >= BLOCKS) {
            return null;
        }
        // An emoji comes from a colour face when one covers it, before a monochrome symbol font.
        let emoji = color || isPictographic(cp);
        var most: u32 = 0;
        for (f in this.faces) {
            most = most.max(f.coverage[block] as u32);
        }
        var tried = Vector<usize>.create();
        for (attempt in 0..8) {
            var best: usize? = null;
            for (k in 0..this.faces.length) {
                let f = borrow this.faces[k];
                if (f.coverage[block] == 0 || contains(tried, k)) {
                    continue;
                }
                match (best) {
                    Some(b) => {
                        if (better(f, borrow this.faces[b], block, most, emoji, weight)) {
                            best = k;
                        }
                    }
                    null => { best = k; }
                }
            }
            let k = match (best) {
                Some(b) => b,
                null => { return null; }
            };
            if (this.maps(k, cp)) {
                return k;
            }
            let ignored = tried.push(k);
        }
        return null;
    }

    /// Whether catalog face `k`'s cmap maps `cp`.
    fn maps(borrow mut this, k: usize, cp: u32) -> bool {
        let file = match (File.open(this.faces[k].path.view())) {
            Ok(f) => f,
            Err(_) => { return false; }
        };
        let face = this.faces[k].face;
        return match (readCmap(file, face, mut this.cmap)) {
            Some(_) => cmapGlyph(this.cmap.view(), cp) != 0,
            null => false,
        };
    }

    /// Reads every TrueType face in the system's font folders into the catalog.
    fn scan(borrow mut this) {
        this.scanned = true;
        let started = Clock.monotonicNanos();
        this.scanFolders();
        this.scanMs = round<f64>(Clock.monotonicNanos() - started) / 1000000.0;
    }

    fn scanFolders(borrow mut this) {
        match (Environment.variable("CEEUI_FONT_PATH")) {
            Some(d) => { this.walk(d, 0); }
            null => {}
        }
        // Android keeps its fonts in /system/fonts (and, from Android 10, some in /product/fonts).
        let fixed: [StringView; 8] = [
            "/System/Library/Fonts",
            "/Library/Fonts",
            "C:/Windows/Fonts",
            "/usr/share/fonts",
            "/usr/local/share/fonts",
            "/usr/X11R6/lib/X11/fonts",
            "/system/fonts",
            "/product/fonts",
        ];
        for (d in fixed) {
            this.walk(d, 0);
        }
        let home = Environment.variable("HOME") ?? "";
        let local = Environment.variable("LOCALAPPDATA") ?? "";
        let suffixes: [StringView; 3] = ["/Library/Fonts", "/.local/share/fonts", "/.fonts"];
        if (home.length > 0) {
            for (s in suffixes) {
                match (joined(home, s[1..s.length])) {
                    Some(p) => { this.walk(p.view(), 0); }
                    null => {}
                }
            }
        }
        if (local.length > 0) {
            match (joined(local, "Microsoft/Windows/Fonts")) {
                Some(p) => { this.walk(p.view(), 0); }
                null => {}
            }
        }
    }

    /// The font files under `dir`, four folders deep at most (Linux keeps fonts in nested folders).
    fn walk(borrow mut this, dir: StringView, depth: u32) {
        let names = match (Directory.list(dir)) {
            Ok(n) => n,
            Err(_) => { return; }
        };
        for (name in names) {
            if (name.length == 0 || name[0] == '.') {
                continue;
            }
            let path = match (joined(dir, name.view())) {
                Some(p) => p,
                null => { continue; }
            };
            if (fontFile(name.view())) {
                this.addFile(path);
            } else if (depth < 4) {
                match (File.kind(path.view())) {
                    Ok(Some(PathKind.Directory)) => { this.walk(path.view(), depth + 1); }
                    _ => {}
                }
            }
        }
    }

    /// Each face of the font file at `path` that ceeui draws (TrueType or CFF outlines, or sbix or CBDT colour
    /// bitmaps): its weight, style and coverage. CFF2 faces are left out.
    fn addFile(borrow mut this, path: String) {
        let file = match (File.open(path.view())) {
            Ok(f) => f,
            Err(_) => { return; }
        };
        var head = Vector<u8>.create();
        if (!readAt(file, 0, mut head, 12)) {
            return;
        }
        let faces = fontFaceCount(head.view());
        if (faces == 0 || faces > 64) {
            return;
        }
        if (faces > 1 && !readAt(file, 0, mut head, 12 + (faces as usize) * 4)) {
            return;
        }
        var dir = Vector<u8>.create();
        var os2 = Vector<u8>.create();
        for (face in 0..faces) {
            let at = match (faceDirectory(head.view(), face)) {
                Some(a) => a,
                null => { continue; }
            };
            if (!readAt(file, at, mut dir, 12)) {
                continue;
            }
            let tables = u16be(dir.view(), 4) as usize;
            if (!readAt(file, at, mut dir, 12 + tables * 16)) {
                continue;
            }
            let bitmap = findTable(dir.view(), ['s', 'b', 'i', 'x']) != null ||
                (findTable(
                    dir.view(),
                    ['C', 'B', 'D', 'T'],
                ) != null && findTable(dir.view(), ['C', 'B', 'L', 'C']) != null);
            if (!drawableFace(dir.view()) && !bitmap) {
                continue;
            }
            var weight: u32 = 400;
            var italic = false;
            var sans = false;
            match (findTable(dir.view(), ['O', 'S', '/', '2'])) {
                Some(t) => {
                    if (t.length >= 64 && readAt(file, t.offset, mut os2, 64)) {
                        weight = u16be(os2.view(), 4);
                        italic = (u16be(os2.view(), 62) & 1) != 0;
                        let serifStyle = os2[33];
                        sans = os2[32] == 2 && serifStyle >= 11 && serifStyle <= 13;
                    }
                }
                null => {}
            }
            if (readCmap(file, face, mut this.cmap) == null) {
                continue;
            }
            var coverage = Vector<u16>.create();
            for (b in 0..BLOCKS) {
                if (coverage.push(0).isErr()) {
                    return;
                }
            }
            cmapCoverage(this.cmap.view(), mut coverage.viewMut());
            let copy = match (path.clone()) {
                Ok(c) => c,
                Err(_) => { return; }
            };
            let size = match (file.length()) {
                Ok(n) => n as usize,
                Err(_) => 0,
            };
            let ignored = this.faces.push(Face {
                path: copy,
                face: face,
                weight: weight,
                italic: italic,
                sans: sans,
                size: size,
                coverage: coverage,
                bitmap: bitmap,
                color: bitmap || findTable(dir.view(), ['C', 'O', 'L', 'R']) != null,
            });
        }
    }
}

/// Face `face`'s cmap table of an open font file into `out`; null when it has none or it is too big.
fn readCmap(file: borrow File, face: u32, out: borrow mut Vector<u8>) -> usize? {
    var head = Vector<u8>.create();
    if (!readAt(file, 0, mut head, 12)) {
        return null;
    }
    let faces = fontFaceCount(head.view());
    if (faces > 1 && !readAt(file, 0, mut head, 12 + (faces as usize) * 4)) {
        return null;
    }
    let at = faceDirectory(head.view(), face)?;
    var dir = Vector<u8>.create();
    if (!readAt(file, at, mut dir, 12)) {
        return null;
    }
    let tables = u16be(dir.view(), 4) as usize;
    if (!readAt(file, at, mut dir, 12 + tables * 16)) {
        return null;
    }
    let t = findTable(dir.view(), ['c', 'm', 'a', 'p'])?;
    if (t.length > MAX_CMAP || !readAt(file, t.offset, mut out, t.length)) {
        return null;
    }
    return t.length;
}

fn contains(v: borrow Vector<usize>, x: usize) -> bool {
    for (y in v) {
        if (y == x) {
            return true;
        }
    }
    return false;
}

/// Whether face `a` is a better choice for `block` than face `b`, when the best covers `most` of its code points:
/// for an emoji, a colour face first; then covering nearly as much as the best (90 %), then sans-serif, then the weight nearer 400, then upright, then the
/// smaller file, then covering more.
fn better(a: borrow Face, b: borrow Face, block: usize, most: u32, emoji: bool, weight: u32) -> bool {
    if (emoji && a.color != b.color) {
        return a.color;
    }
    let ca = a.coverage[block] as u32;
    let cb = b.coverage[block] as u32;
    let fullA = ca * 10 >= most * 9;
    let fullB = cb * 10 >= most * 9;
    if (fullA != fullB) {
        return fullA;
    }
    if (a.sans != b.sans) {
        return a.sans;
    }
    let da = if (a.weight > weight) a.weight - weight else weight - a.weight;
    let db = if (b.weight > weight) b.weight - weight else weight - b.weight;
    if (da != db) {
        return da < db;
    }
    if (a.italic != b.italic) {
        return !a.italic;
    }
    if (a.size != b.size) {
        return a.size < b.size;
    }
    return ca > cb;
}

/// Whether the table record at `r` of a face's directory holds colour bitmaps (sbix, CBDT), which a Raster is
/// loaded without.
fn isBitmapData(dir: Slice<u8>, r: usize) -> bool {
    let tag = u32be(dir, r);
    return tag == 0x73626978 || tag == 0x43424454;
}

fn putU32(v: borrow mut Vector<u8>, at: usize, x: usize) {
    v[at] = truncate<u8>(x >> 24);
    v[at + 1] = truncate<u8>(x >> 16);
    v[at + 2] = truncate<u8>(x >> 8);
    v[at + 3] = truncate<u8>(x);
}

/// Glyph `glyph`'s bitmap in face `b` at strike `ppem`, or else at the nearest strike that has it (a bigger one
/// first): readBitmap's offsets, and the strike it came from.
fn readNearestBitmap(b: borrow BitmapFace, ppem: u32, glyph: u32, png: borrow mut Vector<u8>) -> [f32; 3]? {
    match (readBitmap(b, ppem, glyph, png)) {
        Some(p) => { return [p[0], p[1], round<f32>(ppem)]; }
        null => {}
    }
    // Bigger strikes, smallest first; then smaller ones, biggest first.
    for (pass in 0..2) {
        var tried = ppem;
        loop {
            var next: u32 = 0;
            for (p in b.strikePpem) {
                let wanted =
                    if (pass == 0) p > tried && (next == 0 || p < next) else p < tried && (next == 0 || p > next);
                if (wanted) {
                    next = p;
                }
            }
            if (next == 0) {
                break;
            }
            tried = next;
            match (readBitmap(b, next, glyph, png)) {
                Some(p) => { return [p[0], p[1], round<f32>(next)]; }
                null => {}
            }
        }
    }
    return null;
}

/// Glyph `glyph`'s bitmap in face `b` at strike `ppem`, as PNG bytes into `png`: its left edge's offset right of the
/// glyph's origin and its top edge's above the baseline, in the strike's pixels. Null when it has none there.
fn readBitmap(b: borrow BitmapFace, ppem: u32, glyph: u32, png: borrow mut Vector<u8>) -> [f32; 2]? {
    let file = match (File.open(b.path.view())) {
        Ok(f) => f,
        Err(_) => { return null; }
    };
    for (s in 0..b.strikeAt.length) {
        if (b.strikePpem[s] == ppem) {
            return sbixBitmap(file, b.strikeAt[s], glyph, png);
        }
    }
    if (b.cbdt != 0) {
        return cbdtBitmap(file, b, ppem, glyph, png);
    }
    return null;
}

/// An sbix strike's (at `strike` in the file) PNG for `glyph`, following one 'dupe'.
fn sbixBitmap(file: borrow File, strike: usize, glyph: u32, png: borrow mut Vector<u8>) -> [f32; 2]? {
    var g = glyph;
    var bytes = Vector<u8>.create();
    for (hop in 0..2) {
        if (!readAt(file, strike + 4 + (g as usize) * 4, mut bytes, 8)) {
            return null;
        }
        let o0 = u32be(bytes.view(), 0) as usize;
        let o1 = u32be(bytes.view(), 4) as usize;
        if (o1 <= o0 + 8 || o1 - o0 > 4194304 || !readAt(file, strike + o0, mut png, o1 - o0)) {
            return null;
        }
        let kind = u32be(png.view(), 4);
        if (kind == 0x64757065) { // 'dupe': the bitmap of another glyph
            g = u16be(png.view(), 8);
            continue;
        }
        if (kind != 0x706E6720) { // 'png '
            return null;
        }
        let left = i16be(png.view(), 0);
        let bottom = i16be(png.view(), 2);
        let n = png.length;
        for (i in 8..n) {
            png[i - 8] = png[i];
        }
        while (png.length > n - 8) {
            png.pop();
        }
        let h = match (imageInfo(png.view())) {
            Ok(info) => round<f32>(info.h),
            Err(_) => { return null; }
        };
        return [left, bottom + h];
    }
    return null;
}

/// A CBDT bitmap for `glyph` at strike `ppem`, found through face `b`'s CBLC (index formats 1 to 5; image formats
/// 17, 18 and 19, the PNG ones).
fn cbdtBitmap(file: borrow File, b: borrow BitmapFace, ppem: u32, glyph: u32, png: borrow mut Vector<u8>) -> [f32; 2]? {
    let c = b.cblc.view();
    if (c.length < 8) {
        return null;
    }
    let sizes = u32be(c, 4) as usize;
    for (i in 0..sizes) {
        let r = 8 + i * 48;
        if (r + 48 > c.length || (c[r + 45] as u32) != ppem || glyph < u16be(c, r + 40) || glyph > u16be(c, r + 42)) {
            continue;
        }
        let array = u32be(c, r) as usize;
        let count = u32be(c, r + 8) as usize;
        for (j in 0..count) {
            let e = array + j * 8;
            if (e + 8 > c.length) {
                return null;
            }
            let first = u16be(c, e);
            let last = u16be(c, e + 2);
            if (glyph < first || glyph > last) {
                continue;
            }
            let sub = array + (u32be(c, e + 4) as usize);
            if (sub + 8 > c.length) {
                return null;
            }
            let indexFormat = u16be(c, sub);
            let imageFormat = u16be(c, sub + 2);
            let data = b.cbdt + (u32be(c, sub + 4) as usize);
            let k = (glyph - first) as usize;
            var offset: usize = 0;
            var length: usize = 0;
            var metrics: usize = 0; // big metrics in the index (formats 2 and 5)
            if (indexFormat == 1 && sub + 16 + k * 4 <= c.length) {
                offset = u32be(c, sub + 8 + k * 4) as usize;
                length = (u32be(c, sub + 12 + k * 4) as usize) - offset;
            } else if (indexFormat == 3 && sub + 12 + k * 2 <= c.length) {
                offset = u16be(c, sub + 8 + k * 2) as usize;
                length = (u16be(c, sub + 10 + k * 2) as usize) - offset;
            } else if (indexFormat == 2 && sub + 20 <= c.length) {
                length = u32be(c, sub + 8) as usize;
                offset = k * length;
                metrics = sub + 12;
            } else if (indexFormat == 4 && sub + 12 <= c.length) {
                let n = u32be(c, sub + 8) as usize;
                for (p in 0..n) {
                    let q = sub + 12 + p * 4;
                    if (q + 8 <= c.length && u16be(c, q) == glyph) {
                        offset = u16be(c, q + 2) as usize;
                        length = (u16be(c, q + 6) as usize) - offset;
                    }
                }
            } else if (indexFormat == 5 && sub + 24 <= c.length) {
                length = u32be(c, sub + 8) as usize;
                metrics = sub + 12;
                let n = u32be(c, sub + 20) as usize;
                for (p in 0..n) {
                    if (sub + 24 + p * 2 + 2 <= c.length && u16be(c, sub + 24 + p * 2) == glyph) {
                        offset = p * length;
                    }
                }
            }
            if (length == 0 || length > 4194304 || !readAt(file, data + offset, mut png, length)) {
                return null;
            }
            var left: f32 = 0.0;
            var top: f32 = 0.0;
            var skip: usize = 0;
            if (imageFormat == 17 && length > 9) {
                left = i8f(png[2]);
                top = i8f(png[3]);
                skip = 9;
            } else if (imageFormat == 18 && length > 12) {
                left = i8f(png[2]);
                top = i8f(png[3]);
                skip = 12;
            } else if (imageFormat == 19 && length > 4 && metrics != 0) {
                left = i8f(c[metrics + 2]);
                top = i8f(c[metrics + 3]);
                skip = 4;
            } else {
                return null;
            }
            let n = png.length;
            for (q in skip..n) {
                png[q - skip] = png[q];
            }
            while (png.length > n - skip) {
                png.pop();
            }
            return [left, top];
        }
    }
    return null;
}
