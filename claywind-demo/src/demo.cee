// SPDX-License-Identifier: MIT
// The ClayWind example dashboard, ported from main.c: a sidebar with six nav items and three pages (Dashboard,
// Controls, Effects) that show off the Tailwind-style API, every control, and the ThorVG-era effects. Every host
// (headless, terminal, browser) runs this same code:
//
//     ui.begin(mut platform);
//     demoFrame(mut ui, mut app, metrics);
//     ui.endFrame(mut platform, metrics)?;
//     // then render with a backend over app.pageBg(ui)
//
// The layout, styles and texts follow main.c line for line, so a frame matches the C build's.

import claywind;

/// main.c's NAV_COUNT, NAV_CONTROLS and NAV_EFFECTS.
public const NAV_COUNT: usize = 6;
/// The format of what DemoApp.save writes: changed whenever what it writes changes.
public const DEMO_STATE_VERSION: u32 = 1;
const NAV_CONTROLS: usize = 1;
const NAV_EFFECTS: usize = 2;

static NAV_ITEMS: [StringView; 6] = ["Dashboard", "Controls", "Effects", "Projects", "Activity", "Settings"];
static PRIO_ITEMS: [StringView; 3] = ["Low", "Medium", "High"];
static FILE_ITEMS: [StringView; 6] = ["README.md", "main.c", "clay.h", "renderer.h", "controls.h", "PARITY.md"];
static THEME_ITEMS: [StringView; 3] = ["System", "Light", "Dark"];
static CTX_ITEMS: [StringView; 4] = ["Cut", "Copy", "Paste", "Delete"];
static CONTROLS_TABS: [StringView; 5] = ["Inputs", "Selection", "Lists", "Tasks", "Drag"];
/// The Drag tab's cards and its board's columns.
static CARD_TITLES: [StringView; 6] = ["Layout engine", "Shaping", "Bidi", "GPU backends", "Menus", "Drag and drop"];
static BOARD_COLUMNS: [StringView; 2] = ["To do", "Done"];
/// What the board's cards are, as a drag's kind.
const DRAG_CARD: u32 = 1;
/// The Tasks tab's counts: the primes below each.
static PRIME_LIMITS: [u64; 3] = [1000000, 5000000, 20000000];
static PRIME_LABELS: [StringView; 3] = ["1 M", "5 M", "20 M"];
static SIZE_ITEMS: [StringView; 4] = ["Small", "Medium", "Large", "X-Large"];
static TAG_ITEMS: [StringView; 10] = [
    "layout",
    "tailwind",
    "clay",
    "thorvg",
    "immediate-mode",
    "single-header",
    "flexbox",
    "wrap",
    "margins",
    "variants",
];
static BLEND_NAMES: [StringView; 16] = [
    "multiply",
    "screen",
    "overlay",
    "darken",
    "lighten",
    "color-dodge",
    "color-burn",
    "hard-light",
    "soft-light",
    "difference",
    "exclusion",
    "hue",
    "saturation",
    "color",
    "luminosity",
    "plus-lighter",
];
const HALF_PI: f32 = 1.5707964;
static GRADIENT_DIRS: [StringView; 8] = ["t", "tr", "r", "br", "b", "bl", "l", "tl"];

/// How far a count of primes got: the numbers below `checked` (of those below `below`) hold `found` primes.
public struct PrimeCount {
    public below: u64;
    public checked: u64;
    public found: u64;

    /// Whether the count is complete.
    public fn done(this) -> bool => this.below > 0 && this.checked >= this.below;
}

/// The primes in [from, to), by trial division: work for a background job, a step at a time.
public fn primesIn(from: u64, to: u64) -> u64 {
    var found: u64 = 0;
    var n = from.max(2);
    while (n < to) {
        if (n == 2 || (n & 1) == 1) {
            var prime = true;
            var d: u64 = 3;
            while (d * d <= n) {
                if (n % d == 0) {
                    prime = false;
                    break;
                }
                d += 2;
            }
            if (prime) {
                found += 1;
            }
        }
        n += 1;
    }
    return found;
}

/// Background work for the Controls page's Tasks tab: a host with threads runs the count on one (claywind_tasks,
/// whose results wake the window); NoJobs is a host without them, and the tab says so.
public interface DemoJobs {
    /// Whether this host runs background jobs.
    fn available(borrow this) -> bool;
    /// Starts counting the primes below `below`, cancelling a count under way.
    fn startCount(borrow mut this, below: u64);
    /// Cancels the count under way.
    fn cancelCount(borrow mut this);
    /// The count's latest report, if one arrived (call until null each frame).
    fn pollCount(borrow mut this, ui: borrow mut Ui) -> PrimeCount?;
    /// Whether a count is under way.
    fn counting(borrow this) -> bool;
}

/// A host without background jobs.
public struct NoJobs {
    public fn create() -> NoJobs => NoJobs {};
}

impl DemoJobs for NoJobs {
    fn available(borrow this) -> bool => false;
    fn startCount(borrow mut this, below: u64) {}
    fn cancelCount(borrow mut this) {}
    fn pollCount(borrow mut this, ui: borrow mut Ui) -> PrimeCount? => null;
    fn counting(borrow this) -> bool => false;
}

/// A file the app asks its host to choose (a menu's Open… or Save As…): the host shows the system's dialog, then
/// reads or writes the file and reports back (DemoApp.fileOpened, fileSaved, fileNotDone).
public enum FileRequest {
    /// Open a file: the host reads it and reports its size.
    Open,
    /// Save As: the host writes `DemoApp.saveText` to the file chosen.
    Save,
}

/// The demo's menus (a host builds the system's menus from them; their shortcuts are the actions' key bindings, which
/// the demo binds on its first frame).
public fn demoMenu<B: MenuBuilder>(m: borrow mut B) {
    m.menu("File");
    m.item("Open…", "open-file");
    m.item("Save As…", "save-as");
    m.menu("Edit");
    m.item("Cut", "cut");
    m.item("Copy", "copy");
    m.item("Paste", "paste");
    m.separator();
    m.item("Select All", "select-all");
    m.menu("View");
    m.item("Dashboard", "show-dashboard");
    m.item("Controls", "show-controls");
    m.item("Effects", "show-effects");
    m.separator();
    m.item("Toggle Light Mode", "toggle-theme");
    m.menu("Window");
    m.item("Live State", "open-inspector");
}

/// The app state (main.c's statics), all caller-owned state for the controls.
public struct DemoApp {
    public clicks: i32;
    public elapsed: f32;
    /// How many frames ran (the window sleeps between them while nothing changes).
    public frames: u64;
    /// The PRO badge's rocking, in seconds of rocking: it rocks while the pointer is over it, then settles.
    rock: f32;
    public activeNav: usize;
    public focusedNav: usize;
    nameBuf: [u8; 64];
    nameLen: usize;
    nameEdit: TextEdit;
    subscribe: bool;
    prioSel: usize;
    prioOpen: bool;
    fileSel: usize;
    volume: f32;
    qty: i32;
    radioSel: usize;
    filesChecked: [bool; 6];
    ctxOpen: bool;
    ctxX: f32;
    ctxY: f32;
    controlsTab: usize;
    noteBuf: [u8; 64];
    noteLen: usize;
    saves: i32;
    notifyEmail: bool;
    notifyPush: bool;
    sizeSel: usize;
    sizeOpen: bool;
    /// The Tasks tab: the latest count report, and when its count started (the clock, for the time it took).
    primes: PrimeCount;
    primesStarted: f64;
    primesTook: f64;
    /// The Live state panel in a window of its own (inspectorFrame): asked for, until the host reports it closed.
    inspectorWanted: bool;
    /// Whether the host opens windows of its own (setOpensWindows): only then does the panel offer one.
    opensWindows: bool;
    /// The key bindings of the menus' actions are made on the first frame.
    bound: bool;
    /// Whether the host shows file dialogs (setOpensFiles), the file it was asked for, and the last outcome to show.
    opensFiles: bool;
    fileWanted: FileRequest?;
    fileStatus: [u8; 160];
    fileStatusLen: usize;
    /// A menu bar the demo draws itself (setDrawsMenuBar: a host whose system has none), and which menu is open.
    drawsMenuBar: bool;
    menuModel: MenuModel;
    menuOpen: usize;
    /// The Drag tab: each card's column, files dropped from the system (the host's number for the drop it has not
    /// answered yet, 0 for none), and the names the last drop gave.
    cardColumn: [u8; 6];
    takesFileDrops: bool;
    dropWanted: u64;
    droppedNames: [u8; 240];
    droppedLen: usize;
    droppedCount: u32;

    /// main.c's initial state (and `ClayWind_darkMode = true`, which the host sets on the Ui).
    public fn create() -> DemoApp => DemoApp {
        clicks: 0,
        elapsed: 0.0,
        frames: 0,
        rock: 0.0,
        activeNav: 0,
        focusedNav: 0,
        nameBuf: [0u8; 64],
        nameLen: 0,
        nameEdit: TextEdit.at(0),
        subscribe: false,
        prioSel: 1,
        prioOpen: false,
        fileSel: 0,
        volume: 0.5,
        qty: 3,
        radioSel: 0,
        filesChecked: [false; 6],
        ctxOpen: false,
        ctxX: 0.0,
        ctxY: 0.0,
        controlsTab: 0,
        noteBuf: [0u8; 64],
        noteLen: 0,
        saves: 0,
        notifyEmail: true,
        notifyPush: false,
        sizeSel: 1,
        sizeOpen: false,
        primes: PrimeCount { below: 0, checked: 0, found: 0 },
        primesStarted: 0.0,
        primesTook: 0.0,
        inspectorWanted: false,
        opensWindows: false,
        bound: false,
        opensFiles: false,
        fileWanted: null,
        fileStatus: [0u8; 160],
        fileStatusLen: 0,
        drawsMenuBar: false,
        menuModel: MenuModel.create(),
        menuOpen: 0,
        cardColumn: [0u8, 0, 1, 0, 1, 0],
        takesFileDrops: false,
        dropWanted: 0,
        droppedNames: [0u8; 240],
        droppedLen: 0,
        droppedCount: 0,
    };

    /// Writes what the demo shows into a snapshot (hot reload: the rebuilt demo reads it back on start).
    public fn save(this, w: borrow mut SnapshotWriter) {
        w.u32(truncate<u32>(this.activeNav));
        w.u32(truncate<u32>(this.focusedNav));
        w.u32(truncate<u32>(this.controlsTab));
        w.u32(truncate<u32>(this.clicks));
        w.bytes(this.nameBuf[0..this.nameLen]);
        w.u32(truncate<u32>(this.nameEdit.caret));
        w.u32(truncate<u32>(this.nameEdit.anchor));
        w.bytes(this.noteBuf[0..this.noteLen]);
        w.bool(this.subscribe);
        w.u32(truncate<u32>(this.prioSel));
        w.u32(truncate<u32>(this.fileSel));
        w.f32(this.volume);
        w.u32(truncate<u32>(this.qty));
        w.u32(truncate<u32>(this.radioSel));
        for (i in 0usize..6) {
            w.bool(this.filesChecked[i]);
        }
        w.u32(truncate<u32>(this.saves));
        w.bool(this.notifyEmail);
        w.bool(this.notifyPush);
        w.u32(truncate<u32>(this.sizeSel));
        for (i in 0usize..6) {
            w.u8(this.cardColumn[i]);
        }
    }

    /// Reads back what `save` wrote: true, and the state restored, from an intact snapshot of this format; false,
    /// and the state as it was, otherwise.
    public fn restore(borrow mut this, r: borrow mut SnapshotReader) -> bool {
        var next = DemoApp.create();
        next.opensWindows = this.opensWindows;
        next.opensFiles = this.opensFiles;
        next.takesFileDrops = this.takesFileDrops;
        next.drawsMenuBar = this.drawsMenuBar;
        next.menuModel = this.menuModel;
        next.activeNav = (r.u32() as usize).min(NAV_COUNT - 1);
        next.focusedNav = (r.u32() as usize).min(NAV_COUNT - 1);
        next.controlsTab = (r.u32() as usize).min(CONTROLS_TABS.length - 1);
        next.clicks = truncate<i32>(r.u32());
        next.nameLen = r.bytesInto(mut next.nameBuf[..]);
        next.nameEdit = TextEdit { caret: (r.u32() as usize).min(next.nameLen), anchor: 0 };
        next.nameEdit.anchor = (r.u32() as usize).min(next.nameLen);
        next.noteLen = r.bytesInto(mut next.noteBuf[..]);
        next.subscribe = r.bool();
        next.prioSel = (r.u32() as usize).min(PRIO_ITEMS.length - 1);
        next.fileSel = (r.u32() as usize).min(FILE_ITEMS.length - 1);
        next.volume = r.f32().max(0.0).min(1.0);
        next.qty = truncate<i32>(r.u32());
        next.radioSel = (r.u32() as usize).min(THEME_ITEMS.length - 1);
        for (i in 0usize..6) {
            next.filesChecked[i] = r.bool();
        }
        next.saves = truncate<i32>(r.u32());
        next.notifyEmail = r.bool();
        next.notifyPush = r.bool();
        next.sizeSel = (r.u32() as usize).min(SIZE_ITEMS.length - 1);
        for (i in 0usize..6) {
            next.cardColumn[i] = r.u8().min(1);
        }
        if (!r.intact()) {
            return false;
        }
        this = next;
        return true;
    }

    /// Opens the Controls page's tab `k` (Inputs, Selection, Lists, Tasks, Drag).
    public fn selectControlsTab(borrow mut this, k: usize) {
        if (k < CONTROLS_TABS.length) {
            this.controlsTab = k;
        }
    }

    /// The host passes on files dragged from the system (Platform.fileDrag): the Drag tab has a place for them.
    public fn setTakesFileDrops(borrow mut this, takes: bool) {
        this.takesFileDrops = takes;
    }

    /// Files the system dropped on the Drag tab: the host's number for the drop, whose paths the host gives back
    /// (filesDropped), or null.
    public fn takeFileDrop(borrow mut this) -> u64? {
        let id = this.dropWanted;
        this.dropWanted = 0;
        return if (id == 0) null else id;
    }

    /// Starts the answer to a file drop: `count` files, whose names follow (fileDropped).
    public fn filesDropped(borrow mut this, count: u32) {
        this.droppedCount = count;
        this.droppedLen = 0;
    }

    /// One dropped file's path (its name is shown).
    public fn fileDropped(borrow mut this, path: Slice<u8>) {
        let name = fileName(path);
        if (this.droppedLen > 0 && this.droppedLen < 240) {
            this.droppedNames[this.droppedLen] = '\n';
            this.droppedLen += 1;
        }
        for (i in 0..name.length) {
            if (this.droppedLen < 240) {
                this.droppedNames[this.droppedLen] = name[i];
                this.droppedLen += 1;
            }
        }
    }

    /// The host has no native menus to give (X11): the demo draws its menus (demoMenu) in a bar of its own.
    public fn setDrawsMenuBar(borrow mut this, draws: bool) {
        this.drawsMenuBar = draws;
        if (draws && this.menuModel.isEmpty()) {
            demoMenu(mut this.menuModel);
        }
    }

    /// The host shows the system's file dialogs: File's Open… and Save As… ask it for files.
    public fn setOpensFiles(borrow mut this, opens: bool) {
        this.opensFiles = opens;
    }

    /// The file the app asked for since the last call, if any: the host shows the dialog and reports back.
    public fn takeFileRequest(borrow mut this) -> FileRequest? {
        let r = this.fileWanted;
        this.fileWanted = null;
        return r;
    }

    /// What Save As writes: the Controls page's name and note, a line each.
    public fn saveText(this) -> [u8; 130] {
        var out = [0u8; 130];
        var n: usize = 0;
        for (i in 0..this.nameLen) {
            out[n] = this.nameBuf[i];
            n += 1;
        }
        out[n] = '\n';
        n += 1;
        for (i in 0..this.noteLen) {
            out[n] = this.noteBuf[i];
            n += 1;
        }
        out[n] = '\n';
        return out;
    }

    /// How many bytes of saveText are the text.
    public fn saveTextLength(this) -> usize => this.nameLen + this.noteLen + 2;

    /// The host read the file at `path` (`size` bytes).
    public fn fileOpened(borrow mut this, path: Slice<u8>, size: u64) {
        var w = TextWriter.create(mut this.fileStatus[..]);
        w.text("Opened ");
        w.bytes(fileName(path));
        w.text(" (");
        grouped(mut w, size);
        w.text(" bytes)");
        this.fileStatusLen = w.written().length;
    }

    /// The host wrote saveText to `path`.
    public fn fileSaved(borrow mut this, path: Slice<u8>) {
        var w = TextWriter.create(mut this.fileStatus[..]);
        w.text("Saved ");
        w.bytes(fileName(path));
        this.fileStatusLen = w.written().length;
    }

    /// The dialog was cancelled, or the file could not be read or written (`why`).
    public fn fileNotDone(borrow mut this, why: StringView) {
        var w = TextWriter.create(mut this.fileStatus[..]);
        w.text(why);
        this.fileStatusLen = w.written().length;
    }

    /// The host can open more windows: the Live state panel offers to open in one.
    public fn setOpensWindows(borrow mut this, opens: bool) {
        this.opensWindows = opens;
    }

    /// Whether the app wants the Live state panel in a window of its own (a host with windows opens one and draws it
    /// with inspectorFrame).
    public fn wantsInspector(this) -> bool => this.inspectorWanted;

    /// The host closed the inspector window (its user did): the panel's button offers it again.
    public fn inspectorClosed(borrow mut this) {
        this.inspectorWanted = false;
    }

    /// Opens nav tab `index` (CLAYWIND_SCREENSHOT_TAB).
    public fn selectTab(borrow mut this, index: usize) {
        if (index < NAV_COUNT) {
            this.activeNav = index;
            this.focusedNav = index;
        }
    }
}

// ---- themed colors (Tailwind dark:) ------------------------------------------------------------------------------------

/// The page background, which the host also clears the frame to.
public fn pageBg(ui: borrow Ui) -> u32 => ui.theme(SLATE_950, SLATE_100);
fn panelBg(ui: borrow Ui) -> u32 => ui.theme(SLATE_900, WHITE);
fn rowBg(ui: borrow Ui, alt: bool) -> u32 => if (alt) ui.theme(CHARCOAL, SLATE_200) else ui.theme(SLATE_800, SLATE_100);
fn inkCol(ui: borrow Ui) -> u32 => ui.theme(SLATE_100, SLATE_800);
fn muteCol(ui: borrow Ui) -> u32 => ui.theme(SLATE_500, SLATE_500);
fn lineCol(ui: borrow Ui) -> u32 => ui.theme(SLATE_700, SLATE_300);

/// main.c's clicked(): hovered and the button went down this frame.
fn clicked(ui: borrow Ui, id: StringView) -> bool => ui.clickedHash(hashId(id));

/// Hash of `prefix` + `n` (main.c's F("tag-%d", t) ids).
fn numberedId(prefix: StringView, n: i64) -> u32 {
    var buffer = [0u8; 48];
    var w = TextWriter.create(mut buffer[..]);
    w.text(prefix);
    w.signed(n);
    return hashBytes(w.written());
}

/// Hash of `prefix` + `name`.
fn namedId(prefix: StringView, name: StringView) -> u32 {
    var buffer = [0u8; 48];
    var w = TextWriter.create(mut buffer[..]);
    w.text(prefix);
    w.text(name);
    return hashBytes(w.written());
}

/// The frame: main.c's update() then BuildUI().
public fn demoFrame<M: TextMetrics>(ui: borrow mut Ui, app: borrow mut DemoApp, metrics: borrow M) {
    var jobs = NoJobs.create();
    demoFrameWith(mut ui, mut app, metrics, mut jobs);
}

/// demoFrame on a host that runs background jobs (the Controls page's Tasks tab).
public fn demoFrameWith<M: TextMetrics, J: DemoJobs>(
    ui: borrow mut Ui,
    app: borrow mut DemoApp,
    metrics: borrow M,
    jobs: borrow mut J,
) {
    update(mut ui, mut app);
    // The count's reports, whichever page shows.
    loop {
        match (jobs.pollCount(mut ui)) {
            Some(c) => {
                app.primes = c;
                if (c.done()) {
                    app.primesTook = ui.time() - app.primesStarted;
                }
            }
            null => { break; }
        }
    }
    // With a soft keyboard up, the page ends above it.
    let safe = ui.safeAreaWithKeyboard();
    if (app.drawsMenuBar) {
        ui.open(Style.column().id("window").w(Size.grow()).h(Size.grow()).bg(pageBg(ui)).safe(safe));
        Controls.menuBar(mut ui, "menubar", app.menuModel, mut app.menuOpen);
    }
    // The page's background fills the screen; its content keeps clear of a phone's bars and cutouts.
    let rootSafe = if (app.drawsMenuBar) Insets.zero() else safe;
    ui.open(Style.row().id("root").w(Size.grow()).h(Size.grow()).bg(pageBg(ui)).safe(rootSafe));
    sidebar(mut ui, app);
    if (app.activeNav == NAV_CONTROLS) {
        controlsPage(mut ui, mut app, metrics, mut jobs);
    } else if (app.activeNav == NAV_EFFECTS) {
        effectsPage(mut ui, app);
    } else {
        dashboard(mut ui, app);
    }
    // Fixed, floating badge pinned to the top-right of the window (position + z-index), translucent, rocking.
    ui.open(
        Style.box().id("proBadge").fixed().top(12.0 + safe.top).left(
            ui.screenSize().w - 78.0 - safe.right,
        ).z(10).px(space(3.0)).py(space(1.0))
            .bg(withAlpha(AMBER_500, 235)).rounded(Radius.Md).rotate(Math.sin(app.rock * 2.0) * 6.0),
    );
    ui.label("PRO", Text.of().font(FONT_18).color(SLATE_950).tracking(2.0).align(TextAlign.Center));
    ui.close();
    // Tooltip over the counter button, and a right-click context menu; both float on top, so they come last.
    Controls.tooltip(mut ui, "clickBtn", "Increments the click counter");
    Controls.tooltip(mut ui, "ci-save", "Counts saves (shown in Live state)");
    match (Controls.contextMenu(mut ui, "ctx", CTX_ITEMS[..], mut app.ctxOpen, app.ctxX, app.ctxY)) {
        Some(act) => { app.clicks += (truncate<i32>(act)) + 1; }
        null => {}
    }
    ui.close();
    if (app.drawsMenuBar) {
        ui.close();
    }
}

fn update(ui: borrow mut Ui, app: borrow mut DemoApp) {
    app.elapsed += ui.frameTime();
    app.frames += 1;
    // The badge rocks while the pointer is over it; after, it swings on to rest (where sin(2 rock) is 0). A frame
    // after a long sleep counts as a short one.
    let dt = ui.frameTime().min(0.1);
    let rest = HALF_PI * (app.rock / HALF_PI).ceil();
    if (ui.hovered("proBadge")) {
        app.rock += dt;
        ui.requestFrame();
    } else if (app.rock < rest) {
        app.rock = (app.rock + dt).min(rest);
        ui.requestFrame();
    }
    if (clicked(ui, "clickBtn")) {
        app.clicks += 1;
    }
    if (app.clicks > 0 && clicked(ui, "resetBtn")) {
        app.clicks = 0; // the disabled button does nothing
    }
    let p = ui.pointer();
    if (p.secondaryPressed) {
        app.ctxOpen = true;
        app.ctxX = p.position.x;
        app.ctxY = p.position.y;
    }
    // T toggles the theme (main.c checks the T key; here it is the typed letter, ignored while a field has focus).
    if ((ui.focused() == 0 && (ui.typed('T') || ui.typed('t'))) || ui.action("toggle-theme")) {
        let dark = ui.isDarkMode();
        ui.setDarkMode(!dark);
    }
    // The menus' actions (demoMenu), from their items or their key bindings.
    if (!app.bound) {
        ui.bind("secondary-o", "open-file", "");
        ui.bind("secondary-shift-s", "save-as", "");
        ui.bind("secondary-1", "show-dashboard", "");
        ui.bind("secondary-2", "show-controls", "");
        ui.bind("secondary-3", "show-effects", "");
        ui.bind("secondary-shift-l", "toggle-theme", "");
        ui.bind("secondary-shift-i", "open-inspector", "");
        app.bound = true;
    }
    if (ui.action("show-dashboard")) {
        app.activeNav = 0;
        app.focusedNav = 0;
    }
    if (ui.action("show-controls")) {
        app.activeNav = NAV_CONTROLS;
        app.focusedNav = NAV_CONTROLS;
    }
    if (ui.action("show-effects")) {
        app.activeNav = NAV_EFFECTS;
        app.focusedNav = NAV_EFFECTS;
    }
    if (ui.action("open-inspector") && app.opensWindows) {
        app.inspectorWanted = true;
    }
    if (app.opensFiles && ui.action("open-file")) {
        app.fileWanted = FileRequest.Open;
    }
    if (app.opensFiles && ui.action("save-as")) {
        app.fileWanted = FileRequest.Save;
    }
    // Keyboard focus: Up/Down move the cursor, Enter selects the focused item.
    if (ui.keyPressed(Key.Down)) {
        app.focusedNav = (app.focusedNav + 1) % NAV_COUNT;
    }
    if (ui.keyPressed(Key.Up)) {
        app.focusedNav = (app.focusedNav + NAV_COUNT - 1) % NAV_COUNT;
    }
    if (ui.keyPressed(Key.Enter)) {
        app.activeNav = app.focusedNav;
    }
    // A click on a nav item also selects it (and moves focus there).
    for (i in 0..NAV_COUNT) {
        if (ui.pressedOn(hashId(NAV_ITEMS[i]))) {
            app.activeNav = i;
            app.focusedNav = i;
        }
    }
}

// ---- sidebar -------------------------------------------------------------------------------------------------------------

fn sidebar(ui: borrow mut Ui, app: borrow DemoApp) {
    let wide = match (ui.breakpoint()) {
        Breakpoint.Sm => false,
        _ => true,
    };
    ui.open(Style.column().id("sidebar").w(Size.fixed(if (wide) 220.0 else 72.0)).h(Size.grow()).bg(panelBg(ui))
        .p(space(5.0)).gap(space(2.0)));
    ui.open(Style.row().pb(space(3.0)));
    ui.label(if (wide) "ClayWind" else "CW", Text.of().font(TEXT_2XL).color(inkCol(ui)).tracking(1.0));
    ui.close();
    for (i in 0..NAV_COUNT) {
        let name = NAV_ITEMS[i];
        let active = i == app.activeNav;
        let itemBg = if (active) BLUE_600 else ui.theme(SLATE_800, SLATE_200);
        var style = Style.box().id(name).w(Size.grow()).px(space(3.0)).py(space(2.0)).bg(itemBg).rounded(Radius.Md)
            .cursor(Cursor.Pointer).isFocused(i == app.focusedNav).focus(Style.of().border(2.0, BLUE_300));
        if (!active) {
            style = style.hover(Style.of().bg(ui.theme(SLATE_700, SLATE_300)));
        }
        ui.open(style);
        let item = ui.access(hashId(name), AccessRole.Tab, name.bytes()); // the pages, to a screen reader
        ui.accessFlag(item, ACCESS_SELECTED, active);
        let fg = if (active) WHITE else muteCol(ui);
        if (wide) {
            ui.label(name, Text.of().color(fg));
        } else {
            ui.label(name[0..1], Text.of().color(fg).align(TextAlign.Center));
        }
        ui.close();
    }
    // Push the footer to the bottom.
    ui.open(Style.box().h(Size.grow()));
    ui.close();
    // The last file a menu's Open… or Save As… dealt with.
    if (app.fileStatusLen > 0) {
        ui.labelBytes(app.fileStatus[0..app.fileStatusLen], Text.of().color(inkCol(ui)).clamp(3));
    }
    if (wide) {
        // A long description clamped to two lines with an ellipsis (line-clamp-2).
        ui.label(
            "A Tailwind-style UI toolkit for Clay, rendered by ThorVG, forked for extra parity.",
            Text.of().color(muteCol(ui)).clamp(2),
        );
        ui.label("v0.1 · Clay 0.14", Text.of().color(muteCol(ui)));
    }
    ui.close();
}

// ---- dashboard -----------------------------------------------------------------------------------------------------------

fn statCard(ui: borrow mut Ui, id: StringView, label: StringView, value: Slice<u8>, accent: u32) {
    // The card is a group: hovering anywhere in it brightens the faded accent dot.
    ui.open(
        Style.column().id(id).w(Size.grow()).h(Size.fixed(110.0)).minW(150.0).maxW(320.0).bg(panelBg(ui)).p(space(4.0))
            .gap(space(2.0)).rounded(Radius.Lg).borderL(4.0, accent).shadow(ShadowSize.Lg)
            .transition(
                TransitionSpec.transformOnly().durationMs(150.0),
            ).cursor(Cursor.Pointer).hover(Style.of().scale(1.03)),
    );
    ui.open(Style.row().w(Size.grow()).gap(space(2.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label(label, Text.of().color(muteCol(ui)).tracking(1.0));
    ui.open(Style.box().w(Size.grow()));
    ui.close();
    ui.open(Style.box().w(Size.fixed(8.0)).aspect(1.0).bg(withAlpha(accent, 90)).rounded(Radius.Md)
        .groupHover(id, Style.of().bg(accent)));
    ui.close();
    ui.close();
    ui.labelBytes(value, Text.of().font(TEXT_2XL).color(inkCol(ui)));
    ui.close();
}

fn spacer(ui: borrow mut Ui) {
    ui.open(Style.box().w(Size.grow()));
    ui.close();
}

fn dashboard(ui: borrow mut Ui, app: borrow DemoApp) {
    ui.open(Style.column().id("content").w(Size.grow()).h(Size.grow()).bg(pageBg(ui)).p(space(6.0)).gap(space(5.0)));
    // Header row.
    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label("Dashboard", Text.of().font(TEXT_XL).color(inkCol(ui)).bold());
    // @container: react to the content panel's own width (not the window's).
    ui.label(if (ui.containerWidth("content") >= 760.0) "· wide" else "· compact", Text.of().color(muteCol(ui)));
    spacer(mut ui);
    ui.open(Style.box().id("clickBtn").px(space(4.0)).py(space(3.0)).bg(EMERALD_600).rounded(Radius.Md)
        .ring(2.0, EMERALD_300, 2.0).transition(TransitionSpec.colorsOnly().durationMs(200.0)).cursor(Cursor.Pointer)
        .hover(Style.of().bg(EMERALD_500)).active(Style.of().bg(EMERALD_700)));
    var clickText = [0u8; 32];
    var cw = TextWriter.create(mut clickText[..]);
    cw.text("Clicked ");
    cw.signed(app.clicks as i64);
    ui.access(hashId("clickBtn"), AccessRole.Button, cw.written());
    ui.labelBytes(cw.written(), Text.of().color(WHITE));
    ui.close();
    // Reset: disabled (greyed, no hover/cursor) until there is something to reset.
    ui.open(
        Style.box().id("resetBtn").px(space(4.0)).py(space(3.0)).bg(ROSE_600).rounded(Radius.Md).cursor(Cursor.Pointer)
            .hover(Style.of().bg(ROSE_500)).isDisabled(app.clicks == 0).disabled(
            Style.of().bg(ui.theme(SLATE_800, SLATE_300)),
        ),
    );
    let reset = ui.access(hashId("resetBtn"), AccessRole.Button, "Reset".bytes());
    ui.accessFlag(reset, ACCESS_DISABLED, app.clicks == 0);
    ui.label("Reset", Text.of().color(if (app.clicks == 0) muteCol(ui) else WHITE));
    ui.close();
    ui.close();

    // Gradient banner, rounded like any other background, at 60% opacity.
    ui.open(
        Style.box().id("banner").w(Size.grow()).h(Size.fixed(6.0)).gradient(
            GradientDir.ToTopRight,
            INDIGO_600,
            VIOLET_500,
        )
            .via(FUCHSIA_500).rounded(Radius.Md).opacity(0.6),
    );
    ui.close();

    // Nested opacity: an outer group at 60% holding an inner one at 50%.
    ui.open(Style.box().id("nestop").w(Size.grow()).h(Size.fixed(6.0)).opacity(0.6));
    ui.open(Style.row().alignXY(AxisAlign.Start, AxisAlign.Center).gap(space(2.0)));
    ui.open(Style.box().w(Size.fixed(80.0)).h(Size.fixed(5.0)).bg(SKY_500).rounded(Radius.Md));
    ui.close();
    ui.open(Style.box().w(Size.fixed(80.0)).h(Size.fixed(5.0)).opacity(0.5).bg(EMERALD_400).rounded(Radius.Md));
    ui.close();
    ui.close();
    ui.close();

    // mix-blend: overlapping translucent RGB chips with additive blend.
    ui.open(Style.box().id("blend").blend(BlendMode.Add).h(Size.fixed(26.0)));
    ui.open(Style.row().alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.open(Style.box().w(Size.fixed(60.0)).h(Size.fixed(26.0)).bg(withAlpha(RED_500, 150)).rounded(Radius.Lg));
    ui.close();
    ui.open(
        Style.box().w(Size.fixed(60.0)).h(Size.fixed(26.0)).ml(-24.0).bg(withAlpha(GREEN_500, 150)).rounded(Radius.Lg),
    );
    ui.close();
    ui.open(
        Style.box().w(Size.fixed(60.0)).h(Size.fixed(26.0)).ml(-24.0).bg(withAlpha(BLUE_500, 150)).rounded(Radius.Lg),
    );
    ui.close();
    ui.close();
    ui.close();

    // Filters: a blurred chip and a grayscale chip.
    ui.open(Style.row().gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.open(Style.box().px(space(3.0)).py(space(1.0)).bg(SKY_500).rounded(Radius.Md).blur(3.0));
    ui.label("blur", Text.of().color(SLATE_950));
    ui.close();
    ui.open(Style.box().px(space(3.0)).py(space(1.0)).bg(AMBER_500).rounded(Radius.Md).grayscale());
    ui.label("grayscale", Text.of().color(SLATE_950));
    ui.close();
    ui.close();

    // items-baseline: a big price and a small suffix on one baseline.
    ui.open(Style.row().gap(space(1.0)).items(Items.Baseline));
    ui.label("$49", Text.of().size(40.0).bold().color(inkCol(ui)));
    ui.label("/mo", Text.of().size(18.0).color(muteCol(ui)));
    ui.open(Style.box().w(Size.fixed(12.0)));
    ui.close();
    ui.label("billed annually", Text.of().size(14.0).color(muteCol(ui)));
    ui.close();

    // size-*, basis + shrink-0, and space-x.
    ui.open(Style.row().w(Size.grow()).h(Size.fixed(40.0)).gapX(space(2.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.open(Style.box().size(Size.fixed(32.0)).bg(SKY_500).rounded(Radius.Md));
    ui.close();
    ui.open(Style.box().size(Size.fixed(32.0)).bg(VIOLET_500).rounded(Radius.Md));
    ui.close();
    ui.open(Style.box().basis(160.0).shrink0().h(Size.fixed(32.0)).bg(ui.theme(SLATE_800, SLATE_200)).rounded(Radius.Md)
        .px(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label("basis-160 · shrink-0", Text.of().size(14.0).color(muteCol(ui)));
    ui.close();
    ui.open(Style.box().w(Size.grow()).h(Size.fixed(32.0)).bg(EMERALD_700).rounded(Radius.Md));
    ui.close();
    ui.close();

    // Stat cards.
    ui.open(Style.row().w(Size.grow()).gap(space(4.0)));
    var uptime = [0u8; 32];
    var uw = TextWriter.create(mut uptime[..]);
    let now = ui.time(); // the clock: frame times are capped, and the window sleeps between frames
    uw.signed(truncate<i64>(now.floor()));
    uw.byte('s');
    statCard(mut ui, "cardUptime", "Uptime", uw.written(), BLUE_500);
    // Whole seconds: the next frame that changes the card is at the next second.
    ui.requestFrameAfter(now.floor() + 1.0 - now);
    var clicks = [0u8; 32];
    var kw = TextWriter.create(mut clicks[..]);
    kw.signed(app.clicks as i64);
    statCard(mut ui, "cardClicks", "Clicks", kw.written(), EMERALD_500);
    var frames = [0u8; 32];
    var fw = TextWriter.create(mut frames[..]);
    fw.decimal(app.frames);
    statCard(mut ui, "cardFrames", "Frames", fw.written(), AMBER_500);
    ui.close();

    // A wrapping tag row (flex-wrap).
    ui.open(Style.row().id("tags").w(Size.grow()).wrap().gapX(space(2.0)).gapY(space(2.0)));
    for (t in 0..TAG_ITEMS.length) {
        ui.open(Style.box().idHash(numberedId("tag-", truncate<i64>(t))).px(space(3.0)).py(space(1.0))
            .bg(ui.theme(SLATE_800, SLATE_200)).rounded(Radius.Md).cursor(Cursor.Pointer).hover(
            Style.of().bg(BLUE_600),
        ));
        ui.label(TAG_ITEMS[t], Text.of().color(inkCol(ui)));
        ui.close();
    }
    ui.close();

    // A scrollable activity log.
    ui.label("Activity", Text.of().font(TEXT_XL).color(inkCol(ui)));
    ui.open(
        Style.box().id("log").w(
            Size.grow(),
        ).h(Size.grow()).bg(panelBg(ui)).p(space(2.0)).gap(space(2.0)).rounded(Radius.Lg)
            .scroll(ScrollAxis.Vertical),
    );
    ui.open(Style.column().w(Size.grow()).gap(space(2.0)).divide(1.0, lineCol(ui)));
    for (i in 0..40) {
        ui.open(Style.row().idHash(numberedId("row-", i as i64)).w(Size.grow()).px(space(3.0)).py(space(3.0))
            .bg(rowBg(ui, i % 2 == 0)).rounded(Radius.Sm).alignXY(AxisAlign.Start, AxisAlign.Center));
        ui.open(
            Style.box().w(Size.fixed(10.0)).aspect(1.0).bg(if (i % 3 == 0) ROSE_400 else TEAL_400).rounded(Radius.Md),
        );
        ui.close();
        ui.open(Style.box().w(Size.fixed(12.0)));
        ui.close();
        var event = [0u8; 40];
        var ew = TextWriter.create(mut event[..]);
        ew.text("Event #");
        ew.signed((i + 1) as i64);
        ew.text(" processed");
        ui.labelBytes(ew.written(), Text.of().color(inkCol(ui)).mono());
        ui.close();
    }
    ui.close();
    ui.close();
    ui.close();
}

// ---- controls page -------------------------------------------------------------------------------------------------------

/// A small muted caption above a control.
fn caption(ui: borrow mut Ui, text: StringView) {
    let c = muteCol(ui);
    ui.label(text, Text.of().size(14.0).color(c));
}

/// One "key  value" line in the live-state panel.
fn stateRow(ui: borrow mut Ui, key: StringView, value: Slice<u8>) {
    ui.open(Style.row().w(Size.grow()).gap(space(2.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label(key, Text.of().size(14.0).color(muteCol(ui)));
    spacer(mut ui);
    ui.labelBytes(value, Text.of().size(14.0).color(inkCol(ui)).mono());
    ui.close();
}

fn inputsSection<M: TextMetrics>(ui: borrow mut Ui, app: borrow mut DemoApp, metrics: borrow M) {
    ui.open(Style.column().w(Size.grow()).gap(space(1.0)));
    caption(mut ui, "Name · caret editing (Left/Right/Home/End, Backspace/Delete)");
    Controls.textField(mut ui, metrics, "ci-name", mut app.nameBuf[..], mut app.nameLen, mut app.nameEdit);
    ui.accessName("ci-name", "Name");
    ui.close();
    ui.open(Style.column().w(Size.grow()).gap(space(1.0)));
    caption(mut ui, "Quick note · simple append-only input");
    Controls.textInput(mut ui, "ci-note", mut app.noteBuf[..], mut app.noteLen);
    ui.accessName("ci-note", "Note");
    ui.close();
    ui.open(Style.row().gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    caption(mut ui, "Volume");
    Controls.slider(mut ui, "ci-vol", mut app.volume, 0.0, 1.0, 200.0);
    ui.accessName("ci-vol", "Volume");
    var pct = [0u8; 16];
    var pw = TextWriter.create(mut pct[..]);
    pw.signed(truncate<i64>((app.volume * 100.0 + 0.5).floor()));
    pw.byte('%');
    ui.labelBytes(pw.written(), Text.of().color(inkCol(ui)).mono());
    ui.close();
    ui.open(Style.row().gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    caption(mut ui, "Quantity");
    Controls.spinInput(mut ui, "ci-qty", mut app.qty, 0, 99, 1);
    ui.accessName("ci-qty", "Quantity");
    ui.close();
    ui.open(Style.row().gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    if (Controls.button(mut ui, "ci-save", "Save")) {
        app.saves += 1;
    }
    if (Controls.button(mut ui, "ci-clear", "Clear")) {
        app.nameLen = 0;
        app.nameEdit = TextEdit.at(0);
        app.noteLen = 0;
    }
    caption(mut ui, if (app.saves != 0) "Saved · see Live state" else "Hover Save for a tooltip");
    ui.close();
}

fn selectionSection(ui: borrow mut Ui, app: borrow mut DemoApp) {
    ui.open(Style.column().gap(space(2.0)));
    caption(mut ui, "Checkboxes");
    Controls.checkbox(mut ui, "ci-sub", "Subscribe to updates", mut app.subscribe);
    Controls.checkbox(mut ui, "ci-email", "Email notifications", mut app.notifyEmail);
    Controls.checkbox(mut ui, "ci-push", "Push notifications", mut app.notifyPush);
    ui.close();
    ui.open(Style.column().gap(space(2.0)));
    caption(mut ui, "Theme (radio) · Light/Dark switch the app");
    if (Controls.radio(mut ui, "ci-theme", THEME_ITEMS[..], mut app.radioSel) && app.radioSel != 0) {
        ui.setDarkMode(app.radioSel == 2);
    }
    ui.close();
    // Dropdowns float their list below the trigger, above everything else.
    ui.open(Style.row().gap(space(5.0)).alignXY(AxisAlign.Start, AxisAlign.Start));
    ui.open(Style.column().w(Size.fixed(180.0)).gap(space(1.0)));
    caption(mut ui, "Priority");
    Controls.dropdown(mut ui, "ci-prio", PRIO_ITEMS[..], mut app.prioSel, mut app.prioOpen);
    ui.accessName("ci-prio", "Priority");
    ui.close();
    ui.open(Style.column().w(Size.fixed(180.0)).gap(space(1.0)));
    caption(mut ui, "Size");
    Controls.dropdown(mut ui, "ci-size", SIZE_ITEMS[..], mut app.sizeSel, mut app.sizeOpen);
    ui.accessName("ci-size", "Size");
    ui.close();
    ui.close();
}

fn listsSection(ui: borrow mut Ui, app: borrow mut DemoApp) {
    ui.open(Style.row().w(Size.grow()).gap(space(5.0)).alignXY(AxisAlign.Start, AxisAlign.Start));
    ui.open(Style.column().w(Size.grow()).gap(space(1.0)));
    caption(mut ui, "Open (single select)");
    Controls.listbox(mut ui, "ci-files", FILE_ITEMS[..], mut app.fileSel, Size.fixed(150.0));
    ui.close();
    ui.open(Style.column().w(Size.grow()).gap(space(1.0)));
    caption(mut ui, "Stage (multi select)");
    Controls.listboxMulti(mut ui, "ci-stage", FILE_ITEMS[..], mut app.filesChecked[..], Size.fixed(150.0));
    ui.close();
    ui.close();
    caption(mut ui, "Right-click anywhere for a context menu (it bumps the Dashboard's click counter).");
}

/// `"text"` into `w`.
fn quoted(w: borrow mut TextWriter, text: Slice<u8>) {
    w.byte('"');
    w.bytes(text);
    w.byte('"');
}

/// The last part of a path (after its last '/' or '\\').
fn fileName(path: Slice<u8>) -> Slice<u8> {
    var start: usize = 0;
    for (i in 0..path.length) {
        if (path[i] == '/' || path[i] == '\\') {
            start = i + 1;
        }
    }
    return path[start..path.length];
}

/// `n` in decimal with its thousands separated by commas.
fn grouped(w: borrow mut TextWriter, n: u64) {
    var digits = [0u8; 20];
    var count: usize = 0;
    var v = n;
    loop {
        digits[count] = truncate<u8>(v % 10) + '0';
        count += 1;
        v /= 10;
        if (v == 0) {
            break;
        }
    }
    var k = count;
    while (k > 0) {
        k -= 1;
        w.byte(digits[k]);
        if (k > 0 && k % 3 == 0) {
            w.byte(',');
        }
    }
}

/// The Drag tab: a board whose cards are dragged between its columns, and a place for files from the system.
fn dragSection(ui: borrow mut Ui, app: borrow mut DemoApp) {
    caption(
        mut ui,
        if (app.takesFileDrops) "Drag the cards between the columns; drop files from the system below."
            else "Drag the cards between the columns.",
    );
    ui.open(Style.row().w(Size.grow()).gap(space(4.0)));
    for (c in 0usize..2) {
        let column = subName("ci-col", c);
        let target = ui.dropTarget(column, DRAG_CARD);
        let over = match (target) {
            DropState.Over(_) => true,
            _ => false,
        };
        match (target) {
            DropState.Dropped(p) => {
                if (p.value < 6) {
                    app.cardColumn[p.value as usize] = truncate<u8>(c);
                }
            }
            _ => {}
        }
        ui.open(Style.column().idHash(column).w(Size.grow()).h(Size.fixed(230.0)).p(space(3.0)).gap(space(2.0))
            .rounded(Radius.Lg).bg(if (over) withAlpha(BLUE_500, 60) else SLATE_800).border(
            1.0,
            if (over) BLUE_500 else SLATE_700,
        ));
        ui.label(BOARD_COLUMNS[c], Text.of().color(muteCol(ui)).bold());
        for (k in 0usize..6) {
            if (app.cardColumn[k] as usize != c) {
                continue;
            }
            let card = subName("ci-card", k);
            ui.open(Style.box().idHash(card).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Md)
                .bg(SLATE_700).cursor(Cursor.Pointer));
            let dragged = ui.dragSource(card, DragPayload.of(DRAG_CARD, k as u64));
            ui.label(CARD_TITLES[k], Text.of().color(if (dragged) SLATE_500 else SLATE_100));
            ui.close();
        }
        ui.close();
    }
    ui.close();
    // The card being dragged, under the pointer.
    match (ui.dragging()) {
        Some(p) => {
            if (p.kind == DRAG_CARD && p.value < 6) {
                let at = ui.dragPosition();
                ui.open(Style.box().fixed().passthrough().left(at.x + 8.0).top(at.y + 8.0).z(500).px(space(3.0))
                    .py(space(2.0)).rounded(Radius.Md).bg(BLUE_600));
                ui.label(CARD_TITLES[p.value as usize], Text.of().color(SLATE_50));
                ui.close();
            }
        }
        null => {}
    }
    if (!app.takesFileDrops) {
        return;
    }
    // Files from the system.
    let zone = hashId("ci-files-drop");
    let target = ui.dropTarget(zone, DRAG_FILES);
    let over = match (target) {
        DropState.Over(_) => true,
        _ => false,
    };
    match (target) {
        DropState.Dropped(p) => { app.dropWanted = p.value; }
        _ => {}
    }
    ui.open(Style.column().idHash(zone).w(Size.grow()).h(Size.fixed(90.0)).p(space(3.0)).rounded(Radius.Lg)
        .alignXY(AxisAlign.Center, AxisAlign.Center).bg(if (over) withAlpha(EMERALD_500, 60) else NONE)
        .border(1.0, if (over) EMERALD_500 else SLATE_600));
    if (app.droppedCount > 0) {
        var head = [0u8; 48];
        var w = TextWriter.create(mut head[..]);
        w.decimal(app.droppedCount as u64);
        w.text(if (app.droppedCount == 1) " file dropped:" else " files dropped:");
        ui.labelBytes(w.written(), Text.of().color(inkCol(ui)));
        ui.labelBytes(app.droppedNames[0..app.droppedLen], Text.of().color(muteCol(ui)).clamp(3));
    } else {
        ui.label(if (over) "Drop to list them" else "Drop files here", Text.of().color(muteCol(ui)));
    }
    ui.close();
}

/// `base` with `-k` after it, as an id.
fn subName(base: StringView, k: usize) -> u32 {
    var b = [0u8; 32];
    var w = TextWriter.create(mut b[..]);
    w.text(base);
    w.byte('-');
    w.decimal(k as u64);
    return hashBytes(w.written());
}

/// The Tasks tab: counting primes on a background thread. Its reports wake the window, which otherwise sleeps.
fn tasksSection<J: DemoJobs>(ui: borrow mut Ui, app: borrow mut DemoApp, jobs: borrow mut J) {
    if (!jobs.available()) {
        caption(mut ui, "This host runs no background jobs (the desktop and GPU hosts do).");
        return;
    }
    caption(mut ui, "Count primes on a background thread: the window sleeps between its reports.");
    ui.open(Style.row().gap(space(2.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label("Below", Text.of().color(inkCol(ui)));
    for (k in 0..PRIME_LIMITS.length) {
        var id = [0u8; 16];
        var w = TextWriter.create(mut id[..]);
        w.text("ci-primes");
        w.decimal(k as u64);
        if (Controls.button(mut ui, StringView.fromUtf8(w.written())!, PRIME_LABELS[k])) {
            jobs.startCount(PRIME_LIMITS[k]);
            app.primes = PrimeCount { below: PRIME_LIMITS[k], checked: 0, found: 0 };
            app.primesStarted = ui.time();
        }
    }
    if (jobs.counting() && Controls.button(mut ui, "ci-primes-cancel", "Cancel")) {
        jobs.cancelCount();
    }
    ui.close();
    let c = app.primes;
    if (c.below == 0) {
        return;
    }
    // The progress bar, and what the count found so far.
    let part = round<f32>(c.checked) / round<f32>(c.below);
    ui.open(Style.box().w(Size.grow()).h(Size.fixed(8.0)).bg(SLATE_700).rounded(Radius.Full));
    ui.open(Style.box().w(Size.percent(part.min(1.0))).h(Size.grow()).bg(EMERALD_500).rounded(Radius.Full));
    ui.close();
    ui.close();
    var line = [0u8; 96];
    var lw = TextWriter.create(mut line[..]);
    grouped(mut lw, c.found);
    lw.text(" primes below ");
    grouped(mut lw, c.checked);
    if (c.done()) {
        lw.text(", in ");
        Format.fixed(mut lw, round<f32>(app.primesTook), 2);
        lw.text(" s");
    } else if (!jobs.counting()) {
        lw.text(" (cancelled)");
    }
    ui.labelBytes(lw.written(), Text.of().color(inkCol(ui)));
}

/// A second window's frame: the Live state panel on its own, sharing the app's state with the main window, and a
/// button that changes it (the main window's click counter follows).
public fn inspectorFrame(ui: borrow mut Ui, app: borrow mut DemoApp) {
    ui.open(Style.column().id("inspector").w(Size.grow()).h(Size.grow()).bg(pageBg(ui)).p(space(4.0)));
    statePanel(mut ui, mut app, true);
    ui.close();
}

/// The Live state panel: beside the Controls page's panel, or filling a window of its own (`inWindow`).
fn statePanel(ui: borrow mut Ui, app: borrow mut DemoApp, inWindow: bool) {
    var staged: i64 = 0;
    for (i in 0usize..6) {
        if (app.filesChecked[i]) {
            staged += 1;
        }
    }
    ui.open(
        Style.column().id("ci-state").w(if (inWindow) Size.grow() else Size.fixed(260.0)).bg(panelBg(ui)).p(
            space(5.0),
        ).gap(space(2.0)).rounded(Radius.Lg),
    );
    ui.label("Live state", Text.of().color(inkCol(ui)).bold());
    ui.open(Style.box().h(Size.fixed(4.0)));
    ui.close();
    var b = [0u8; 96];
    var w = TextWriter.create(mut b[..]);
    quoted(mut w, app.nameBuf[0..app.nameLen]);
    stateRow(mut ui, "name", w.written());
    var b2 = [0u8; 32];
    var w2 = TextWriter.create(mut b2[..]);
    w2.signed(truncate<i64>(app.nameEdit.caret));
    stateRow(mut ui, "caret", w2.written());
    var b3 = [0u8; 96];
    var w3 = TextWriter.create(mut b3[..]);
    quoted(mut w3, app.noteBuf[0..app.noteLen]);
    stateRow(mut ui, "note", w3.written());
    var b4 = [0u8; 32];
    var w4 = TextWriter.create(mut b4[..]);
    Format.fixed(mut w4, app.volume, 2);
    stateRow(mut ui, "volume", w4.written());
    var b5 = [0u8; 32];
    var w5 = TextWriter.create(mut b5[..]);
    w5.signed(app.qty as i64);
    stateRow(mut ui, "quantity", w5.written());
    var b6 = [0u8; 32];
    var w6 = TextWriter.create(mut b6[..]);
    w6.signed(app.saves as i64);
    stateRow(mut ui, "saves", w6.written());
    let sub = if (app.subscribe) "yes" else "no";
    stateRow(mut ui, "subscribe", sub.bytes());
    var b7 = [0u8; 32];
    var w7 = TextWriter.create(mut b7[..]);
    w7.text(if (app.notifyEmail) "on" else "off");
    w7.text(" / ");
    w7.text(if (app.notifyPush) "on" else "off");
    stateRow(mut ui, "email / push", w7.written());
    stateRow(mut ui, "theme", THEME_ITEMS[app.radioSel].bytes());
    stateRow(mut ui, "priority", PRIO_ITEMS[app.prioSel].bytes());
    stateRow(mut ui, "size", SIZE_ITEMS[app.sizeSel].bytes());
    stateRow(mut ui, "open", FILE_ITEMS[app.fileSel].bytes());
    var b8 = [0u8; 32];
    var w8 = TextWriter.create(mut b8[..]);
    w8.signed(staged);
    w8.text(if (staged == 1) " file" else " files");
    stateRow(mut ui, "staged", w8.written());
    ui.open(Style.box().h(Size.fixed(8.0)));
    ui.close();
    if (inWindow) {
        // A change made here shows in the main window too: both draw the same state.
        var b9 = [0u8; 32];
        var w9 = TextWriter.create(mut b9[..]);
        w9.signed(app.clicks as i64);
        stateRow(mut ui, "clicks", w9.written());
        if (Controls.button(mut ui, "ci-insp-click", "Click")) {
            app.clicks += 1;
        }
    } else if (app.inspectorWanted) {
        caption(mut ui, "Shown in its own window too.");
    } else if (app.opensWindows && Controls.button(mut ui, "ci-pop", "Open in a window")) {
        app.inspectorWanted = true;
    }
    ui.close();
}

fn controlsPage<M: TextMetrics, J: DemoJobs>(
    ui: borrow mut Ui,
    app: borrow mut DemoApp,
    metrics: borrow M,
    jobs: borrow mut J,
) {
    ui.open(Style.column().id("content").w(Size.grow()).h(Size.grow()).bg(pageBg(ui)).p(space(6.0)).gap(space(5.0)));
    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label("Controls", Text.of().font(TEXT_XL).color(inkCol(ui)).bold());
    ui.label("· controls.h · Tab cycles focus", Text.of().color(muteCol(ui)).wrap(TextWrap.None));
    ui.close();
    Controls.tabs(mut ui, "ci-tabs", CONTROLS_TABS[..], mut app.controlsTab);
    ui.open(Style.row().w(Size.grow()).gap(space(5.0)).alignXY(AxisAlign.Start, AxisAlign.Start));
    ui.open(
        Style.column().id("ci-panel").w(Size.grow()).bg(panelBg(ui)).p(space(5.0)).gap(space(4.0)).rounded(Radius.Lg),
    );
    if (app.controlsTab == 0) {
        inputsSection(mut ui, mut app, metrics);
    } else if (app.controlsTab == 1) {
        selectionSection(mut ui, mut app);
    } else if (app.controlsTab == 2) {
        listsSection(mut ui, mut app);
    } else if (app.controlsTab == 3) {
        tasksSection(mut ui, mut app, mut jobs);
    } else {
        dragSection(mut ui, mut app);
    }
    ui.close();
    statePanel(mut ui, mut app, false);
    ui.close();
    ui.close();
}

// ---- effects page --------------------------------------------------------------------------------------------------------

fn sectionTitle(ui: borrow mut Ui, title: StringView, hint: StringView) {
    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label(title, Text.of().font(TEXT_XL).color(inkCol(ui)).bold());
    ui.label(hint, Text.of().color(muteCol(ui)));
    ui.close();
}

fn dirOf(name: StringView) -> GradientDir {
    let b = name.bytes();
    let first = b[0];
    let second: u8 = if (b.length > 1) b[1] else 0;
    if (first == 't') {
        return if (second ==
            'r') GradientDir.ToTopRight else if (second == 'l') GradientDir.ToTopLeft else GradientDir.ToTop;
    }
    if (first == 'b') {
        return if (second ==
            'r') GradientDir.ToBottomRight else if (second == 'l') GradientDir.ToBottomLeft else GradientDir.ToBottom;
    }
    return if (first == 'r') GradientDir.ToRight else GradientDir.ToLeft;
}

fn blendOf(i: usize) -> BlendMode => match (i) {
    0 => BlendMode.Multiply,
    1 => BlendMode.Screen,
    2 => BlendMode.Overlay,
    3 => BlendMode.Darken,
    4 => BlendMode.Lighten,
    5 => BlendMode.ColorDodge,
    6 => BlendMode.ColorBurn,
    7 => BlendMode.HardLight,
    8 => BlendMode.SoftLight,
    9 => BlendMode.Difference,
    10 => BlendMode.Exclusion,
    11 => BlendMode.Hue,
    12 => BlendMode.Saturation,
    13 => BlendMode.Color,
    14 => BlendMode.Luminosity,
    _ => BlendMode.Add, // plus-lighter
};

fn gradientSwatch(ui: borrow mut Ui, dir: StringView) {
    ui.open(Style.column().idHash(namedId("gsw-", dir)).gap(space(1.0)).alignXY(AxisAlign.Center, AxisAlign.Center));
    ui.open(
        Style.box().w(Size.fixed(72.0)).h(Size.fixed(48.0)).rounded(Radius.Lg).gradient(
            dirOf(dir),
            INDIGO_600,
            ROSE_500,
        ),
    );
    ui.close();
    var b = [0u8; 16];
    var w = TextWriter.create(mut b[..]);
    w.text("to-");
    w.text(dir);
    ui.labelBytes(w.written(), Text.of().color(muteCol(ui)));
    ui.close();
}

/// A captioned column of one swatch.
fn swatchOpen(ui: borrow mut Ui) {
    ui.open(Style.column().gap(space(1.0)).alignXY(AxisAlign.Center, AxisAlign.Center));
}

fn gradientsSection(ui: borrow mut Ui, app: borrow DemoApp) {
    sectionTitle(mut ui, "Gradients", "bg-gradient-to-* · from/via/to · stop positions · bg-radial · angle");
    ui.open(
        Style.column().id("gradCard").w(Size.grow()).bg(panelBg(ui)).p(space(5.0)).gap(space(4.0)).rounded(Radius.Lg),
    );
    // All eight Tailwind directions.
    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).wrap());
    for (dir in GRADIENT_DIRS) {
        gradientSwatch(mut ui, dir);
    }
    ui.close();
    // via + positions, radial, and a live CSS angle.
    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).wrap().alignXY(AxisAlign.Start, AxisAlign.Center));
    swatchOpen(mut ui);
    ui.open(
        Style.box().w(Size.fixed(160.0)).h(Size.fixed(48.0)).rounded(Radius.Lg).gradient(
            GradientDir.ToRight,
            SKY_500,
            AMBER_500,
        )
            .via(FUCHSIA_500),
    );
    ui.close();
    ui.label("from · via · to", Text.of().color(muteCol(ui)));
    ui.close();
    swatchOpen(mut ui);
    ui.open(Style.box().w(Size.fixed(160.0)).h(Size.fixed(48.0)).rounded(Radius.Lg)
        .gradient(GradientDir.ToRight, EMERALD_500, EMERALD_500).via(SLATE_950).stops(20.0, 50.0, 80.0));
    ui.close();
    ui.label("from-20% via-50% to-80%", Text.of().color(muteCol(ui)));
    ui.close();
    swatchOpen(mut ui);
    ui.open(
        Style.box().w(Size.fixed(96.0)).h(Size.fixed(48.0)).rounded(Radius.Lg).gradient(
            GradientDir.Radial,
            AMBER_500,
            ROSE_500,
        ),
    );
    ui.close();
    ui.label("bg-radial", Text.of().color(muteCol(ui)));
    ui.close();
    swatchOpen(mut ui);
    ui.requestFrame(); // the live gradient turns every frame while it shows
    let turns = app.elapsed * 40.0 / 360.0;
    var angle = (turns - turns.floor()) * 360.0;
    if (angle < 1.0) {
        angle = 1.0; // 0 would mean "use the direction"
    }
    ui.open(Style.box().id("gradSpin").w(Size.fixed(96.0)).h(Size.fixed(48.0)).rounded(Radius.Full)
        .gradient(GradientDir.ToRight, CYAN_500, INDIGO_600).gradientAngle(angle));
    ui.close();
    var b = [0u8; 32];
    var w = TextWriter.create(mut b[..]);
    Format.fixed(mut w, angle, 0);
    w.text("deg (live)");
    ui.labelBytes(w.written(), Text.of().color(muteCol(ui)));
    ui.close();
    ui.close();
    ui.close();
}

fn blendSection(ui: borrow mut Ui) {
    sectionTitle(mut ui, "Blend modes", "mix-blend-* · every CSS mode; ThorVG renders all 17");
    ui.open(
        Style.column().id("blendCard").w(Size.grow()).bg(panelBg(ui)).p(space(5.0)).gap(space(4.0)).rounded(Radius.Lg),
    );
    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).wrap());
    for (i in 0..BLEND_NAMES.length) {
        let name = BLEND_NAMES[i];
        ui.open(
            Style.column().idHash(namedId("bm-", name)).gap(space(1.0)).alignXY(AxisAlign.Center, AxisAlign.Center),
        );
        // Backdrop: a sky-to-amber tile. Source: a rose disc blended over it.
        ui.open(
            Style.box().w(Size.fixed(88.0)).h(Size.fixed(56.0)).rounded(Radius.Md).gradient(
                GradientDir.ToBottomRight,
                SKY_500,
                AMBER_500,
            )
                .clip(),
        );
        ui.open(
            Style.box().blend(blendOf(i)).w(
                Size.fixed(40.0),
            ).h(Size.fixed(40.0)).mt(8.0).ml(24.0).bg(ROSE_500).rounded(Radius.Full),
        );
        ui.close();
        ui.close();
        ui.label(name, Text.of().color(muteCol(ui)));
        ui.close();
    }
    ui.close();
    ui.close();
}

/// The clip demo's content: an oversized gradient strip and an offset chip.
fn clipContent(ui: borrow mut Ui) {
    ui.open(
        Style.box().w(Size.fixed(260.0)).h(Size.fixed(60.0)).m(-8.0).gradient(
            GradientDir.ToRight,
            VIOLET_500,
            CYAN_500,
        ),
    );
    ui.close();
    ui.open(Style.box().w(Size.fixed(80.0)).h(Size.fixed(80.0)).mt(40.0).ml(-20.0).bg(AMBER_500).rounded(Radius.Md));
    ui.close();
}

fn clipSection(ui: borrow mut Ui) {
    sectionTitle(mut ui, "Rounded clipping", "overflow-hidden follows rounded-* (CSS behavior)");
    ui.open(Style.row().w(Size.grow()).gap(space(4.0)).wrap());
    // Clipped: the oversized child and the offset chip are cut at the rounded corners.
    swatchOpen(mut ui);
    ui.open(
        Style.box().id("clipOn").w(Size.fixed(220.0)).h(Size.fixed(120.0)).bg(panelBg(ui)).rounded(Radius.Xl2).clip(),
    );
    clipContent(mut ui);
    ui.close();
    ui.label("rounded-2xl overflow-hidden", Text.of().color(muteCol(ui)));
    ui.close();
    // The same content without clip.
    swatchOpen(mut ui);
    ui.open(Style.box().id("clipOff").w(Size.fixed(220.0)).h(Size.fixed(120.0)).bg(panelBg(ui)).rounded(Radius.Xl2));
    clipContent(mut ui);
    ui.close();
    ui.label("rounded-2xl (no clip)", Text.of().color(muteCol(ui)));
    ui.close();
    // A scroll container with rounded corners: scrolling clips to the radius too.
    swatchOpen(mut ui);
    ui.open(
        Style.column().id("clipScroll").w(Size.fixed(220.0)).h(Size.fixed(120.0)).bg(panelBg(ui)).rounded(Radius.Xl2)
            .scroll(ScrollAxis.Vertical).p(space(3.0)).gap(space(2.0)),
    );
    for (i in 0usize..8) {
        ui.open(
            Style.box().w(Size.grow()).py(space(2.0)).px(space(3.0)).bg(
                ui.theme(SLATE_800, SLATE_200),
            ).rounded(Radius.Md),
        );
        var b = [0u8; 40];
        var w = TextWriter.create(mut b[..]);
        w.text("row ");
        w.signed(truncate<i64>(i + 1));
        w.text(" · wheel to scroll");
        ui.labelBytes(w.written(), Text.of().color(inkCol(ui)));
        ui.close();
    }
    ui.close();
    ui.label("overflow-y-auto rounded-2xl", Text.of().color(muteCol(ui)));
    ui.close();
    ui.close();
}

fn effectsPage(ui: borrow mut Ui, app: borrow DemoApp) {
    ui.open(Style.column().id("content").w(Size.grow()).h(Size.grow()).bg(pageBg(ui)).p(space(6.0)).gap(space(5.0))
        .scroll(ScrollAxis.Vertical));
    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));
    ui.label("Effects", Text.of().font(TEXT_XL).color(inkCol(ui)).bold());
    ui.label("· gradients, blend modes and rounded clipping, all rendered by ThorVG", Text.of().color(muteCol(ui)));
    ui.close();
    clipSection(mut ui);
    gradientsSection(mut ui, app);
    blendSection(mut ui);
    ui.close();
}
