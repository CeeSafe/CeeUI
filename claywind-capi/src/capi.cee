// SPDX-License-Identifier: MIT
// ClayWind for C (roadmap P6). A host calls claywind_run with a frame function; ClayWind opens a window and, for each
// frame, calls it with a frame handle. The frame function builds the window from its own state with the calls below,
// in immediate mode, as a ClayWind app's frame does in CeeSafe; they are recorded into a Frame and replayed into the
// Ui (frame.cee). The C API is include/claywind.h. Text is UTF-8, given as a pointer and a length (no NUL needed).
//
// The handle a frame function gets is valid only during that call, on the thread claywind_run runs on.

import claywind;
import claywind_desktop;
import claywind_fonts;

/// The API's version: major * 10000 + minor * 100 + patch.
const API_VERSION: i32 = 200;

/// What claywind_run returns.
const RUN_CLOSED: i32 = 0;
const RUN_NO_WINDOW: i32 = 1;
const RUN_NO_MEMORY: i32 = 2;
const RUN_NO_FONTS: i32 = 3;
const RUN_FRAME_TOO_LARGE: i32 = 4;
const RUN_WINDOW_REFUSED: i32 = 5;

/// The frame behind a handle a frame function was given.
/// Safety: claywind_run gives the frame function a handle to its own Frame, which lives until claywind_run returns,
/// and the API's contract (claywind.h) is that a handle is used only during the frame function's call, on its thread.
fn frameOf(handle: *mut void) -> borrow mut(static) Frame {
    return unsafe { Ptr.toBorrowMut(handle as *mut Frame) };
}

/// `length` bytes at `text`; empty when the pointer is null.
/// Safety: the API's contract (claywind.h) is that a pointer and length name `length` readable bytes for the call.
fn bytesOf(text: *u8, length: usize) -> Slice<static, u8> {
    if (text.isNull() || length == 0) {
        return "".bytes();
    }
    return unsafe { Slice.fromRaw(text, length) };
}

/// The version of this library (API_VERSION).
@export
fn claywind_version() -> i32 => API_VERSION;

/// Opens a window titled `title`, `width` x `height` points, and runs it until it is closed, calling `frame(handle,
/// user)` for each frame. Returns 0 when the window was closed, or why it stopped (RUN_*). The host calls
/// ceesafe_init first, on the thread that runs the window (the main thread on macOS).
/// Safety: `frame` is the host's function of that type (claywind.h); it is called with a handle to a Frame that
/// outlives the call and with the host's own `user`, which ClayWind never reads.
@export
fn claywind_run(
    title: *u8,
    titleLength: usize,
    width: i32,
    height: i32,
    frame: extern "C" fn(*mut void, *mut void),
    user: *mut void,
) -> i32 {
    if (frame.isNull()) {
        return RUN_NO_WINDOW;
    }
    let name = StringView.fromUtf8(bytesOf(title, titleLength)) ?? "";
    var window = match (Window.open(
        if (name.length > 0) name else "ClayWind",
        saturatingTruncate<u32>(width.max(1)),
        saturatingTruncate<u32>(height.max(1)),
    )) {
        Ok(w) => w,
        Err(_) => { return RUN_NO_WINDOW; }
    };
    var paneStorage = zeros(33554432);
    let capacity = rasterCapacityFor(window);
    var rasterStorage = zeros(capacity.bytes());
    let paneMemory = FixedBufferAllocator.over(mut paneStorage.viewMut());
    let rasterMemory = FixedBufferAllocator.over(mut rasterStorage.viewMut());
    var pane = match (Pane.create(paneMemory, 1, 4096, 16384, MAX_PIXELS_WIDTH * MAX_PIXELS_HEIGHT, window.size())) {
        Ok(p) => p,
        Err(_) => { return RUN_NO_MEMORY; }
    };
    var raster = match (Raster.create(rasterMemory, capacity)) {
        Ok(r) => r,
        Err(_) => { return RUN_NO_MEMORY; }
    };
    if (!loadSystemFonts(mut raster)) {
        return RUN_NO_FONTS;
    }
    var systemFonts = SystemFonts.create();
    var share = RasterShare.create();
    pane.ui.setSecondaryIsCommand(match (window.nativeHandle()) {
        WindowHandle.AppKit(_, _) => true,
        _ => false,
    });
    var recorded = Frame.create();
    loop {
        if (pane.takeEvents(mut window)) {
            return RUN_CLOSED;
        }
        // The host's frame, recorded, then replayed into the page: the window's whole area, inside its safe area.
        recorded.begin(pane.ui.isDarkMode());
        let handle = borrow mut recorded as *mut Frame as *mut void;
        unsafe {
            frame(handle, user);
        }
        pane.begin(mut window);
        let dark = pane.ui.isDarkMode();
        pane.ui.open(Style.column().id("claywind-page").w(Size.grow()).h(Size.grow()).p(space(6.0)).gap(space(3.0))
            .bg(if (dark) SLATE_950 else SLATE_50).safe(pane.ui.safeArea()));
        replay(mut pane.ui, mut recorded, raster);
        pane.ui.close();
        if (!pane.end(mut window, raster)) {
            return RUN_FRAME_TOO_LARGE;
        }
        if (systemFonts.supplyFrame(mut raster, pane.ui) > 0) {
            // The same commands draw other glyphs now; the next frame lays them out with the fonts' measures.
            pane.damage.invalidate();
            pane.ui.requestFrame();
        }
        if (!pane.draw(mut raster, mut share, mut window, Color.hex(if (dark) SLATE_950 else SLATE_50))) {
            return RUN_WINDOW_REFUSED;
        }
        pane.platform.endFrame();
        if (pane.ui.needsFrame()) {
            window.waitFrame();
        } else {
            Window.waitAny(pane.ui.frameDelayMs(IDLE_MS));
        }
    }
}

/// Starts a column (children top to bottom), `gap` points between children.
@export
fn claywind_column(frame: *mut void, gap: f32) {
    frameOf(frame).column(gap);
}

/// Starts a row (children left to right, centred across), `gap` points between them.
@export
fn claywind_row(frame: *mut void, gap: f32) {
    frameOf(frame).row(gap);
}

/// Starts a panel: a column with padding on a raised background, rounded.
@export
fn claywind_panel(frame: *mut void) {
    frameOf(frame).panel();
}

/// Space that takes what a row or column has left.
@export
fn claywind_spacer(frame: *mut void) {
    frameOf(frame).spacer();
}

/// Ends the column, row or panel started last.
@export
fn claywind_end(frame: *mut void) {
    frameOf(frame).end();
}

/// Text in the theme's ink, wrapped at words.
@export
fn claywind_label(frame: *mut void, text: *u8, length: usize) {
    frameOf(frame).label(bytesOf(text, length));
}

/// Text in the muted colour.
@export
fn claywind_caption(frame: *mut void, text: *u8, length: usize) {
    frameOf(frame).caption(bytesOf(text, length));
}

/// A heading: larger, bold.
@export
fn claywind_heading(frame: *mut void, text: *u8, length: usize) {
    frameOf(frame).heading(bytesOf(text, length));
}

/// A button named `id` (unique in the frame), labelled `label`; true when it was pressed in the last frame.
@export
fn claywind_button(frame: *mut void, id: *u8, idLength: usize, label: *u8, labelLength: usize) -> bool {
    return frameOf(frame).button(bytesOf(id, idLength), bytesOf(label, labelLength));
}

/// A checkbox over `*value`; when the user flipped it in the last frame, `*value` takes the new state and the call
/// returns true.
/// Safety: the API's contract (claywind.h) is that `value` points to a bool the host owns, for the call.
@export
fn claywind_checkbox(
    frame: *mut void,
    id: *u8,
    idLength: usize,
    label: *u8,
    labelLength: usize,
    value: *mut bool,
) -> bool {
    if (value.isNull()) {
        return false;
    }
    var on = unsafe { value.read() };
    let changed = frameOf(frame).checkbox(bytesOf(id, idLength), bytesOf(label, labelLength), mut on);
    unsafe {
        value.write(on);
    }
    return changed;
}

/// A text field named `id` over the host's UTF-8 text, the first `*length` of `capacity` bytes at `buffer`. When the
/// user changed the text in the last frame, the buffer and `*length` take the new text (cut at a character to fit;
/// not NUL-terminated) and the call returns true. `name` is what a screen reader calls the field. A null buffer or
/// length, or no capacity, draws no field.
/// Safety: the API's contract (claywind.h) is that `buffer` names `capacity` writable bytes and `length` a size_t the
/// host owns, for the call.
@export
fn claywind_text_field(
    frame: *mut void,
    id: *u8,
    idLength: usize,
    name: *u8,
    nameLength: usize,
    buffer: *mut u8,
    capacity: usize,
    length: *mut usize,
) -> bool {
    if (buffer.isNull() || length.isNull() || capacity == 0) {
        return false;
    }
    let text = unsafe { SliceMut.fromRaw(buffer, capacity) };
    var n = unsafe { length.read() };
    let changed = frameOf(frame).textField(bytesOf(id, idLength), bytesOf(name, nameLength), text, mut n);
    unsafe {
        length.write(n);
    }
    return changed;
}

/// Whether the UI is in its dark theme.
@export
fn claywind_is_dark(frame: *mut void) -> bool => frameOf(frame).isDark();

/// The dark theme on or off, from this frame on.
@export
fn claywind_set_dark(frame: *mut void, dark: bool) {
    frameOf(frame).setDark(dark);
}

/// Asks for another frame soon, for state that changed outside the controls (a timer, a download).
@export
fn claywind_request_frame(frame: *mut void) {
    frameOf(frame).requestFrame();
}
