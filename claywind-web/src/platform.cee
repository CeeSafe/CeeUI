// SPDX-License-Identifier: MIT
// The web host's platform: what the page tells of the pointer, the keys, the fingers and the canvas's size, as the
// Ui's input. The page queues events; the host takes them before each frame (host.cee) as a kind and four numbers.

import claywind;

/// The kinds of event the page queues (web.js writes the same numbers).
const EVENT_MOVE: i32 = 1;   // x, y
const EVENT_BUTTON: i32 = 2; // button (0 primary, 1 middle, 2 secondary), down, x, y
const EVENT_WHEEL: i32 = 3;  // dx, dy in lines; positive dy scrolls up
const EVENT_KEY: i32 = 4;    // the key's index or -1, down + 2 * repeat, modifiers (1 shift, 2 control, 4 alt, 8 command), its character or 0
const EVENT_TEXT: i32 = 5;   // a typed Unicode scalar
const EVENT_RESIZE: i32 = 6; // width, height in layout points, the device pixels to a point
const EVENT_FOCUS: i32 = 7;  // focused
const EVENT_TOUCH: i32 = 8;  // the finger's id * 4 + its phase (0 began, 1 moved, 2 ended, 3 cancelled), x, y, seconds

/// Wheel lines to ClayWind's wheel units, as the desktop host has it.
const WHEEL_UNITS: f32 = 2.5;

public struct WebPlatform {
    size: Dims;
    pointerState: Pointer;
    down: u64;
    pressed: u64;
    repeated: u64;
    typed: [u32; 64];
    typedCount: usize;
    typedRead: usize;
    strokes: [Keystroke; 16];
    strokeCount: usize;
    strokeRead: usize;
    dt: f32;
    clock: f64;
    public cursor: Cursor;
    /// The device pixels to a layout point, as the page last said.
    public ratio: f32;
    /// Whether the page is on an Apple system, where shortcuts are Command's (Ui.setSecondaryIsCommand).
    public apple: bool;
    shownCursor: u32;
    /// The page's touches this frame, for the Ui's gestures; past 64 a frame, later moves are left out, never a
    /// finger's start or end (as the desktop host's).
    touches: [Touch; 64];
    touchCount: usize;
    touchRead: usize;

    public fn create(size: Dims, ratio: f32) -> WebPlatform => WebPlatform {
        size: size,
        pointerState: Pointer.at(Vec2 { x: -100.0, y: -100.0 }),
        down: 0,
        pressed: 0,
        repeated: 0,
        typed: [0u32; 64],
        typedCount: 0,
        typedRead: 0,
        strokes: [Keystroke { key: null, character: 0, modifiers: Modifiers.none() }; 16],
        strokeCount: 0,
        strokeRead: 0,
        dt: 0.0,
        clock: 0.0,
        cursor: Cursor.Default,
        ratio: ratio,
        apple: false,
        shownCursor: 0,
        touches: [Touch { id: 0, phase: TouchPhase.Began, position: Vec2.zero(), time: 0.0 }; 64],
        touchCount: 0,
        touchRead: 0,
    };

    public fn setFrameTime(borrow mut this, seconds: f32) {
        this.dt = if (seconds > 0.25) 0.25 else seconds;
        this.clock += seconds as f64;
    }

    /// Clears the one-frame edges after a frame used them.
    public fn endFrame(borrow mut this) {
        this.pointerState.pressed = false;
        this.pointerState.released = false;
        this.pointerState.secondaryPressed = false;
        this.pointerState.wheel = Vec2.zero();
        this.pressed = 0;
        this.repeated = 0;
        this.typedCount = 0;
        this.typedRead = 0;
        this.strokeCount = 0;
        this.strokeRead = 0;
        this.touchCount = 0;
        this.touchRead = 0;
    }

    /// Folds one of the page's events into this frame's state.
    public fn apply(borrow mut this, kind: i32, v: [f64; 4]) {
        if (kind == EVENT_MOVE) {
            this.pointerState.position = Vec2 { x: round<f32>(v[0]), y: round<f32>(v[1]) };
        } else if (kind == EVENT_BUTTON) {
            this.pointerState.position = Vec2 { x: round<f32>(v[2]), y: round<f32>(v[3]) };
            let isDown = v[1] != 0.0;
            if (v[0] == 2.0) {
                this.pointerState.secondaryDown = isDown;
                if (isDown) {
                    this.pointerState.secondaryPressed = true;
                }
            } else if (v[0] == 0.0) {
                if (isDown) {
                    this.pointerState.down = true;
                    this.pointerState.pressed = true;
                } else if (this.pointerState.down) {
                    this.pointerState.down = false;
                    this.pointerState.released = true;
                }
            }
        } else if (kind == EVENT_WHEEL) {
            this.pointerState.wheel.y += round<f32>(v[1]) * WHEEL_UNITS;
        } else if (kind == EVENT_KEY) {
            this.key(v);
        } else if (kind == EVENT_TEXT) {
            if (this.typedCount < 64 && v[0] >= 0.0 && v[0] < 1114112.0) {
                this.typed[this.typedCount] = truncate<u32>(truncate<i64>(v[0]));
                this.typedCount += 1;
            }
        } else if (kind == EVENT_RESIZE) {
            if (v[0] >= 1.0 && v[1] >= 1.0) {
                this.size = Dims { w: round<f32>(v[0]), h: round<f32>(v[1]) };
                if (v[2] > 0.0) {
                    this.ratio = round<f32>(v[2]);
                }
            }
        } else if (kind == EVENT_FOCUS) {
            if (v[0] == 0.0) {
                // Keys and buttons released while another window had the focus never arrive.
                this.down = 0;
                this.pointerState.down = false;
                this.pointerState.secondaryDown = false;
            }
        } else if (kind == EVENT_TOUCH) {
            let packed = truncate<u32>(truncate<i64>(v[0]));
            let phase = match (packed & 3) {
                0 => TouchPhase.Began,
                1 => TouchPhase.Moved,
                2 => TouchPhase.Ended,
                _ => TouchPhase.Cancelled,
            };
            if (this.touchCount == 64 || ((packed & 3) == 1 && this.touchCount >= 56)) {
                return; // the last eight places are kept for starts and ends
            }
            this.touches[this.touchCount] = Touch {
                id: packed >> 2,
                phase: phase,
                position: Vec2 { x: round<f32>(v[1]), y: round<f32>(v[2]) },
                time: v[3],
            };
            this.touchCount += 1;
        }
    }

    fn key(borrow mut this, v: [f64; 4]) {
        let flags = truncate<u32>(truncate<i64>(v[1]));
        let isDown = (flags & 1) != 0;
        let repeat = (flags & 2) != 0;
        let held = truncate<u32>(truncate<i64>(v[2]));
        this.hold(Key.LeftShift, (held & 1) != 0);
        this.hold(Key.LeftControl, (held & 2) != 0);
        this.hold(Key.LeftAlt, (held & 4) != 0);
        var named: Key? = null;
        if (v[0] >= 0.0 && v[0] < round<f64>(KEY_COUNT)) {
            named = keyAt(truncate<u32>(truncate<i64>(v[0])));
        }
        let character = if (v[3] > 0.0 && v[3] < 1114112.0) truncate<u32>(truncate<i64>(v[3])) else 0;
        if (isDown && this.strokeCount < 16 && (character != 0 || named != null)) {
            this.strokes[this.strokeCount] = Keystroke {
                key: named,
                character: if (character >= 'A' && character <= 'Z') character + 32 else character,
                modifiers: Modifiers {
                    shift: (held & 1) != 0,
                    control: (held & 2) != 0,
                    alt: (held & 4) != 0,
                    command: (held & 8) != 0,
                },
            };
            this.strokeCount += 1;
        }
        match (named) {
            Some(k) => {
                let bit = 1u64 << (keyIndex(k) as u64);
                if (!isDown) {
                    this.down = this.down & (bit ^ 0xFFFFFFFFFFFFFFFF);
                } else if (repeat) {
                    this.repeated = this.repeated | bit;
                } else {
                    this.down = this.down | bit;
                    this.pressed = this.pressed | bit;
                }
            }
            null => {}
        }
    }

    fn hold(borrow mut this, key: Key, held: bool) {
        let bit = 1u64 << (keyIndex(key) as u64);
        this.down = if (held) this.down | bit else this.down & (bit ^ 0xFFFFFFFFFFFFFFFF);
    }
}

impl Platform for WebPlatform {
    fn screenSize(borrow this) -> Dims => this.size;
    fn frameTime(borrow this) -> f32 => this.dt;
    fn time(borrow this) -> f64 => this.clock;
    fn pointer(borrow this) -> Pointer => this.pointerState;
    fn keyDown(borrow this, key: Key) -> bool => (this.down >> (keyIndex(key) as u64)) & 1 == 1;
    fn keyPressed(borrow this, key: Key) -> bool => (this.pressed >> (keyIndex(key) as u64)) & 1 == 1;
    fn keyRepeated(borrow this, key: Key) -> bool => (this.repeated >> (keyIndex(key) as u64)) & 1 == 1;
    fn nextKeystroke(borrow mut this) -> Keystroke? {
        if (this.strokeRead >= this.strokeCount) {
            return null;
        }
        let s = this.strokes[this.strokeRead];
        this.strokeRead += 1;
        return s;
    }
    fn nextChar(borrow mut this) -> u32 {
        if (this.typedRead >= this.typedCount) {
            return 0;
        }
        let c = this.typed[this.typedRead];
        this.typedRead += 1;
        return c;
    }
    fn nextTouch(borrow mut this) -> Touch? {
        if (this.touchRead >= this.touchCount) {
            return null;
        }
        let t = this.touches[this.touchRead];
        this.touchRead += 1;
        return t;
    }
    fn setCursor(borrow mut this, cursor: Cursor) {
        this.cursor = cursor;
    }
}
