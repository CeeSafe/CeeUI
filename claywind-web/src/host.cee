// SPDX-License-Identifier: MIT
// The web host (roadmap P5): a ClayWind app as a WebAssembly module in a browser, drawn by the software renderer
// onto a canvas. The app is a freestanding package that exports `run`, a loop of frames:
//
//   @export("run")
//   fn run() -> i32 {
//       var uiBlock = WebBlock.take(8388608);    ... a Ui, a Raster (webRasterCapacity), a Damage over such blocks
//       let fonts = WebFonts.open();
//       raster.loadFont(1, fonts.font(0));       ... the fonts the page was given, by their order
//       var platform = WebPlatform.open();
//       ui.setSecondaryIsCommand(platform.apple);
//       loop {
//           platform.beginFrame(mut ui);
//           ui.begin(mut platform);
//           platform.editInto(mut ui);
//           ... the app's frame ...
//           if (ui.endFrame(mut platform, raster).isOk()) { platform.show(ui, mut raster, mut damage, clear); }
//           platform.finishFrame(ui);
//       }
//   }
//
// `run` runs in a worker of the page (page/worker.js), where waiting is allowed: `beginFrame` returns when the
// browser's next frame is due, and `finishFrame` sleeps while nothing changes. claywind-pack's `web` target builds
// the module and puts the page beside it.

import claywind;

/// The largest frame, in pixels (the desktop host's): a canvas larger than this at its pixel ratio is drawn at a
/// lower one. page/web.js has the same numbers.
public const WEB_MAX_PIXELS_WIDTH: usize = 2880;
public const WEB_MAX_PIXELS_HEIGHT: usize = 1800;

/// The memory a Raster of webRasterCapacity needs.
public const WEB_RASTER_BYTES: usize = 264241152;

/// The font id of the page's fallback font `k` once loaded.
const FIRST_FALLBACK_ID: u32 = 64;

extern "C" {
    /// `size` bytes of the module's memory (host.c), which stay the caller's; null when there are not that many left.
    @effects()
    fn web_take(size: usize) -> *mut u8;
    /// The canvas as the page starts: its width and height in points, the device pixels to a point, and 1 on an
    /// Apple system.
    fn web_start(values: *mut f64);
    /// The page's font `index`, in the module's memory, and its length; null past the last.
    fn web_font(index: u32, length: *mut usize) -> *u8;
    /// The page's fallback font `index`, fetched now, in the module's memory, and its length; null past the last or
    /// when it cannot be had.
    fn web_fallback(index: u32, length: *mut usize) -> *u8;
    /// Waits for the page's next frame; the seconds since the last wait returned.
    fn web_wait() -> f64;
    /// Sleeps until the page queues an event or `seconds` pass; a negative number is no limit.
    fn web_idle(seconds: f64);
    /// The next event the page queued, as its kind (platform.cee) with its four numbers in `values`, or 0.
    fn web_event(values: *mut f64) -> i32;
    /// A box of the frame that changed, in pixels: before `web_present`, once for each.
    fn web_box(x: u32, y: u32, width: u32, height: u32);
    /// Shows the boxes given of the frame, `width` by `height` pixels, each R, G, B, A.
    fn web_present(pixels: *u32, width: u32, height: u32);
    /// The pointer's shape: 0 the arrow, 1 a hand, 2 a text beam.
    fn web_cursor(kind: u32);
    /// The text the page last pasted, in the module's memory, and its length.
    fn web_pasted(length: *mut usize) -> *u8;
    /// Puts `length` bytes of UTF-8 on the clipboard.
    fn web_copy(text: *u8, length: usize);
    /// The text an input method is composing, in the module's memory, and its length (0 when none).
    fn web_composition(length: *mut usize) -> *u8;
    /// Whether a text field has the focus (`on`), the kind of text it takes (TextKind's order), what its Return key
    /// says (ReturnKey's order) and its caret's box in points: the page's own text input goes there, which brings a
    /// phone's keyboard and the input method.
    fn web_text_input(on: u32, kind: u32, returnKey: u32, x: f32, y: f32, width: f32, height: f32);
    /// One of the frame's elements for a screen reader, in reading order: its id, role (accessRoleNumber), flags
    /// (ACCESS_*), box in points, range and value, label and value text, and a text field's caret and anchor.
    fn web_access_node(
        id: u32,
        role: u32,
        flags: u32,
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        min: f32,
        max: f32,
        now: f32,
        label: *u8,
        labelLength: usize,
        value: *u8,
        valueLength: usize,
        caret: usize,
        anchor: usize,
    );
    /// The elements given since the last call are the page's whole list now.
    fn web_access_end();
}

/// A block of the module's memory, for a FixedBufferAllocator. The module's memory is fixed when it is built
/// (host.c's WEB_MEMORY), and nothing is given back: an app takes its blocks once, as it starts.
public struct WebBlock {
    start: *mut u8;
    size: usize;

    /// `size` bytes; a block of none when there are not that many left.
    /// Safety: web_take gives `size` bytes nothing else uses, or null.
    public fn take(size: usize) -> WebBlock {
        unsafe {
            let start = web_take(size);
            return WebBlock { start: start, size: if (start as usize == 0) 0 else size };
        }
    }

    /// The block's bytes; empty when it could not be taken.
    /// Safety: `start` names `size` bytes that are this block's alone.
    public fn bytes(borrow mut this) -> SliceMut<u8> {
        unsafe {
            return SliceMut.fromRaw(this.start, this.size);
        }
    }
}

/// The page's fonts (the files claywind-pack was given, in their order).
public struct WebFonts {
    unused: u8;

    public fn open() -> WebFonts => WebFonts { unused: 0 };

    /// Font `index`: a file's bytes for Raster.loadFont, empty past the last.
    /// Safety: web_font gives a pointer to `length` bytes the page wrote, which stay, or null.
    public fn font(borrow this, index: u32) -> Slice<u8> {
        unsafe {
            var length: usize = 0;
            let bytes = web_font(index, borrow mut length as *mut usize);
            return Slice.fromRaw(bytes, if (bytes as usize == 0) 0 else length);
        }
    }
}

/// A Raster's capacity for the web host: frames up to WEB_MAX_PIXELS, and room for the page's fallback fonts (a font
/// with the CJK characters is tens of megabytes).
public fn webRasterCapacity() -> RasterCapacity {
    var capacity = RasterCapacity.of(WEB_MAX_PIXELS_WIDTH, WEB_MAX_PIXELS_HEIGHT);
    capacity.fontBytes = 67108864;
    return capacity;
}

/// The ratio to draw at: the page's, lowered until `size` points fit the largest frame (as the desktop host's).
fn ratioFor(size: Dims, wanted: f32) -> f32 {
    let w = if (size.w < 1.0) 1.0 else size.w;
    let h = if (size.h < 1.0) 1.0 else size.h;
    let ratio = if (wanted >= 1.0) wanted else 1.0;
    return ratio.min(round<f32>(WEB_MAX_PIXELS_WIDTH) / w).min(round<f32>(WEB_MAX_PIXELS_HEIGHT) / h);
}

fn pixels(points: f32, ratio: f32, most: usize) -> usize {
    let n = saturatingTruncate<usize>(Math.round(points * ratio));
    return n.max(1).min(most);
}

impl WebPlatform {
    /// The platform of the page's canvas as it is now.
    /// Safety: web_start writes four numbers.
    public fn open() -> WebPlatform {
        var values = [0.0f64; 4];
        unsafe {
            web_start(borrow mut values[0] as *mut f64);
        }
        var platform = WebPlatform.create(
            Dims { w: round<f32>(values[0]), h: round<f32>(values[1]) },
            round<f32>(values[2]),
        );
        platform.apple = values[3] != 0.0;
        return platform;
    }

    /// Before `ui.begin`: waits for the browser's next frame, and takes what the page queued since the last; what
    /// a screen reader asked goes to `ui`, whose controls see it in this frame.
    /// Safety: web_event writes four numbers.
    public fn beginFrame(borrow mut this, ui: borrow mut Ui) {
        unsafe {
            this.setFrameTime(round<f32>(web_wait()));
            var values = [0.0f64; 4];
            loop {
                let kind = web_event(borrow mut values[0] as *mut f64);
                if (kind == 0) {
                    break;
                }
                if (kind == EVENT_ACCESS) {
                    let action = match (truncate<i64>(values[1])) {
                        0 => AccessAction.Press,
                        1 => AccessAction.Focus,
                        2 => AccessAction.Increment,
                        _ => AccessAction.Decrement,
                    };
                    let _ = ui.accessAct(truncate<u32>(truncate<i64>(values[0])), action);
                } else {
                    this.apply(kind, values);
                }
            }
        }
    }

    /// The frame's elements for a screen reader, to the page, when they are not what it has: an element with no
    /// place or the id 0 is left out. The page keeps them as elements of its own over the canvas (page/web.js).
    /// Safety: web_access_node reads the two texts during the call.
    fn giveAccess(borrow mut this, ui: borrow Ui) {
        let sum = ui.accessSum();
        if (sum == this.accessSum) {
            return;
        }
        this.accessSum = sum;
        // The page has no containers yet (CeeSafe ADR 0207's, which the page will give as ARIA's): the list is given
        // as CeeSafe gives it to a system without them. Containers are left out, a table's row is a list's item and
        // holds what is in it when it has a name, a column header is a button.
        var namedRows = [0u32; 64];
        var namedCount: usize = 0;
        unsafe {
            for (i in 0..ui.accessCount()) {
                let node = ui.accessAt(i);
                let box = match (ui.accessBox(node)) {
                    Some(b) => b,
                    null => { continue; }
                };
                if (node.id == 0) {
                    continue;
                }
                var inNamedRow = false;
                for (k in 0..namedCount) {
                    inNamedRow = inNamedRow || (node.parent != 0 && namedRows[k] == node.parent);
                }
                if (inNamedRow) {
                    if (accessContains(node.role) && namedCount < 64) {
                        namedRows[namedCount] = node.id; // what it holds is the row's too
                        namedCount += 1;
                    }
                    continue;
                }
                let label = ui.accessLabel(node);
                var role = node.role;
                if (role == AccessRole.Row) {
                    role = AccessRole.ListItem;
                    if (label.length > 0 && namedCount < 64) {
                        namedRows[namedCount] = node.id;
                        namedCount += 1;
                    }
                } else if (role == AccessRole.ColumnHeader) {
                    role = AccessRole.Button;
                } else if (accessContains(role)) {
                    continue;
                }
                let value = ui.accessValueOf(node);
                web_access_node(
                    node.id,
                    truncate<u32>(accessRoleNumber(role)),
                    node.flags,
                    box.x,
                    box.y,
                    box.w,
                    box.h,
                    node.min,
                    node.max,
                    node.now,
                    label.ptr,
                    label.length,
                    value.ptr,
                    value.length,
                    node.caret.min(value.length),
                    node.anchor.min(value.length),
                );
            }
            web_access_end();
        }
    }

    /// After `ui.begin` (whose key bindings made this frame's shortcuts edit commands): the text for a Paste, and
    /// what the input method is composing.
    /// Safety: web_pasted and web_composition give a pointer to `length` bytes that stay until the next call, or
    /// null.
    public fn editInto(borrow this, ui: borrow mut Ui) {
        if (ui.commanded(EditCommand.Paste)) {
            unsafe {
                var length: usize = 0;
                let bytes = web_pasted(borrow mut length as *mut usize);
                if (bytes as usize != 0) {
                    ui.paste(Slice.fromRaw(bytes, length));
                }
            }
        }
        unsafe {
            var length: usize = 0;
            let bytes = web_composition(borrow mut length as *mut usize);
            if (bytes as usize == 0) {
                length = 0;
            }
            // The composition's caret is at its end: a page is not told where it is inside.
            ui.setComposition(Slice.fromRaw(bytes, length), length);
        }
    }

    /// Whether a character was given up on: no fallback font has it.
    fn isHopeless(borrow this, cp: u32) -> bool {
        for (i in 0..this.hopelessCount) {
            if (this.hopeless[i] == cp) {
                return true;
            }
        }
        return false;
    }

    /// The page's fallback fonts (claywind-pack's `--fallback`, in their order) for the characters of the frame's
    /// text that its fonts lack: the next ones are fetched and added to `raster`'s fallback chain until one has the
    /// character; how many were added. Text in the app's own fonts fetches nothing.
    /// Safety: web_fallback gives a pointer to `length` bytes, which stay, or null.
    fn supplyFonts(borrow mut this, ui: borrow Ui, raster: borrow mut Raster) -> u32 {
        var added: u32 = 0;
        for (k in 0..ui.commandCount()) {
            let command = ui.commandAt(k);
            match (command) {
                Command.Text(_, run) => {
                    let utf8 = ui.textOf(command);
                    var i: usize = 0;
                    while (i < utf8.length) {
                        let cp = decodeUtf8(utf8, i);
                        i += cp[1] as usize;
                        // A private-use character means something else in every font: none is looked for.
                        let privateUse = (cp[0] >= 0xE000 && cp[0] <= 0xF8FF) || cp[0] >= 0xF0000;
                        if (cp[0] < 0x80 || privateUse || raster.covers(run.fontId, cp[0]) || this.isHopeless(cp[0])) {
                            continue;
                        }
                        while (!this.fallbacksDone && !raster.covers(run.fontId, cp[0])) {
                            unsafe {
                                var length: usize = 0;
                                let bytes = web_fallback(this.fallbackNext, borrow mut length as *mut usize);
                                if (bytes as usize == 0) {
                                    this.fallbacksDone = true;
                                } else {
                                    let id = FIRST_FALLBACK_ID + this.fallbackNext;
                                    if (raster.loadFont(id, Slice.fromRaw(bytes, length)) && raster.addFallback(id)) {
                                        added += 1;
                                    }
                                    this.fallbackNext += 1;
                                }
                            }
                        }
                        if (!raster.covers(run.fontId, cp[0]) && this.hopelessCount < this.hopeless.length) {
                            this.hopeless[this.hopelessCount] = cp[0];
                            this.hopelessCount += 1;
                        }
                    }
                }
                _ => {}
            }
        }
        return added;
    }

    /// After a frame that fit (`ui.endFrame`): draws what changed of it into `raster` over `clear`, and shows just
    /// that; a frame like the last shows nothing. The page is given the frame's elements for a screen reader, and
    /// asked for a fallback font when the frame's text has a character its fonts lack.
    /// Safety: web_present reads the frame's pixels during the call.
    public fn show(borrow mut this, ui: borrow Ui, raster: borrow mut Raster, damage: borrow mut Damage, clear: Color) {
        let scale = ratioFor(this.size, this.ratio);
        let w = pixels(this.size.w, scale, WEB_MAX_PIXELS_WIDTH);
        let h = pixels(this.size.h, scale, WEB_MAX_PIXELS_HEIGHT);
        this.giveAccess(ui);
        if (this.supplyFonts(ui, mut raster) > 0) {
            // The same commands draw other glyphs now, and the next frame, which runs at once, lays them out.
            damage.invalidate();
            this.again = true;
        }
        let boxes = damage.plan(ui, raster, clear, w, h, scale);
        if (boxes == 0) {
            return;
        }
        raster.setPixelRatio(scale);
        let _ = raster.resize(w, h);
        damage.draw(mut raster, ui, clear);
        unsafe {
            for (k in 0..boxes) {
                let r = damage.redrawn(k);
                web_box(
                    saturatingTruncate<u32>(r.x),
                    saturatingTruncate<u32>(r.y),
                    saturatingTruncate<u32>(r.w),
                    saturatingTruncate<u32>(r.h),
                );
            }
            let frame = raster.pixels();
            web_present(frame.ptr, truncate<u32>(raster.frameWidth()), truncate<u32>(raster.frameHeight()));
        }
    }

    /// After the frame: what it copied onto the clipboard, the pointer's shape, whether and where a text field
    /// wants the keyboard, and then a sleep while nothing
    /// changes: until an event, a caret's blink or a frame the Ui asked for later.
    /// Safety: web_copy reads the bytes during the call.
    public fn finishFrame(borrow mut this, ui: borrow Ui) {
        unsafe {
            match (ui.copiedText()) {
                Some(bytes) => { web_copy(bytes.ptr, bytes.length); }
                null => {}
            }
            let kind = match (this.cursor) {
                Cursor.Default => 0u32,
                Cursor.Pointer => 1u32,
                Cursor.Text => 2u32,
            };
            if (kind != this.shownCursor) {
                web_cursor(kind);
                this.shownCursor = kind;
            }
            // The page's text input follows the focused field's caret; the page is told when any of it changes.
            let wanted = ui.wantsTextInput();
            let textKind = match (ui.textInputKind()) {
                TextKind.Text => 0u32,
                TextKind.Number => 1u32,
                TextKind.Decimal => 2u32,
                TextKind.Email => 3u32,
                TextKind.Url => 4u32,
                TextKind.Password => 5u32,
            };
            let face = match (ui.returnKey()) {
                ReturnKey.Done => 0u32,
                ReturnKey.Go => 1u32,
                ReturnKey.Next => 2u32,
                ReturnKey.Search => 3u32,
                ReturnKey.Send => 4u32,
                ReturnKey.System => 5u32,
            };
            let area = if (wanted) ui.textInputArea() else Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
            let state = [
                if (wanted) 1.0f32 else 0.0,
                round<f32>(textKind),
                round<f32>(face),
                area.x,
                area.y,
                area.w,
                area.h,
            ];
            var same = true;
            for (i in 0..state.length) {
                same = same && state[i] == this.textInput[i];
            }
            if (!same) {
                this.textInput = state;
                web_text_input(if (wanted) 1 else 0, textKind, face, area.x, area.y, area.w, area.h);
            }
            this.endFrame();
            if (this.again) {
                this.again = false;
                return;
            }
            match (ui.frameDelay()) {
                Some(seconds) => {
                    if (seconds > 0.0) {
                        web_idle(seconds);
                    }
                }
                null => { web_idle(-1.0); }
            }
        }
    }
}
