// SPDX-License-Identifier: MIT
// The system's fonts for ClayWind, which reads no files itself. `SystemFonts` keeps a catalog of the TrueType faces
// in the OS's font folders, read only as far as choosing a fallback needs (each face's table directory, OS/2 and
// cmap), and `supply` loads into a Raster the faces that cover characters its fonts lack, adding them to its
// fallback chain. The catalog is built the first time a character is missing, so Latin-only text never scans.

import claywind;

/// The code points the catalog keeps coverage for: planes 0 to 2 (emoji and the CJK extensions too), in blocks of
/// 256 code points.
const BLOCKS: usize = 768;

/// The font id of catalog face `k` once loaded: the same in every Raster it is loaded into.
const FIRST_ID: u32 = 64;

/// The largest cmap table read (a CJK font's is a few hundred kilobytes).
const MAX_CMAP: usize = 8388608;

/// A face in the system's fonts.
struct Face {
    path: String;
    face: u32;
    /// OS/2's weight class (400 regular) and whether it is italic.
    weight: u32;
    italic: bool;
    /// Sans-serif by its PANOSE serif style (OS/2): what a user interface wants.
    sans: bool;
    /// The file's size: of two faces that cover as much, the smaller costs less memory once loaded.
    size: usize;
    /// How many code points it maps in each block of 256 (claywind's cmapCoverage).
    coverage: Vector<u16>;
}

/// The system's fonts, as a catalog and a supplier of fallbacks.
public struct SystemFonts {
    faces: Vector<Face>;
    scanned: bool;
    /// Characters no system font has: not looked for again.
    hopeless: Vector<u32>;
    cmap: Vector<u8>;
    /// The faces loaded so far, into any Raster.
    public loaded: u32;
    /// Their files, in the order they were first loaded.
    files: Vector<String>;
    /// How long building the catalog took, in milliseconds (0 until it was built).
    public scanMs: f64;
}

fn readAt(file: borrow File, offset: usize, out: borrow mut Vector<u8>, length: usize) -> bool {
    out.clear();
    for (i in 0..length) {
        if (out.push(0).isErr()) {
            return false;
        }
    }
    var got: usize = 0;
    while (got < length) {
        let n = match (file.readAt(mut out.viewMut()[got..length], (offset + got) as u64)) {
            Ok(k) => k,
            Err(_) => { return false; }
        };
        if (n == 0) {
            return false;
        }
        got += n;
    }
    return true;
}

fn u16be(d: Slice<u8>, at: usize) -> u32 => ((d[at] as u32) << 8) | (d[at + 1] as u32);

fn u32be(d: Slice<u8>, at: usize) -> u32 => (u16be(d, at) << 16) | u16be(d, at + 2);

/// Whether `name` ends in a font file extension: .ttf, .ttc, .otf or .otc, in any case.
fn fontFile(name: StringView) -> bool {
    let b = name.bytes();
    if (b.length < 4 || b[b.length - 4] != '.') {
        return false;
    }
    let x = b[b.length - 3] | 0x20;
    let y = b[b.length - 2] | 0x20;
    let z = b[b.length - 1] | 0x20;
    return (x == 't' && y == 't' && (z == 'f' || z == 'c')) || (x == 'o' && y == 't' && (z == 'f' || z == 'c'));
}

fn joined(dir: StringView, name: StringView) -> String? {
    var s = match (String.withCapacity(dir.length + 1 + name.length)) {
        Ok(x) => x,
        Err(_) => { return null; }
    };
    if (s.append(dir).isErr() || s.append("/").isErr() || s.append(name).isErr()) {
        return null;
    }
    return s;
}

impl SystemFonts {
    public fn create() -> SystemFonts => SystemFonts {
        faces: Vector<Face>.create(),
        scanned: false,
        hopeless: Vector<u32>.create(),
        cmap: Vector<u8>.create(),
        loaded: 0,
        files: Vector<String>.create(),
        scanMs: 0.0,
    };

    /// How many different font files were loaded, and each one's path.
    public fn loadedFileCount(borrow this) -> usize => this.files.length;
    public fn loadedFile(borrow this, k: usize) -> StringView => this.files[k].view();

    /// How many faces the catalog holds (0 until a character was missing).
    public fn faceCount(borrow this) -> usize => this.faces.length;

    /// Loads into `raster` system faces for the characters of `utf8` that a run in font `fontId` has no glyph for,
    /// adding each to the fallback chain: how many it loaded (lay the frame out again when any were).
    public fn supply(borrow mut this, raster: borrow mut Raster, utf8: Slice<u8>, fontId: u32) -> u32 {
        var added: u32 = 0;
        var i: usize = 0;
        while (i < utf8.length) {
            let cp = decodeUtf8(utf8, i);
            i += cp[1] as usize;
            // A private-use character means something else in every font: none is looked for.
            let privateUse = (cp[0] >= 0xE000 && cp[0] <= 0xF8FF) || cp[0] >= 0xF0000;
            if (cp[0] < 0x80 || privateUse || raster.covers(fontId, cp[0]) || this.isHopeless(cp[0])) {
                continue;
            }
            if (!this.scanned) {
                this.scan();
            }
            var done = false;
            match (this.choose(cp[0])) {
                Some(k) => {
                    let id = FIRST_ID + truncate<u32>(k);
                    if (this.load(raster, k, id) && raster.addFallback(id)) {
                        added += 1;
                        this.loaded += 1;
                        done = raster.covers(fontId, cp[0]);
                    }
                }
                null => {}
            }
            if (!done) {
                let ignored = this.hopeless.push(cp[0]);
            }
        }
        return added;
    }

    /// `supply` for every text run of `ui`'s laid-out frame.
    public fn supplyFrame(borrow mut this, raster: borrow mut Raster, ui: borrow Ui) -> u32 {
        var added: u32 = 0;
        for (k in 0..ui.commandCount()) {
            let command = ui.commandAt(k);
            match (command) {
                Command.Text(_, run) => { added += this.supply(raster, ui.textOf(command), run.fontId); }
                _ => {}
            }
        }
        return added;
    }

    fn isHopeless(borrow this, cp: u32) -> bool {
        for (h in this.hopeless) {
            if (h == cp) {
                return true;
            }
        }
        return false;
    }

    /// Catalog face `k` into `raster` as font `id` (the whole file: a collection's faces share its tables).
    fn load(borrow mut this, raster: borrow mut Raster, k: usize, id: u32) -> bool {
        let face = this.faces[k].face;
        let file = match (File.open(this.faces[k].path.view())) {
            Ok(f) => f,
            Err(_) => { return false; }
        };
        let length = match (file.length()) {
            Ok(n) => n as usize,
            Err(_) => { return false; }
        };
        var bytes = Vector<u8>.create();
        if (!readAt(file, 0, mut bytes, length)) {
            return false;
        }
        if (!raster.loadFontFace(id, bytes.view(), face)) {
            return false;
        }
        var known = false;
        for (f in this.files) {
            known = known || f.view() == this.faces[k].path.view();
        }
        if (!known) {
            match (this.faces[k].path.clone()) {
                Ok(p) => { let ignored = this.files.push(p); }
                Err(_) => {}
            }
        }
        return true;
    }

    /// The face that best covers `cp` (see `better`), one whose cmap really maps it.
    fn choose(borrow mut this, cp: u32) -> usize? {
        let block = (cp >> 8) as usize;
        if (block >= BLOCKS) {
            return null;
        }
        var most: u32 = 0;
        for (f in this.faces) {
            most = most.max(f.coverage[block] as u32);
        }
        var tried = Vector<usize>.create();
        for (attempt in 0..8) {
            var best: usize? = null;
            for (k in 0..this.faces.length) {
                let f = borrow this.faces[k];
                if (f.coverage[block] == 0 || contains(tried, k)) {
                    continue;
                }
                match (best) {
                    Some(b) => {
                        if (better(f, borrow this.faces[b], block, most)) {
                            best = k;
                        }
                    }
                    null => { best = k; }
                }
            }
            let k = match (best) {
                Some(b) => b,
                null => { return null; }
            };
            if (this.maps(k, cp)) {
                return k;
            }
            let ignored = tried.push(k);
        }
        return null;
    }

    /// Whether catalog face `k`'s cmap maps `cp`.
    fn maps(borrow mut this, k: usize, cp: u32) -> bool {
        let file = match (File.open(this.faces[k].path.view())) {
            Ok(f) => f,
            Err(_) => { return false; }
        };
        let face = this.faces[k].face;
        return match (readCmap(file, face, mut this.cmap)) {
            Some(_) => cmapGlyph(this.cmap.view(), cp) != 0,
            null => false,
        };
    }

    /// Reads every TrueType face in the system's font folders into the catalog.
    fn scan(borrow mut this) {
        this.scanned = true;
        let started = Clock.monotonicNanos();
        this.scanFolders();
        this.scanMs = round<f64>(Clock.monotonicNanos() - started) / 1000000.0;
    }

    fn scanFolders(borrow mut this) {
        match (Environment.variable("CLAYWIND_FONT_PATH")) {
            Some(d) => { this.walk(d, 0); }
            null => {}
        }
        let fixed: [StringView; 6] = [
            "/System/Library/Fonts",
            "/Library/Fonts",
            "C:/Windows/Fonts",
            "/usr/share/fonts",
            "/usr/local/share/fonts",
            "/usr/X11R6/lib/X11/fonts",
        ];
        for (d in fixed) {
            this.walk(d, 0);
        }
        let home = Environment.variable("HOME") ?? "";
        let local = Environment.variable("LOCALAPPDATA") ?? "";
        let suffixes: [StringView; 3] = ["/Library/Fonts", "/.local/share/fonts", "/.fonts"];
        if (home.length > 0) {
            for (s in suffixes) {
                match (joined(home, s[1..s.length])) {
                    Some(p) => { this.walk(p.view(), 0); }
                    null => {}
                }
            }
        }
        if (local.length > 0) {
            match (joined(local, "Microsoft/Windows/Fonts")) {
                Some(p) => { this.walk(p.view(), 0); }
                null => {}
            }
        }
    }

    /// The font files under `dir`, four folders deep at most (Linux keeps fonts in nested folders).
    fn walk(borrow mut this, dir: StringView, depth: u32) {
        let names = match (Directory.list(dir)) {
            Ok(n) => n,
            Err(_) => { return; }
        };
        for (name in names) {
            if (name.length == 0 || name[0] == '.') {
                continue;
            }
            let path = match (joined(dir, name.view())) {
                Some(p) => p,
                null => { continue; }
            };
            if (fontFile(name.view())) {
                this.addFile(path);
            } else if (depth < 4) {
                match (File.kind(path.view())) {
                    Ok(Some(PathKind.Directory)) => { this.walk(path.view(), depth + 1); }
                    _ => {}
                }
            }
        }
    }

    /// Each TrueType face of the font file at `path`: its weight, style and coverage. Faces with CFF outlines (not
    /// drawn yet) and colour-bitmap faces (sbix, CBDT: not drawn yet) are left out.
    fn addFile(borrow mut this, path: String) {
        let file = match (File.open(path.view())) {
            Ok(f) => f,
            Err(_) => { return; }
        };
        var head = Vector<u8>.create();
        if (!readAt(file, 0, mut head, 12)) {
            return;
        }
        let faces = fontFaceCount(head.view());
        if (faces == 0 || faces > 64) {
            return;
        }
        if (faces > 1 && !readAt(file, 0, mut head, 12 + (faces as usize) * 4)) {
            return;
        }
        var dir = Vector<u8>.create();
        var os2 = Vector<u8>.create();
        for (face in 0..faces) {
            let at = match (faceDirectory(head.view(), face)) {
                Some(a) => a,
                null => { continue; }
            };
            if (!readAt(file, at, mut dir, 12)) {
                continue;
            }
            let tables = u16be(dir.view(), 4) as usize;
            if (!readAt(file, at, mut dir, 12 + tables * 16) || !trueTypeFace(dir.view())) {
                continue;
            }
            if (findTable(
                dir.view(),
                ['s', 'b', 'i', 'x'],
            ) != null || findTable(dir.view(), ['C', 'B', 'D', 'T']) != null) {
                continue;
            }
            var weight: u32 = 400;
            var italic = false;
            var sans = false;
            match (findTable(dir.view(), ['O', 'S', '/', '2'])) {
                Some(t) => {
                    if (t.length >= 64 && readAt(file, t.offset, mut os2, 64)) {
                        weight = u16be(os2.view(), 4);
                        italic = (u16be(os2.view(), 62) & 1) != 0;
                        let serifStyle = os2[33];
                        sans = os2[32] == 2 && serifStyle >= 11 && serifStyle <= 13;
                    }
                }
                null => {}
            }
            if (readCmap(file, face, mut this.cmap) == null) {
                continue;
            }
            var coverage = Vector<u16>.create();
            for (b in 0..BLOCKS) {
                if (coverage.push(0).isErr()) {
                    return;
                }
            }
            cmapCoverage(this.cmap.view(), mut coverage.viewMut());
            let copy = match (path.clone()) {
                Ok(c) => c,
                Err(_) => { return; }
            };
            let size = match (file.length()) {
                Ok(n) => n as usize,
                Err(_) => 0,
            };
            let ignored = this.faces.push(Face {
                path: copy,
                face: face,
                weight: weight,
                italic: italic,
                sans: sans,
                size: size,
                coverage: coverage,
            });
        }
    }
}

/// Face `face`'s cmap table of an open font file into `out`; null when it has none or it is too big.
fn readCmap(file: borrow File, face: u32, out: borrow mut Vector<u8>) -> usize? {
    var head = Vector<u8>.create();
    if (!readAt(file, 0, mut head, 12)) {
        return null;
    }
    let faces = fontFaceCount(head.view());
    if (faces > 1 && !readAt(file, 0, mut head, 12 + (faces as usize) * 4)) {
        return null;
    }
    let at = faceDirectory(head.view(), face)?;
    var dir = Vector<u8>.create();
    if (!readAt(file, at, mut dir, 12)) {
        return null;
    }
    let tables = u16be(dir.view(), 4) as usize;
    if (!readAt(file, at, mut dir, 12 + tables * 16)) {
        return null;
    }
    let t = findTable(dir.view(), ['c', 'm', 'a', 'p'])?;
    if (t.length > MAX_CMAP || !readAt(file, t.offset, mut out, t.length)) {
        return null;
    }
    return t.length;
}

fn contains(v: borrow Vector<usize>, x: usize) -> bool {
    for (y in v) {
        if (y == x) {
            return true;
        }
    }
    return false;
}

/// Whether face `a` is a better choice for `block` than face `b`, when the best covers `most` of its code points:
/// covering nearly as much as the best (90 %), then sans-serif, then the weight nearer 400, then upright, then the
/// smaller file, then covering more.
fn better(a: borrow Face, b: borrow Face, block: usize, most: u32) -> bool {
    let ca = a.coverage[block] as u32;
    let cb = b.coverage[block] as u32;
    let fullA = ca * 10 >= most * 9;
    let fullB = cb * 10 >= most * 9;
    if (fullA != fullB) {
        return fullA;
    }
    if (a.sans != b.sans) {
        return a.sans;
    }
    let da = if (a.weight > 400) a.weight - 400 else 400 - a.weight;
    let db = if (b.weight > 400) b.weight - 400 else 400 - b.weight;
    if (da != db) {
        return da < db;
    }
    if (a.italic != b.italic) {
        return !a.italic;
    }
    if (a.size != b.size) {
        return a.size < b.size;
    }
    return ca > cb;
}
