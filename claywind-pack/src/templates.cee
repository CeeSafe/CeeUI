// SPDX-License-Identifier: MIT
// Generated by template/make_templates.py from the files in template/: the app `claywind-pack new`
// makes. __NAME__ is the app's name; __DEPS__ its dependencies on ClayWind's packages.

/// How many files a new app has.
const TEMPLATE_COUNT: usize = 5;

/// Each file's path in the new app.
static TEMPLATE_PATHS: [StringView; 5] = [
    "ceesafe.toml",
    "README.md",
    ".gitignore",
    "src/main.cee",
    "src/app.cee",
];

/// Each file's text.
static TEMPLATE_TEXTS: [StringView; 5] = [
    "[package]\nname = \"__NAME__\"\nversion = \"0.1.0\"\nkind = \"executable\"\nwindowed = true # a GUI program: no console window on Windows\nceesafec = \">=0.78.0\"\n\n[dependencies]\n__DEPS__\n",
    "# __NAME__\n\nA [ClayWind](https://github.com/CeeSafe/Clay) app, made by `claywind-pack new`: a list of tasks to add to, tick\noff and delete, in a window of its own.\n\n```sh\nceesafec fetch          # the ClayWind packages it depends on\nceesafec build          # out/__NAME__\nout/__NAME__\n```\n\n- `src/app.cee` is the app: its state (`App`) and the frame that lays out the window from it (`appFrame`). ClayWind\n  is immediate mode: the frame runs whenever something changes, and the controls say what the user did.\n- `src/main.cee` opens the window, sets aside the UI's and the renderer's memory, and runs the frames.\n\nPack it as an app a system installs, from this directory, with ClayWind's `claywind-pack`:\n`claywind-pack macos`, `ios-simulator`, `ios`, `android` or `web`.\n\nWhile it runs, secondary-Alt-I (Command-Option-I on macOS) turns on ClayWind's layout inspector.\n",
    "out/\n",
    "// The app's window: it opens one, lays out a frame whenever something changes, draws it with ClayWind's software\n// renderer, and sleeps in between. The app itself is in app.cee.\n\nimport claywind;\nimport claywind_desktop;\nimport claywind_fonts;\n\nfn main() -> i32 {\n    var app = App.create();\n    var window = match (Window.open(\"__NAME__\", 720, 560)) {\n        Ok(w) => w,\n        Err(e) => {\n            Console.writeError(\"__NAME__: cannot open a window: \");\n            Console.writeErrorLine(windowError(e));\n            return 1;\n        }\n    };\n    // The UI's and the renderer's memory, set aside once: a frame allocates nothing.\n    var paneStorage = zeros(33554432);\n    var rasterStorage = zeros(301989888);\n    let paneMemory = FixedBufferAllocator.over(mut paneStorage.viewMut());\n    let rasterMemory = FixedBufferAllocator.over(mut rasterStorage.viewMut());\n    var pane = match (Pane.create(paneMemory, 1, 4096, 16384, MAX_PIXELS_WIDTH * MAX_PIXELS_HEIGHT, window.size())) {\n        Ok(p) => p,\n        Err(_) => {\n            Console.writeErrorLine(\"__NAME__: not enough memory for the UI\");\n            return 1;\n        }\n    };\n    var raster = match (Raster.create(rasterMemory, desktopRasterCapacity())) {\n        Ok(r) => r,\n        Err(_) => {\n            Console.writeErrorLine(\"__NAME__: not enough memory for the renderer\");\n            return 1;\n        }\n    };\n    if (!loadSystemFonts(mut raster)) {\n        Console.writeErrorLine(\"__NAME__: no fonts found; set CLAYWIND_FONT_DIR\");\n        return 1;\n    }\n    // Fonts for what the loaded ones lack (other scripts, emoji), found among the system's when a frame needs them.\n    var systemFonts = SystemFonts.create();\n    var share = RasterShare.create();\n    pane.ui.setDarkMode(true);\n    pane.ui.setSecondaryIsCommand(match (window.nativeHandle()) {\n        WindowHandle.AppKit(_, _) => true,\n        _ => false,\n    });\n    loop {\n        if (pane.takeEvents(mut window)) {\n            break; // the window was closed\n        }\n        pane.begin(mut window);\n        appFrame(mut pane.ui, mut app, raster);\n        if (!pane.end(mut window, raster)) {\n            Console.writeErrorLine(\"__NAME__: the frame does not fit the UI's capacity\");\n            return 1;\n        }\n        if (systemFonts.supplyFrame(mut raster, pane.ui) > 0) {\n            // The same commands draw other glyphs now; the next frame lays them out with the fonts' measures.\n            pane.damage.invalidate();\n            pane.ui.requestFrame();\n        }\n        if (!pane.draw(\n            mut raster,\n            mut share,\n            mut window,\n            Color.hex(if (pane.ui.isDarkMode()) SLATE_950 else SLATE_50),\n        )) {\n            Console.writeErrorLine(\"__NAME__: the window refused a frame\");\n            return 1;\n        }\n        pane.platform.endFrame();\n        if (pane.ui.needsFrame()) {\n            window.waitFrame();\n        } else {\n            Window.waitAny(pane.ui.frameDelayMs(IDLE_MS));\n        }\n    }\n    return 0;\n}\n",
    "// The app: its state, and the frame that shows it. ClayWind is immediate mode: `appFrame` runs each frame and lays out\n// the whole window from the state; what the user does comes back through the controls' results.\n\nimport claywind;\n\n/// The most tasks the app keeps, and the longest a task's text is.\nconst MAX_TASKS: usize = 1000;\nconst TASK_BYTES: usize = 96;\n\n/// A task: its text, and whether it is done.\nstruct Task {\n    text: [u8; 96];\n    length: usize;\n    done: bool;\n}\n\n/// The app's state.\npublic struct App {\n    tasks: Vector<Task>;\n    /// The new task's text, as it is typed.\n    draft: [u8; 96];\n    draftLength: usize;\n    draftEdit: TextEdit;\n    selected: usize?;\n\n    public fn create() -> App {\n        var app = App {\n            tasks: Vector<Task>.create(),\n            draft: [0u8; 96],\n            draftLength: 0,\n            draftEdit: TextEdit.at(0),\n            selected: null,\n        };\n        app.add(\"Read ClayWind's README\");\n        app.add(\"Change this app's frame in src/app.cee\");\n        app.add(\"Pack it: claywind-pack macos\");\n        return app;\n    }\n\n    /// Adds a task (cut to TASK_BYTES at a character's start), unless the list is full.\n    fn add(borrow mut this, text: StringView) {\n        if (this.tasks.length >= MAX_TASKS) {\n            return;\n        }\n        let b = text.bytes();\n        var n = b.length.min(TASK_BYTES);\n        while (n > 0 && n < b.length && (b[n] & 0xC0) == 0x80) {\n            n -= 1;\n        }\n        var task = Task { text: [0u8; 96], length: n, done: false };\n        for (i in 0..n) {\n            task.text[i] = b[i];\n        }\n        this.tasks.push(task)!;\n    }\n}\n\n/// One frame of the app.\npublic fn appFrame<M: TextMetrics>(ui: borrow mut Ui, app: borrow mut App, metrics: borrow M) {\n    let dark = ui.isDarkMode();\n    let ink = if (dark) SLATE_100 else SLATE_900;\n    ui.open(Style.column().id(\"page\").w(Size.grow()).h(Size.grow()).p(space(6.0)).gap(space(4.0))\n        .bg(if (dark) SLATE_950 else SLATE_50).safe(ui.safeArea()));\n    // The header: the title, how many are left, and the theme.\n    ui.open(Style.row().w(Size.grow()).gap(space(3.0)).alignXY(AxisAlign.Start, AxisAlign.Center));\n    ui.label(\"Tasks\", Text.of().size(24.0).bold().color(ink));\n    var left: usize = 0;\n    for (task in app.tasks.view()) {\n        if (!task.done) {\n            left += 1;\n        }\n    }\n    var count = [0u8; 32];\n    var w = TextWriter.create(mut count[..]);\n    w.decimal(left as u64);\n    w.text(\" left\");\n    ui.labelBytes(w.written(), Text.of().color(SLATE_400));\n    ui.open(Style.box().w(Size.grow()));\n    ui.close();\n    if (Controls.button(mut ui, \"theme\", if (dark) \"Light\" else \"Dark\")) {\n        ui.setDarkMode(!dark);\n    }\n    ui.close();\n    // A new task: typed, then added with the button or Enter.\n    // (Enter is read before the field, which gives up the focus on it.)\n    let enter = ui.hasFocusNamed(\"draft\") && ui.keyPressed(Key.Enter);\n    ui.open(Style.row().w(Size.grow()).gap(space(2.0)).alignXY(AxisAlign.Start, AxisAlign.Center));\n    ui.open(Style.box().w(Size.grow()));\n    Controls.textField(mut ui, metrics, \"draft\", mut app.draft[..], mut app.draftLength, mut app.draftEdit);\n    ui.close();\n    if ((Controls.button(mut ui, \"add\", \"Add\") || enter) && app.draftLength > 0) {\n        let typed = app.draft; // a copy: adding changes the app\n        let text = StringView.fromUtf8(typed[0..app.draftLength]) ?? \"\";\n        app.add(text);\n        app.draftLength = 0;\n        app.draftEdit = TextEdit.at(0);\n        ui.setFocus(hashId(\"draft\")); // ready for the next one\n    }\n    ui.close();\n    // The tasks: a press selects one, Enter (or its box) marks it done, Delete takes it away.\n    let list = Controls.virtualList(mut ui, \"tasks\", app.tasks.length, 40.0, Size.grow(), mut app.selected);\n    for (i in list.first..list.last) {\n        let task = app.tasks[i];\n        let name = StringView.fromUtf8(task.text[0..task.length]) ?? \"\";\n        let on = Controls.virtualRow(mut ui, list, i, mut app.selected, name);\n        var done = task.done;\n        var boxId = [0u8; 24];\n        var b = TextWriter.create(mut boxId[..]);\n        b.text(\"done\");\n        b.decimal(i as u64);\n        if (Controls.checkbox(mut ui, StringView.fromUtf8(b.written()) ?? \"done\", \"\", mut done)) {\n            app.tasks[i].done = done;\n        }\n        ui.label(name, Text.of().color(if (on) WHITE else if (task.done) SLATE_500 else SLATE_200));\n        ui.close();\n    }\n    Controls.endVirtualList(mut ui, list);\n    if (ui.hasFocusNamed(\"tasks\")) {\n        match (app.selected) {\n            Some(i) => {\n                if (ui.keyPressed(Key.Enter)) {\n                    app.tasks[i].done = !app.tasks[i].done;\n                }\n                if (ui.keyPressed(Key.Delete) || ui.keyPressed(Key.Backspace)) {\n                    app.tasks.remove(i);\n                    app.selected = if (app.tasks.length == 0) null else Some(i.min(app.tasks.length - 1));\n                }\n            }\n            null => {}\n        }\n    }\n    ui.close();\n}\n",
];
