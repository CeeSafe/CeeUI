// SPDX-License-Identifier: MIT
// The desktop host: the ClayWind demo in a native window (lib/std's Window, CeeSafe ADR 0069: AppKit on macOS, Win32
// on Windows, X11 on Linux), drawn by ClayWind's software renderer. 100% CeeSafe, no C.
//
//   ./out/desktop
//   CLAYWIND_FONT_DIR=DIR   where Arial.ttf, "Arial Bold.ttf" and "Courier New.ttf" are (otherwise the system's
//                           fonts are looked for: macOS, Windows, then Linux's Microsoft core fonts or DejaVu)
//   CLAYWIND_LIGHT=1        start in light mode (T toggles it, as in the demo)
//
// The window resizes freely and the layout follows it. Frames are drawn at the display's pixel ratio (2 on a Retina
// display, Raster.setPixelRatio), up to MAX_PIXELS_WIDTH × MAX_PIXELS_HEIGHT pixels: a window too large for that at
// its ratio is drawn at a lower one, which the window scales up. Each frame redraws only what changed (Damage), and
// the window is given only those boxes (Window.presentChanged, ceesafec 0.14.0); nothing, when nothing changed.
//
// The Controls page's Live state panel opens in a window of its own (the inspector), which shares the app's state:
// each window has its own Ui, Damage and platform, and the two share one Raster (and its fonts), which keeps each
// window's last frame while it draws the other's (RasterFrame). While nothing changes, the program sleeps until either
// window has an event or is woken (Window.waitAny, CeeSafe ADR 0145).

import claywind;
import claywind_demo;
import claywind_fonts;
import claywind_demo_tasks;

const START_WIDTH: u32 = 1024;
const START_HEIGHT: u32 = 640;
const INSPECTOR_WIDTH: u32 = 340;
const INSPECTOR_HEIGHT: u32 = 600;
/// Which window's frame the Raster holds: the main window's, the inspector's, or neither's.
const MAIN: usize = 0;
const INSPECTOR: usize = 1;
const NEITHER: usize = 2;
/// How long an idle window sleeps for want of an event (a wake or an event ends it sooner).
const IDLE_MS: u32 = 0xFFFFFFFF;
const MAX_PIXELS_WIDTH: usize = 2880;
const MAX_PIXELS_HEIGHT: usize = 1800;

fn readFile(path: StringView) -> Vector<u8> {
    var bytes = Vector<u8>.create();
    match (File.open(path)) {
        Ok(f) => {
            var file = f;
            var chunk = [0u8; 65536];
            loop {
                let n = match (file.read(mut chunk[..])) {
                    Ok(k) => k,
                    Err(_) => 0,
                };
                if (n == 0) {
                    break;
                }
                for (i in 0usize..n) {
                    bytes.push(chunk[i])!;
                }
            }
        }
        Err(_) => {}
    }
    return bytes;
}

/// Loads `dir/file` as font `id`; false when it is missing or does not fit.
fn loadFont(raster: borrow mut Raster, id: u32, dir: StringView, file: StringView) -> bool {
    var path = [0u8; 512];
    var w = TextWriter.create(mut path[..]);
    w.text(dir);
    w.byte('/');
    w.text(file);
    let name = match (StringView.fromUtf8(w.written())) {
        Some(n) => n,
        null => { return false; }
    };
    let bytes = readFile(name);
    return bytes.length > 0 && raster.loadFont(id, bytes.view());
}

/// The regular, bold and monospaced faces from the first place that has them.
fn loadFonts(raster: borrow mut Raster) -> bool {
    match (Environment.variable("CLAYWIND_FONT_DIR")) {
        Some(dir) => {
            return loadFont(mut raster, FONT_18, dir, "Arial.ttf") &&
                loadFont(mut raster, FONT_BOLD, dir, "Arial Bold.ttf") &&
                loadFont(mut raster, FONT_MONO, dir, "Courier New.ttf");
        }
        null => {}
    }
    let places: [StringView; 16] = [
        "/System/Library/Fonts/Supplemental",
        "Arial.ttf",
        "Arial Bold.ttf",
        "Courier New.ttf",
        "C:/Windows/Fonts",
        "arial.ttf",
        "arialbd.ttf",
        "cour.ttf",
        "/usr/share/fonts/truetype/msttcorefonts",
        "Arial.ttf",
        "Arial_Bold.ttf",
        "Courier_New.ttf",
        "/usr/share/fonts/truetype/dejavu",
        "DejaVuSans.ttf",
        "DejaVuSans-Bold.ttf",
        "DejaVuSansMono.ttf",
    ];
    for (k in 0usize..4) {
        let dir = places[k * 4];
        if (loadFont(mut raster, FONT_18, dir, places[k * 4 + 1])) {
            return loadFont(mut raster, FONT_BOLD, dir, places[k * 4 + 2]) &&
                loadFont(mut raster, FONT_MONO, dir, places[k * 4 + 3]);
        }
    }
    return false;
}

fn zeros(count: usize) -> Vector<u8> {
    var v = Vector<u8>.withCapacity(count)!;
    for (i in 0..count) {
        v.push(0)!;
    }
    return v;
}

/// The ratio to draw at: the window's, lowered until `size` points fit the raster's pixels.
fn ratioFor(size: WindowSize, scale: f32) -> f32 {
    let w = round<f32>(if (size.width < 1) 1 else size.width);
    let h = round<f32>(if (size.height < 1) 1 else size.height);
    let wanted = if (scale >= 1.0) scale else 1.0;
    let fitW = round<f32>(MAX_PIXELS_WIDTH) / w;
    let fitH = round<f32>(MAX_PIXELS_HEIGHT) / h;
    return wanted.min(fitW).min(fitH);
}

/// The pixel size and ratio `size` points at `scale` are drawn at (fitRaster's).
fn pixelsFor(size: WindowSize, scale: f32) -> [usize; 2] {
    let ratio = ratioFor(size, scale);
    let w = saturatingTruncate<usize>(Math.round(round<f32>(size.width) * ratio));
    let h = saturatingTruncate<usize>(Math.round(round<f32>(size.height) * ratio));
    return [w.max(1).min(MAX_PIXELS_WIDTH), h.max(1).min(MAX_PIXELS_HEIGHT)];
}

/// One window's part of the host: its Ui, the Damage of its frames, its last frame while the Raster draws the other
/// window's, its input, and its clock.
struct Pane<region r> {
    ui: Ui<r>;
    damage: Damage<r>;
    frame: RasterFrame<r>;
    platform: DesktopPlatform;
    last: u64;

    fn create(
        memory: borrow(r) FixedBufferAllocator,
        elements: usize,
        commands: usize,
        pixels: usize,
        size: WindowSize,
    ) -> Result<Pane<r>, AllocError> {
        return Ok(Pane {
            ui: Ui.create(memory, UiCapacity.of(elements))?,
            damage: Damage.create(memory, commands)?,
            frame: RasterFrame.create(memory, pixels)?,
            platform: DesktopPlatform.create(Dims { w: round<f32>(size.width), h: round<f32>(size.height) }),
            last: Timer.now(),
        });
    }

    /// Takes the window's events into the platform; true when the window asks to close.
    fn takeEvents(borrow mut this, window: borrow mut Window) -> bool {
        loop {
            match (window.nextEvent()) {
                Some(WindowEvent.Closed) => { return true; }
                Some(e) => { this.platform.apply(e); }
                null => { return false; }
            }
        }
    }

    /// Starts a frame: the clock, the input, and the text the window's input method has.
    fn begin(borrow mut this, window: borrow mut Window) {
        let now = Timer.now();
        this.platform.setFrameTime(round<f32>(now - this.last) / 1000.0);
        this.last = now;
        this.ui.begin(mut this.platform);
        this.platform.editInto(mut this.ui, mut window);
    }

    /// Ends a frame: layout, the text input's place and the cursor. False when the frame does not fit the Ui.
    fn end(borrow mut this, window: borrow mut Window, raster: borrow Raster) -> bool {
        match (this.ui.endFrame(mut this.platform, raster)) {
            Ok() => {}
            Err(_) => { return false; }
        }
        this.platform.editFrom(this.ui, mut window);
        window.setCursor(windowCursor(this.platform.cursor));
        return true;
    }
}

/// Draws `pane`'s frame into `raster` and shows what changed in `window`: the raster takes this window's last frame
/// back first when it holds the other window's (`holds`), keeping that one in `other`. False when the window refused
/// the frame.
fn drawPane(
    raster: borrow mut Raster,
    holds: borrow mut usize,
    me: usize,
    pane: borrow mut Pane,
    other: borrow mut Pane,
    window: borrow mut Window,
) -> bool {
    let clear = Color.hex(pageBg(pane.ui));
    let size = window.size();
    let scale = window.scale();
    let px = pixelsFor(size, scale);
    let ratio = ratioFor(size, scale);
    var boxes = pane.damage.plan(pane.ui, clear, px[0], px[1], ratio);
    if (boxes == 0) {
        return true;
    }
    if (holds != me) {
        if (holds != NEITHER && !raster.keepFrame(mut other.frame)) {
            other.damage.invalidate(); // its frame did not fit: drawn whole next time
        }
        if (!raster.takeFrame(mut pane.frame)) {
            pane.damage.invalidate(); // no frame of its own to draw over: draw it whole
            boxes = pane.damage.plan(pane.ui, clear, px[0], px[1], ratio);
        }
        holds = me;
    }
    raster.setPixelRatio(ratio);
    raster.resize(px[0], px[1]);
    pane.damage.draw(mut raster, pane.ui, clear);
    // Only the boxes Damage redrew changed: the window shows just those (Window.presentChanged).
    var shown = [WindowBox { x: 0, y: 0, width: 0, height: 0 }; 4];
    for (k in 0..boxes) {
        let r = pane.damage.redrawn(k);
        shown[k] = WindowBox {
            x: saturatingTruncate<u32>(r.x),
            y: saturatingTruncate<u32>(r.y),
            width: saturatingTruncate<u32>(r.w),
            height: saturatingTruncate<u32>(r.h),
        };
    }
    let width = truncate<u32>(raster.frameWidth());
    let height = truncate<u32>(raster.frameHeight());
    return window.presentChanged(raster.pixels(), width, height, shown[0..boxes]).isOk();
}

/// A Key as the window's menus name it.
fn windowKeyOf(k: Key) -> WindowKey? => match (k) {
    Key.Tab => WindowKey.Tab,
    Key.Enter => WindowKey.Enter,
    Key.Escape => WindowKey.Escape,
    Key.Backspace => WindowKey.Backspace,
    Key.Delete => WindowKey.Delete,
    Key.Left => WindowKey.Left,
    Key.Right => WindowKey.Right,
    Key.Up => WindowKey.Up,
    Key.Down => WindowKey.Down,
    Key.Home => WindowKey.Home,
    Key.End => WindowKey.End,
    Key.PageUp => WindowKey.PageUp,
    Key.PageDown => WindowKey.PageDown,
    Key.F1 => WindowKey.Function(1),
    Key.F2 => WindowKey.Function(2),
    Key.F3 => WindowKey.Function(3),
    Key.F4 => WindowKey.Function(4),
    Key.F5 => WindowKey.Function(5),
    Key.F6 => WindowKey.Function(6),
    Key.F7 => WindowKey.Function(7),
    Key.F8 => WindowKey.Function(8),
    Key.F9 => WindowKey.Function(9),
    Key.F10 => WindowKey.Function(10),
    Key.F11 => WindowKey.Function(11),
    Key.F12 => WindowKey.Function(12),
    _ => null,
};

/// A key binding as a menu item's shortcut.
fn shortcutOf(binding: KeyBinding?) -> MenuShortcut? {
    let b = match (binding) {
        Some(x) => x,
        null => { return null; }
    };
    let key = match (b.key) {
        Some(k) => match (windowKeyOf(k)) {
            Some(w) => w,
            null => { return null; }
        },
        null => WindowKey.Character(b.character),
    };
    let m = b.modifiers;
    return MenuShortcut {
        key: key,
        modifiers: WindowModifiers { shift: m.shift, control: m.control, alt: m.alt, command: m.command },
    };
}

/// The app's menus (`model`) as the system's: each item's id is its place in the model, its shortcut its action's
/// key binding in `ui`.
fn systemMenu(model: borrow MenuModel, ui: borrow Ui) -> Result<Menu, AllocError> {
    var menu = Menu.create();
    for (k in 0..model.partCount()) {
        let title = match (StringView.fromUtf8(model.partTitle(k))) {
            Some(t) => t,
            null => "?",
        };
        match (model.partKind(k)) {
            MenuPartKind.Menu => { menu.addMenu(title)?; }
            MenuPartKind.Item => {
                menu.addItem(truncate<u32>(k), title, shortcutOf(ui.bindingForHash(model.partAction(k))))?;
            }
            MenuPartKind.Separator => { menu.addSeparator()?; }
        }
    }
    return Ok(menu);
}

/// Shows the system's file dialog the app asked for, then reads or writes the file and tells the app.
fn answerFileRequest(request: FileRequest, app: borrow mut DemoApp, window: borrow mut Window) {
    match (request) {
        FileRequest.Open => {
            match (FileDialog.openFile(mut window, "Open", "")) {
                Ok(Some(path)) => {
                    match (File.open(path.view())) {
                        Ok(f) => {
                            match (f.length()) {
                                Ok(n) => { app.fileOpened(path.view().bytes(), n); }
                                Err(_) => { app.fileNotDone("Could not read the file"); }
                            }
                        }
                        Err(_) => { app.fileNotDone("Could not open the file"); }
                    }
                }
                Ok(null) => { app.fileNotDone("Open cancelled"); }
                Err(_) => { app.fileNotDone("No file dialog on this system"); }
            }
        }
        FileRequest.Save => {
            match (FileDialog.saveFile(mut window, "Save As", "notes.txt", "txt")) {
                Ok(Some(path)) => {
                    let text = app.saveText();
                    let written = match (File.create(path.view())) {
                        Ok(f) => f.writeAt(text[0..app.saveTextLength()], 0).isOk(),
                        Err(_) => false,
                    };
                    if (written) {
                        app.fileSaved(path.view().bytes());
                    } else {
                        app.fileNotDone("Could not write the file");
                    }
                }
                Ok(null) => { app.fileNotDone("Save cancelled"); }
                Err(_) => { app.fileNotDone("No file dialog on this system"); }
            }
        }
    }
}

/// The message for a window that does not open.
fn windowError(e: WindowError) -> StringView => match (e) {
    WindowError.Unsupported => "this system has no window support",
    WindowError.NoDisplay => "no display",
    WindowError.NotMainThread => "not on the main thread",
    WindowError.Resources => "the system refused",
};

fn main() -> i32 {
    // Hot reload (claywind-dev, `--hot DIR`): the state the previous build saved, its window's size included.
    let hotDir = hotDirectory();
    var app = DemoApp.create();
    let resumed: HotStart? = match (hotDir) {
        Some(d) => hotRestore(d, mut app),
        null => null,
    };
    let startWidth = match (resumed) {
        Some(r) => r.width,
        null => START_WIDTH,
    };
    let startHeight = match (resumed) {
        Some(r) => r.height,
        null => START_HEIGHT,
    };
    var window = match (Window.open("ClayWind — CeeSafe", startWidth, startHeight)) {
        Ok(w) => w,
        Err(e) => {
            Console.writeError("desktop: cannot open a window: ");
            Console.writeErrorLine(windowError(e));
            return 1;
        }
    };
    // The demo's background jobs (the Controls page's Tasks tab): their reports wake the window.
    var jobs = match (ThreadJobs.create(window.waker())) {
        Ok(j) => j,
        Err(_) => {
            Console.writeErrorLine("desktop: no memory for the background jobs");
            return 1;
        }
    };
    var mainStorage = zeros(67108864);
    var inspectorStorage = zeros(33554432);
    var rasterStorage = zeros(301989888);
    let mainMemory = FixedBufferAllocator.over(mut mainStorage.viewMut());
    let inspectorMemory = FixedBufferAllocator.over(mut inspectorStorage.viewMut());
    let rasterMemory = FixedBufferAllocator.over(mut rasterStorage.viewMut());
    let full = MAX_PIXELS_WIDTH * MAX_PIXELS_HEIGHT;
    var main = match (Pane.create(mainMemory, 4096, 16384, full, window.size())) {
        Ok(p) => p,
        Err(_) => {
            Console.writeErrorLine("desktop: not enough memory for the UI");
            return 1;
        }
    };
    let small = WindowSize { width: INSPECTOR_WIDTH, height: INSPECTOR_HEIGHT };
    var inspector = match (Pane.create(inspectorMemory, 512, 2048, full / 2, small)) {
        Ok(p) => p,
        Err(_) => {
            Console.writeErrorLine("desktop: not enough memory for the inspector");
            return 1;
        }
    };
    var capacity = RasterCapacity.of(MAX_PIXELS_WIDTH, MAX_PIXELS_HEIGHT);
    capacity.fontBytes = 100663296; // room for fallback fonts from the system: a CJK font is tens of megabytes
    var raster = match (Raster.create(rasterMemory, capacity)) {
        Ok(r) => r,
        Err(_) => {
            Console.writeErrorLine("desktop: not enough memory for the renderer");
            return 1;
        }
    };
    if (!loadFonts(mut raster)) {
        Console.writeErrorLine("desktop: no fonts found; set CLAYWIND_FONT_DIR");
        return 1;
    }
    app.setOpensWindows(true);
    app.setOpensFiles(true);
    // The menus: the system's (a macOS menu bar, a Windows window's menu), else drawn by the demo (X11, or
    // CLAYWIND_DRAWN_MENUS=1). They are set after the first frame, which binds their actions' keys.
    var menuModel = MenuModel.create();
    demoMenu(mut menuModel);
    var menuSet = false;
    if (Environment.variable("CLAYWIND_DRAWN_MENUS") != null) {
        app.setDrawsMenuBar(true);
        menuSet = true;
    }
    let dark = match (resumed) {
        Some(r) => r.dark,
        null => Environment.variable("CLAYWIND_LIGHT") == null,
    };
    // A new build's request to take over (hot reload), watched on a thread of its own.
    let hot: HotWatch? = match (hotDir) {
        Some(d) => HotWatch.start(d, window.waker()),
        null => null,
    };
    // Shortcuts use Command on macOS (an AppKit window), Control elsewhere.
    let command = match (window.nativeHandle()) {
        WindowHandle.AppKit(_, _) => true,
        _ => false,
    };
    main.ui.setDarkMode(dark);
    main.ui.setSecondaryIsCommand(command);
    inspector.ui.setDarkMode(dark);
    inspector.ui.setSecondaryIsCommand(command);
    var second: Window? = null; // the inspector's window, while it is open
    var holds = NEITHER;
    // Fonts from the system for characters the loaded ones lack, found as the frames need them.
    var systemFonts = SystemFonts.create();
    loop {
        if (main.takeEvents(mut window)) {
            return 0;
        }
        // A new build is ready (hot reload): save where the app is, and let it take over.
        let reload = match (borrow hot) {
            Some(h) => h.reloadAsked(),
            null => false,
        };
        if (reload) {
            match (hotDir) {
                Some(d) => {
                    if (!hotSave(d, window.size(), main.ui.isDarkMode(), app)) {
                        Console.writeErrorLine("desktop: could not save the state for the new build");
                    }
                }
                null => {}
            }
            return 0;
        }
        // A menu item chosen: its action, for this frame.
        loop {
            match (window.nextMenuChoice()) {
                Some(id) => {
                    if ((id as usize) < menuModel.partCount()) {
                        main.platform.choose(menuModel.partAction(id as usize));
                    }
                }
                null => { break; }
            }
        }
        var closeSecond = false;
        match (borrow mut second) {
            Some(w) => { closeSecond = inspector.takeEvents(mut w); }
            null => {}
        }
        if (closeSecond) {
            second = null; // the inspector's window closes
            inspector.frame.clear();
            inspector.damage.invalidate();
            if (holds == INSPECTOR) {
                holds = NEITHER;
            }
            app.inspectorClosed();
        }
        // Both windows draw the same state, so each frame runs in both: one whose frame did not change draws nothing.
        main.begin(mut window);
        demoFrameWith(mut main.ui, mut app, raster, mut jobs);
        if (!main.end(mut window, raster)) {
            Console.writeErrorLine("desktop: the frame does not fit the UI capacity");
            return 1;
        }
        if (systemFonts.supplyFrame(mut raster, main.ui) > 0) {
            main.damage.invalidate(); // the same commands draw other glyphs now (the next frame lays them out)
            inspector.damage.invalidate();
        }
        if (!drawPane(mut raster, mut holds, MAIN, mut main, mut inspector, mut window)) {
            Console.writeErrorLine("desktop: the window refused a frame");
            return 1;
        }
        main.platform.endFrame();
        if (!menuSet) {
            menuSet = true;
            let shown = match (systemMenu(menuModel, main.ui)) {
                Ok(menu) => window.setMenu(menu).isOk(),
                Err(_) => false,
            };
            if (!shown) {
                app.setDrawsMenuBar(true); // no menu bar from the system: the demo draws its own
                main.ui.requestFrame();
            }
        }
        // A file the app asked for (File > Open…, Save As…): the system's dialog, then the file.
        match (app.takeFileRequest()) {
            Some(request) => {
                answerFileRequest(request, mut app, mut window);
                main.ui.requestFrame(); // the next frame shows how it went
            }
            null => {}
        }
        if (app.wantsInspector() && second == null) {
            match (Window.open("Live state", INSPECTOR_WIDTH, INSPECTOR_HEIGHT)) {
                Ok(w) => {
                    second = w;
                    inspector.damage.invalidate();
                }
                Err(e) => {
                    Console.writeError("desktop: cannot open the inspector: ");
                    Console.writeErrorLine(windowError(e));
                    app.inspectorClosed();
                }
            }
        }
        var inspectorBusy = false;
        match (borrow mut second) {
            Some(w) => {
                inspector.begin(mut w);
                inspectorFrame(mut inspector.ui, mut app);
                if (!inspector.end(mut w, raster)) {
                    Console.writeErrorLine("desktop: the inspector's frame does not fit its UI capacity");
                    return 1;
                }
                if (!drawPane(mut raster, mut holds, INSPECTOR, mut inspector, mut main, mut w)) {
                    Console.writeErrorLine("desktop: the inspector's window refused a frame");
                    return 1;
                }
                inspector.platform.endFrame();
                inspectorBusy = inspector.ui.needsFrame();
            }
            null => {}
        }
        // The next frame at the display's pace while something moves in either window; otherwise sleep until either
        // window has an event or is woken, or what a frame asked for (a caret blink, a timer): no CPU while idle.
        if (main.ui.needsFrame() || inspectorBusy) {
            window.waitFrame();
        } else {
            var delay = main.ui.frameDelayMs(IDLE_MS);
            if (second != null) {
                delay = delay.min(inspector.ui.frameDelayMs(IDLE_MS));
            }
            Window.waitAny(delay);
        }
    }
}
