// SPDX-License-Identifier: MIT
// ---- JPEG (image.cee's third format) -----------------------------------------------------------------------------------------------------------
// Baseline and progressive JPEG (ITU T.81): Huffman coding, 8-bit samples, one to four components with any sampling
// (4:4:4, 4:2:2, 4:2:0, greyscale), restart intervals, and the orientation a camera writes in its EXIF data (the
// pixels come out as the photo is meant to be seen). Not supported: arithmetic coding, 12-bit samples, lossless and
// hierarchical modes, CMYK. `jpegInfo` reports the scratch: each component's coefficients (two bytes each) and its
// samples (one byte each), over the blocks of whole MCUs.

/// A component of the frame: its id, sampling factors, quantization table, and where its blocks are in the scratch.
struct JpegComponent {
    id: u8;
    hs: usize;
    vs: usize;
    tq: usize;
    /// Blocks a row and rows of blocks, over whole MCUs; and the blocks that hold the image.
    blocksW: usize;
    blocksH: usize;
    usedW: usize;
    usedH: usize;
    /// Offsets in the scratch of its coefficients (i16, little-endian) and its samples (u8).
    coefAt: usize;
    sampleAt: usize;
    /// The DC prediction while a scan decodes.
    pred: i32;
    /// The Huffman tables a scan uses for it.
    td: usize;
    ta: usize;
}

/// A Huffman table (T.81 F.2.2.3): the values in code order, and for each length the smallest and largest code and
/// where its values start.
struct JpegHuffman {
    values: [u8; 256];
    minCode: [i32; 17];
    maxCode: [i32; 18];
    valPtr: [i32; 17];
    present: bool;
}

fn emptyJpegHuffman() -> JpegHuffman => JpegHuffman {
    values: [0u8; 256],
    minCode: [0i32; 17],
    maxCode: [-1i32; 18],
    valPtr: [0i32; 17],
    present: false,
};

/// What the headers say: the frame, its tables, and where the first scan is.
struct JpegFrame {
    w: usize;
    h: usize;
    progressive: bool;
    count: usize;
    comps: [JpegComponent; 4];
    hmax: usize;
    vmax: usize;
    mcusX: usize;
    mcusY: usize;
    /// The EXIF orientation, 1 (as stored) to 8.
    orientation: u32;
    scratch: usize;
}

fn emptyComponent() -> JpegComponent => JpegComponent {
    id: 0,
    hs: 1,
    vs: 1,
    tq: 0,
    blocksW: 0,
    blocksH: 0,
    usedW: 0,
    usedH: 0,
    coefAt: 0,
    sampleAt: 0,
    pred: 0,
    td: 0,
    ta: 0,
};

fn be16(b: Slice<u8>, at: usize) -> usize => ((b[at] as usize) << 8) | (b[at + 1] as usize);

/// A 16-bit and a 32-bit field of TIFF data, in its byte order.
fn tiff16(b: Slice<u8>, at: usize, little: bool) -> usize =>
    if (little) (b[at] as usize) | ((b[at + 1] as usize) << 8) else be16(b, at);

fn tiff32(b: Slice<u8>, at: usize, little: bool) -> usize =>
    if (little) tiff16(b, at, true) | (tiff16(b, at + 2, true) << 16) else (be16(b, at) << 16) | be16(b, at + 2);

/// The orientation an APP1 Exif segment (`b[at..end]`) gives in its first directory, or 1 when it gives none.
fn exifOrientation(b: Slice<u8>, at: usize, end: usize) -> u32 {
    if (end < at + 14 || b[at] != 'E' || b[at + 1] != 'x' || b[at + 2] != 'i' || b[at + 3] != 'f' || b[at + 4] != 0) {
        return 1;
    }
    let t = at + 6;
    let little = b[t] == 'I' && b[t + 1] == 'I';
    if (!little && !(b[t] == 'M' && b[t + 1] == 'M')) {
        return 1;
    }
    let ifd = t + tiff32(b, t + 4, little);
    if (ifd + 2 > end) {
        return 1;
    }
    let entries = tiff16(b, ifd, little);
    for (k in 0..entries) {
        let e = ifd + 2 + k * 12;
        if (e + 12 > end) {
            return 1;
        }
        if (tiff16(b, e, little) == 0x0112) {
            let v = tiff16(b, e + 8, little);
            return if (v >= 1 && v <= 8) truncate<u32>(v) else 1;
        }
    }
    return 1;
}

/// Reads the headers up to the first scan: the frame, and the scratch it needs. The tables are read again by the
/// decoder; this is what `imageInfo` needs.
fn jpegFrame(b: Slice<u8>) -> Result<JpegFrame, ImageError> {
    var f = JpegFrame {
        w: 0,
        h: 0,
        progressive: false,
        count: 0,
        comps: [emptyComponent(), emptyComponent(), emptyComponent(), emptyComponent()],
        hmax: 1,
        vmax: 1,
        mcusX: 0,
        mcusY: 0,
        orientation: 1,
        scratch: 0,
    };
    var at: usize = 2;
    loop {
        if (at + 4 > b.length) {
            return Err(ImageError.Truncated);
        }
        if (b[at] != 0xFF) {
            return Err(ImageError.Corrupt);
        }
        let marker = b[at + 1];
        if (marker == 0xFF) {
            at += 1; // fill bytes
            continue;
        }
        let length = be16(b, at + 2);
        let body = at + 4;
        let end = at + 2 + length;
        if (length < 2 || end > b.length) {
            return Err(ImageError.Truncated);
        }
        if (marker == 0xE1) {
            let o = exifOrientation(b, body, end);
            if (o != 1) {
                f.orientation = o;
            }
        } else if (marker == 0xC0 || marker == 0xC1 || marker == 0xC2) {
            if (b[body] != 8) {
                return Err(ImageError.Unsupported); // 12-bit samples
            }
            f.progressive = marker == 0xC2;
            f.h = be16(b, body + 1);
            f.w = be16(b, body + 3);
            f.count = b[body + 5] as usize;
            if (f.w == 0 || f.h == 0 || (f.count != 1 && f.count != 3) || body + 6 + f.count * 3 > end) {
                return Err(if (f.count == 4) ImageError.Unsupported else ImageError.Corrupt);
            }
            for (c in 0..f.count) {
                let p = body + 6 + c * 3;
                f.comps[c].id = b[p];
                f.comps[c].hs = (b[p + 1] >> 4) as usize;
                f.comps[c].vs = (b[p + 1] & 15) as usize;
                f.comps[c].tq = (b[p + 2] & 3) as usize;
                if (f.comps[c].hs == 0 || f.comps[c].hs > 4 || f.comps[c].vs == 0 || f.comps[c].vs > 4) {
                    return Err(ImageError.Corrupt);
                }
                f.hmax = f.hmax.max(f.comps[c].hs);
                f.vmax = f.vmax.max(f.comps[c].vs);
            }
            f.mcusX = (f.w + 8 * f.hmax - 1) / (8 * f.hmax);
            f.mcusY = (f.h + 8 * f.vmax - 1) / (8 * f.vmax);
            var scratch: usize = 0;
            for (c in 0..f.count) {
                let hs = f.comps[c].hs;
                let vs = f.comps[c].vs;
                f.comps[c].blocksW = f.mcusX * hs;
                f.comps[c].blocksH = f.mcusY * vs;
                f.comps[c].usedW = ((f.w * hs + f.hmax - 1) / f.hmax + 7) / 8;
                f.comps[c].usedH = ((f.h * vs + f.vmax - 1) / f.vmax + 7) / 8;
                let blocks = f.comps[c].blocksW * f.comps[c].blocksH;
                f.comps[c].coefAt = scratch;
                scratch += blocks * 128;
                f.comps[c].sampleAt = scratch;
                scratch += blocks * 64;
            }
            f.scratch = scratch;
        } else if (marker == 0xDA) {
            if (f.count == 0) {
                return Err(ImageError.Corrupt);
            }
            return Ok(f);
        } else if (marker >= 0xC3 && marker <= 0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC) {
            return Err(ImageError.Unsupported); // lossless, hierarchical, arithmetic
        }
        at = end;
    }
}

/// A JPEG's size as it is shown (turned as its orientation says), and the scratch `decodeJpeg` needs.
fn jpegInfo(b: Slice<u8>) -> Result<ImageInfo, ImageError> => jpegInfoScaled(b, 1);

/// The same at 1/`scale` of its size (1 or 8: at an eighth, each block's average, its DC coefficient).
fn jpegInfoScaled(b: Slice<u8>, scale: usize) -> Result<ImageInfo, ImageError> {
    let f = jpegFrame(b)?;
    let turned = f.orientation >= 5;
    let w = (f.w + scale - 1) / scale;
    let h = (f.h + scale - 1) / scale;
    return Ok(ImageInfo {
        kind: ImageKind.Jpeg,
        w: if (turned) h else w,
        h: if (turned) w else h,
        scratchBytes: f.scratch,
    });
}

/// The bits of the entropy-coded data: bytes after a 0xFF are skipped when 0 (stuffing); a marker ends the data, and
/// zeros are read past it.
struct BitReader {
    at: usize;
    bits: u32;
    count: u32;
    marker: bool;
}

fn fillBits(r: borrow mut BitReader, b: Slice<u8>) {
    while (r.count <= 24) {
        var byte: u32 = 0;
        if (!r.marker && r.at < b.length) {
            let v = b[r.at];
            if (v == 0xFF) {
                let next = if (r.at + 1 < b.length) b[r.at + 1] else 0xD9;
                if (next == 0) {
                    byte = 0xFF;
                    r.at += 2;
                } else {
                    r.marker = true; // a marker: the data ends here
                }
            } else {
                byte = v as u32;
                r.at += 1;
            }
        }
        r.bits |= byte << (24 - r.count);
        r.count += 8;
    }
}

/// The next `n` bits, at most 16: no code or value of a JPEG is longer, and a damaged one asking for more reads none.
fn readBits(r: borrow mut BitReader, b: Slice<u8>, n: u32) -> u32 {
    if (n == 0 || n > 16) {
        return 0;
    }
    fillBits(mut r, b);
    let v = r.bits >> (32 - n);
    r.bits = r.bits << n;
    r.count -= n;
    return v;
}

fn readBit(r: borrow mut BitReader, b: Slice<u8>) -> u32 => readBits(mut r, b, 1);

/// A value of `n` bits as the coding gives it: a leading 0 makes it negative (T.81 F.2.2.1, EXTEND).
fn extendBits(v: u32, n: u32) -> i32 {
    if (n == 0) {
        return 0;
    }
    let value = truncate<i32>(v);
    return if (v < (1u32 << (n - 1))) value - (truncate<i32>(1u32 << n) - 1) else value;
}

/// The next value of table `t`, or null for a code it does not have.
fn decodeHuffman(r: borrow mut BitReader, b: Slice<u8>, t: borrow JpegHuffman) -> u8? {
    var code: i32 = 0;
    for (length in 1usize..17) {
        code = code * 2 + truncate<i32>(readBit(mut r, b));
        if (code <= t.maxCode[length]) {
            let index = t.valPtr[length] + code - t.minCode[length];
            if (index < 0 || index > 255) {
                return null;
            }
            return Some(t.values[truncate<usize>(index)]);
        }
    }
    return null;
}

/// Restarts the reader after an RSTn marker: the bits left are dropped, and the marker passed.
fn restart(r: borrow mut BitReader, b: Slice<u8>) {
    r.bits = 0;
    r.count = 0;
    r.marker = false;
    while (r.at + 1 < b.length && !(b[r.at] == 0xFF && b[r.at + 1] >= 0xD0 && b[r.at + 1] <= 0xD7)) {
        r.at += 1;
    }
    if (r.at + 1 < b.length) {
        r.at += 2;
    }
}

fn getCoef(s: Slice<u8>, at: usize) -> i32 {
    let v = (s[at] as u32) | ((s[at + 1] as u32) << 8);
    return if (v >= 0x8000) truncate<i32>(v) - 0x10000 else truncate<i32>(v);
}

fn setCoef(s: SliceMut<u8>, at: usize, v: i32) {
    let u = truncate<u32>(v) & 0xFFFF;
    s[at] = truncate<u8>(u & 0xFF);
    s[at + 1] = truncate<u8>(u >> 8);
}

/// The natural (row-major) position of the k-th coefficient in zigzag order.
const ZIGZAG: [u8; 64] = [
    0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21,
    28, 35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61,
    54, 47, 55, 62, 63,
];

/// What a scan decodes: its spectral band and successive approximation, and the progressive end-of-band run.
struct Scan {
    ss: usize;
    se: usize;
    ah: u32;
    al: u32;
    eobrun: u32;
}

/// Decodes one block of a scan into the coefficients at `at` (natural order). Null for corrupt data.
fn decodeBlock(
    r: borrow mut BitReader,
    b: Slice<u8>,
    scratch: SliceMut<u8>,
    at: usize,
    comp: borrow mut JpegComponent,
    dc: borrow JpegHuffman,
    ac: borrow JpegHuffman,
    scan: borrow mut Scan,
    progressive: bool,
) -> bool {
    if (!progressive) {
        // Baseline: the whole block.
        let t = match (decodeHuffman(mut r, b, dc)) {
            Some(v) => v as u32,
            null => { return false; }
        };
        if (t > 15) {
            return false;
        }
        let diff = extendBits(readBits(mut r, b, t), t);
        // A coefficient is 16 bits: the prediction stays in their range whatever a damaged file adds up to.
        comp.pred = (comp.pred + diff).max(-32768).min(32767);
        setCoef(mut scratch, at, comp.pred);
        var k: usize = 1;
        while (k < 64) {
            let rs = match (decodeHuffman(mut r, b, ac)) {
                Some(v) => v as u32,
                null => { return false; }
            };
            let run = (rs >> 4) as usize;
            let size = rs & 15;
            if (size == 0) {
                if (run != 15) {
                    break; // end of block
                }
                k += 16;
                continue;
            }
            k += run;
            if (k > 63) {
                return false;
            }
            setCoef(mut scratch, at + (ZIGZAG[k] as usize) * 2, extendBits(readBits(mut r, b, size), size));
            k += 1;
        }
        return true;
    }
    if (scan.ss == 0) {
        // Progressive DC: the first scan, or a refinement bit.
        if (scan.ah == 0) {
            let t = match (decodeHuffman(mut r, b, dc)) {
                Some(v) => v as u32,
                null => { return false; }
            };
            if (t > 15) {
                return false;
            }
            comp.pred = (comp.pred + extendBits(readBits(mut r, b, t), t)).max(-32768).min(32767);
            setCoef(mut scratch, at, comp.pred * truncate<i32>(1u32 << scan.al));
        } else if (readBit(mut r, b) == 1) {
            setCoef(mut scratch, at, truncate<i32>(truncate<u32>(getCoef(scratch, at)) | (1u32 << scan.al)));
        }
        return true;
    }
    if (scan.ah == 0) {
        // Progressive AC, first scan of a band.
        if (scan.eobrun > 0) {
            scan.eobrun -= 1;
            return true;
        }
        var k = scan.ss;
        while (k <= scan.se) {
            let rs = match (decodeHuffman(mut r, b, ac)) {
                Some(v) => v as u32,
                null => { return false; }
            };
            let run = rs >> 4;
            let size = rs & 15;
            if (size == 0) {
                if (run < 15) {
                    scan.eobrun = (1u32 << run) - 1;
                    if (run > 0) {
                        scan.eobrun += readBits(mut r, b, run);
                    }
                    break;
                }
                k += 16;
                continue;
            }
            k += run as usize;
            if (k > 63) {
                return false;
            }
            setCoef(
                mut scratch,
                at + (ZIGZAG[k] as usize) * 2,
                extendBits(readBits(mut r, b, size), size) * truncate<i32>(1u32 << scan.al),
            );
            k += 1;
        }
        return true;
    }
    // Progressive AC refinement (T.81 G.1.2.3): a bit for each coefficient already nonzero, and new ones of ±1.
    let p1 = truncate<i32>(1u32 << scan.al);
    let m1 = -1i32 * p1;
    var k = scan.ss;
    if (scan.eobrun == 0) {
        while (k <= scan.se) {
            let rs = match (decodeHuffman(mut r, b, ac)) {
                Some(v) => v as u32,
                null => { return false; }
            };
            var run = truncate<i32>(rs >> 4);
            let size = rs & 15;
            var value: i32 = 0;
            if (size == 0) {
                if (run < 15) {
                    scan.eobrun = (1u32 << truncate<u32>(run)) + readBits(mut r, b, truncate<u32>(run));
                    break;
                }
            } else {
                value = if (readBit(mut r, b) == 1) p1 else m1;
            }
            while (k <= scan.se) {
                let z = at + (ZIGZAG[k] as usize) * 2;
                let coef = getCoef(scratch, z);
                if (coef != 0) {
                    if (readBit(mut r, b) == 1 && (truncate<u32>(coef) & truncate<u32>(p1)) == 0) {
                        setCoef(mut scratch, z, if (coef >= 0) coef + p1 else coef + m1);
                    }
                } else {
                    if (run == 0) {
                        if (value != 0) {
                            setCoef(mut scratch, z, value);
                        }
                        k += 1;
                        break;
                    }
                    run -= 1;
                }
                k += 1;
            }
        }
    }
    if (scan.eobrun > 0) {
        while (k <= scan.se) {
            let z = at + (ZIGZAG[k] as usize) * 2;
            let coef = getCoef(scratch, z);
            if (coef != 0 && readBit(mut r, b) == 1 && (truncate<u32>(coef) & truncate<u32>(p1)) == 0) {
                setCoef(mut scratch, z, if (coef >= 0) coef + p1 else coef + m1);
            }
            k += 1;
        }
        scan.eobrun -= 1;
    }
    return true;
}

/// cos((2x + 1) u π / 16) · C(u) / 2, times 4096, at [u * 8 + x]: the inverse DCT's basis (T.81 A.3.3).
const IDCT: [i32; 64] = [
    1448, 1448, 1448, 1448, 1448, 1448, 1448, 1448, 2009, 1703, 1138, 400, -400, -1138, -1703, -2009, 1892, 784, -784, -1892, -1892, -784, 784, 1892, 1703, -400, -2009, -1138, 1138, 2009, 400, -1703, 1448, -1448, -1448, 1448, 1448, -1448, -1448, 1448, 1138, -2009, 400, 1703, -1703, -400, 2009, -1138, 784, -1892, 1892, -784, -784, 1892, -1892, 784, 400, -1138, 1703, -2009, 2009, -1703, 1138, -400,
];

/// `x` divided by 2^`n`, rounded down (an arithmetic shift right).
fn down(x: i64, n: u32) -> i64 {
    let d = truncate<i64>(1u64 << n);
    return if (x >= 0) x / d else -((-x + d - 1) / d);
}

/// The samples of the block at `coefAt` (dequantized by `q`, natural order) into the plane at `sampleAt`, a row of
/// `stride` bytes apart.
fn idctBlock(
    scratch: SliceMut<u8>,
    coefAt: usize,
    sampleAt: usize,
    stride: usize,
    q: borrow [u16; 64],
    table: borrow [i32; 64],
) {
    var c = [0i32; 64];
    var any = false;
    for (i in 0usize..64) {
        let v = getCoef(scratch, coefAt + i * 2);
        c[i] = v * (q[i] as i32);
        any = any || (i > 0 && v != 0);
    }
    if (!any) {
        // Only the DC: one value for the whole block.
        let value = truncate<i32>(down((c[0] as i64) + 4, 3)) + 128;
        let v = truncate<u8>(value.max(0).min(255));
        for (y in 0usize..8) {
            for (x in 0usize..8) {
                scratch[sampleAt + y * stride + x] = v;
            }
        }
        return;
    }
    // Rows, then columns; each pass keeps 12 more fractional bits, taken off at the end.
    var rows = [0i64; 64];
    for (y in 0usize..8) {
        for (x in 0usize..8) {
            var sum: i64 = 0;
            for (u in 0usize..8) {
                sum += (c[y * 8 + u] as i64) * (table[u * 8 + x] as i64);
            }
            rows[y * 8 + x] = sum;
        }
    }
    for (x in 0usize..8) {
        for (y in 0usize..8) {
            var sum: i64 = 0;
            for (v in 0usize..8) {
                sum += rows[v * 8 + x] * (table[v * 8 + y] as i64);
            }
            let value = truncate<i32>(down(sum + 8388608, 24)) + 128;
            scratch[sampleAt + y * stride + x] = truncate<u8>(value.max(0).min(255));
        }
    }
}

/// The block at `coefAt` as `nx` by `ny` averages of its samples (1, 2, 4 or 8 each way), into the plane at
/// `sampleAt`, a row of `stride` bytes apart: the inverse DCT with each axis's basis summed over the pixels of a part,
/// which is the part's average with no 8 by 8 transform made (an eighth of a JPEG's size, where a subsampled
/// component needs more than its block's average).
fn idctAverages(
    scratch: SliceMut<u8>,
    coefAt: usize,
    sampleAt: usize,
    stride: usize,
    q: borrow [u16; 64],
    table: borrow [i32; 64],
    nx: usize,
    ny: usize,
) {
    let gx = 8 / nx;
    let gy = 8 / ny;
    var shift: u32 = 24;
    var g = gx * gy;
    while (g > 1) {
        shift += 1;
        g /= 2;
    }
    // tmp[v * nx + i]: row v's coefficients against the x basis summed over part i.
    var tmp = [0i64; 64];
    for (v in 0usize..8) {
        for (i in 0..nx) {
            var sum: i64 = 0;
            for (u in 0usize..8) {
                let c = getCoef(scratch, coefAt + (v * 8 + u) * 2) * (q[v * 8 + u] as i32);
                if (c == 0) {
                    continue;
                }
                var k: i64 = 0;
                for (x in i * gx..i * gx + gx) {
                    k += table[u * 8 + x] as i64;
                }
                sum += (c as i64) * k;
            }
            tmp[v * nx + i] = sum;
        }
    }
    for (j in 0..ny) {
        for (i in 0..nx) {
            var sum: i64 = 0;
            for (v in 0usize..8) {
                var k: i64 = 0;
                for (y in j * gy..j * gy + gy) {
                    k += table[v * 8 + y] as i64;
                }
                sum += tmp[v * nx + i] * k;
            }
            let value = truncate<i32>(down(sum + truncate<i64>(1u64 << (shift - 1)), shift)) + 128;
            scratch[sampleAt + j * stride + i] = truncate<u8>(value.max(0).min(255));
        }
    }
}

/// One axis of a component's sampling at the image's pixel `p`: the two samples to blend and their weights, in
/// quarters. A component at half the resolution is blended 3:1 from the two samples nearest the pixel's middle,
/// as libjpeg's "fancy" upsampling does; one at full resolution is its own sample; other ratios take the nearest.
struct Taps {
    a: usize;
    b: usize;
    wa: i32;
    wb: i32;
}

fn taps(p: usize, ratio: usize, extent: usize) -> Taps {
    let last = if (extent > 0) extent - 1 else 0;
    if (ratio == 2) {
        let base = (p / 2).min(last);
        let other = if (p % 2 == 1) (base + 1).min(last) else if (base > 0) base - 1 else 0;
        return Taps { a: base, b: other, wa: 3, wb: 1 };
    }
    let base = (p / ratio.max(1)).min(last);
    return Taps { a: base, b: base, wa: 4, wb: 0 };
}

/// The sample of component `comp` at the image's pixel (`x`, `y`), its plane `per` samples a block wide (8, or 1 at
/// an eighth of the size).
fn sampleAt(
    scratch: Slice<u8>,
    comp: borrow JpegComponent,
    x: usize,
    y: usize,
    w: usize,
    h: usize,
    hmax: usize,
    vmax: usize,
    per: usize,
) -> i32 {
    let stride = comp.blocksW * per;
    let rx = hmax / comp.hs;
    let ry = vmax / comp.vs;
    if (per == 1) {
        // At an eighth every component has one sample a pixel: a subsampled one's blocks were made as `rx` by `ry`
        // averages (idctAverages).
        return scratch[comp.sampleAt + y * comp.blocksW * rx + x] as i32;
    }
    if (rx == 1 && ry == 1) {
        return scratch[comp.sampleAt + y * stride + x] as i32;
    }
    let tx = taps(x, rx, (w * comp.hs + hmax - 1) / hmax);
    let ty = taps(y, ry, (h * comp.vs + vmax - 1) / vmax);
    let row0 = comp.sampleAt + ty.a * stride;
    let row1 = comp.sampleAt + ty.b * stride;
    let sum = ty.wa * (tx.wa * (scratch[row0 + tx.a] as i32) + tx.wb * (scratch[row0 + tx.b] as i32)) +
        ty.wb * (tx.wa * (scratch[row1 + tx.a] as i32) + tx.wb * (scratch[row1 + tx.b] as i32));
    return (sum + 8) / 16;
}

/// Where the stored pixel (`x`, `y`) of a `w` by `h` image goes when the orientation turns it (EXIF 2.32, tag
/// 0x0112): its column and row in the image as it is seen.
fn turn(orientation: u32, x: usize, y: usize, w: usize, h: usize) -> [usize; 2] => match (orientation) {
    2 => [w - 1 - x, y],
    3 => [w - 1 - x, h - 1 - y],
    4 => [x, h - 1 - y],
    5 => [y, x],
    6 => [h - 1 - y, x],
    7 => [h - 1 - y, w - 1 - x],
    8 => [y, w - 1 - x],
    _ => [x, y],
};

/// Decodes a JPEG into `pixels` (`info.w * info.h`, as `jpegInfo` gives them: turned as the photo is meant to be
/// seen), using `scratch` (`info.scratchBytes`).
fn decodeJpeg(b: Slice<u8>, info: ImageInfo, pixels: SliceMut<u32>, scratch: SliceMut<u8>) -> Result<void, ImageError> =>
    decodeJpegScaled(b, info, 1, mut pixels, mut scratch);

/// The same at 1/`scale` of the size (1 or 8, as `jpegInfoScaled`): at an eighth, each block is one sample, its DC
/// coefficient (the block's average), so no inverse DCT is done and an eighth of the pixels in each way are made.
fn decodeJpegScaled(
    b: Slice<u8>,
    info: ImageInfo,
    scale: usize,
    pixels: SliceMut<u32>,
    scratch: SliceMut<u8>,
) -> Result<void, ImageError> {
    var f = jpegFrame(b)?;
    for (i in 0..f.scratch) {
        scratch[i] = 0;
    }
    var quant = [[0u16; 64]; 4];
    var dcTables = [emptyJpegHuffman(), emptyJpegHuffman(), emptyJpegHuffman(), emptyJpegHuffman()];
    var acTables = [emptyJpegHuffman(), emptyJpegHuffman(), emptyJpegHuffman(), emptyJpegHuffman()];
    var interval: usize = 0;
    var at: usize = 2;
    var scans: usize = 0;
    loop {
        if (at + 2 > b.length) {
            break; // no EOI: what was decoded is shown
        }
        if (b[at] != 0xFF) {
            at += 1; // stray bytes between segments
            continue;
        }
        let marker = b[at + 1];
        if (marker == 0xFF || (marker >= 0xD0 && marker <= 0xD7) || marker == 0x00) {
            at += if (marker == 0xFF) 1 else 2;
            continue;
        }
        if (marker == 0xD9) {
            break;
        }
        if (at + 4 > b.length) {
            return Err(ImageError.Truncated);
        }
        let length = be16(b, at + 2);
        let body = at + 4;
        let end = at + 2 + length;
        if (length < 2 || end > b.length) {
            return Err(ImageError.Truncated);
        }
        if (marker == 0xDB) {
            var p = body;
            while (p < end) {
                let precision = b[p] >> 4;
                let id = (b[p] & 3) as usize;
                p += 1;
                for (k in 0usize..64) {
                    let v = if (precision == 0) b[p + k] as u16 else truncate<u16>(be16(b, p + k * 2));
                    quant[id][ZIGZAG[k] as usize] = v;
                }
                p += if (precision == 0) 64 else 128;
            }
        } else if (marker == 0xC4) {
            var p = body;
            while (p + 17 <= end) {
                let class = b[p] >> 4;
                let id = (b[p] & 3) as usize;
                var t = emptyJpegHuffman();
                var total: usize = 0;
                for (l in 1usize..17) {
                    total += b[p + l] as usize;
                }
                if (total > 256 || p + 17 + total > end) {
                    return Err(ImageError.Corrupt);
                }
                for (k in 0..total) {
                    t.values[k] = b[p + 17 + k];
                }
                var code: i32 = 0;
                var k: i32 = 0;
                for (l in 1usize..17) {
                    let n = b[p + l] as i32;
                    t.valPtr[l] = k;
                    t.minCode[l] = code;
                    code += n;
                    k += n;
                    t.maxCode[l] = if (n > 0) code - 1 else -1;
                    code = code * 2;
                }
                t.present = true;
                if (class == 0) {
                    dcTables[id] = t;
                } else {
                    acTables[id] = t;
                }
                p += 17 + total;
            }
        } else if (marker == 0xDD) {
            interval = be16(b, body);
        } else if (marker == 0xDA) {
            let n = b[body] as usize;
            if (n == 0 || n > 4 || body + 1 + n * 2 + 3 > end) {
                return Err(ImageError.Corrupt);
            }
            var inScan = [0usize; 4];
            for (k in 0..n) {
                let id = b[body + 1 + k * 2];
                let tables = b[body + 2 + k * 2];
                var found = false;
                for (c in 0..f.count) {
                    if (f.comps[c].id == id) {
                        inScan[k] = c;
                        f.comps[c].td = (tables >> 4) as usize & 3;
                        f.comps[c].ta = (tables & 15) as usize & 3;
                        found = true;
                    }
                }
                if (!found) {
                    return Err(ImageError.Corrupt);
                }
            }
            let sp = body + 1 + n * 2;
            var scan = Scan {
                ss: b[sp] as usize,
                se: b[sp + 1] as usize,
                ah: (b[sp + 2] >> 4) as u32,
                al: (b[sp + 2] & 15) as u32,
                eobrun: 0,
            };
            if (!f.progressive) {
                scan.ss = 0;
                scan.se = 63;
            }
            if (scan.se > 63 || scan.ss > scan.se || scan.al > 13 || scan.ah > 13) {
                return Err(ImageError.Corrupt);
            }
            for (c in 0..f.count) {
                f.comps[c].pred = 0;
            }
            var r = BitReader { at: end, bits: 0, count: 0, marker: false };
            // A scan of one component goes over its own blocks; one of several, over MCUs.
            let units = if (n == 1) f.comps[inScan[0]].usedW * f.comps[inScan[0]].usedH else f.mcusX * f.mcusY;
            for (unit in 0..units) {
                if (interval > 0 && unit > 0 && unit % interval == 0) {
                    restart(mut r, b);
                    for (c in 0..f.count) {
                        f.comps[c].pred = 0;
                    }
                    scan.eobrun = 0;
                }
                for (k in 0..n) {
                    let c = inScan[k];
                    let hs = if (n == 1) 1 else f.comps[c].hs;
                    let vs = if (n == 1) 1 else f.comps[c].vs;
                    for (v in 0..vs) {
                        for (h in 0..hs) {
                            let bx = if (n == 1) unit % f.comps[c].usedW else (unit % f.mcusX) * f.comps[c].hs + h;
                            let by = if (n == 1) unit / f.comps[c].usedW else (unit / f.mcusX) * f.comps[c].vs + v;
                            let blockAt = f.comps[c].coefAt + (by * f.comps[c].blocksW + bx) * 128;
                            let dc = dcTables[f.comps[c].td];
                            let ac = acTables[f.comps[c].ta];
                            if (!decodeBlock(
                                mut r,
                                b,
                                mut scratch,
                                blockAt,
                                mut f.comps[c],
                                dc,
                                ac,
                                mut scan,
                                f.progressive,
                            )) {
                                return Err(ImageError.Corrupt);
                            }
                        }
                    }
                }
            }
            scans += 1;
            // The scan's data runs to the next marker.
            at = r.at;
            continue;
        }
        at = end;
    }
    if (scans == 0) {
        return Err(ImageError.Truncated);
    }
    // Samples from coefficients (each block's DC alone at an eighth of the size), then colours.
    let eighth = scale == 8;
    let per: usize = if (eighth) 1 else 8;
    let table = IDCT;
    for (c in 0..f.count) {
        let comp = f.comps[c];
        // At an eighth a full component's block is its average, its DC; a subsampled one's is rx by ry averages.
        let rx = if (eighth) f.hmax / comp.hs else 1;
        let ry = if (eighth) f.vmax / comp.vs else 1;
        let stride = comp.blocksW * per * rx;
        for (by in 0..comp.blocksH) {
            for (bx in 0..comp.blocksW) {
                let block = by * comp.blocksW + bx;
                if (eighth && rx == 1 && ry == 1) {
                    let dc = getCoef(scratch, comp.coefAt + block * 128) * (quant[comp.tq][0] as i32);
                    let value = truncate<i32>(down((dc as i64) + 4, 3)) + 128;
                    scratch[comp.sampleAt + by * stride + bx] = truncate<u8>(value.max(0).min(255));
                } else if (eighth) {
                    idctAverages(
                        mut scratch,
                        comp.coefAt + block * 128,
                        comp.sampleAt + by * ry * stride + bx * rx,
                        stride,
                        quant[comp.tq],
                        table,
                        rx,
                        ry,
                    );
                } else {
                    idctBlock(
                        mut scratch,
                        comp.coefAt + block * 128,
                        comp.sampleAt + by * 8 * stride + bx * 8,
                        stride,
                        quant[comp.tq],
                        table,
                    );
                }
            }
        }
    }
    let w = if (eighth) (f.w + 7) / 8 else f.w;
    let h = if (eighth) (f.h + 7) / 8 else f.h;
    let turned = f.orientation >= 5;
    let outW = if (turned) h else w;
    for (y in 0..h) {
        for (x in 0..w) {
            var rgb = [0u32; 3];
            if (f.count == 1) {
                let comp = f.comps[0];
                let v = scratch[comp.sampleAt + y * comp.blocksW * per + x] as u32;
                rgb = [v, v, v];
            } else {
                var ycc = [0i32; 3];
                for (c in 0usize..3) {
                    ycc[c] = sampleAt(scratch, f.comps[c], x, y, w, h, f.hmax, f.vmax, per);
                }
                // JFIF: YCbCr to RGB, in 16 fractional bits.
                let cb = ycc[1] - 128;
                let cr = ycc[2] - 128;
                let yy = ycc[0] * 65536 + 32768;
                let rr = truncate<i32>(down((yy + 91881 * cr) as i64, 16));
                let gg = truncate<i32>(down((yy - 22554 * cb - 46802 * cr) as i64, 16));
                let bb = truncate<i32>(down((yy + 116130 * cb) as i64, 16));
                rgb = [
                    truncate<u32>(rr.max(0).min(255)),
                    truncate<u32>(gg.max(0).min(255)),
                    truncate<u32>(bb.max(0).min(255)),
                ];
            }
            // Where this stored pixel goes, as the orientation turns the photo (EXIF 2.32, tag 0x0112).
            let to = turn(f.orientation, x, y, w, h);
            pixels[to[1] * outW + to[0]] = packRgba(rgb[0], rgb[1], rgb[2], 255);
        }
    }
    let _ = info;
    return Ok();
}
