// SPDX-License-Identifier: MIT
// The Unicode Bidirectional Algorithm (UAX #9) for one paragraph shown as one line: each character's embedding level
// (rules P2 to I2, then L1), and the visual order those levels give (L2). It passes Unicode's own test files
// (BidiTest.txt, BidiCharacterTest.txt: ceeui-tests' bidi tests, with CEEUI_UCD pointing at them).
//
// Everything works in caller-supplied scratch, BIDI_SCRATCH u32s per character, in blocks of one u32 per character:
//   0 class: the current class in bits 0-7, the original in bits 8-15
//   1 bracket key (bracketKey)
//   2 for an isolate initiator, its matching PDI's index + 1; for a matched PDI, MATCHED
//   3 the character's explicit level (X1 to X8) in bits 0-7, its resolved level in bits 8-15
//   4 its position among the characters X9 keeps
//   5 the characters X9 keeps, in order
//   6 the isolating run sequence being resolved
//   7 its bracket pairs (opening and closing positions in the sequence)

/// The level of a character rule X9 removes (embedding and override controls, PDF, BN): it has none.
public const BIDI_REMOVED: u8 = 0xFF;
/// The scratch bidiLevels and bidiResolveClasses need, in u32s per character.
public const BIDI_SCRATCH: usize = 8;

const BIDI_MAX_DEPTH: u32 = 125;
const MATCHED: u32 = 0x80000000;

fn bidiOf(p: u32) -> u32 => (p >> 17) & 31;
fn joiningOf(p: u32) -> u32 => (p >> 22) & 7;

/// `cp`'s Bidi_Class, as bidiResolveClasses takes it: 0 L, 1 R, 2 AL, 3 EN, 4 ES, 5 ET, 6 AN, 7 CS, 8 NSM, 9 BN,
/// 10 B, 11 S, 12 WS, 13 ON, 14 LRE, 15 LRO, 16 RLE, 17 RLO, 18 PDF, 19 LRI, 20 RLI, 21 FSI, 22 PDI.
public fn bidiClass(cp: u32) -> u32 => bidiOf(unicodeProps(cp));

/// The character whose glyph is `cp`'s mirrored (BidiMirroring.txt), for a right-to-left run; `cp` when none is.
public fn bidiMirror(cp: u32) -> u32 {
    var lo: usize = 0;
    var hi = BIDI_MIRROR_COUNT;
    while (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        let v = BIDI_MIRRORS[mid * 2];
        if (v == cp) {
            return BIDI_MIRRORS[mid * 2 + 1];
        }
        if (v < cp) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return cp;
}

/// U+2329 and U+232A are canonically U+3008 and U+3009, the one canonical equivalence among paired brackets.
fn canonicalBracket(cp: u32) -> u32 => if (cp == 0x2329) 0x3008 else if (cp == 0x232A) 0x3009 else cp;

/// `cp`'s key for pairing brackets (BD16): 0 when it is no paired bracket; else the code point of the closing
/// bracket of its pair (canonical) shifted left one, with bit 0 set for a closing bracket.
fn bracketKey(cp: u32) -> u32 {
    var lo: usize = 0;
    var hi = BIDI_BRACKET_COUNT;
    while (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        let v = BIDI_BRACKETS[mid * 3];
        if (v == cp) {
            let close = BIDI_BRACKETS[mid * 3 + 2];
            let closing = if (close == 1) cp else BIDI_BRACKETS[mid * 3 + 1];
            return (canonicalBracket(closing) << 1) | close;
        }
        if (v < cp) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return 0;
}

fn isIsolateInitiator(c: u32) -> bool => c == BIDI_LRI || c == BIDI_RLI || c == BIDI_FSI;

/// Whether the paragraph that `utf8` starts is right to left (UAX #9 P2 and P3): its first strong character, outside
/// isolates, is R or AL. False when it has none, or at its first line break before one.
public fn bidiParagraphRtl(utf8: Slice<u8>) -> bool {
    var depth: u32 = 0;
    var i: usize = 0;
    while (i < utf8.length) {
        let cp = decodeUtf8(utf8, i);
        i += cp[1] as usize;
        let c = bidiClass(cp[0]);
        if (c == BIDI_B) {
            return false;
        }
        if (isIsolateInitiator(c)) {
            depth += 1;
        } else if (c == BIDI_PDI) {
            if (depth > 0) {
                depth -= 1;
            }
        } else if (depth == 0 && (c == BIDI_L || c == BIDI_R || c == BIDI_AL)) {
            return c != BIDI_L;
        }
    }
    return false;
}

/// Whether X9 removes a character of original class `c`.
fn isRemoved(c: u32) -> bool =>
    c == BIDI_RLE || c == BIDI_LRE || c == BIDI_RLO || c == BIDI_LRO || c == BIDI_PDF || c == BIDI_BN;

/// A neutral or isolate formatting character, for N1 and N2.
fn isNeutral(c: u32) -> bool =>
    c == BIDI_B || c == BIDI_S || c == BIDI_WS || c == BIDI_ON || c == BIDI_LRI || c == BIDI_RLI ||
        c == BIDI_FSI || c == BIDI_PDI;

/// The direction a resolved class counts as for N0, N1 and N2 (EN and AN as R); BIDI_ON for a neutral.
fn strongOf(c: u32) -> u32 =>
    if (c == BIDI_L) BIDI_L else if (c == BIDI_R || c == BIDI_EN || c == BIDI_AN) BIDI_R else BIDI_ON;

fn directionOf(level: u32) -> u32 => if ((level & 1) != 0) BIDI_R else BIDI_L;

/// The paragraph being resolved: its scratch (the blocks above) and size.
struct BidiText<region r> {
    s: SliceMut<r, u32>;
    n: usize;
    para: u32;
    /// How many characters X9 keeps.
    keptCount: usize;
}

impl<region r> BidiText<r> {
    fn cls(borrow this, i: usize) -> u32 => this.s[i] & 0xFF;
    fn original(borrow this, i: usize) -> u32 => (this.s[i] >> 8) & 0xFF;
    fn setCls(borrow mut this, i: usize, c: u32) {
        this.s[i] = (this.s[i] & 0xFFFFFF00) | c;
    }
    fn key(borrow this, i: usize) -> u32 => this.s[this.n + i];
    fn matchOf(borrow this, i: usize) -> u32 => this.s[this.n * 2 + i];
    fn level(borrow this, i: usize) -> u32 => this.s[this.n * 3 + i] & 0xFF;
    fn setLevel(borrow mut this, i: usize, l: u32) {
        this.s[this.n * 3 + i] = l | (l << 8);
    }
    fn resolved(borrow this, i: usize) -> u32 => (this.s[this.n * 3 + i] >> 8) & 0xFF;
    fn setResolved(borrow mut this, i: usize, l: u32) {
        let at = this.n * 3 + i;
        this.s[at] = (this.s[at] & 0xFF) | (l << 8);
    }
    fn keptPos(borrow this, i: usize) -> usize => this.s[this.n * 4 + i] as usize;
    fn kept(borrow this, k: usize) -> usize => this.s[this.n * 5 + k] as usize;
    fn seq(borrow this, k: usize) -> usize => this.s[this.n * 6 + k] as usize;
    // The class of the sequence's `k`-th character.
    fn sc(borrow this, k: usize) -> u32 => this.cls(this.seq(k));
    fn setSc(borrow mut this, k: usize, c: u32) {
        let i = this.seq(k);
        this.setCls(i, c);
    }

    /// BD9: each isolate initiator's matching PDI (block 2), and each matched PDI marked. Block 5 is the stack.
    fn matchIsolates(borrow mut this) {
        let n = this.n;
        var depth: usize = 0;
        for (i in 0..n) {
            this.s[n * 2 + i] = 0;
        }
        for (i in 0..n) {
            let c = this.original(i);
            if (isIsolateInitiator(c)) {
                this.s[n * 5 + depth] = truncate<u32>(i);
                depth += 1;
            } else if (c == BIDI_PDI && depth > 0) {
                depth -= 1;
                let j = this.s[n * 5 + depth] as usize;
                this.s[n * 2 + j] = truncate<u32>(i) + 1;
                this.s[n * 2 + i] = MATCHED;
            } else if (c == BIDI_B) {
                depth = 0;
            }
        }
    }

    /// P2 and P3 on characters `from` up to `to`: 0 for a first strong L, 1 for R or AL, -1 for none; isolates are
    /// skipped to their matching PDI.
    fn firstStrong(borrow this, from: usize, to: usize) -> i32 {
        var i = from;
        while (i < to) {
            let c = this.original(i);
            if (c == BIDI_L) {
                return 0;
            }
            if (c == BIDI_R || c == BIDI_AL) {
                return 1;
            }
            if (isIsolateInitiator(c)) {
                let m = this.matchOf(i);
                if (m == 0) {
                    return -1;
                }
                i = m as usize;
                continue;
            }
            if (c == BIDI_B) {
                return -1;
            }
            i += 1;
        }
        return -1;
    }

    /// X1 to X8: each character's explicit level, and the class an override gives it.
    fn explicitLevels(borrow mut this) {
        var stackLevel = [0u8; 128];
        var stackOverride = [0u8; 128]; // 0 none, 1 L, 2 R
        var stackIsolate = [false; 128];
        var depth: usize = 1;
        stackLevel[0] = truncate<u8>(this.para);
        var overflowIsolates: u32 = 0;
        var overflowEmbeddings: u32 = 0;
        var validIsolates: u32 = 0;
        for (i in 0..this.n) {
            let c = this.original(i);
            let top = stackLevel[depth - 1] as u32;
            let ov = stackOverride[depth - 1];
            if (c == BIDI_RLE || c == BIDI_LRE || c == BIDI_RLO || c == BIDI_LRO) {
                let rtl = c == BIDI_RLE || c == BIDI_RLO;
                let next = if (rtl) (top + 1) | 1 else (top + 2) & 0xFE;
                this.setLevel(i, top);
                if (next <= BIDI_MAX_DEPTH && overflowIsolates == 0 && overflowEmbeddings == 0) {
                    stackLevel[depth] = truncate<u8>(next);
                    stackOverride[depth] = if (c == BIDI_LRO) 1 else if (c == BIDI_RLO) 2 else 0;
                    stackIsolate[depth] = false;
                    depth += 1;
                } else if (overflowIsolates == 0) {
                    overflowEmbeddings += 1;
                }
                continue;
            }
            if (isIsolateInitiator(c)) {
                this.setLevel(i, top);
                if (ov != 0) {
                    this.setCls(i, if (ov == 1) BIDI_L else BIDI_R);
                }
                var rtl = c == BIDI_RLI;
                if (c == BIDI_FSI) {
                    let m = this.matchOf(i);
                    let end = if (m == 0) this.n else (m - 1) as usize;
                    rtl = this.firstStrong(i + 1, end) == 1;
                }
                let next = if (rtl) (top + 1) | 1 else (top + 2) & 0xFE;
                if (next <= BIDI_MAX_DEPTH && overflowIsolates == 0 && overflowEmbeddings == 0) {
                    validIsolates += 1;
                    stackLevel[depth] = truncate<u8>(next);
                    stackOverride[depth] = 0;
                    stackIsolate[depth] = true;
                    depth += 1;
                } else {
                    overflowIsolates += 1;
                }
                continue;
            }
            if (c == BIDI_PDI) {
                if (overflowIsolates > 0) {
                    overflowIsolates -= 1;
                } else if (validIsolates > 0) {
                    overflowEmbeddings = 0;
                    while (!stackIsolate[depth - 1]) {
                        depth -= 1;
                    }
                    depth -= 1;
                    validIsolates -= 1;
                }
                this.setLevel(i, stackLevel[depth - 1] as u32);
                let o = stackOverride[depth - 1];
                if (o != 0) {
                    this.setCls(i, if (o == 1) BIDI_L else BIDI_R);
                }
                continue;
            }
            if (c == BIDI_PDF) {
                if (overflowIsolates > 0) {
                    // nothing
                } else if (overflowEmbeddings > 0) {
                    overflowEmbeddings -= 1;
                } else if (!stackIsolate[depth - 1] && depth >= 2) {
                    depth -= 1;
                }
                this.setLevel(i, top);
                continue;
            }
            if (c == BIDI_B) {
                this.setLevel(i, this.para);
                continue;
            }
            this.setLevel(i, top);
            if (c != BIDI_BN && ov != 0) {
                this.setCls(i, if (ov == 1) BIDI_L else BIDI_R);
            }
        }
    }

    /// The level of the kept character before kept position `k`, or the paragraph's.
    fn levelBefore(borrow this, k: usize) -> u32 => if (k == 0) this.para else this.level(this.kept(k - 1));

    /// W1 to W7, N0 to N2 and I1 to I2 on the isolating run sequence in block 6 (`count` characters).
    fn resolveSequence(borrow mut this, count: usize) {
        let first = this.seq(0);
        let last = this.seq(count - 1);
        let level = this.level(first);
        let before = this.levelBefore(this.keptPos(first));
        var after = this.para;
        if (!isIsolateInitiator(this.original(last))) {
            let k = this.keptPos(last) + 1;
            if (k < this.keptCount) {
                after = this.level(this.kept(k));
            }
        }
        let sos = directionOf(level.max(before));
        let eos = directionOf(level.max(after));
        let embedding = directionOf(level);
        // W1: a mark takes the class before it (ON after an isolate initiator or PDI; sos at the start).
        for (k in 0..count) {
            if (this.sc(k) == BIDI_NSM) {
                var c = sos;
                if (k > 0) {
                    let p = this.sc(k - 1);
                    c = if (isIsolateInitiator(p) || p == BIDI_PDI) BIDI_ON else p;
                }
                this.setSc(k, c);
            }
        }
        // W2, W3: European numbers after Arabic letters are Arabic; AL is R.
        var strong = sos;
        for (k in 0..count) {
            let c = this.sc(k);
            if (c == BIDI_L || c == BIDI_R || c == BIDI_AL) {
                strong = c;
            } else if (c == BIDI_EN && strong == BIDI_AL) {
                this.setSc(k, BIDI_AN);
            }
        }
        for (k in 0..count) {
            if (this.sc(k) == BIDI_AL) {
                this.setSc(k, BIDI_R);
            }
        }
        // W4: one separator between two numbers of a kind.
        if (count >= 3) {
            for (k in 1..count - 1) {
                let c = this.sc(k);
                let p = this.sc(k - 1);
                let x = this.sc(k + 1);
                if (c == BIDI_ES && p == BIDI_EN && x == BIDI_EN) {
                    this.setSc(k, BIDI_EN);
                } else if (c == BIDI_CS && p == x && (p == BIDI_EN || p == BIDI_AN)) {
                    this.setSc(k, p);
                }
            }
        }
        // W5: terminators next to European numbers.
        var k: usize = 0;
        while (k < count) {
            if (this.sc(k) != BIDI_ET) {
                k += 1;
                continue;
            }
            var e = k;
            while (e < count && this.sc(e) == BIDI_ET) {
                e += 1;
            }
            if ((k > 0 && this.sc(k - 1) == BIDI_EN) || (e < count && this.sc(e) == BIDI_EN)) {
                for (j in k..e) {
                    this.setSc(j, BIDI_EN);
                }
            }
            k = e;
        }
        // W6: other separators and terminators are neutral.
        for (j in 0..count) {
            let c = this.sc(j);
            if (c == BIDI_ES || c == BIDI_ET || c == BIDI_CS) {
                this.setSc(j, BIDI_ON);
            }
        }
        // W7: European numbers after L are L.
        strong = sos;
        for (j in 0..count) {
            let c = this.sc(j);
            if (c == BIDI_L || c == BIDI_R) {
                strong = c;
            } else if (c == BIDI_EN && strong == BIDI_L) {
                this.setSc(j, BIDI_L);
            }
        }
        this.resolveBrackets(count, sos, embedding);
        // N1, N2: neutrals between two of one direction take it; others the embedding direction.
        k = 0;
        while (k < count) {
            if (!isNeutral(this.sc(k))) {
                k += 1;
                continue;
            }
            var e = k;
            while (e < count && isNeutral(this.sc(e))) {
                e += 1;
            }
            let lead = if (k == 0) sos else strongOf(this.sc(k - 1));
            let trail = if (e >= count) eos else strongOf(this.sc(e));
            let to = if (lead == trail) lead else embedding;
            for (j in k..e) {
                this.setSc(j, to);
            }
            k = e;
        }
        // I1, I2.
        for (j in 0..count) {
            let i = this.seq(j);
            let c = this.cls(i);
            var l = level;
            if ((level & 1) == 0) {
                if (c == BIDI_R) {
                    l += 1;
                } else if (c == BIDI_AN || c == BIDI_EN) {
                    l += 2;
                }
            } else if (c == BIDI_L || c == BIDI_EN || c == BIDI_AN) {
                l += 1;
            }
            this.setResolved(i, l);
        }
    }

    /// BD16 and N0: paired brackets take the direction of what they enclose, or of what comes before them.
    fn resolveBrackets(borrow mut this, count: usize, sos: u32, embedding: u32) {
        let n = this.n;
        var stackKey = [0u32; 63];
        var stackPos = [0usize; 63];
        var depth: usize = 0;
        var pairs: usize = 0;
        for (k in 0..count) {
            let key = this.key(this.seq(k));
            if (key == 0 || this.sc(k) != BIDI_ON) {
                continue;
            }
            if ((key & 1) == 0) {
                if (depth == 63) {
                    pairs = 0;
                    break;
                }
                stackKey[depth] = key >> 1;
                stackPos[depth] = k;
                depth += 1;
                continue;
            }
            var d = depth;
            while (d > 0) {
                if (stackKey[d - 1] == key >> 1) {
                    // A pair, kept sorted by its opening bracket.
                    let open = stackPos[d - 1];
                    var at = pairs;
                    while (at > 0 && (this.s[n * 7 + (at - 1) * 2] as usize) > open) {
                        this.s[n * 7 + at * 2] = this.s[n * 7 + (at - 1) * 2];
                        this.s[n * 7 + at * 2 + 1] = this.s[n * 7 + (at - 1) * 2 + 1];
                        at -= 1;
                    }
                    this.s[n * 7 + at * 2] = truncate<u32>(open);
                    this.s[n * 7 + at * 2 + 1] = truncate<u32>(k);
                    pairs += 1;
                    depth = d - 1;
                    break;
                }
                d -= 1;
            }
        }
        for (p in 0..pairs) {
            let open = this.s[n * 7 + p * 2] as usize;
            let close = this.s[n * 7 + p * 2 + 1] as usize;
            var same = false;
            var opposite = false;
            for (j in open + 1..close) {
                let d = strongOf(this.sc(j));
                if (d == embedding) {
                    same = true;
                    break;
                }
                if (d != BIDI_ON) {
                    opposite = true;
                }
            }
            var to = BIDI_ON;
            if (same) {
                to = embedding;
            } else if (opposite) {
                var context = sos;
                var j = open;
                while (j > 0) {
                    j -= 1;
                    let d = strongOf(this.sc(j));
                    if (d != BIDI_ON) {
                        context = d;
                        break;
                    }
                }
                to = if (context != embedding) context else embedding;
            }
            if (to == BIDI_ON) {
                continue;
            }
            this.setSc(open, to);
            this.setSc(close, to);
            // Marks after a bracket that changed take its direction.
            var j = open + 1;
            while (j < count && this.original(this.seq(j)) == BIDI_NSM) {
                this.setSc(j, to);
                j += 1;
            }
            j = close + 1;
            while (j < count && this.original(this.seq(j)) == BIDI_NSM) {
                this.setSc(j, to);
                j += 1;
            }
        }
    }
}

/// Resolves the `n` characters whose classes are in block 0 and bracket keys in block 1 of `s`: their levels into
/// `levels` (BIDI_REMOVED for those X9 removes), L1 applied as for one line. The paragraph level.
fn resolve(s: SliceMut<u32>, n: usize, direction: i32, levels: SliceMut<u8>) -> i32 {
    var t = BidiText { s: s, n: n, para: 0, keptCount: 0 };
    for (i in 0..n) {
        let c = t.s[i] & 0xFF;
        t.s[i] = c | (c << 8);
    }
    t.matchIsolates();
    // P2, P3 (or the direction asked for).
    let first = t.firstStrong(0, n);
    t.para = if (direction == 0 || direction == 1) truncate<u32>(direction) else if (first == 1) 1 else 0;
    t.explicitLevels();
    // X9: the characters kept, and each character's position among them.
    var m: usize = 0;
    for (i in 0..n) {
        t.s[n * 4 + i] = truncate<u32>(m);
        if (!isRemoved(t.original(i))) {
            t.s[n * 5 + m] = truncate<u32>(i);
            m += 1;
        }
    }
    t.keptCount = m;
    // X10: level runs, chained across isolates into isolating run sequences, each resolved.
    var k: usize = 0;
    while (k < m) {
        let i = t.kept(k);
        let e = runEnd(t, k);
        if (t.original(i) == BIDI_PDI && t.matchOf(i) == MATCHED) {
            // Resolved with the sequence its isolate initiator ends.
            k = e;
            continue;
        }
        var count: usize = 0;
        var a = k;
        var b = e;
        loop {
            for (j in a..b) {
                t.s[n * 6 + count] = truncate<u32>(t.kept(j));
                count += 1;
            }
            let last = t.kept(b - 1);
            let mt = t.matchOf(last);
            if (!isIsolateInitiator(t.original(last)) || mt == 0) {
                break;
            }
            a = t.keptPos((mt - 1) as usize);
            b = runEnd(t, a);
        }
        t.resolveSequence(count);
        k = e;
    }
    // L1: separators, and whitespace and isolate controls before them or at the end, at the paragraph level.
    var trailing = true;
    var i = n;
    while (i > 0) {
        i -= 1;
        let c = t.original(i);
        if (c == BIDI_S || c == BIDI_B) {
            t.setResolved(i, t.para);
            trailing = true;
        } else if (trailing && (c == BIDI_WS || isIsolateInitiator(c) || c == BIDI_PDI || isRemoved(c))) {
            t.setResolved(i, t.para);
        } else {
            trailing = false;
        }
    }
    for (j in 0..n) {
        levels[j] = if (isRemoved(t.original(j))) BIDI_REMOVED else truncate<u8>(t.resolved(j));
    }
    return truncate<i32>(t.para);
}

/// The end of the level run that starts at kept position `k`.
fn runEnd(t: borrow BidiText, k: usize) -> usize {
    let level = t.level(t.kept(k));
    var e = k + 1;
    while (e < t.keptCount && t.level(t.kept(e)) == level) {
        e += 1;
    }
    return e;
}

/// UAX #9 on characters given by their classes (bidiClass's numbers), with no paired brackets: each one's level
/// into `levels` (BIDI_REMOVED for those X9 removes). `direction` is 0 for a left-to-right paragraph, 1 for
/// right-to-left, -1 for its first strong character's (P2, P3). The paragraph level, or -1 when `levels` or
/// `scratch` (BIDI_SCRATCH u32s per character) is too small.
public fn bidiResolveClasses(classes: Slice<u8>, direction: i32, levels: SliceMut<u8>, scratch: SliceMut<u32>) -> i32 {
    let n = classes.length;
    if (levels.length < n || scratch.length < n * BIDI_SCRATCH) {
        return -1;
    }
    for (i in 0..n) {
        scratch[i] = classes[i] as u32;
        scratch[n + i] = 0;
    }
    return resolve(scratch, n, direction, levels);
}

/// UAX #9 on `utf8` as one paragraph on one line: each code point's level, in order, into `levels`
/// (BIDI_REMOVED for those X9 removes). `direction` as bidiResolveClasses takes it. The paragraph level, or -1 when
/// `levels` (one per code point) or `scratch` (BIDI_SCRATCH u32s per code point) is too small.
public fn bidiLevels(utf8: Slice<u8>, direction: i32, levels: SliceMut<u8>, scratch: SliceMut<u32>) -> i32 {
    var n: usize = 0;
    var i: usize = 0;
    while (i < utf8.length) {
        i += decodeUtf8(utf8, i)[1] as usize;
        n += 1;
    }
    if (levels.length < n || scratch.length < n * BIDI_SCRATCH) {
        return -1;
    }
    i = 0;
    var k: usize = 0;
    while (i < utf8.length) {
        let cp = decodeUtf8(utf8, i);
        scratch[k] = bidiClass(cp[0]);
        scratch[n + k] = bracketKey(cp[0]);
        i += cp[1] as usize;
        k += 1;
    }
    return resolve(scratch, n, direction, levels);
}

/// L2: the visual order, left to right, of the characters with `levels` (bidiLevels'), as their indexes into
/// `order`, leaving out those X9 removed. How many it wrote (0 when `order` is shorter than `levels`).
public fn bidiVisualOrder(levels: Slice<u8>, order: SliceMut<u32>) -> usize {
    if (order.length < levels.length) {
        return 0;
    }
    var m: usize = 0;
    var highest: u8 = 0;
    var lowestOdd: u8 = 0xFF;
    for (i in 0..levels.length) {
        let l = levels[i];
        if (l == BIDI_REMOVED) {
            continue;
        }
        order[m] = truncate<u32>(i);
        m += 1;
        highest = highest.max(l);
        if ((l & 1) != 0) {
            lowestOdd = lowestOdd.min(l);
        }
    }
    if (lowestOdd == 0xFF) {
        return m;
    }
    var level = highest;
    while (level >= lowestOdd) {
        var k: usize = 0;
        while (k < m) {
            if (levels[order[k] as usize] < level) {
                k += 1;
                continue;
            }
            var e = k;
            while (e < m && levels[order[e] as usize] >= level) {
                e += 1;
            }
            var a = k;
            var b = e - 1;
            while (a < b) {
                let x = order[a];
                order[a] = order[b];
                order[b] = x;
                a += 1;
                b -= 1;
            }
            k = e;
        }
        if (level == 0) {
            break;
        }
        level -= 1;
    }
    return m;
}
