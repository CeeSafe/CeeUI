// SPDX-License-Identifier: MIT
// The immediate-mode UI context: renderer.h's frame loop and element opening on top of the layout engine.
//
// Per frame: `begin(platform)` hit-tests the pointer against the previous frame's layout (as Clay_SetPointerState
// does), updates scroll containers (Clay_UpdateScrollContainers: wheel, drag, momentum) and opens the root; elements
// are declared with `open`/`close` (or `nest` with a closure) and `label`; `end` lays out and records what the next
// frame needs; `render` sends the commands to a backend.
//
// An element's style is resolved as RendererOpenElement does: base props, then hover (pointer over it), active
// (hovered and pressed), group-hover, focus, and disabled (which wins and suppresses the rest), then transitions.

/// Tailwind's breakpoints, mobile first: the window's width is at least the breakpoint's (`SCREEN_SM` and the
/// others), and `Base` is below `sm` (a phone held upright).
public enum Breakpoint {
    Base,
    Sm,
    Md,
    Lg,
    Xl,
    Xxl,
}

/// Where each breakpoint begins, in points of the window's width, as Tailwind's (40rem, 48rem, 64rem, 80rem, 96rem).
public const SCREEN_SM: f32 = 640.0;
public const SCREEN_MD: f32 = 768.0;
public const SCREEN_LG: f32 = 1024.0;
public const SCREEN_XL: f32 = 1280.0;
public const SCREEN_2XL: f32 = 1536.0;

/// The width from which breakpoint `b` holds.
public fn screenFrom(b: Breakpoint) -> f32 => match (b) {
    Breakpoint.Base => 0.0,
    Breakpoint.Sm => SCREEN_SM,
    Breakpoint.Md => SCREEN_MD,
    Breakpoint.Lg => SCREEN_LG,
    Breakpoint.Xl => SCREEN_XL,
    Breakpoint.Xxl => SCREEN_2XL,
};

/// A screen's size along one axis, as a layout chooses by it (Ui.widthClass, Ui.heightClass): `Compact` is a phone
/// held upright (its width) or on its side (its height), `Regular` a tablet or a desktop window.
public enum SizeClass {
    Compact,
    Regular,
}

/// Below these, in layout units, a screen's width and height are compact.
public const COMPACT_WIDTH: f32 = 600.0;
public const COMPACT_HEIGHT: f32 = 480.0;

/// One scroll container's state across frames (Clay__ScrollContainerDataInternal).
struct ScrollState {
    id: u32;
    position: Vec2;
    momentum: Vec2;
    scrollOrigin: Vec2;
    pointerOrigin: Vec2;
    pointerActive: bool;
    momentumTime: f32;
    /// A touch pan's fling, in points a second (gestures.cee).
    fling: Vec2;
    content: Dims;
    size: Dims;
    area: Rect;
    horizontal: bool;
    vertical: bool;
    openThisFrame: bool;
    /// A mouse drag does not scroll it (`Style.noDragScroll`: a drag in a text view selects).
    noDrag: bool;
    /// `scrollToBottom` was asked this frame: once the frame's layout has measured the content (which may have
    /// grown in it, a message added), the container goes to that end, and the next frame draws it there.
    toBottom: bool;
}

/// How much a `Ui` holds.
public struct UiCapacity {
    public layout: LayoutCapacity;
    public animations: usize;
    public scrollContainers: usize;
    /// Bytes for text going to and from the clipboard, and for an input method's composition (each).
    public textBytes: usize;

    public fn of(elements: usize) -> UiCapacity => UiCapacity {
        layout: LayoutCapacity.of(elements),
        animations: 512,
        scrollContainers: 64,
        textBytes: 16384,
    };
}

public struct Ui<region r> {
    tree: LayoutTree<r>;
    animations: Transitions<r>;
    scrolls: FixedList<r, ScrollState>;
    pressedIds: FixedList<r, u32>;
    clickedIds: FixedList<r, u32>;
    pointerState: Pointer;
    frameDt: f32;
    cursorWanted: Cursor;
    /// Whether this frame asked for the system's Back (`wantBack`).
    backWanted: bool;
    /// The scroll panel whose scroll bar's thumb the pointer is dragging (0 for none), and where on the thumb it took
    /// hold, from its top.
    thumbDrag: u32;
    thumbGrab: f32;
    darkMode: bool;
    screen: Dims;
    safe: Insets;
    keyboard: f32;
    // Keys and text for this frame (copied from the platform at `begin`).
    keysDown: u64;
    keysPressed: u64;
    keysRepeated: u64;
    chars: FixedList<r, u32>;
    charRead: usize;
    clock: f64;
    // Focus and drag capture (controls.h's ClayWind_focusedId / ClayWind_activeId), and this frame's focusables.
    focusedId: u32;
    activeId: u32;
    /// Where the captured control was taken hold of, in whatever terms it chose (captureAnchor).
    anchor: f32;
    focusables: FixedList<r, u32>;
    // Text editing with the host (ui_edit.cee): this frame's edit commands, text pasted and copied, the input
    // method's composition, and the focused text field's caret.
    commands: u32;
    /// Whether the system clipboard has text, as the host last found (an edit menu enables Paste by it).
    clipboardText: bool;
    /// A text field's own edit menu (ui_edit.cee): the field it is open for (0: none), and where.
    fieldMenu: u32;
    fieldMenuX: f32;
    fieldMenuY: f32;
    /// The field whose menu took a choice: it keeps the focus through that press's release (a phone keeps its keyboard).
    fieldMenuChoice: u32;
    /// Set when a menu that offers Paste opened: the host reads the clipboard for it (takeClipboardWanted).
    clipboardWanted: bool;
    pasted: SliceMut<r, u8>;
    pastedLength: usize;
    copied: SliceMut<r, u8>;
    copiedLength: usize;
    hasCopied: bool;
    composing: SliceMut<r, u8>;
    composingLength: usize;
    composingCaret: usize;
    /// The text field that had the focus at the end of the last frame (0: none), and a composition it was given back
    /// when the focus left it mid-composition: its owner's id, and its bytes (ui_edit.cee).
    lastTextFocus: u32;
    handover: SliceMut<r, u8>;
    handoverLength: usize;
    handoverOwner: u32;
    textFocusMoved: bool;
    caretArea: Rect;
    /// The layout inspector (ui_inspect.cee): whether it is on, and the element it shows.
    inspecting: bool;
    inspected: ElementInfo?;
    wantsText: bool;
    /// The element that gives up the focus when the frame ends (leaveFocus); 0 = none.
    leavingId: u32;
    textKind: TextKind;
    returnKeyFace: ReturnKey;
    // Accessibility (access.cee): this frame's elements for a screen reader and their labels' bytes, the depth of
    // the reported control being built (0: none), and the reader's actions: this frame's, and those waiting.
    accessNodes: FixedList<r, AccessNode>;
    accessBytes: FixedList<r, u8>;
    accessInside: u32;
    // The containers open around the element being built (CeeSafe ADR 0207): their ids and depths, innermost last.
    accessOpenIds: [u32; 16];
    accessOpenDepths: [u32; 16];
    accessOpenCount: usize;
    accessNow: FixedList<r, PendingAccess>;
    accessWaiting: FixedList<r, PendingAccess>;
    // Actions (actions.cee): the bindings, this frame's keystrokes and the actions they triggered, the key contexts
    // open around the element being built, and those around the focused element last frame.
    bindings: FixedList<r, Binding>;
    keystrokes: FixedList<r, Keystroke>;
    triggered: FixedList<r, u32>;
    /// The drag under way, if any (drag.cee).
    drag: DragState;
    /// Actions dispatched this frame, triggered at the next `begin` (actions.cee).
    queuedActions: [u32; 8];
    queuedCount: usize;
    openDepth: u32;
    contextNames: [u32; 16];
    contextDepths: [u32; 16];
    contextCount: usize;
    focusContexts: [u32; 16];
    focusContextCount: usize;
    nextFocusContexts: [u32; 16];
    nextFocusContextCount: usize;
    secondaryIsCommand: bool;
    // Frame pacing (state.cee): another frame asked for, a frame asked for later (seconds from this frame's clock,
    // negative for none), input seen this frame, and the pointer's last place.
    requested: bool;
    requestedAfter: f64;
    inputSeen: bool;
    lastPointer: Vec2;
    // Repeated presses: when and where the last went down, and how many came in quick succession.
    lastPressTime: f64;
    lastPressAt: Vec2;
    presses: u32;
    // Touches (gestures.cee): the recognizer, the elements under the gesture's start, the scroll container a pan
    // moves (0 for none), whether the fingers make the pointer, and whether they cancelled its press this frame.
    gestures: GestureState;
    gestureTargets: FixedList<r, u32>;
    touchScroll: u32;
    touchDriven: bool;
    touchGiven: Vec2;
    pressCancelled: bool;

    /// A context whose memory comes from `memory`, which it borrows for its whole life.
    public fn create(memory: borrow(r) FixedBufferAllocator, capacity: UiCapacity) -> Result<Ui<r>, AllocError> {
        let tree = LayoutTree.create(memory, capacity.layout)?;
        let animations = Transitions.create(memory, capacity.animations)?;
        let empty = ScrollState {
            id: 0,
            position: Vec2.zero(),
            momentum: Vec2.zero(),
            scrollOrigin: Vec2.zero(),
            pointerOrigin: Vec2.zero(),
            pointerActive: false,
            momentumTime: 0.0,
            fling: Vec2.zero(),
            content: Dims { w: 0.0, h: 0.0 },
            size: Dims { w: 0.0, h: 0.0 },
            area: Rect.zero(),
            horizontal: false,
            vertical: false,
            openThisFrame: false,
            noDrag: false,
            toBottom: false,
        };
        let scrolls = memory.allocArray(capacity.scrollContainers, empty)?;
        let pressed = memory.allocArray(capacity.layout.elements, 0u32)?;
        let targets = memory.allocArray(capacity.layout.elements, 0u32)?;
        let clicked = memory.allocArray(capacity.layout.elements, 0u32)?;
        let chars = memory.allocArray(64, 0u32)?;
        let focusables = memory.allocArray(64, 0u32)?;
        let accessNodes = memory.allocArray(capacity.layout.elements, emptyAccessNode())?;
        let accessBytes = memory.allocArray(capacity.textBytes, 0u8)?;
        let accessNow = memory.allocArray(16, emptyPendingAccess())?;
        let accessWaiting = memory.allocArray(16, emptyPendingAccess())?;
        let pasted = memory.allocArray(capacity.textBytes, 0u8)?;
        let bindings = memory.allocArray(128, emptyBinding())?;
        let keystrokes = memory.allocArray(16, Keystroke { key: null, character: 0, modifiers: Modifiers.none() })?;
        let triggered = memory.allocArray(16, 0u32)?;
        let copied = memory.allocArray(capacity.textBytes, 0u8)?;
        let composing = memory.allocArray(capacity.textBytes, 0u8)?;
        let handover = memory.allocArray(capacity.textBytes, 0u8)?;
        var ui = Ui {
            tree: tree,
            animations: animations,
            scrolls: FixedList<ScrollState>.over(scrolls),
            pressedIds: FixedList<u32>.over(pressed),
            clickedIds: FixedList<u32>.over(clicked),
            pointerState: Pointer.at(Vec2 { x: -1.0, y: -1.0 }),
            frameDt: 0.0,
            cursorWanted: Cursor.Default,
            backWanted: false,
            thumbDrag: 0,
            thumbGrab: 0.0,
            darkMode: false,
            screen: Dims { w: 0.0, h: 0.0 },
            safe: Insets.zero(),
            keyboard: 0.0,
            keysDown: 0,
            keysPressed: 0,
            keysRepeated: 0,
            chars: FixedList<u32>.over(chars),
            charRead: 0,
            clock: 0.0,
            focusedId: 0,
            activeId: 0,
            anchor: 0.0,
            focusables: FixedList<u32>.over(focusables),
            commands: 0,
            clipboardText: false,
            fieldMenu: 0,
            fieldMenuX: 0.0,
            fieldMenuY: 0.0,
            fieldMenuChoice: 0,
            clipboardWanted: false,
            pasted: pasted,
            pastedLength: 0,
            copied: copied,
            copiedLength: 0,
            hasCopied: false,
            composing: composing,
            composingLength: 0,
            composingCaret: 0,
            lastTextFocus: 0,
            handover: handover,
            handoverLength: 0,
            handoverOwner: 0,
            textFocusMoved: false,
            caretArea: Rect.zero(),
            inspecting: false,
            inspected: null,
            wantsText: false,
            leavingId: 0,
            textKind: TextKind.Text,
            returnKeyFace: ReturnKey.Done,
            accessNodes: FixedList<AccessNode>.over(accessNodes),
            accessBytes: FixedList<u8>.over(accessBytes),
            accessInside: 0,
            accessOpenIds: [0u32; 16],
            accessOpenDepths: [0u32; 16],
            accessOpenCount: 0,
            accessNow: FixedList<PendingAccess>.over(accessNow),
            accessWaiting: FixedList<PendingAccess>.over(accessWaiting),
            bindings: FixedList<Binding>.over(bindings),
            keystrokes: FixedList<Keystroke>.over(keystrokes),
            triggered: FixedList<u32>.over(triggered),
            drag: DragState.none(),
            queuedActions: [0u32; 8],
            queuedCount: 0,
            openDepth: 0,
            contextNames: [0u32; 16],
            contextDepths: [0u32; 16],
            contextCount: 0,
            focusContexts: [0u32; 16],
            focusContextCount: 0,
            nextFocusContexts: [0u32; 16],
            nextFocusContextCount: 0,
            secondaryIsCommand: false,
            requested: false,
            requestedAfter: -1.0,
            inputSeen: false,
            lastPointer: Vec2 { x: -1.0, y: -1.0 },
            lastPressTime: -1.0,
            lastPressAt: Vec2.zero(),
            presses: 0,
            gestures: GestureState.create(),
            gestureTargets: FixedList<u32>.over(targets),
            touchScroll: 0,
            touchDriven: false,
            touchGiven: Vec2.zero(),
            pressCancelled: false,
        };
        ui.bindDefaults();
        return Ok(ui);
    }

    // ---- the frame -------------------------------------------------------------------------------------------------

    /// Starts a frame (ClayWind_BeginFrame): input, hit-testing against the last frame, scrolling, the root.
    public fn begin(borrow mut this, platform: borrow mut dyn Platform) {
        let given = platform.pointer();
        this.frameDt = platform.frameTime();
        this.clock = platform.time();
        this.keysDown = 0;
        this.keysPressed = 0;
        this.keysRepeated = 0;
        for (i in 0..KEY_COUNT) {
            let key = keyAt(i);
            let bit = 1u64 << (i as u64);
            if (platform.keyDown(key)) {
                this.keysDown |= bit;
            }
            if (platform.keyPressed(key)) {
                this.keysPressed |= bit;
            }
            if (platform.keyRepeated(key)) {
                this.keysRepeated |= bit;
            }
        }
        this.requested = false;
        this.requestedAfter = -1.0;
        // Touches (gestures.cee): while fingers make gestures, they make the pointer too.
        this.pressCancelled = false;
        let touched = this.takeTouches(mut platform);
        let pointer = this.touchPointer(given, touched);
        this.pointerState = pointer;
        // Input this frame: the frame after it must run too, as hovers and focus settle a frame later.
        this.inputSeen =
            touched || pointer.pressed || pointer.released || pointer.secondaryPressed || pointer.wheel.x != 0.0 ||
                pointer.wheel.y != 0.0 || pointer.position.x != this.lastPointer.x ||
                pointer.position.y != this.lastPointer.y || this.keysPressed != 0 || this.keysRepeated != 0;
        this.lastPointer = pointer.position;
        this.chars.clear();
        this.charRead = 0;
        loop {
            let c = platform.nextChar();
            if (c == 0 || !this.chars.push(c)) {
                break;
            }
        }
        this.inputSeen = this.inputSeen || this.chars.length() > 0;
        this.focusables.clear();
        this.commands = 0;
        this.pastedLength = 0;
        this.hasCopied = false;
        this.copiedLength = 0;
        this.wantsText = false;
        this.textKind = TextKind.Text;
        this.returnKeyFace = ReturnKey.Done;
        this.beginAccess();
        // Keystrokes to actions, through the key contexts around last frame's focused element.
        this.takeKeystrokes(mut platform);
        this.tree.hitTest(pointer.position);
        // The inspector reads the last frame's element under the pointer while the frame still holds it.
        this.inspectLastFrame();
        // Drags (drag.cee): one starting, moving or dropped, or files dragged from the system over the window.
        this.updateDrag(mut platform, pointer);

        // Clicks: an element is clicked when the pointer went down and came back up over it.
        this.clickedIds.clear();
        if (this.pressCancelled) {
            this.pressedIds.clear(); // a pan, pinch or long press took the finger: its lift is no click
        }
        if (pointer.pressed) {
            // A press soon after the last, near it, counts on (a double or triple click).
            let near = (pointer.position.x - this.lastPressAt.x).abs() <= 4.0 &&
                (pointer.position.y - this.lastPressAt.y).abs() <= 4.0;
            this.presses = if (near && this.clock - this.lastPressTime <= 0.4) this.presses + 1 else 1;
            this.lastPressTime = this.clock;
            this.lastPressAt = pointer.position;
            this.pressedIds.clear();
            for (i in 0..this.tree.pointerOverCount()) {
                this.pressedIds.push(this.tree.pointerOverAt(i));
            }
        }
        if (pointer.released && !this.drag.active) {
            for (i in 0..this.pressedIds.length()) {
                let id = this.pressedIds.get(i);
                if (this.tree.isPointerOver(id)) {
                    this.clickedIds.push(id);
                }
            }
            this.pressedIds.clear();
        }

        let dt = this.frameDt;
        this.updateScrollContainers(pointer.wheel, dt);
        this.advanceFlings(dt);
        this.touchScrolling();
        this.animations.tick();
        this.cursorWanted = Cursor.Default;
        this.backWanted = false;
        this.screen = platform.screenSize();
        this.safe = platform.safeArea();
        this.keyboard = platform.keyboardInset();
        this.tree.begin(this.screen.w, this.screen.h);
    }

    /// Sends the frame's commands to a backend, in paint order.
    public fn render(borrow this, backend: borrow mut dyn Backend) {
        for (i in 0..this.tree.commandCount()) {
            let command = this.tree.command(i);
            backend.draw(command, this.tree.commandBytes(command));
        }
    }

    /// The command at `i` and its bytes (a text run's or a path's; empty otherwise), for `renderInto`.
    public fn commandCount(borrow this) -> usize => this.tree.commandCount();
    public fn commandAt(borrow this, i: usize) -> Command => this.tree.command(i);
    public fn textOf(borrow this, command: Command) -> Slice<u8> => this.tree.commandBytes(command);

    // ---- elements --------------------------------------------------------------------------------------------------

    /// Opens a container styled by `style`; its children follow until the matching `close`.
    public fn open(borrow mut this, style: Style) {
        this.openDepth += 1;
        let id = this.tree.idFor(style.elementId);
        var decl = style.base;
        applyProps(mut decl, style.props);
        // The responsive variants, smallest first, each from its width up; then the states, as Tailwind orders them.
        let widths = [SCREEN_SM, SCREEN_MD, SCREEN_LG, SCREEN_XL, SCREEN_2XL];
        for (k in 0..5usize) {
            if (this.screen.w >= widths[k]) {
                match (style.screenProps[k]) {
                    Some(p) => { applyProps(mut decl, p); }
                    null => {}
                }
            }
        }
        let enabled = !style.disabledNow;
        let hovered = this.tree.isPointerOver(id);
        if (enabled && hovered) {
            match (style.hoverProps) {
                Some(p) => { applyProps(mut decl, p); }
                null => {}
            }
            if (this.pointerState.down) {
                match (style.activeProps) {
                    Some(p) => { applyProps(mut decl, p); }
                    null => {}
                }
            }
        }
        if (enabled && style.groupId != 0 && this.tree.isPointerOver(style.groupId)) {
            match (style.groupProps) {
                Some(p) => { applyProps(mut decl, p); }
                null => {}
            }
        }
        if (enabled && style.focused) {
            match (style.focusProps) {
                Some(p) => { applyProps(mut decl, p); }
                null => {}
            }
        }
        if (style.disabledNow) {
            match (style.disabledProps) {
                Some(p) => { applyProps(mut decl, p); }
                null => {}
            }
        }
        match (style.transitionSpec) {
            Some(spec) => {
                let dt = this.frameDt;
                this.animations.apply(id, spec, dt, mut decl);
            }
            null => {}
        }
        let scrolls = decl.clip.any() && style.props.scroll != null;
        if (scrolls) {
            decl.clip.childOffset = this.scrollOffsetFor(id, decl.clip, style.props.noDragScroll);
        }
        this.tree.open(style.elementId, decl);
        if (scrolls) {
            this.scrollBar(id); // its first child, floating over it
        }
        if (enabled && hovered) {
            match (style.props.cursor) {
                Some(c) => { this.cursorWanted = c; }
                null => {}
            }
        }
    }

    /// Closes the innermost open container.
    public fn close(borrow mut this) {
        this.leaveKeyContexts();
        this.closeAccess();
        this.openDepth -= 1;
        this.tree.close();
    }

    /// `open(style)`, then `body`, then `close()`: the block form of the C `Box(...) { ... }` macro.
    public fn nest(borrow mut this, style: Style, body: borrow mut fn(borrow mut Ui<r>)) {
        this.open(style);
        body(mut this);
        this.close();
    }

    /// A text leaf (Label).
    public fn label(borrow mut this, text: StringView, look: Text) {
        this.accessText(this.tree.idFor(0), text.bytes());
        this.tree.text(text.bytes(), look.config());
    }

    /// A paragraph of rich text: `utf8` in the looks of `styles`, one run after another (bytes past the last run, or
    /// past the 64th, in `look`). Alignment, wrapping, line height and line clamp are `look`'s; each run gives its
    /// bytes their font, size, colour and spacing. The runs wrap together and share a baseline on each line.
    public fn richLabel(borrow mut this, utf8: Slice<u8>, look: Text, styles: Slice<TextStyle>) {
        let base = look.config();
        var spans = [StyleSpan { length: 0, config: base }; 64];
        let n = styles.length.min(64);
        for (k in 0..n) {
            var c = styles[k].look.config();
            // The paragraph's settings stay the paragraph's.
            c.align = base.align;
            c.wrap = base.wrap;
            c.lineClamp = base.lineClamp;
            spans[k] = StyleSpan { length: styles[k].length, config: c };
        }
        this.accessText(this.tree.idFor(0), utf8);
        this.tree.richText(utf8, base, spans[0..n]);
    }

    /// An element styled by `style` that draws a vector path in its box, clipped to it: `encoded` is a
    /// `PathBuilder`'s bytes, in the box's points from its top-left (or in `look`'s view box).
    public fn path(borrow mut this, style: Style, encoded: Slice<u8>, look: PathLook) {
        this.open(style);
        this.tree.path(encoded, look);
        this.close();
    }

    /// A text leaf from UTF-8 bytes, such as a `TextWriter`'s output (LabelF with F()).
    public fn labelBytes(borrow mut this, utf8: Slice<u8>, look: Text) {
        this.accessText(this.tree.idFor(0), utf8);
        this.tree.text(utf8, look.config());
    }

    // ---- state queries ---------------------------------------------------------------------------------------------

    /// Whether the element named `name` is under the pointer (as of the last layout).
    public fn hovered(borrow this, name: StringView) -> bool => this.tree.isPointerOver(hashId(name));

    /// Whether it is hovered with the button down (Tailwind active:).
    public fn pressed(borrow this, name: StringView) -> bool => this.pointerState.down && this.hovered(name);

    /// Whether it was pressed and released under the pointer this frame.
    public fn clicked(borrow this, name: StringView) -> bool => this.clickedHash(hashId(name));

    public fn clickedHash(borrow this, id: u32) -> bool {
        if (this.accessPressed(id)) { // a screen reader's activation is a click
            return true;
        }
        for (i in 0..this.clickedIds.length()) {
            if (this.clickedIds.get(i) == id) {
                return true;
            }
        }
        return false;
    }

    public fn pointer(borrow this) -> Pointer => this.pointerState;

    // ---- keys, text and the clock (ceeui_platform.h's wrappers, as of this frame's `begin`) -------------------

    public fn keyDown(borrow this, k: Key) -> bool => (this.keysDown & (1u64 << (keyIndex(k) as u64))) != 0;
    /// Asks for the system's Back this frame (CeeSafe ADR 0233): while a frame asks, Back is `Key.Back`
    /// (`keyPressed(Key.Back)`), for going back a page; a frame that does not ask leaves it to the system, which leaves
    /// the app, as an app's first page should. Nothing on a system without a Back.
    public fn wantBack(borrow mut this) {
        this.backWanted = true;
    }

    public fn keyPressed(borrow this, k: Key) -> bool => (this.keysPressed & (1u64 << (keyIndex(k) as u64))) != 0;
    public fn keyRepeated(borrow this, k: Key) -> bool => (this.keysRepeated & (1u64 << (keyIndex(k) as u64))) != 0;
    /// Pressed or OS-repeated this frame.
    public fn keyHit(borrow this, k: Key) -> bool => this.keyPressed(k) || this.keyRepeated(k);
    public fn shiftDown(borrow this) -> bool => this.keyDown(Key.LeftShift) || this.keyDown(Key.RightShift);
    /// Whether the modifier that makes an arrow move by words is held: Option on macOS (where the secondary modifier
    /// is Command), Control elsewhere.
    public fn wordModifierDown(borrow this) -> bool =>
        if (this.secondaryIsCommand) this.keyDown(Key.LeftAlt) || this.keyDown(Key.RightAlt)
            else this.keyDown(Key.LeftControl) || this.keyDown(Key.RightControl);

    /// The next character typed this frame, or 0 (ClayWind_CharPressed: each is consumed once).
    public fn nextChar(borrow mut this) -> u32 {
        if (this.charRead >= this.chars.length()) {
            return 0;
        }
        let c = this.chars.get(this.charRead);
        this.charRead += 1;
        return c;
    }

    /// Whether `c` was typed this frame, without consuming it (ClayWind_KeyPressed on a letter key).
    public fn typed(borrow this, c: u32) -> bool {
        for (i in 0..this.chars.length()) {
            if (this.chars.get(i) == c) {
                return true;
            }
        }
        return false;
    }

    /// How many presses came in quick succession, this one included (2 for a double click, 3 for a triple).
    public fn pressCount(borrow this) -> u32 => this.presses;

    /// Seconds since start, from the platform (ClayWind_Time).
    public fn time(borrow this) -> f64 => this.clock;

    // ---- clicks, focus and capture (controls.h's helpers) ----------------------------------------------------------

    /// ClayWind_Clicked: the pointer is over element `id` and the primary button went down this frame.
    /// A screen reader's activation of it counts (access.cee).
    public fn pressedOn(borrow this, id: u32) -> bool =>
        (this.pointerState.pressed && this.tree.isPointerOver(id)) || this.accessPressed(id);

    /// The secondary (right) button went down over element `id` this frame.
    public fn secondaryPressedOn(borrow this, id: u32) -> bool =>
        this.pointerState.secondaryPressed && this.tree.isPointerOver(id);

    /// The primary button came up away from element `id`, which is not capturing a drag: a click or a tap elsewhere
    /// has ended. A text field leaves on this and not on the press, so that what was tapped (a Send button beside
    /// it) is still where it was when the tap ends: on a phone the keyboard goes with the focus, and the page moves.
    public fn releasedOutside(borrow this, id: u32) -> bool =>
        this.pointerState.released && this.activeId != id && !this.tree.isPointerOver(id);

    /// ClayWind_PressedOutside: the primary button went down over neither `a` nor `b` (0 = none).
    public fn pressedOutside(borrow this, a: u32, b: u32) -> bool {
        if (!this.pointerState.pressed) {
            return false;
        }
        let over = this.tree.isPointerOver(a) || (b != 0 && this.tree.isPointerOver(b));
        return !over;
    }

    /// Whether element `id` is under the pointer (as of the last layout).
    public fn overHash(borrow this, id: u32) -> bool => this.tree.isPointerOver(id);

    public fn hasFocus(borrow this, id: u32) -> bool => this.focusedId != 0 && this.focusedId == id;

    /// Controls: whether control `id` has the focus and was activated from the keyboard this frame, by Enter or Space,
    /// as a native button, checkbox or radio button is.
    public fn activatedByKey(borrow this, id: u32) -> bool =>
        this.hasFocus(id) && (this.keyPressed(Key.Enter) || this.typed(32));
    public fn hasFocusNamed(borrow this, name: StringView) -> bool => this.hasFocus(hashId(name));
    public fn setFocus(borrow mut this, id: u32) {
        this.focusedId = id;
        this.leavingId = 0; // focused again in the frame it was to leave (a Send button that keeps the field)
    }

    /// Element `id` gives up the focus at the end of this frame, unless `setFocus` is called before then. Until
    /// then it is focused as before, so the frame reports what a focused field reports (its caret, its keyboard):
    /// a field left and focused again in one frame never loses the soft keyboard for a moment.
    public fn leaveFocus(borrow mut this, id: u32) {
        this.leavingId = id;
    }
    public fn clearFocus(borrow mut this) {
        this.focusedId = 0;
    }
    public fn focused(borrow this) -> u32 => this.focusedId;

    /// The control capturing a drag (ClayWind_activeId); 0 = none.
    public fn captured(borrow this) -> u32 => this.activeId;
    public fn capture(borrow mut this, id: u32) {
        this.activeId = id;
    }

    /// Captures `id` and keeps `anchor` with it: how far from what it drags it was taken hold of, so that the drag
    /// keeps that distance (a column's edge, grabbed a few points from it).
    fn captureWith(borrow mut this, id: u32, anchor: f32) {
        this.activeId = id;
        this.anchor = anchor;
    }

    /// The anchor the captured control kept (captureWith).
    fn captureAnchor(borrow this) -> f32 => this.anchor;

    /// ClayWind_RegisterFocusable: `id` takes part in Tab cycling this frame.
    public fn registerFocusable(borrow mut this, id: u32) {
        this.focusables.push(id);
        if (id == this.focusedId && id != 0) {
            this.noteFocusContexts();
        }
    }

    /// The box element `id` had in the last laid-out frame.
    public fn boxOfHash(borrow this, id: u32) -> Rect? => this.tree.boxOf(id);

    /// The frame delta the transitions advance by, in seconds.
    public fn frameTime(borrow this) -> f32 => this.frameDt;

    public fn screenSize(borrow this) -> Dims => this.screen;

    /// How far the system covers the screen from each edge this frame (Platform.safeArea): none on a desktop. The
    /// root still fills the screen; `Style.safe(ui.safeArea())` keeps an element's content inside.
    public fn safeArea(borrow this) -> Insets => this.safe;

    /// How much of the screen's bottom the soft keyboard covers this frame (Platform.keyboardInset): none without one.
    public fn keyboardInset(borrow this) -> f32 => this.keyboard;

    /// The safe area with the soft keyboard: its bottom is the larger of the safe area's and the keyboard's, so a
    /// page laid out by it keeps its content, and a field at its foot, above the keyboard while one shows.
    public fn safeAreaWithKeyboard(borrow this) -> Insets => Insets {
        left: this.safe.left,
        top: this.safe.top,
        right: this.safe.right,
        bottom: this.safe.bottom.max(this.keyboard),
    };

    /// The screen's width as a size class: compact below COMPACT_WIDTH (a phone held upright).
    public fn widthClass(borrow this) -> SizeClass =>
        if (this.screen.w < COMPACT_WIDTH) SizeClass.Compact else SizeClass.Regular;

    /// The screen's height as a size class: compact below COMPACT_HEIGHT (a phone on its side).
    public fn heightClass(borrow this) -> SizeClass =>
        if (this.screen.h < COMPACT_HEIGHT) SizeClass.Compact else SizeClass.Regular;

    /// The widest breakpoint the window's width reaches.
    public fn breakpoint(borrow this) -> Breakpoint {
        let w = this.screen.w;
        if (w >= SCREEN_2XL) {
            return Breakpoint.Xxl;
        }
        if (w >= SCREEN_XL) {
            return Breakpoint.Xl;
        }
        if (w >= SCREEN_LG) {
            return Breakpoint.Lg;
        }
        if (w >= SCREEN_MD) {
            return Breakpoint.Md;
        }
        if (w >= SCREEN_SM) {
            return Breakpoint.Sm;
        }
        return Breakpoint.Base;
    }

    /// Whether the window is at least as wide as breakpoint `b`: what builds an element only from a width up, as
    /// Tailwind's `hidden md:block` shows it (`if (ui.atLeast(Breakpoint.Md)) { sidebar(ui); }`).
    public fn atLeast(borrow this, b: Breakpoint) -> bool => this.screen.w >= screenFrom(b);

    /// Dark mode (ClayWind_darkMode) and THEME(dark, light).
    public fn setDarkMode(borrow mut this, on: bool) {
        this.darkMode = on;
    }
    public fn isDarkMode(borrow this) -> bool => this.darkMode;
    public fn theme(borrow this, dark: u32, light: u32) -> u32 => if (this.darkMode) dark else light;

    /// A control's colour in the theme: `dark`, a colour as the dark theme draws it, as it is in the dark theme, and
    /// in the light one a slate turned over (50 and 950, 100 and 900, ... 400 and 600; 500 stays), so a surface that
    /// was dark is light and its ink dark. Other colours (the blues, white) are the same in both.
    public fn tone(borrow this, dark: u32) -> u32 => if (this.darkMode) dark else lightSlate(dark);

    /// @container: the size the element named `name` had on the previous frame (0 before its first layout).
    public fn containerSize(borrow this, name: StringView) -> Dims {
        return match (this.tree.boxOf(hashId(name))) {
            Some(b) => Dims { w: b.w, h: b.h },
            null => Dims { w: 0.0, h: 0.0 },
        };
    }
    public fn containerWidth(borrow this, name: StringView) -> f32 => this.containerSize(name).w;
    public fn containerHeight(borrow this, name: StringView) -> f32 => this.containerSize(name).h;

    /// The laid-out box of an element in the last frame.
    public fn boxOf(borrow this, name: StringView) -> Rect? => this.tree.boxOf(hashId(name));

    /// The engine, for render commands and anything this layer does not wrap.
    public fn layout(borrow this) -> borrow(this) LayoutTree<r> => borrow this.tree;

    // ---- scrolling -------------------------------------------------------------------------------------------------

    /// The scroll offset of the container named `name` (0, 0 if it is not one).
    public fn scrollOffset(borrow this, name: StringView) -> Vec2 => this.scrollOffsetHash(hashId(name));

    /// The scroll offset of the container whose id hashes to `id`.
    fn scrollOffsetHash(borrow this, id: u32) -> Vec2 {
        return match (this.scrollSlot(id)) {
            Some(k) => this.scrolls.items[k].position,
            null => Vec2.zero(),
        };
    }

    /// ScrollContainerByY / ByX: moves by a delta, clamped to the content.
    public fn scrollBy(borrow mut this, name: StringView, dx: f32, dy: f32) {
        this.scrollByHash(hashId(name), dx, dy);
    }

    fn scrollByHash(borrow mut this, id: u32, dx: f32, dy: f32) {
        match (this.scrollSlot(id)) {
            Some(k) => {
                let s = this.scrolls.items[k];
                let minX = -(s.content.w - s.size.w).max(0.0);
                let minY = -(s.content.h - s.size.h).max(0.0);
                this.scrolls.items[k].position = Vec2 {
                    x: (s.position.x + dx).max(minX).min(0.0),
                    y: (s.position.y + dy).max(minY).min(0.0),
                };
            }
            null => {}
        }
    }

    /// Scrolls panel `name` as little as brings its content's rows from `top` to `bottom` (points from the content's
    /// top) into sight; when they are taller than the panel, their top. Not clamped to the content now, which may
    /// have grown this frame (a line typed): the next frame clamps it to the content then laid out.
    public fn scrollIntoView(borrow mut this, name: StringView, top: f32, bottom: f32) {
        match (this.scrollSlot(hashId(name))) {
            Some(k) => {
                let s = this.scrolls.items[k];
                let shownTop = -s.position.y;
                var wanted = shownTop;
                if (bottom > shownTop + s.size.h) {
                    wanted = bottom - s.size.h;
                }
                if (top < wanted) {
                    wanted = top;
                }
                if (wanted != shownTop) {
                    this.scrolls.items[k].position.y = -wanted.max(0.0);
                    this.requestFrame();
                }
            }
            null => {}
        }
    }

    /// ScrollContainerTop.
    public fn scrollToTop(borrow mut this, name: StringView) {
        match (this.scrollSlot(hashId(name))) {
            Some(k) => { this.scrolls.items[k].position.y = 0.0; }
            null => {}
        }
    }

    /// ScrollContainerBottom. Scrolls to the end of the content as the last frame measured it, and again after this
    /// frame's layout, to the end of what this frame put in it: content added in the same frame (a message just
    /// sent) is not left below the view. The second move shows in the next frame, which it asks for.
    public fn scrollToBottom(borrow mut this, name: StringView) {
        match (this.scrollSlot(hashId(name))) {
            Some(k) => {
                let s = this.scrolls.items[k];
                this.scrolls.items[k].position.y = -(s.content.h - s.size.h).max(0.0);
                this.scrolls.items[k].toBottom = true;
            }
            null => {}
        }
    }

    /// A scroll panel's vertical scroll bar, while its content is taller than it: a thumb along its right edge, as long
    /// as the share of the content shown and as far down as it is scrolled, from the last frame's layout. Dragging the
    /// thumb scrolls the panel; it floats over the content (z 50: under menus, popups and a title bar).
    fn scrollBar(borrow mut this, id: u32) {
        let k = match (this.scrollSlot(id)) {
            Some(k) => k,
            null => { return; }
        };
        let s = this.scrolls.items[k];
        let range = s.content.h - s.size.h;
        let track = s.area.h;
        if (!s.vertical || range <= 0.5 || track < 24.0) {
            if (this.thumbDrag == id) {
                this.thumbDrag = 0;
            }
            return;
        }
        let length = (track * s.size.h / s.content.h).max(24.0).min(track);
        let thumb = id ^ 0x5C0B0A75u32; // the thumb's id, the panel's own mixed
        let p = this.pointerState;
        if (this.thumbDrag == id) {
            if (p.down) {
                let top = (p.position.y - this.thumbGrab - s.area.y).max(0.0).min(track - length);
                this.scrolls.items[k].position.y = -(top / (track - length).max(1.0)) * range;
                this.requestFrame();
            } else {
                this.thumbDrag = 0;
            }
        }
        let shown = (-this.scrolls.items[k].position.y / range).max(0.0).min(1.0);
        let top = s.area.y + shown * (track - length);
        if (this.thumbDrag == 0 && this.pressedOn(thumb)) {
            this.thumbDrag = id;
            this.thumbGrab = p.position.y - top;
        }
        let active = this.thumbDrag == id || this.tree.isPointerOver(thumb);
        this.open(
            Style.box().idHash(thumb).fixed().left(s.area.x + s.area.w - 9.0).top(top).z(50).w(Size.fixed(7.0)).h(
                Size.fixed(length),
            ).rounded(Radius.Full).bg(withAlpha(this.tone(SLATE_400), if (active) 200 else 110)),
        );
        this.close();
    }

    fn scrollSlot(borrow this, id: u32) -> usize? {
        for (k in 0..this.scrolls.length()) {
            if (this.scrolls.items[k].id == id) {
                return k;
            }
        }
        return null;
    }

    /// The child offset for a scroll container being declared (Clay_GetScrollOffset), creating its state.
    fn scrollOffsetFor(borrow mut this, id: u32, clip: Clip, noDrag: bool) -> Vec2 {
        match (this.scrollSlot(id)) {
            Some(k) => {
                this.scrolls.items[k].openThisFrame = true;
                this.scrolls.items[k].noDrag = noDrag;
                this.scrolls.items[k].horizontal = clip.horizontal;
                this.scrolls.items[k].vertical = clip.vertical;
                return this.scrolls.items[k].position;
            }
            null => {
                let fresh = ScrollState {
                    id: id,
                    position: Vec2.zero(),
                    momentum: Vec2.zero(),
                    scrollOrigin: Vec2 { x: -1.0, y: -1.0 },
                    pointerOrigin: Vec2.zero(),
                    pointerActive: false,
                    momentumTime: 0.0,
                    fling: Vec2.zero(),
                    content: Dims { w: 0.0, h: 0.0 },
                    size: Dims { w: 0.0, h: 0.0 },
                    area: Rect.zero(),
                    horizontal: clip.horizontal,
                    vertical: clip.vertical,
                    openThisFrame: true,
                    noDrag: noDrag,
                    toBottom: false,
                };
                this.scrolls.push(fresh);
                return Vec2.zero();
            }
        }
    }

    /// Clay_UpdateScrollContainers with drag scrolling enabled: momentum, then wheel and drag on the deepest
    /// hovered scroll container.
    fn updateScrollContainers(borrow mut this, wheel: Vec2, dt: f32) {
        // Fingers scroll by their pan (gestures.cee), not by Clay's drag of a pressed pointer; nor does a drag of a
        // scroll bar's thumb drag its panel (`scrollBar` moves it).
        let pointerActive = this.pointerState.down && !this.touchDriven && this.thumbDrag == 0;
        var best: usize? = null;
        var bestDepth: usize = 0;
        for (k in 0..this.scrolls.length()) {
            this.scrolls.items[k].openThisFrame = false;
            var s = this.scrolls.items[k];
            if (this.thumbDrag == s.id) {
                s.pointerActive = false; // the thumb's drag, not the panel's: no fling from it when let go
                s.momentum = Vec2.zero();
            }
            if (!pointerActive && s.pointerActive) {
                let xDiff = s.position.x - s.scrollOrigin.x;
                if (xDiff < -10.0 || xDiff > 10.0) {
                    s.momentum.x = xDiff / (s.momentumTime * 25.0);
                }
                let yDiff = s.position.y - s.scrollOrigin.y;
                if (yDiff < -10.0 || yDiff > 10.0) {
                    s.momentum.y = yDiff / (s.momentumTime * 25.0);
                }
                s.pointerActive = false;
                s.pointerOrigin = Vec2.zero();
                s.scrollOrigin = Vec2.zero();
                s.momentumTime = 0.0;
            }
            let scrolled = wheel.x != 0.0 || wheel.y != 0.0;
            s.position.x += s.momentum.x;
            s.momentum.x *= 0.95;
            if ((s.momentum.x > -0.1 && s.momentum.x < 0.1) || scrolled) {
                s.momentum.x = 0.0;
            }
            s.position.x = s.position.x.max(-(s.content.w - s.size.w).max(0.0)).min(0.0);
            s.position.y += s.momentum.y;
            s.momentum.y *= 0.95;
            if ((s.momentum.y > -0.1 && s.momentum.y < 0.1) || scrolled) {
                s.momentum.y = 0.0;
            }
            s.position.y = s.position.y.max(-(s.content.h - s.size.h).max(0.0)).min(0.0);
            this.scrolls.items[k] = s;
            // The deepest scroll container under the pointer gets the wheel and the drag.
            for (j in 0..this.tree.pointerOverCount()) {
                if (this.tree.pointerOverAt(j) == s.id && (best == null || j >= bestDepth)) {
                    best = k;
                    bestDepth = j;
                }
            }
        }
        match (best) {
            Some(k) => {
                var s = this.scrolls.items[k];
                let canV = s.vertical && s.content.h > s.size.h;
                let canH = s.horizontal && s.content.w > s.size.w;
                if (canV) {
                    s.position.y += wheel.y * 10.0;
                }
                if (canH) {
                    s.position.x += wheel.x * 10.0;
                }
                if (pointerActive && !s.noDrag) {
                    s.momentum = Vec2.zero();
                    let p = this.pointerState.position;
                    if (!s.pointerActive) {
                        s.pointerOrigin = p;
                        s.scrollOrigin = s.position;
                        s.pointerActive = true;
                    } else {
                        var dx: f32 = 0.0;
                        var dy: f32 = 0.0;
                        if (canH) {
                            let old = s.position.x;
                            s.position.x = (s.scrollOrigin.x + (p.x - s.pointerOrigin.x)).min(0.0).max(
                                -(s.content.w - s.area.w),
                            );
                            dx = s.position.x - old;
                        }
                        if (canV) {
                            let old = s.position.y;
                            s.position.y = (s.scrollOrigin.y + (p.y - s.pointerOrigin.y)).min(0.0).max(
                                -(s.content.h - s.area.h),
                            );
                            dy = s.position.y - old;
                        }
                        if (dx > -0.1 && dx < 0.1 && dy > -0.1 && dy < 0.1 && s.momentumTime > 0.15) {
                            s.momentumTime = 0.0;
                            s.pointerOrigin = p;
                            s.scrollOrigin = s.position;
                        } else {
                            s.momentumTime += dt;
                        }
                    }
                }
                if (canV) {
                    s.position.y = s.position.y.min(0.0).max(-(s.content.h - s.size.h));
                }
                if (canH) {
                    s.position.x = s.position.x.min(0.0).max(-(s.content.w - s.size.w));
                }
                this.scrolls.items[k] = s;
            }
            null => {}
        }
    }
}

/// Ending the frame and rendering it, generic over the text metrics and the backend.
impl<region r> Ui<r> {
    /// Sends the frame's commands to any backend.
    public fn renderInto<B: Backend>(borrow this, backend: borrow mut B) {
        for (i in 0..this.commandCount()) {
            let command = this.commandAt(i);
            backend.draw(command, this.textOf(command));
        }
    }

    /// Ends the frame: lays out, keeps what scrolling needs, and shows the cursor the hovered elements asked for.
    /// Err when the frame does not fit the Ui's capacity: it then has no commands, and a host keeps the last frame
    /// it drew rather than draw this one.
    public fn endFrame<M: TextMetrics>(
        borrow mut this,
        platform: borrow mut dyn Platform,
        metrics: borrow M,
    ) -> Result<void, AllocError> {
        if (this.leavingId != 0) {
            if (this.focusedId == this.leavingId) {
                this.focusedId = 0;
            }
            this.leavingId = 0;
        }
        this.endTextFocus();
        this.drawInspector();
        let result = this.tree.endLayout(metrics);
        // Scroll containers that were declared this frame record their size and content; the rest go away.
        var k: usize = 0;
        while (k < this.scrolls.length()) {
            let state = this.scrolls.items[k];
            if (!state.openThisFrame) {
                let last = this.scrolls.length() - 1;
                this.scrolls.items[k] = this.scrolls.items[last];
                this.scrolls.pop();
                continue;
            }
            match (this.tree.scrollExtent(state.id)) {
                Some(e) => {
                    this.scrolls.items[k].size = e.size;
                    this.scrolls.items[k].content = e.content;
                    this.scrolls.items[k].area = e.area;
                    if (state.toBottom) {
                        let end = -(e.content.h - e.size.h).max(0.0);
                        if (end != this.scrolls.items[k].position.y) {
                            this.scrolls.items[k].position.y = end;
                            this.requestFrame();
                        }
                    }
                }
                null => {}
            }
            this.scrolls.items[k].toBottom = false;
            k += 1;
        }
        platform.setCursor(this.cursorWanted);
        platform.setBackWanted(this.backWanted);
        // ClayWind_EndControls: Tab / Shift-Tab move focus through the controls registered this frame.
        let count = this.focusables.length();
        if (this.keyPressed(Key.Tab) && count > 0) {
            var index: usize? = null;
            for (i in 0..count) {
                if (this.focusables.get(i) == this.focusedId) {
                    index = i;
                    break;
                }
            }
            let back = this.shiftDown();
            let next = match (index) {
                Some(i) => if (back) (i + count - 1) % count else (i + 1) % count,
                null => if (back) count - 1 else 0,
            };
            this.focusedId = this.focusables.get(next);
        }
        return result;
    }
}
