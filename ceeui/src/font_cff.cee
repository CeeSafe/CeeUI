// SPDX-License-Identifier: MIT
// CFF outlines (OpenType fonts with a 'CFF ' table: Hiragino, Noto CJK, many .otf fonts): the Compact Font Format's
// INDEXes and DICTs, CID-keyed fonts' per-glyph Private DICTs (FDArray, FDSelect), and Type 2 charstrings run into
// the same outline as glyf's (font units, y flipped). Hints are counted but not applied. CFF2 is not read.

/// Where a CFF table's parts are, from its Top DICT (offsets in the font file).
struct CffInfo {
    charStrings: usize;
    globalSubrs: usize;
    /// The Private DICT's Subrs INDEX (not CID-keyed), or 0.
    localSubrs: usize;
    /// CID-keyed: the FDArray INDEX and FDSelect, or 0.
    fdArray: usize;
    fdSelect: usize;
}

/// An INDEX at `o`: its count, the offset its offsets are relative to (minus 1), its offset size, and its end.
struct CffIndex {
    count: usize;
    offsets: usize;
    offSize: usize;
    data: usize;
    end: usize;
}

fn cffOffset(d: Slice<u8>, at: usize, size: usize) -> usize {
    var v: usize = 0;
    for (k in 0..size) {
        v = (v << 8) | (d[at + k] as usize);
    }
    return v;
}

fn cffIndex(d: Slice<u8>, o: usize) -> CffIndex? {
    if (!valid(d, o, 2)) {
        return null;
    }
    let count = u16at(d, o) as usize;
    if (count == 0) {
        return CffIndex { count: 0, offsets: o + 2, offSize: 1, data: o + 2, end: o + 2 };
    }
    if (!valid(d, o, 3)) {
        return null;
    }
    let offSize = u8at(d, o + 2) as usize;
    if (offSize < 1 || offSize > 4 || !valid(d, o + 3, (count + 1) * offSize)) {
        return null;
    }
    let offsets = o + 3;
    let data = offsets + (count + 1) * offSize - 1;
    let end = data + cffOffset(d, offsets + count * offSize, offSize);
    if (end > d.length) {
        return null;
    }
    return CffIndex { count: count, offsets: offsets, offSize: offSize, data: data, end: end };
}

/// Item `i` of an INDEX: [start, end) in the file, or null.
fn cffItem(d: Slice<u8>, ix: CffIndex, i: usize) -> [usize; 2]? {
    if (i >= ix.count) {
        return null;
    }
    let a = ix.data + cffOffset(d, ix.offsets + i * ix.offSize, ix.offSize);
    let b = ix.data + cffOffset(d, ix.offsets + (i + 1) * ix.offSize, ix.offSize);
    if (a > b || b > d.length) {
        return null;
    }
    return [a, b];
}

/// The operands of DICT operator `op` (`op` >= 1200 for an escaped one, 1200 + the second byte) in [start, end):
/// up to two integers (reals read as 0), or null when it is not there.
fn cffDict(d: Slice<u8>, start: usize, end: usize, op: u32) -> [i32; 2]? {
    var stack = [0i32; 48];
    var sp: usize = 0;
    var i = start;
    while (i < end) {
        let b = u8at(d, i);
        if (b <= 21) {
            var key = b;
            i += 1;
            if (b == 12) {
                if (i >= end) {
                    return null;
                }
                key = 1200 + u8at(d, i);
                i += 1;
            }
            if (key == op) {
                return [if (sp > 0) stack[0] else 0, if (sp > 1) stack[1] else 0];
            }
            sp = 0;
            continue;
        }
        var v: i32 = 0;
        if (b == 28 && i + 2 < end) {
            v = i16at(d, i + 1);
            i += 3;
        } else if (b == 29 && i + 4 < end) {
            v = truncate<i32>(u32at(d, i + 1));
            i += 5;
        } else if (b == 30) {
            i += 1; // a real: nibbles to a 0xF
            while (i < end) {
                let n = u8at(d, i);
                i += 1;
                if ((n & 0x0F) == 0x0F || (n >> 4) == 0x0F) {
                    break;
                }
            }
        } else if (b >= 32 && b <= 246) {
            v = truncate<i32>(b) - 139;
            i += 1;
        } else if (b >= 247 && b <= 250 && i + 1 < end) {
            v = (truncate<i32>(b) - 247) * 256 + truncate<i32>(u8at(d, i + 1)) + 108;
            i += 2;
        } else if (b >= 251 && b <= 254 && i + 1 < end) {
            v = 0 - (truncate<i32>(b) - 251) * 256 - truncate<i32>(u8at(d, i + 1)) - 108;
            i += 2;
        } else {
            return null;
        }
        if (sp < 48) {
            stack[sp] = v;
            sp += 1;
        }
    }
    return null;
}

/// The Subrs INDEX of the Private DICT at [`at`, `at` + `size`), or 0.
fn cffPrivateSubrs(d: Slice<u8>, at: usize, size: usize) -> usize {
    if (size == 0 || !valid(d, at, size)) {
        return 0;
    }
    return match (cffDict(d, at, at + size, 19)) {
        Some(v) => if (v[0] > 0) at + truncate<usize>(v[0]) else 0,
        null => 0,
    };
}

/// A CFF table at `cff`'s parts, or null when it is not a usable CFF (version 1) table.
fn parseCff(d: Slice<u8>, cff: usize) -> CffInfo? {
    if (!valid(d, cff, 4) || u8at(d, cff) != 1) {
        return null;
    }
    let names = cffIndex(d, cff + (u8at(d, cff + 2) as usize))?;
    let tops = cffIndex(d, names.end)?;
    let strings = cffIndex(d, tops.end)?;
    let globals = cffIndex(d, strings.end)?;
    let top = cffItem(d, tops, 0)?;
    let cs = cffDict(d, top[0], top[1], 17)?;
    if (cs[0] <= 0) {
        return null;
    }
    var info = CffInfo {
        charStrings: cff + truncate<usize>(cs[0]),
        globalSubrs: strings.end,
        localSubrs: 0,
        fdArray: 0,
        fdSelect: 0,
    };
    match (cffDict(d, top[0], top[1], 1236)) { // FDArray: CID-keyed
        Some(fa) => {
            let fs = cffDict(d, top[0], top[1], 1237)?;
            info.fdArray = cff + truncate<usize>(fa[0]);
            info.fdSelect = cff + truncate<usize>(fs[0]);
        }
        null => {
            match (cffDict(d, top[0], top[1], 18)) { // Private: size, offset
                Some(p) => {
                    if (p[0] > 0 && p[1] > 0) {
                        info.localSubrs = cffPrivateSubrs(d, cff + truncate<usize>(p[1]), truncate<usize>(p[0]));
                    }
                }
                null => {}
            }
        }
    }
    // The Global Subrs INDEX follows the String INDEX.
    info.globalSubrs = strings.end;
    let ignored = globals.count;
    return info;
}

/// The local Subrs of glyph `glyph`: the Private DICT's, or for a CID-keyed font its Font DICT's (FDSelect).
fn cffLocalSubrs(d: Slice<u8>, cff: usize, info: CffInfo, glyph: u32) -> usize {
    if (info.fdArray == 0) {
        return info.localSubrs;
    }
    let s = info.fdSelect;
    if (!valid(d, s, 1)) {
        return 0;
    }
    var fd: usize = 0;
    let format = u8at(d, s);
    if (format == 0) {
        if (!valid(d, s + 1 + (glyph as usize), 1)) {
            return 0;
        }
        fd = u8at(d, s + 1 + (glyph as usize)) as usize;
    } else if (format == 3) {
        if (!valid(d, s, 5)) {
            return 0;
        }
        let ranges = u16at(d, s + 1) as usize;
        if (!valid(d, s + 3, ranges * 3 + 2)) {
            return 0;
        }
        var found = false;
        for (r in 0..ranges) {
            let first = u16at(d, s + 3 + r * 3);
            let next = u16at(d, s + 3 + (r + 1) * 3);
            if (glyph >= first && glyph < next) {
                fd = u8at(d, s + 5 + r * 3) as usize;
                found = true;
                break;
            }
        }
        if (!found) {
            return 0;
        }
    } else {
        return 0;
    }
    let fds = match (cffIndex(d, info.fdArray)) {
        Some(x) => x,
        null => { return 0; }
    };
    let dict = match (cffItem(d, fds, fd)) {
        Some(x) => x,
        null => { return 0; }
    };
    return match (cffDict(d, dict[0], dict[1], 18)) {
        Some(p) => if (p[0] > 0 && p[1] > 0) cffPrivateSubrs(
            d,
            cff + truncate<usize>(p[1]),
            truncate<usize>(p[0]),
        ) else 0,
        null => 0,
    };
}

/// The bias a Type 2 subroutine number is stored with, for an INDEX of `count` subroutines.
fn cffBias(count: usize) -> i32 => if (count < 1240) 107 else if (count < 33900) 1131 else 32768;

/// A Type 2 charstring's running state.
struct Charstring {
    stack: [f32; 48];
    sp: usize;
    x: f32;
    y: f32;
    stems: usize;
    /// Whether the first stack-clearing operator (which may carry the advance width first) has run.
    widthDone: bool;
    open: bool;
    ox: f32;
    oy: f32;
    ended: bool;
}

impl Charstring {
    /// The operands of a stack-clearing operator that takes `even` (true: an even count; false: `n`) arguments:
    /// the index of the first, past a leading width when there is one.
    fn first(borrow mut this, takes: usize, even: bool) -> usize {
        var skip: usize = 0;
        if (!this.widthDone) {
            this.widthDone = true;
            if ((even && this.sp % 2 == 1) || (!even && this.sp > takes)) {
                skip = 1;
            }
        }
        return skip;
    }

    fn moveTo(borrow mut this, out: borrow mut GlyphOutline) {
        if (this.open) {
            outlineOp(mut out, 3, 0.0, 0.0);
        }
        outlineOp(mut out, 0, this.ox + this.x, this.oy - this.y);
        this.open = true;
    }

    fn lineTo(borrow mut this, out: borrow mut GlyphOutline, dx: f32, dy: f32) {
        this.x += dx;
        this.y += dy;
        outlineOp(mut out, 1, this.ox + this.x, this.oy - this.y);
    }

    fn curveTo(borrow mut this, out: borrow mut GlyphOutline, a: f32, b: f32, c: f32, e: f32, f: f32, g: f32) {
        let x1 = this.x + a;
        let y1 = this.y + b;
        let x2 = x1 + c;
        let y2 = y1 + e;
        this.x = x2 + f;
        this.y = y2 + g;
        outlineCubic(
            mut out,
            this.ox + x1,
            this.oy - y1,
            this.ox + x2,
            this.oy - y2,
            this.ox + this.x,
            this.oy - this.y,
        );
    }

    fn close(borrow mut this, out: borrow mut GlyphOutline) {
        if (this.open) {
            outlineOp(mut out, 3, 0.0, 0.0);
            this.open = false;
        }
    }

    /// Runs the charstring at [start, end) of `d`; false on a malformed one.
    fn run(
        borrow mut this,
        d: Slice<u8>,
        start: usize,
        end: usize,
        globals: CffIndex,
        locals: CffIndex?,
        depth: u32,
        out: borrow mut GlyphOutline,
    ) -> bool {
        if (depth > 10) {
            return false;
        }
        var i = start;
        while (i < end && !this.ended) {
            let b = u8at(d, i);
            i += 1;
            if (b >= 32 || b == 28) {
                var v: f32 = 0.0;
                if (b == 28) {
                    if (i + 2 > end) {
                        return false;
                    }
                    v = round<f32>(i16at(d, i));
                    i += 2;
                } else if (b <= 246) {
                    v = round<f32>(truncate<i32>(b) - 139);
                } else if (b <= 250) {
                    if (i >= end) {
                        return false;
                    }
                    v = round<f32>((truncate<i32>(b) - 247) * 256 + truncate<i32>(u8at(d, i)) + 108);
                    i += 1;
                } else if (b <= 254) {
                    if (i >= end) {
                        return false;
                    }
                    v = round<f32>(0 - (truncate<i32>(b) - 251) * 256 - truncate<i32>(u8at(d, i)) - 108);
                    i += 1;
                } else {
                    if (i + 4 > end) {
                        return false;
                    }
                    v = round<f32>(truncate<i32>(u32at(d, i))) / 65536.0;
                    i += 4;
                }
                if (this.sp < 48) {
                    this.stack[this.sp] = v;
                    this.sp += 1;
                }
                continue;
            }
            let s = this.stack;
            let n = this.sp;
            if (b == 1 || b == 3 || b == 18 || b == 23) { // hstem, vstem, hstemhm, vstemhm
                let k = this.first(0, true);
                this.stems += (n - k) / 2;
                this.sp = 0;
            } else if (b == 19 || b == 20) { // hintmask, cntrmask: implicit vstems, then the mask's bytes
                let k = this.first(0, true);
                this.stems += (n - k) / 2;
                i += (this.stems + 7) / 8;
                this.sp = 0;
            } else if (b == 21) { // rmoveto
                let k = this.first(2, false);
                if (n < k + 2) {
                    return false;
                }
                this.x += s[k];
                this.y += s[k + 1];
                this.moveTo(mut out);
                this.sp = 0;
            } else if (b == 22 || b == 4) { // hmoveto, vmoveto
                let k = this.first(1, false);
                if (n < k + 1) {
                    return false;
                }
                if (b == 22) {
                    this.x += s[k];
                } else {
                    this.y += s[k];
                }
                this.moveTo(mut out);
                this.sp = 0;
            } else if (b == 5) { // rlineto
                var k: usize = 0;
                while (k + 1 < n) {
                    this.lineTo(mut out, s[k], s[k + 1]);
                    k += 2;
                }
                this.sp = 0;
            } else if (b == 6 || b == 7) { // hlineto, vlineto: alternating
                var horizontal = b == 6;
                for (k in 0..n) {
                    if (horizontal) {
                        this.lineTo(mut out, s[k], 0.0);
                    } else {
                        this.lineTo(mut out, 0.0, s[k]);
                    }
                    horizontal = !horizontal;
                }
                this.sp = 0;
            } else if (b == 8) { // rrcurveto
                var k: usize = 0;
                while (k + 5 < n) {
                    this.curveTo(mut out, s[k], s[k + 1], s[k + 2], s[k + 3], s[k + 4], s[k + 5]);
                    k += 6;
                }
                this.sp = 0;
            } else if (b == 24) { // rcurveline
                var k: usize = 0;
                while (n >= 8 && k + 6 <= n - 2) {
                    this.curveTo(mut out, s[k], s[k + 1], s[k + 2], s[k + 3], s[k + 4], s[k + 5]);
                    k += 6;
                }
                if (k + 1 < n) {
                    this.lineTo(mut out, s[k], s[k + 1]);
                }
                this.sp = 0;
            } else if (b == 25) { // rlinecurve
                var k: usize = 0;
                while (n >= 8 && k + 2 <= n - 6) {
                    this.lineTo(mut out, s[k], s[k + 1]);
                    k += 2;
                }
                if (k + 5 < n) {
                    this.curveTo(mut out, s[k], s[k + 1], s[k + 2], s[k + 3], s[k + 4], s[k + 5]);
                }
                this.sp = 0;
            } else if (b == 26) { // vvcurveto
                var k: usize = 0;
                var dx1: f32 = 0.0;
                if (n % 2 == 1) {
                    dx1 = s[0];
                    k = 1;
                }
                while (k + 3 < n) {
                    this.curveTo(mut out, dx1, s[k], s[k + 1], s[k + 2], 0.0, s[k + 3]);
                    dx1 = 0.0;
                    k += 4;
                }
                this.sp = 0;
            } else if (b == 27) { // hhcurveto
                var k: usize = 0;
                var dy1: f32 = 0.0;
                if (n % 2 == 1) {
                    dy1 = s[0];
                    k = 1;
                }
                while (k + 3 < n) {
                    this.curveTo(mut out, s[k], dy1, s[k + 1], s[k + 2], s[k + 3], 0.0);
                    dy1 = 0.0;
                    k += 4;
                }
                this.sp = 0;
            } else if (b == 30 || b == 31) { // vhcurveto, hvcurveto: alternating, the last with an optional fifth
                var k: usize = 0;
                var vertical = b == 30;
                while (k + 3 < n) {
                    let last = if (n - k == 5) s[k + 4] else 0.0;
                    if (vertical) {
                        this.curveTo(mut out, 0.0, s[k], s[k + 1], s[k + 2], s[k + 3], last);
                    } else {
                        this.curveTo(mut out, s[k], 0.0, s[k + 1], s[k + 2], last, s[k + 3]);
                    }
                    vertical = !vertical;
                    k += 4;
                }
                this.sp = 0;
            } else if (b == 10 || b == 29) { // callsubr, callgsubr
                if (n == 0) {
                    return false;
                }
                this.sp -= 1;
                let ix = if (b == 29) globals else match (locals) {
                    Some(l) => l,
                    null => { return false; }
                };
                let k = truncate<i32>(s[n - 1]) + cffBias(ix.count);
                if (k < 0) {
                    return false;
                }
                let item = match (cffItem(d, ix, truncate<usize>(k))) {
                    Some(x) => x,
                    null => { return false; }
                };
                if (!this.run(d, item[0], item[1], globals, locals, depth + 1, mut out)) {
                    return false;
                }
            } else if (b == 11) { // return
                return true;
            } else if (b == 14) { // endchar
                let k = this.first(0, false);
                let ignored = k;
                this.close(mut out);
                this.ended = true;
                this.sp = 0;
            } else if (b == 12) {
                if (i >= end) {
                    return false;
                }
                let e = u8at(d, i);
                i += 1;
                if (e == 35 && n >= 12) { // flex
                    this.curveTo(mut out, s[0], s[1], s[2], s[3], s[4], s[5]);
                    this.curveTo(mut out, s[6], s[7], s[8], s[9], s[10], s[11]);
                } else if (e == 34 && n >= 7) { // hflex
                    this.curveTo(mut out, s[0], 0.0, s[1], s[2], s[3], 0.0);
                    this.curveTo(mut out, s[4], 0.0, s[5], 0.0 - s[2], s[6], 0.0);
                } else if (e == 36 && n >= 9) { // hflex1: back to the starting y
                    this.curveTo(mut out, s[0], s[1], s[2], s[3], s[4], 0.0);
                    this.curveTo(mut out, s[5], 0.0, s[6], s[7], s[8], 0.0 - (s[1] + s[3] + s[7]));
                } else if (e == 37 && n >= 11) { // flex1: the last point closes the larger travel's other axis
                    let dx = s[0] + s[2] + s[4] + s[6] + s[8];
                    let dy = s[1] + s[3] + s[5] + s[7] + s[9];
                    let horizontal = dx.abs() > dy.abs();
                    this.curveTo(mut out, s[0], s[1], s[2], s[3], s[4], s[5]);
                    this.curveTo(
                        mut out,
                        s[6],
                        s[7],
                        s[8],
                        s[9],
                        if (horizontal) s[10] else 0.0 - dx,
                        if (horizontal) 0.0 - dy else s[10],
                    );
                }
                this.sp = 0;
            } else {
                this.sp = 0; // an operator this does not draw with
            }
        }
        return true;
    }
}

/// Glyph `glyph` of the CFF table at `cff` (parsed as `info`), offset by (`ox`, `oy`) font units, into `out`.
fn decodeCffGlyph(
    d: Slice<u8>,
    cff: usize,
    info: CffInfo,
    glyph: u32,
    ox: f32,
    oy: f32,
    out: borrow mut GlyphOutline,
) -> bool {
    let charStrings = match (cffIndex(d, info.charStrings)) {
        Some(x) => x,
        null => { return false; }
    };
    let item = match (cffItem(d, charStrings, glyph as usize)) {
        Some(x) => x,
        null => { return true; }
    };
    let globals = match (cffIndex(d, info.globalSubrs)) {
        Some(x) => x,
        null => { return false; }
    };
    let localsAt = cffLocalSubrs(d, cff, info, glyph);
    let locals = if (localsAt != 0) cffIndex(d, localsAt) else null;
    var cs = Charstring {
        stack: [0.0f32; 48],
        sp: 0,
        x: 0.0,
        y: 0.0,
        stems: 0,
        widthDone: false,
        open: false,
        ox: ox,
        oy: oy,
        ended: false,
    };
    let ok = cs.run(d, item[0], item[1], globals, locals, 0, mut out);
    cs.close(mut out);
    return ok;
}
