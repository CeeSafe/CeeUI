// SPDX-License-Identifier: MIT
// A text field with a selection: the caret and the other end of the selection move by grapheme cluster (Shift with
// the arrows, Home and End extends it), the pointer places the caret and a drag selects, typing and Paste replace
// the selection, Copy and Cut take it, Select All takes everything, and an input method's composition shows at the
// caret, underlined, until it is committed.

/// A text field's caret and the other end of its selection, as byte offsets (equal when nothing is selected).
public struct TextEdit {
    public caret: usize;
    public anchor: usize;

    /// The caret at `offset`, nothing selected.
    public fn at(offset: usize) -> TextEdit => TextEdit { caret: offset, anchor: offset };

    /// Where the selection starts and ends.
    public fn from(this) -> usize => this.caret.min(this.anchor);
    public fn to(this) -> usize => this.caret.max(this.anchor);

    /// Whether anything is selected.
    public fn selects(this) -> bool => this.caret != this.anchor;
}

/// The field's text size, as textInputEx measures it.
const FIELD_TEXT: f32 = 18.0;

/// The grapheme boundary of `text` whose caret is nearest `x` points from its left edge (in right-to-left text the
/// carets run the other way, so every boundary is tried).
fn offsetAt<M: TextMetrics>(metrics: borrow M, text: Slice<u8>, x: f32) -> usize =>
    offsetAtIn(metrics, text, TextConfig.of(FIELD_TEXT), x);

/// offsetAt for text set in `config`.
fn offsetAtIn<M: TextMetrics>(metrics: borrow M, text: Slice<u8>, config: TextConfig, x: f32) -> usize {
    var best: usize = 0;
    var bestDistance = (metrics.caretX(text, config, 0) - x).abs();
    var at: usize = 0;
    while (at < text.length) {
        at = graphemeEnd(text, at);
        let distance = (metrics.caretX(text, config, at) - x).abs();
        if (distance < bestDistance) {
            best = at;
            bestDistance = distance;
        }
    }
    return best;
}

/// The segment between word boundaries (UAX #29) around byte `at` of `text`, which a double click selects: a word,
/// a run of spaces or a mark of punctuation; at the end, the one before.
fn wordAround(text: Slice<u8>, at: usize) -> [usize; 2] {
    if (text.length == 0) {
        return [0, 0];
    }
    let inside = if (at >= text.length) utf8Start(text, text.length) else at;
    let from = wordStart(text, inside);
    return [from, wordEnd(text, from)];
}

/// Where the caret goes from byte `at` of `text` a word forward: the end of the word it is in, or of the next one
/// (spaces and punctuation are passed over).
fn wordForward(text: Slice<u8>, at: usize) -> usize {
    var k = at;
    while (k < text.length) {
        let e = wordEnd(text, k);
        if (isWordLike(text, k, e)) {
            return e;
        }
        k = e;
    }
    return text.length;
}

/// Where the caret goes from byte `at` of `text` a word back: the start of the word it is in, or of the one before.
fn wordBackward(text: Slice<u8>, at: usize) -> usize {
    var k = at.min(text.length);
    while (k > 0) {
        let from = wordStart(text, utf8Start(text, k));
        if (isWordLike(text, from, k)) {
            return from;
        }
        k = from;
    }
    return 0;
}

/// Replaces the selection of `buf[0..len]` with the typeable characters of `utf8` (as far as they fit): the caret
/// after them, nothing selected. Whether anything changed.
fn replaceSelection(buf: SliceMut<u8>, len: borrow mut usize, edit: borrow mut TextEdit, utf8: Slice<u8>) -> bool {
    var changed = false;
    if (edit.selects()) {
        removeBytes(buf, mut len, edit.from(), edit.to());
        edit.caret = edit.from();
        changed = true;
    }
    var i: usize = 0;
    while (i < utf8.length) {
        let c = decodeUtf8(utf8, i);
        i += c[1] as usize;
        if (typeable(c[0])) {
            let at = edit.caret;
            let added = insertChar(buf, mut len, at, c[0]);
            if (added == 0) {
                break;
            }
            edit.caret += added;
            changed = true;
        }
    }
    edit.anchor = edit.caret;
    return changed;
}

/// The most a masked field shows: 340 dots.
const MASK_BYTES: usize = 1020;

/// What a masked field shows for `text`: a dot (U+2022, three bytes) for each grapheme cluster, into `dots`; the
/// bytes written.
fn maskInto(text: Slice<u8>, dots: borrow mut [u8; 1020]) -> usize {
    var n: usize = 0;
    var at: usize = 0;
    while (at < text.length && n + 3 <= MASK_BYTES) {
        at = graphemeEnd(text, at);
        dots[n] = 0xE2;
        dots[n + 1] = 0x80;
        dots[n + 2] = 0xA2;
        n += 3;
    }
    return n;
}

/// The place in a masked field's dots of byte `at` of its text.
fn maskedAt(text: Slice<u8>, at: usize) -> usize {
    var n: usize = 0;
    var i: usize = 0;
    while (i < at && i < text.length && n + 3 <= MASK_BYTES) {
        i = graphemeEnd(text, i);
        n += 3;
    }
    return n;
}

/// Where a caret at byte `at` of `text` is drawn, in points from the text's left edge: among the dots when masked.
fn fieldCaretX<M: TextMetrics>(metrics: borrow M, text: Slice<u8>, masked: bool, at: usize) -> f32 {
    let config = TextConfig.of(FIELD_TEXT);
    if (!masked) {
        return metrics.caretX(text, config, at);
    }
    var dots = [0u8; 1020];
    let n = maskInto(text, mut dots);
    return metrics.caretX(dots[0..n], config, maskedAt(text, at));
}

/// The grapheme boundary of `text` nearest `x` points from the text's left edge, as the field shows it.
fn fieldOffsetAt<M: TextMetrics>(metrics: borrow M, text: Slice<u8>, masked: bool, x: f32) -> usize {
    if (!masked) {
        return offsetAt(metrics, text, x);
    }
    var dots = [0u8; 1020];
    let n = maskInto(text, mut dots);
    var clusters = offsetAt(metrics, dots[0..n], x) / 3;
    var at: usize = 0;
    while (clusters > 0 && at < text.length) {
        at = graphemeEnd(text, at);
        clusters -= 1;
    }
    return at;
}

/// The grapheme boundary of `text` whose caret is the next one to the right (`right`) or left of the caret at
/// byte `at`, as the field shows them; `at` when none is. An arrow moves the caret across the screen, so in
/// right-to-left text Right goes back towards the text's start, and at the meeting of two runs it crosses to the
/// other run's near end. Of two carets at the same place, the one nearer `at` in the text is taken.
fn visualStep<M: TextMetrics>(metrics: borrow M, text: Slice<u8>, masked: bool, at: usize, right: bool) -> usize {
    let here = fieldCaretX(metrics, text, masked, at);
    var best = at;
    var bestAhead: f32 = 0.0;
    var b: usize = 0;
    loop {
        if (b != at) {
            let x = fieldCaretX(metrics, text, masked, b);
            let ahead = if (right) x - here else here - x;
            if (ahead > 0.25) {
                let nearer = (if (b > at) b - at else at - b) < (if (best > at) best - at else at - best);
                if (best == at || ahead < bestAhead - 0.25 || ((ahead - bestAhead).abs() <= 0.25 && nearer)) {
                    best = b;
                    bestAhead = ahead;
                }
            }
        }
        if (b >= text.length) {
            return best;
        }
        b = graphemeEnd(text, b);
    }
}

/// How far right of the field's text area its text starts: 0 for left-to-right text; for a right-to-left paragraph
/// (UAX #9 P2), the room left over, so its text sits at the right as it reads. `inner` is the text area's width
/// (last frame's box; 0 before the field was laid out).
fn fieldShift<M: TextMetrics>(metrics: borrow M, text: Slice<u8>, masked: bool, inner: f32) -> f32 {
    if (masked || inner <= 0.0 || !bidiParagraphRtl(text)) {
        return 0.0;
    }
    return (inner - metrics.measure(text, TextConfig.of(FIELD_TEXT)).w).max(0.0);
}

/// Where bytes [`from`, `to`) of `text` are drawn, as the field shows it (TextMetrics.spans; among the dots when
/// masked); how many spans went into `out`.
fn fieldSpans<M: TextMetrics>(
    metrics: borrow M,
    text: Slice<u8>,
    masked: bool,
    from: usize,
    to: usize,
    out: SliceMut<TextSpan>,
) -> usize {
    let config = TextConfig.of(FIELD_TEXT);
    if (!masked) {
        return metrics.spans(text, config, from, to, out);
    }
    var dots = [0u8; 1020];
    let n = maskInto(text, mut dots);
    return metrics.spans(dots[0..n], config, maskedAt(text, from), maskedAt(text, to), out);
}

impl Controls {
    /// ClayWind_TextField: a one-line text field with a selection (see TextEdit). The pointer places the caret and
    /// a drag selects; the arrows, Home and End move it (with Shift, extending the selection); Backspace and Delete
    /// remove the selection or a grapheme cluster; typing and Paste replace the selection; Copy, Cut and Select All
    /// act on it; Enter leaves the field. While it has focus it shows the input method's composition at the caret
    /// and reports the caret to the host (Ui.textInputArea). It measures text to place the caret, so it takes the
    /// text metrics.
    public fn textField<M: TextMetrics>(
        ui: borrow mut Ui,
        metrics: borrow M,
        id: StringView,
        buf: SliceMut<u8>,
        len: borrow mut usize,
        edit: borrow mut TextEdit,
    ) -> bool => Controls.textFieldOf(mut ui, metrics, id, buf, mut len, mut edit, false);

    /// A text field for a secret: it shows a dot for each character, gives nothing to Copy or Cut, selects
    /// everything on a double click (a word's ends would say where the spaces are), tells a screen reader only the
    /// dots, and asks a phone for the keyboard that neither learns nor suggests. An input method does not compose
    /// in it.
    public fn passwordField<M: TextMetrics>(
        ui: borrow mut Ui,
        metrics: borrow M,
        id: StringView,
        buf: SliceMut<u8>,
        len: borrow mut usize,
        edit: borrow mut TextEdit,
    ) -> bool => Controls.textFieldOf(mut ui, metrics, id, buf, mut len, mut edit, true);

    fn textFieldOf<M: TextMetrics>(
        ui: borrow mut Ui,
        metrics: borrow M,
        id: StringView,
        buf: SliceMut<u8>,
        len: borrow mut usize,
        edit: borrow mut TextEdit,
        masked: bool,
    ) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h);
        var changed = false;
        edit.caret = edit.caret.min(len);
        edit.anchor = edit.anchor.min(len);
        let padX = space(3.0);
        let padY = space(2.0);
        // The pointer: a press places the caret (Shift extends the selection), and a drag moves it.
        let p = ui.pointer();
        let box = ui.boxOfHash(h);
        if (ui.pressedOn(h)) {
            ui.setFocus(h);
            ui.capture(h);
            match (box) {
                Some(b) => {
                    let shift = fieldShift(metrics, buf[0..len], masked, b.w - 2.0 * padX);
                    edit.caret = fieldOffsetAt(metrics, buf[0..len], masked, p.position.x - b.x - padX - shift);
                    if (!ui.shiftDown()) {
                        edit.anchor = edit.caret;
                    }
                    // A double click selects the word, a triple click everything.
                    if (ui.pressCount() == 2 && !masked) {
                        let w = wordAround(buf[0..len], edit.caret);
                        edit.anchor = w[0];
                        edit.caret = w[1];
                    } else if (ui.pressCount() >= 2) {
                        edit.anchor = 0;
                        edit.caret = len;
                    }
                }
                null => {}
            }
        } else if (ui.hasFocus(h) && ui.releasedOutside(h) && ui.fieldMenuChoice != h &&
            !(ui.fieldMenuOwner() == h && ui.overHash(hashId("ceeui-field-menu")))) {
            // (A choice in the field's own menu keeps the focus: the field acts on it the next frame.)
            // A click or a tap anywhere else leaves the field when it ends (on a phone, that hides the keyboard), at
            // the frame's end: what was tapped may focus the field again first (a Send button). A field that was
            // pressed took the focus at the press.
            ui.leaveFocus(h);
        } else if (ui.captured() == h && p.down && ui.pressCount() < 2) {
            match (box) {
                Some(b) => {
                    let shift = fieldShift(metrics, buf[0..len], masked, b.w - 2.0 * padX);
                    edit.caret = fieldOffsetAt(metrics, buf[0..len], masked, p.position.x - b.x - padX - shift);
                }
                null => {}
            }
        }
        if (p.released && ui.captured() == h) {
            ui.capture(0);
        }
        if (p.released && ui.fieldMenuChoice == h) {
            ui.fieldMenuChoice = 0;
        }
        // Its edit menu, as a system's text field has: a secondary click, or a long press on a touch screen, which
        // first selects the word under the finger when nothing is selected (the press put the caret there).
        if (ui.secondaryPressedOn(h)) {
            ui.setFocus(h);
            if (ui.touchDriven && edit.anchor == edit.caret && !masked) {
                let w = wordAround(buf[0..len], edit.caret);
                // Only a word: between words (spaces) the caret stays where the finger put it, as a phone's own.
                var word = false;
                for (b in buf[w[0]..w[1]]) {
                    word = word || (b != ' ' && b != '\t');
                }
                if (word) {
                    edit.anchor = w[0];
                    edit.caret = w[1];
                }
            }
            // With a mouse, at the pointer. On a touch screen, beside the field rather than under the finger, as a
            // phone's own: above it, or below it when the screen has no room above (its five items, about 190 points).
            var mx = p.position.x;
            var my = p.position.y;
            if (ui.touchDriven) {
                match (box) {
                    Some(b) => {
                        mx = b.x;
                        my = if (b.y >= 200.0) b.y - 194.0 else b.y + b.h + 4.0;
                    }
                    null => {}
                }
            }
            ui.openFieldMenu(h, mx, my);
        }
        // A word the input method was still composing here when the focus left: it is the field's text, as if
        // committed before the focus moved (a phone's keyboard composes a word until a space or a tap elsewhere).
        let handed = ui.handoverFor(h);
        if (handed.length > 0) {
            var bytes = [0u8; 1024];
            let n = handed.length.min(1024);
            for (i in 0..n) {
                bytes[i] = handed[i];
            }
            changed = replaceSelection(buf, mut len, mut edit, bytes[0..n]) || changed;
        }
        let focused = ui.hasFocus(h);
        if (focused) {
            if (ui.commanded(EditCommand.SelectAll)) {
                edit.anchor = 0;
                edit.caret = len;
            }
            if ((ui.commanded(EditCommand.Copy) || ui.commanded(EditCommand.Cut)) && edit.selects() && !masked) {
                ui.copyText(buf[edit.from()..edit.to()]);
                if (ui.commanded(EditCommand.Cut)) {
                    let none = [0u8; 1];
                    changed = replaceSelection(buf, mut len, mut edit, none[0..0]) || changed;
                }
            }
            if (ui.commanded(EditCommand.Delete) && edit.selects()) {
                let none = [0u8; 1];
                changed = replaceSelection(buf, mut len, mut edit, none[0..0]) || changed;
            }
            if (ui.commanded(EditCommand.Paste)) {
                var pasted = [0u8; 1024];
                let text = ui.pastedText();
                let n = text.length.min(1024);
                for (i in 0..n) {
                    pasted[i] = text[i];
                }
                changed = replaceSelection(buf, mut len, mut edit, pasted[0..n]) || changed;
            }
            loop {
                let c = ui.nextChar();
                if (c == 0) {
                    break;
                }
                var bytes = [0u8; 4];
                let n = encodeUtf8(c, mut bytes);
                changed = replaceSelection(buf, mut len, mut edit, bytes[0..n]) || changed;
            }
            // Backspace and Delete take the selection, or a whole grapheme cluster.
            if (ui.keyHit(Key.Backspace) && (edit.selects() || edit.caret > 0)) {
                if (!edit.selects()) {
                    edit.anchor = graphemeBefore(buf[0..len], edit.caret);
                }
                let none = [0u8; 1];
                changed = replaceSelection(buf, mut len, mut edit, none[0..0]) || changed;
            }
            if (ui.keyHit(Key.Delete) && (edit.selects() || edit.caret < len)) {
                if (!edit.selects()) {
                    edit.anchor = graphemeEnd(buf[0..len], edit.caret);
                }
                let none = [0u8; 1];
                changed = replaceSelection(buf, mut len, mut edit, none[0..0]) || changed;
            }
            // The arrows move the caret as the text is drawn (in right-to-left text, Right goes towards its start), or
            // with the word modifier (Option on macOS, Control elsewhere) by words: with Shift they extend the
            // selection; without, they end it at its edge on the arrow's side, or move.
            let shift = ui.shiftDown();
            let text = buf[0..len];
            for (right in [false, true]) {
                if (!ui.keyHit(if (right) Key.Right else Key.Left)) {
                    continue;
                }
                if (ui.wordModifierDown() && !masked) {
                    // By words: Right is forward in a left-to-right paragraph, back in a right-to-left one.
                    let forward = right != bidiParagraphRtl(text);
                    edit.caret = if (forward) wordForward(text, edit.caret) else wordBackward(text, edit.caret);
                } else if (!shift && edit.selects()) {
                    let a = fieldCaretX(metrics, text, masked, edit.from());
                    let b = fieldCaretX(metrics, text, masked, edit.to());
                    edit.caret = if ((a <= b) == right) edit.to() else edit.from();
                } else {
                    edit.caret = visualStep(metrics, text, masked, edit.caret, right);
                }
                if (!shift) {
                    edit.anchor = edit.caret;
                }
            }
            if (ui.keyPressed(Key.Home)) {
                edit.caret = 0;
                if (!shift) {
                    edit.anchor = 0;
                }
            }
            if (ui.keyPressed(Key.End)) {
                edit.caret = len;
                if (!shift) {
                    edit.anchor = len;
                }
            }
            if (ui.keyPressed(Key.Enter)) {
                ui.clearFocus();
            }
        }
        ui.open(Controls.fieldStyle(ui, h, focused));
        let node = ui.access(h, AccessRole.TextField, id.bytes());
        var dots = [0u8; 1020];
        let dotCount = if (masked) maskInto(buf[0..len], mut dots) else 0;
        if (masked) {
            ui.accessValue(node, dots[0..dotCount]);
            ui.accessFlag(node, ACCESS_SECURE, true);
            ui.accessCaret(node, maskedAt(buf[0..len], edit.caret), maskedAt(buf[0..len], edit.anchor));
            if (focused) {
                ui.reportTextKind(TextKind.Password);
            }
        } else {
            ui.accessValue(node, buf[0..len]);
            ui.accessCaret(node, edit.caret, edit.anchor);
        }
        let config = TextConfig.of(FIELD_TEXT);
        // A right-to-left paragraph sits at the right: everything drawn at a caret or a span moves with it.
        let shift = match (box) {
            Some(b) => fieldShift(metrics, buf[0..len], masked, b.w - 2.0 * padX),
            null => 0.0,
        };
        let textX = padX + shift;
        // The selection, behind the text: where its characters are drawn, so a selection across right-to-left and
        // left-to-right text is several boxes.
        if (focused && edit.selects()) {
            var spans = [TextSpan { left: 0.0, right: 0.0 }; 8];
            let count = fieldSpans(metrics, buf[0..len], masked, edit.from(), edit.to(), mut spans[..]);
            for (k in 0..count) {
                let s = spans[k];
                ui.open(
                    Style.box().absolute().passthrough().left(textX + s.left).top(padY).w(
                        Size.fixed(s.right - s.left),
                    ).h(Size.fixed(FIELD_TEXT))
                        .bg(0x3B82F666), // BLUE_500 at 40 %: the selected text shows through
                );
                ui.close();
            }
        }
        // The text, with the composition (underlined) at the caret while the input method composes.
        let composing = focused && !masked && ui.composition().length > 0;
        var caretX = fieldCaretX(metrics, buf[0..len], masked, edit.caret);
        ui.open(Style.row().ml(shift).alignXY(AxisAlign.Start, AxisAlign.Center));
        if (composing) {
            // One line: the text with the composition spliced in at the caret, the composition underlined, and
            // the caret where the input method has it, all placed by the glyphs as drawn.
            var line = [0u8; 1024];
            let comp = ui.composition();
            let before = edit.caret.min(1024);
            let n = comp.length.min(1024 - before);
            let after = (len - edit.caret).min(1024 - before - n);
            for (i in 0..before) {
                line[i] = buf[i];
            }
            for (i in 0..n) {
                line[before + i] = comp[i];
            }
            for (i in 0..after) {
                line[before + n + i] = buf[edit.caret + i];
            }
            let all = before + n + after;
            ui.labelBytes(line[0..all], Text.of().color(ui.tone(SLATE_100)));
            let u0 = metrics.caretX(line[0..all], config, before);
            let u1 = metrics.caretX(line[0..all], config, before + n);
            ui.open(Style.box().absolute().passthrough().left(textX + u0.min(u1)).top(padY + FIELD_TEXT)
                .w(Size.fixed((u1 - u0).abs())).h(Size.fixed(1.0)).bg(ui.tone(SLATE_100)));
            ui.close();
            caretX = metrics.caretX(line[0..all], config, before + ui.compositionCaret().min(n));
        } else if (masked && dotCount > 0) {
            ui.labelBytes(dots[0..dotCount], Text.of().color(ui.tone(SLATE_100)));
        } else if (len > 0) {
            ui.labelBytes(buf[0..len], Text.of().color(ui.tone(SLATE_100)));
        }
        ui.close();
        if (focused) {
            if ((truncate<u64>((ui.time() * 2.0).floor()) & 1) == 0 || composing) {
                ui.open(Style.box().absolute().passthrough().left(textX + caretX).top(padY).w(Size.fixed(2.0))
                    .h(Size.fixed(FIELD_TEXT)).bg(ui.tone(SLATE_200)));
                ui.close();
            }
            match (box) {
                Some(b) => { ui.reportCaret(Rect { x: b.x + textX + caretX, y: b.y + padY, w: 2.0, h: FIELD_TEXT }); }
                null => {}
            }
        }
        ui.close();
        if (ui.fieldMenuOwner() == h) {
            // Cut, Copy and Delete with a selection (none in a password field), Paste when the clipboard has text;
            // a choice acts on this field the next frame. A press elsewhere, or the field losing the focus, closes it.
            var open = ui.hasFocus(h);
            let chose = Controls.editMenu(
                mut ui,
                "ceeui-field-menu",
                mut open,
                ui.fieldMenuX,
                ui.fieldMenuY,
                edit.selects() && !masked,
            );
            if (chose) {
                ui.fieldMenuChoice = h;
            }
            if (!open) {
                ui.closeFieldMenu();
            }
        }
        return changed;
    }
}
