// SPDX-License-Identifier: MIT
// ceeui-pack: a CeeUI app as what a system installs (roadmap P4 step 8). Run it in the app's package directory:
//
//   cd ceeui-hosts/gpu && ../../ceeui-pack/out/ceeui_pack android --name "CeeUI GPU" --id com.example.gpu
//
//   macos            out/pack/NAME.app, signed ad hoc (this Mac only)
//   ios-simulator    out/pack/ios-simulator/NAME.app, for `xcrun simctl install`
//   ios              out/pack/ios/NAME.app, signed for a device with a development identity and a provisioning
//                    profile already on this Mac (Xcode makes them), for `xcrun devicectl device install app`
//   android          out/pack/NAME.apk: a NativeActivity app, signed with the debug key, for `adb install`
//   web              out/pack/web: a page and a WebAssembly module, for a package on the web host (ceeui-web);
//                    `--font FILE`, once for each font the app loads, in its order; `--fallback FILE`, once for
//                    each font to fetch when text has a character those lack, in the order they are tried. Serve it with the serve.py in
//                    it, or with any server that sends the same two headers. Needs a clang with the wasm64 target
//                    (CLANG, else Homebrew's llvm, else `clang`) and wasm-ld (WASM_LD).
//
//   new NAME         a new app in directory NAME, from template/ (a window with a list of tasks); `--ceeui PATH`
//                    takes CeeUI's packages from the checkout at PATH rather than from GitHub
//
// `--network WHY` is for an app that uses the network: Android's INTERNET permission, and on iOS the sentence shown
// when the app first reaches a device on the local network.
// `--contacts WHY` is for an app that reads the address book (CeeSafe ADR 0271): iOS's and the Mac's sentence, and
// Android's READ_CONTACTS.
// `--calls` is for an app that rings while it is not running (CeeSafe ADR 0278): iOS's `voip` and `audio` background
// modes; Android's USE_FULL_SCREEN_INTENT, PushService's call notification and src/CallChoice.java.
// `--camera WHY`, `--microphone WHY` and `--save-photos WHY` are for an app that captures with the camera (CeeSafe ADR
// 0265, MediaPicker.capture): iOS's sentences for the camera, the microphone (a video records sound) and adding the
// capture to Photos; on Android, --camera declares the storage permission up to Android 9, where the gallery's item
// needs it. Picking from the photo library needs none of them.
// `--bluetooth WHY` is for an app that prints to Bluetooth printers (CeeSafe ADR 0177): Android's Bluetooth
// permissions, and on iOS and macOS the sentence shown when the app first uses Bluetooth.
// `--notifications` is for an app that shows notifications (CeeSafe ADR 0243): Android's POST_NOTIFICATIONS, which
// Android 13 and later ask the user for when the app calls Notifications.requestPermission. Apple's systems need
// nothing declared.
// `--extension DIR` builds the package in DIR as the app's notification service extension (iOS; CeeSafe ADR 0246),
// PlugIns/<package>.appex, identifier <the app's>.NotificationService, signed with its own profile; `--group ID` is
// an App Group the app and the extension share (their entitlements). With an extension the app needs the group.
// `--push` is for an app that receives push notifications (CeeSafe ADR 0244): on an iOS device the app is signed with
// the profile's `aps-environment`, which only a profile of an explicit App ID with Push Notifications has.
//
// It runs ceesafec for the target, writes the Info.plist or AndroidManifest.xml, and runs the system's own tools
// (xcrun, codesign, security; the NDK's clang, aapt2, zipalign, apksigner). It needs a Mac for the Apple targets, and
// a Unix (`mkdir`, `cp`, `rm`, `zip`, `sh`) for all of them: Windows is not a host for it yet.

/// What to pack, and as what.
struct Options {
    target: String;
    name: String;     // the app's name on the system: --name, else the package's
    id: String;       // its bundle identifier or Android package: --id, else com.example.<package>
    version: String;  // --version, else the package's
    binary: String;   // the executable's name inside a bundle: the package's name
    abis: String;     // --abi, Android's, comma separated: arm64-v8a by default
    profile: String;  // --profile, a .mobileprovision; else the newest fitting one Xcode keeps
    identity: String; // --identity, a signing identity; else the first "Apple Development" one
    keystore: String; // --keystore, else ~/.android/debug.keystore (password "android")
    storePass: String;
    network: String; // --network, why the app uses the network: Android's INTERNET permission and iOS's local
    // network description; empty for an app that uses none
    camera: String;     // --camera, why the app uses the camera (CeeSafe ADR 0265); empty for none
    contacts: String;   // --contacts, why the app reads the address book (CeeSafe ADR 0271); empty for none
    microphone: String; // --microphone, why it records sound (a captured video)
    savePhotos: String; // --save-photos, why it adds its captures to Photos (iOS)
    bluetooth: String;  // --bluetooth, why the app uses Bluetooth (CeeSafe ADR 0177 §2.2): Android's permissions and
    // Apple's NSBluetoothAlwaysUsageDescription; empty for an app that uses none
    notifications: bool; // --notifications: Android's POST_NOTIFICATIONS (CeeSafe ADR 0243)
    calls: bool;         // --calls: calls that ring while the app is not running (CeeSafe ADR 0278)
    push: bool;          // --push: iOS's aps-environment, from the profile (CeeSafe ADR 0244)
    group: String;       // --group: an App Group the app (and its extension) share (CeeSafe ADR 0246)
    extension: String;   // --extension: the directory of a package built as the app's notification service extension
    firebase: String;    // --firebase: an Android app's google-services.json; the APK is then built with Gradle
    fonts: String;       // --font, each on a line: the web target's fonts, in the app's order
    fallbacks: String;   // --fallback, each on a line: the web target's fallback fonts, in the order they are tried
}

fn fail(what: StringView) -> i32 {
    Console.writeError("ceeui-pack: ");
    Console.writeErrorLine(what);
    return 1;
}

fn fail2(what: StringView, more: StringView) -> i32 {
    Console.writeError("ceeui-pack: ");
    Console.writeError(what);
    Console.writeErrorLine(more);
    return 1;
}

fn text(s: StringView) -> String => String.from(s);

/// The pieces joined.
fn cat<const N: usize>(parts: [StringView; N]) -> String {
    var s = String.create();
    for (p in parts[..]) {
        s.append(p);
    }
    return s;
}

/// The text of the file at `path`, or empty.
fn readText(path: StringView) -> String {
    var s = String.create();
    match (File.open(path)) {
        Ok(f) => {
            var file = f;
            var chunk = [0u8; 8192];
            var bytes = Vector<u8>.create();
            loop {
                let n = match (file.read(mut chunk[..])) {
                    Ok(k) => k,
                    Err(_) => 0,
                };
                if (n == 0) {
                    break;
                }
                bytes.extend(chunk[0..n]);
            }
            let ok = s.appendUtf8(bytes.view());
        }
        Err(_) => {}
    }
    return s;
}

fn writeText(path: StringView, content: StringView) -> bool {
    return match (File.create(path)) {
        Ok(f) => {
            var file = f;
            match (file.write(content.bytes())) {
                Ok() => true,
                Err(_) => false,
            }
        }
        Err(_) => false,
    };
}

/// Runs `program` with `arguments`, its output shown; whether it ended with 0.
fn run<const N: usize>(program: StringView, arguments: [StringView; N]) -> bool {
    var args = Vector<StringView>.create();
    args.extend(arguments[..]);
    return match (Process.run(program, args)) {
        Ok(status) => status == 0,
        Err(_) => {
            Console.writeError("ceeui-pack: cannot run ");
            Console.writeErrorLine(program);
            false
        }
    };
}

/// What `program` prints, trimmed; empty when it cannot run or fails.
fn output<const N: usize>(program: StringView, arguments: [StringView; N]) -> String {
    var args = Vector<StringView>.create();
    args.extend(arguments[..]);
    var s = String.create();
    match (Process.capture(program, args, "".bytes())) {
        Ok(result) => {
            if (result.status == 0) {
                match (StringView.fromUtf8(result.stdout.view())) {
                    Some(t) => { s.append(t.trim()); }
                    null => {}
                }
            }
        }
        Err(_) => {}
    }
    return s;
}

/// The value of `key = "value"` in a ceesafe.toml's text, or empty.
fn tomlValue(toml: StringView, key: StringView) -> String {
    var lines = toml.split("\n");
    loop {
        let line = match (lines.next()) {
            Some(l) => l.trim(),
            null => { break; }
        };
        match (line.splitOnce("=")) {
            Some(halves) => {
                if (halves.left.trim() == key) {
                    let value = halves.right.trim();
                    if (value.length >= 2 && value.bytes()[0] == '"') {
                        match (value[1..].indexOf("\"")) {
                            Some(end) => { return text(value[1..1 + end]); }
                            null => {}
                        }
                    }
                }
            }
            null => {}
        }
    }
    return String.create();
}

/// `s` with what XML reserves escaped.
fn xml(s: StringView) -> String {
    var out = String.create();
    let b = s.bytes();
    var start: usize = 0; // the run of plain text not yet copied: whole characters, since the reserved ones are ASCII
    for (i in 0..b.length + 1) {
        let escape = if (i == b.length) ""
            else if (b[i] == '&') "&amp;"
            else if (b[i] == '<') "&lt;"
            else if (b[i] == '>') "&gt;"
            else if (b[i] == '"') "&quot;"
            else "";
        if (i == b.length || escape.length > 0) {
            out.append(s[start..i]);
            out.append(escape);
            start = i + 1;
        }
    }
    return out;
}

/// An empty directory at `path`, its parents made.
fn freshDirectory(path: StringView) -> bool {
    return run("rm", ["-rf", path]) && run("mkdir", ["-p", path]);
}

/// The first directory entry of `dir` in descending order: the newest of versions named by number.
fn newest(dir: StringView) -> String {
    var best = String.create();
    match (Directory.list(dir)) {
        Ok(names) => {
            for (n in names.view()) {
                if (n.view().bytes().length > 0 && n.view().bytes()[0] != '.' && later(n.view(), best.view())) {
                    best = text(n.view());
                }
            }
        }
        Err(_) => {}
    }
    return best;
}

/// Whether version `a` is after `b`, number by number ("36.1.0" after "9.0.0"; "android-36" after "android-9").
fn later(a: StringView, b: StringView) -> bool {
    let x = a.bytes();
    let y = b.bytes();
    var i: usize = 0;
    var j: usize = 0;
    loop {
        if (i >= x.length) {
            return false;
        }
        if (j >= y.length) {
            return true;
        }
        let dx = x[i] >= '0' && x[i] <= '9';
        let dy = y[j] >= '0' && y[j] <= '9';
        if (dx && dy) {
            var n: u64 = 0;
            while (i < x.length && x[i] >= '0' && x[i] <= '9') {
                n = n.wrappingMul(10).wrappingAdd((x[i] - '0') as u64);
                i += 1;
            }
            var m: u64 = 0;
            while (j < y.length && y[j] >= '0' && y[j] <= '9') {
                m = m.wrappingMul(10).wrappingAdd((y[j] - '0') as u64);
                j += 1;
            }
            if (n != m) {
                return n > m;
            }
        } else {
            if (x[i] != y[j]) {
                return x[i] > y[j];
            }
            i += 1;
            j += 1;
        }
    }
}

/// An Apple bundle's Info.plist.
fn infoPlist(o: borrow Options, phone: bool) -> String {
    var p = String.create();
    p.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    p.append(
        "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n",
    )!;
    p.append("<plist version=\"1.0\">\n<dict>\n");
    let pairs: [StringView; 12] = [
        "CFBundleExecutable",
        o.binary.view(),
        "CFBundleIdentifier",
        o.id.view(),
        "CFBundleName",
        o.name.view(),
        "CFBundleDisplayName",
        o.name.view(),
        "CFBundleShortVersionString",
        o.version.view(),
        "CFBundlePackageType",
        "APPL",
    ];
    for (k in 0usize..6) {
        p.append("\t<key>");
        p.append(pairs[k * 2]);
        p.append("</key><string>");
        p.append(xml(pairs[k * 2 + 1]).view());
        p.append("</string>\n");
    }
    p.append("\t<key>CFBundleVersion</key><string>1</string>\n");
    if (o.bluetooth.view().length > 0) {
        // What iOS and macOS show when the app first uses Bluetooth; without it the system ends the app there.
        p.append("\t<key>NSBluetoothAlwaysUsageDescription</key><string>");
        p.append(xml(o.bluetooth.view()).view());
        p.append("</string>\n");
    }
    if (phone) {
        p.append("\t<key>LSRequiresIPhoneOS</key><true/>\n");
        p.append("\t<key>MinimumOSVersion</key><string>17.0</string>\n");
        p.append("\t<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>\n");
        p.append("\t<key>UILaunchScreen</key><dict/>\n");
        if (o.network.view().length > 0) {
            // What iOS shows when the app first reaches a device on the local network.
            p.append("\t<key>NSLocalNetworkUsageDescription</key><string>");
            p.append(xml(o.network.view()).view());
            p.append("</string>\n");
        }
        // The camera, the microphone and Photos (CeeSafe ADR 0265): without them iOS ends an app at their first use.
        usageText(mut p, "NSCameraUsageDescription", o.camera.view());
        usageText(mut p, "NSPhotoLibraryAddUsageDescription", o.savePhotos.view());
        p.append("\t<key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>\n");
        // Every orientation: a CeeUI app lays out again at each size (its size classes).
        p.append("\t<key>UISupportedInterfaceOrientations</key><array>");
        p.append("<string>UIInterfaceOrientationPortrait</string>");
        p.append("<string>UIInterfaceOrientationLandscapeLeft</string>");
        p.append("<string>UIInterfaceOrientationLandscapeRight</string></array>\n");
    } else {
        p.append("\t<key>LSMinimumSystemVersion</key><string>12.0</string>\n");
        p.append("\t<key>NSHighResolutionCapable</key><true/>\n");
    }
    // The address book (CeeSafe ADR 0271) and the microphone (ADRs 0265, 0272), on the phones and the Mac: without them
    // iOS ends an app that asks.
    usageText(mut p, "NSContactsUsageDescription", o.contacts.view());
    usageText(mut p, "NSMicrophoneUsageDescription", o.microphone.view());
    if (phone && o.calls) {
        // Calls (CeeSafe ADR 0278): VoIP pushes wake the app for CallKit; a call's audio goes on with the screen locked.
        p.append("\t<key>UIBackgroundModes</key><array><string>voip</string><string>audio</string></array>\n");
    }
    p.append("</dict>\n</plist>\n");
    return p;
}

/// Where the static OpenSSL for `system` ("android-arm64", "ios-arm64", "ios-sim-arm64") is, when
/// tools/openssl-mobile.sh of CeeSafe.Web has built it in its usual place; empty otherwise.
fn mobileOpenssl(system: StringView) -> String {
    let dir = cat([Environment.variable("HOME") ?? "", "/.cache/ceesafe/openssl-mobile/", system]);
    return if (File.kind(
        cat([dir.view(), "/lib/libssl.a"]).view(),
    ) is Ok(Some(PathKind.File))) dir else String.create();
}

/// Builds the package here with `arguments` after `build --windowed`, for `target` (a manifest's [target.NAME],
/// CeeSafe ADR 0171; empty for this machine) and with `variable` ("NAME=value", or empty) in ceesafec's environment:
/// what a dependency's target table names its libraries by. Whether it built.
fn build(arguments: Slice<StringView>, target: StringView, variable: StringView) -> bool {
    var args = Vector<StringView>.create();
    if (variable.length > 0) {
        args.push(variable);
        args.push("ceesafec");
    }
    args.push("build");
    args.push("--windowed");
    if (target.length > 0) {
        args.push("--target");
        args.push(target);
    }
    args.extend(arguments);
    return match (Process.run(if (variable.length > 0) "env" else "ceesafec", args)) {
        Ok(status) => status == 0,
        Err(_) => {
            Console.writeErrorLine("ceeui-pack: cannot run ceesafec (is it on PATH?)");
            false
        }
    };
}

/// `build`, in the package at `directory` (a notification extension's) rather than the current one.
fn buildIn(directory: StringView, arguments: Slice<StringView>, target: StringView, variable: StringView) -> bool {
    var command = String.create();
    command.append("cd '");
    command.append(directory);
    command.append("' && ");
    if (variable.length > 0) {
        command.append("env '");
        command.append(variable);
        command.append("' ");
    }
    command.append("ceesafec build --windowed --target ");
    command.append(target);
    for (a in arguments) {
        command.append(" '");
        command.append(a);
        command.append("'");
    }
    return run("sh", ["-c", command.view()]);
}

/// The .app at `app` for a Mac or a phone: the directory, the executable built into it, and its Info.plist.
fn bundle(
    o: borrow Options,
    app: StringView,
    phone: bool,
    flags: Slice<StringView>,
    target: StringView,
    variable: StringView,
) -> bool {
    let inner = if (phone) text(app) else cat([app, "/Contents/MacOS"]);
    if (!freshDirectory(inner.view())) {
        return false;
    }
    let exe = cat([inner.view(), "/", o.binary.view()]);
    var args = Vector<StringView>.create();
    args.extend(flags);
    args.push("-o");
    args.push(exe.view());
    if (!build(args.view(), target, variable)) {
        return false;
    }
    let plist = if (phone) cat([app, "/Info.plist"]) else cat([app, "/Contents/Info.plist"]);
    return writeText(plist.view(), infoPlist(o, phone).view());
}

fn packMac(o: borrow Options) -> i32 {
    let app = cat(["out/pack/", o.name.view(), ".app"]);
    let none = Vector<StringView>.create();
    if (!bundle(o, app.view(), false, none.view(), "", "")) {
        return fail("the app was not built");
    }
    if (!run("codesign", ["-s", "-", "-f", app.view()])) {
        return fail("codesign failed");
    }
    Console.write("packed ");
    Console.writeLine(app.view());
    return 0;
}

/// The cc flags of an iOS build for `sdk` ("iphoneos" or "iphonesimulator") and `triple`, after finding its clang.
fn packIos(o: borrow Options, simulator: bool) -> i32 {
    let sdkName = if (simulator) "iphonesimulator" else "iphoneos";
    let clang = output("xcrun", ["--sdk", sdkName, "-f", "clang"]);
    let sdk = output("xcrun", ["--sdk", sdkName, "--show-sdk-path"]);
    if (clang.view().length == 0 || sdk.view().length == 0) {
        return fail("no iOS SDK: xcrun did not find one (is Xcode installed and selected?)");
    }
    let triple = if (simulator) "arm64-apple-ios17.0-simulator" else "arm64-apple-ios17.0";
    let app = cat(["out/pack/", if (simulator) "ios-simulator/" else "ios/", o.name.view(), ".app"]);
    // The main thread's stack is 1 MiB on iOS, an eighth of a Mac's, and UIKit is on it under the program (CeeSafe
    // ADR 0154): 16 MiB, so an app whose `main` holds large values (a Raster is 123 KiB) runs as it does on a desktop.
    let flags: [StringView; 12] = [
        "--cc",
        clang.view(),
        "--cflag",
        "-target",
        "--cflag",
        triple,
        "--cflag",
        "-isysroot",
        "--cflag",
        sdk.view(),
        "--cflag",
        "-Wl,-stack_size,0x1000000",
    ];
    // A dependency that links OpenSSL (CeeSafe.Web's web_tls) is told where the phone's is, unless the caller said.
    var variable = String.create();
    if (Environment.variable("OPENSSL_IOS_DIR") == null) {
        let found = mobileOpenssl(if (simulator) "ios-sim-arm64" else "ios-arm64");
        if (found.view().length > 0) {
            variable = cat(["OPENSSL_IOS_DIR=", found.view()]);
        }
    }
    if (!bundle(o, app.view(), true, flags[..], "ios", variable.view())) {
        return fail("the app was not built");
    }
    var extensionPath = String.create();
    if (o.extension.view().length > 0) {
        extensionPath = cat([app.view(), "/PlugIns/", o.name.view(), "Notifications.appex"]);
        let built = extensionBundle(o, extensionPath.view(), flags[..], variable.view());
        if (built != 0) {
            return built;
        }
    }
    if (simulator) {
        if (!run("codesign", ["-s", "-", "-f", app.view()])) {
            return fail("codesign failed");
        }
    } else {
        if (extensionPath.view().length > 0) {
            let inner = signForDevice(o, extensionPath.view(), extensionId(o).view(), false);
            if (inner != 0) {
                return inner;
            }
        }
        let signed = signForDevice(o, app.view(), o.id.view(), o.push);
        if (signed != 0) {
            return signed;
        }
    }
    Console.write("packed ");
    Console.writeLine(app.view());
    return 0;
}

/// A usage description in an Info.plist, when the app gave one.
fn usageText(p: borrow mut String, key: StringView, why: StringView) {
    if (why.length > 0) {
        p.append("\t<key>");
        p.append(key);
        p.append("</key><string>");
        p.append(xml(why).view());
        p.append("</string>\n");
    }
}

/// The extension's identifier: the app's and `.NotificationService`.
fn extensionId(o: borrow Options) -> String => cat([o.id.view(), ".NotificationService"]);

/// The notification service extension at `appex`: the package in `--extension`'s directory built into it (its
/// executable named after the package), and its Info.plist, which names CeeSafe's principal class (ADR 0246). 0, or a
/// failure's code.
fn extensionBundle(o: borrow Options, appex: StringView, flags: Slice<StringView>, variable: StringView) -> i32 {
    let toml = readText(cat([o.extension.view(), "/ceesafe.toml"]).view());
    let binary = tomlValue(toml.view(), "name");
    if (binary.view().length == 0) {
        return fail2("--extension: no ceesafe.toml with a name in ", o.extension.view());
    }
    if (!freshDirectory(appex)) {
        return fail("could not make the extension's bundle");
    }
    // The package is built in its own directory: a shell's `cd`, then ceesafec as for the app.
    var command = String.create();
    command.append("cd '");
    command.append(o.extension.view());
    command.append("' && ");
    if (variable.length > 0) {
        command.append("env '");
        command.append(variable);
        command.append("' ");
    }
    command.append("ceesafec build --windowed --target ios");
    for (f in flags) {
        command.append(" '");
        command.append(f);
        command.append("'");
    }
    command.append(" -o '");
    command.append(Directory.current()!.view());
    command.append("/");
    command.append(appex);
    command.append("/");
    command.append(binary.view());
    command.append("'");
    if (!run("sh", ["-c", command.view()])) {
        return fail("the extension was not built");
    }
    var p = String.create();
    p.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\">\n<dict>\n");
    p.append("\t<key>CFBundleExecutable</key><string>");
    p.append(xml(binary.view()).view());
    p.append("</string>\n\t<key>CFBundleIdentifier</key><string>");
    p.append(xml(extensionId(o).view()).view());
    p.append("</string>\n\t<key>CFBundleName</key><string>");
    p.append(xml(binary.view()).view());
    // Apple requires an extension's versions to be its app's.
    p.append("</string>\n\t<key>CFBundleShortVersionString</key><string>");
    p.append(xml(o.version.view()).view());
    p.append("</string>\n\t<key>CFBundleVersion</key><string>1</string>\n");
    p.append("\t<key>CFBundlePackageType</key><string>XPC!</string>\n");
    p.append("\t<key>MinimumOSVersion</key><string>17.0</string>\n");
    p.append("\t<key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>\n");
    p.append("\t<key>NSExtension</key><dict>\n");
    p.append("\t\t<key>NSExtensionPointIdentifier</key><string>com.apple.usernotifications.service</string>\n");
    p.append("\t\t<key>NSExtensionPrincipalClass</key><string>CeeSafeNotificationService</string>\n");
    p.append("\t</dict>\n</dict>\n</plist>\n");
    if (!writeText(cat([appex, "/Info.plist"]).view(), p.view())) {
        return fail("could not write the extension's Info.plist");
    }
    return 0;
}

/// The text between `<string>` and `</string>` after `key` in a property list's XML, or empty.
fn plistString(plist: StringView, key: StringView) -> String {
    let marker = cat(["<key>", key, "</key>"]);
    match (plist.indexOf(marker.view())) {
        Some(at) => {
            let rest = plist[at + marker.view().length..];
            match (rest.indexOf("<string>")) {
                Some(open) => {
                    let value = rest[open + 8..];
                    match (value.indexOf("</string>")) {
                        Some(close) => { return text(value[0..close]); }
                        null => {}
                    }
                }
                null => {}
            }
        }
        null => {}
    }
    return String.create();
}

/// The same for a `<date>`.
fn plistDate(plist: StringView, key: StringView) -> String {
    let marker = cat(["<key>", key, "</key>"]);
    match (plist.indexOf(marker.view())) {
        Some(at) => {
            let rest = plist[at + marker.view().length..];
            match (rest.indexOf("<date>")) {
                Some(open) => {
                    let value = rest[open + 6..];
                    match (value.indexOf("</date>")) {
                        Some(close) => { return text(value[0..close]); }
                        null => {}
                    }
                }
                null => {}
            }
        }
        null => {}
    }
    return String.create();
}

/// A provisioning profile for `id` that has not expired: the file and its application identifier (TEAM.id or
/// TEAM.*). An exact one before a wildcard, then the one that expires last. Empty when there is none.
struct Profile {
    path: String;
    appId: String;
}

fn findProfile(id: StringView) -> Profile {
    var found = Profile { path: String.create(), appId: String.create() };
    var foundExact = false;
    var foundExpiry = String.create();
    let now = output("date", ["-u", "+%Y-%m-%dT%H:%M:%SZ"]);
    let home = Environment.variable("HOME") ?? "";
    var places = Vector<String>.create();
    places.push(cat([home, "/Library/Developer/Xcode/UserData/Provisioning Profiles"]));
    places.push(cat([home, "/Library/MobileDevice/Provisioning Profiles"]));
    for (place in places.view()) {
        let names = match (Directory.list(place.view())) {
            Ok(n) => n,
            Err(_) => Vector<String>.create(),
        };
        for (name in names.view()) {
            if (!name.view().endsWith(".mobileprovision")) {
                continue;
            }
            let path = cat([place.view(), "/", name.view()]);
            let plist = output("security", ["cms", "-D", "-i", path.view()]);
            let appId = plistString(plist.view(), "application-identifier");
            let expiry = plistDate(plist.view(), "ExpirationDate");
            let dot = match (appId.view().indexOf(".")) {
                Some(d) => d,
                null => { continue; }
            };
            let pattern = appId.view()[dot + 1..];
            let exact = pattern == id;
            if (!exact && pattern != "*") {
                continue;
            }
            if (!later(expiry.view(), now.view())) {
                continue; // expired
            }
            let better = if (exact != foundExact) exact else later(expiry.view(), foundExpiry.view());
            if (found.path.view().length == 0 || better) {
                found = Profile { path: path, appId: appId };
                foundExact = exact;
                foundExpiry = expiry;
            }
        }
    }
    return found;
}

/// Signs the bundle at `app` for a device: the profile inside it, and the entitlements the profile's app needs.
fn signForDevice(o: borrow Options, app: StringView, id: StringView, push: bool) -> i32 {
    // --profile names the app's; an extension's is found as a default app's is.
    var profilePath = if (id == o.id.view()) text(o.profile.view()) else String.create();
    var appId = String.create();
    if (profilePath.view().length > 0) {
        let plist = output("security", ["cms", "-D", "-i", profilePath.view()]);
        appId = plistString(plist.view(), "application-identifier");
    } else {
        let p = findProfile(id);
        profilePath = text(p.path.view());
        appId = text(p.appId.view());
    }
    let dot = match (appId.view().indexOf(".")) {
        Some(d) => d,
        null => {
            return fail2(
                "no provisioning profile on this Mac fits ",
                id,
            ) + fail("  build any app for the device in Xcode once (it makes a wildcard profile), or pass --profile");
        }
    };
    let team = appId.view()[0..dot];
    var identity = text(o.identity.view());
    if (identity.view().length == 0) {
        // The first "Apple Development" identity: its 40 hex digits, which name it without its owner's name.
        let listed = output("security", ["find-identity", "-v", "-p", "codesigning"]);
        var lines = listed.view().split("\n");
        loop {
            let line = match (lines.next()) {
                Some(l) => l.trim(),
                null => { break; }
            };
            if (line.contains("\"Apple Development:")) {
                match (line.splitOnce(") ")) {
                    Some(h) => {
                        match (h.right.splitOnce(" ")) {
                            Some(parts) => { identity = text(parts.left); }
                            null => {}
                        }
                    }
                    null => {}
                }
                break;
            }
        }
    }
    if (identity.view().length == 0) {
        return fail("no \"Apple Development\" signing identity in the keychain; pass --identity");
    }
    if (!run("cp", [profilePath.view(), cat([app, "/embedded.mobileprovision"]).view()])) {
        return fail("could not copy the provisioning profile");
    }
    // Push (--push): the environment the profile grants, "development" or "production"; a wildcard profile grants none.
    var apsEnvironment = String.create();
    if (push) {
        let plist = output("security", ["cms", "-D", "-i", profilePath.view()]);
        apsEnvironment = plistString(plist.view(), "aps-environment");
        if (apsEnvironment.view().length == 0) {
            return fail2("--push: the profile grants no push notifications: ", profilePath.view()) +
                fail(
                    "  register the App ID with Push Notifications and make a profile for it (a wildcard one has none)",
                );
        }
    }
    let fullId = cat([team, ".", id]);
    var e = String.create();
    e.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\">\n<dict>\n");
    e.append("\t<key>application-identifier</key><string>");
    e.append(xml(fullId.view()).view());
    e.append("</string>\n\t<key>com.apple.developer.team-identifier</key><string>");
    e.append(team);
    e.append("</string>\n\t<key>get-task-allow</key><true/>\n");
    if (apsEnvironment.view().length > 0) {
        e.append("\t<key>aps-environment</key><string>");
        e.append(xml(apsEnvironment.view()).view());
        e.append("</string>\n");
    }
    if (o.group.view().length > 0) {
        // The App Group (--group): iOS also takes it as a keychain access group the app and its extension share
        // (CeeSafe ADR 0246), without its being listed in keychain-access-groups.
        e.append("\t<key>com.apple.security.application-groups</key><array><string>");
        e.append(xml(o.group.view()).view());
        e.append("</string></array>\n");
    }
    e.append("\t<key>keychain-access-groups</key><array><string>");
    e.append(xml(fullId.view()).view());
    e.append("</string></array>\n</dict>\n</plist>\n");
    let entitlements = "out/pack/ios/entitlements.plist";
    if (!writeText(entitlements, e.view())) {
        return fail("could not write the entitlements");
    }
    if (!run("codesign", ["-f", "-s", identity.view(), "--entitlements", entitlements, app])) {
        return fail("codesign failed");
    }
    return 0;
}

/// Android's NDK triple for an ABI, or empty for one that is not Android's.
fn androidTriple(abi: StringView) -> StringView => if (abi == "arm64-v8a") "aarch64-linux-android"
    else if (abi == "x86_64") "x86_64-linux-android"
    else if (abi == "armeabi-v7a") "armv7a-linux-androideabi"
    else if (abi == "x86") "i686-linux-android"
    else "";

/// ceesafec's `--arch` for an Android ABI (CeeSafe ADR 0192): the 32-bit ones lay types out for 4-byte pointers.
fn androidArch(abi: StringView) -> StringView => if (abi == "arm64-v8a") "arm64"
    else if (abi == "x86_64") "x86_64"
    else if (abi == "armeabi-v7a") "armv7"
    else "x86";

/// The app's AndroidManifest.xml. With Firebase (`--firebase`), for Gradle: the package, the versions and the SDK
/// levels are build.gradle.kts's, the APK has code (Firebase's and the messaging service), and the service is declared.
fn androidManifest(o: borrow Options) -> String {
    let gradle = o.firebase.view().length > 0;
    var m = String.create();
    m.append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n");
    m.append("<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\"")!;
    if (gradle) {
        m.append(">\n");
    } else {
        m.append(" package=\"")!;
        m.append(xml(o.id.view()).view());
        m.append("\"\n          android:versionCode=\"1\" android:versionName=\"");
        m.append(xml(o.version.view()).view());
        m.append("\">\n  <uses-sdk android:minSdkVersion=\"25\" android:targetSdkVersion=\"36\"/>\n")!;
    }
    if (o.network.view().length > 0) {
        m.append("  <uses-permission android:name=\"android.permission.INTERNET\"/>\n");
    }
    if (o.camera.view().length > 0) {
        // The camera's app writes to an item of the gallery, which needs this before Android 10 (CeeSafe ADR 0265).
        m.append("  <uses-permission android:name=\"android.permission.WRITE_EXTERNAL_STORAGE\"");
        m.append(" android:maxSdkVersion=\"28\"/>\n");
        // The code scanner's own camera (CeeSafe ADR 0274), asked at run time by CodeScanner.open; with it declared,
        // the runtime asks it before a capture too.
        m.append("  <uses-permission android:name=\"android.permission.CAMERA\"/>\n");
    }
    if (o.microphone.view().length > 0) {
        // A voice note's recording (CeeSafe ADR 0272), asked at run time by AudioRecorder.start; and a call's audio
        // (CeeSafe ADR 0277), whose AudioManager goes into communication mode and picks the speaker or the earpiece.
        m.append("  <uses-permission android:name=\"android.permission.RECORD_AUDIO\"/>\n");
        m.append("  <uses-permission android:name=\"android.permission.MODIFY_AUDIO_SETTINGS\"/>\n");
    }
    if (o.contacts.view().length > 0) {
        // The address book (CeeSafe ADR 0271), asked at run time by Contacts.read.
        m.append("  <uses-permission android:name=\"android.permission.READ_CONTACTS\"/>\n");
    }
    if (o.calls) {
        // A call's notification over the lock screen (CeeSafe ADR 0278).
        m.append("  <uses-permission android:name=\"android.permission.USE_FULL_SCREEN_INTENT\"/>\n");
    }
    if (o.notifications) {
        // Android 13 and later ask for it at run time (CeeSafe ADR 0243); before them it is granted at install.
        m.append("  <uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\"/>\n");
    }
    if (o.bluetooth.view().length > 0) {
        // Android 12 and later ask for these two at run time (CeeSafe ADR 0177 §2.2), the scan never for a location;
        // Android 9 to 11 grant the first two at install and ask for the location, which a scan needs there.
        m.append("  <uses-permission android:name=\"android.permission.BLUETOOTH_CONNECT\"/>\n");
        m.append("  <uses-permission android:name=\"android.permission.BLUETOOTH_SCAN\"");
        m.append(" android:usesPermissionFlags=\"neverForLocation\"/>\n");
        m.append("  <uses-permission android:name=\"android.permission.BLUETOOTH\" android:maxSdkVersion=\"30\"/>\n");
        m.append(
            "  <uses-permission android:name=\"android.permission.BLUETOOTH_ADMIN\" android:maxSdkVersion=\"30\"/>\n",
        )!;
        m.append("  <uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"");
        m.append(" android:maxSdkVersion=\"30\"/>\n");
    }
    m.append("  <application android:label=\"")!;
    m.append(xml(o.name.view()).view());
    // Every APK has code: the provider through which the app's files go to another app (CeeSafe ADR 0268).
    m.append("\" android:hasCode=\"true\"");
    m.append(" android:extractNativeLibs=\"true\">\n");
    // The activity is kept through a rotation, a new size and the keyboard (CeeSafe ADR 0156 §2.3): destroyed, the
    // program would end with it.
    // One activity, whoever starts it: a start by another app or a link while the program runs comes to the one
    // that is there (singleTask). A second NativeActivity over it would be a second window of a program that has
    // one, with no elements for a screen reader.
    m.append("    <activity android:name=\"android.app.NativeActivity\" android:exported=\"true\"\n");
    m.append("              android:launchMode=\"singleTask\"\n");
    m.append("              android:configChanges=\"orientation|screenSize|screenLayout|keyboardHidden|density|")!;
    m.append("smallestScreenSize\">\n")!;
    m.append("      <meta-data android:name=\"android.app.lib_name\" android:value=\"main\"/>\n");
    m.append("      <intent-filter>\n        <action android:name=\"android.intent.action.MAIN\"/>\n");
    m.append("        <category android:name=\"android.intent.category.LAUNCHER\"/>\n      </intent-filter>\n");
    m.append("    </activity>\n");
    if (gradle) {
        // The push that comes while the app is not running (CeeSafe ADR 0249): src/PushService.java, in the app's
        // process, where Firebase's receiver hands it the message.
        m.append("    <service android:name=\"org.ceeui.pack.PushService\" android:exported=\"false\">\n");
        m.append("      <intent-filter>\n");
        m.append("        <action android:name=\"com.google.firebase.MESSAGING_EVENT\"/>\n");
        m.append("      </intent-filter>\n    </service>\n");
        if (o.calls) {
            // A call notification's choice (CeeSafe ADR 0278): src/CallChoice.java, a windowless activity.
            m.append("    <activity android:name=\"org.ceeui.pack.CallChoice\" android:exported=\"false\"");
            m.append(
                " android:theme=\"@android:style/Theme.Translucent.NoTitleBar\" android:excludeFromRecents=\"true\"",
            );
            m.append(" android:noHistory=\"true\" android:taskAffinity=\"\"/>\n");
        }
        if (o.extension.view().length > 0) {
            // The notification extension's process (CeeSafe ADR 0263): src/ExtensionHost.java, which PushService binds.
            m.append("    <service android:name=\"org.ceeui.pack.ExtensionHost\" android:exported=\"false\"");
            m.append(" android:process=\":push\"/>\n");
        }
    }
    // The app's files for another app (CeeSafe ADR 0268): src/Files.java, which ShareSheet and Launcher.openFile hand
    // as content://<package>.ceesafe.files/<path>, with a grant to read that one URI.
    m.append("    <provider android:name=\"org.ceesafe.Files\" android:authorities=\"");
    m.append(xml(o.id.view()).view());
    m.append(".ceesafe.files\"\n              android:exported=\"false\" android:grantUriPermissions=\"true\"/>\n");
    m.append("  </application>\n</manifest>\n");
    return m;
}

/// The messaging service an APK with Firebase carries (CeeSafe ADR 0249), and the class through which it starts the
/// app's notification extension (CeeSafe ADR 0263), whose natives the extension's runtime registers.
const PUSH_SERVICE: StringView = embedText("PushService.java");
const CALL_CHOICE: StringView = embedText("CallChoice.java");
const EXTENSION_CLASS: StringView = embedText("Extension.java");
const EXTENSION_HOST: StringView = embedText("ExtensionHost.java");
/// The content provider every APK carries (CeeSafe ADR 0268).
const FILES_PROVIDER: StringView = embedText("Files.java");

/// The Gradle that builds an APK with Firebase, and the Android Gradle plugin and Firebase Messaging it uses: the
/// wrapper pins the Gradle (fetched once into ~/.gradle), so a build does not depend on the one a machine has.
const GRADLE_VERSION: StringView = "9.6.0";
const ANDROID_PLUGIN_VERSION: StringView = "9.5.2";
const GOOGLE_SERVICES_VERSION: StringView = "4.6.0";
const FIREBASE_MESSAGING_VERSION: StringView = "26.0.2";

/// A Gradle to write the wrapper with: $CEEUI_GRADLE, else `gradle` on the PATH, else the newest a wrapper has
/// fetched under ~/.gradle; empty when there is none.
fn someGradle() -> String {
    if (Environment.variable("CEEUI_GRADLE") is Some(g)) {
        return text(g);
    }
    let found = output("sh", [
        "-c",
        "command -v gradle || ls -d \"$HOME\"/.gradle/wrapper/dists/gradle-*-bin/*/gradle-*/bin/gradle 2>/dev/null | sort -V | tail -1",
    ]);
    return text(found.view().trim());
}

/// An APK with Firebase Messaging (`--firebase`, CeeSafe ADR 0249), built by Gradle into `base` (unsigned): a project
/// in out/pack/android-gradle around what packAndroid made in out/pack/android (the manifest, lib/<abi>), with the
/// app's google-services.json, Firebase Messaging and the messaging service. Gradle merges the libraries' manifests,
/// resources and classes, which the Gradle-free path cannot. The project is kept between builds, for Gradle's caches.
fn gradleBuild(o: borrow Options, sdk: StringView, base: StringView) -> i32 {
    let project = "out/pack/android-gradle";
    let java = cat([project, "/java/org/ceeui/pack"]);
    let ceesafeJava = cat([project, "/java/org/ceesafe"]);
    if (!run("mkdir", ["-p", java.view(), ceesafeJava.view()])) {
        return fail("could not make out/pack/android-gradle");
    }
    if (!(File.kind(o.firebase.view()) is Ok(Some(PathKind.File)))) {
        return fail2("no google-services.json at ", o.firebase.view());
    }
    if (!run("cp", [o.firebase.view(), cat([project, "/google-services.json"]).view()])) {
        return fail("could not copy google-services.json");
    }
    var build = String.create();
    build.append("// Written by ceeui-pack --firebase (CeeSafe ADR 0249); made again at every build.\n");
    build.append("plugins {\n    id(\"com.android.application\") version \"")!;
    build.append(ANDROID_PLUGIN_VERSION);
    build.append("\"\n    id(\"com.google.gms.google-services\") version \"");
    build.append(GOOGLE_SERVICES_VERSION);
    build.append("\"\n}\nandroid {\n    namespace = \"");
    build.append(o.id.view());
    build.append("\"\n    compileSdk = 36\n    defaultConfig {\n        applicationId = \"");
    build.append(o.id.view());
    build.append("\"\n        minSdk = 25\n        targetSdk = 36\n        versionCode = 1\n        versionName = \"");
    build.append(o.version.view());
    build.append("\"\n    }\n    buildTypes { getByName(\"release\") { isMinifyEnabled = false } }\n")!;
    build.append("    packaging { jniLibs { useLegacyPackaging = true } }\n");
    build.append("    sourceSets {\n        getByName(\"main\") {\n");
    build.append("            manifest.srcFile(\"../android/AndroidManifest.xml\")\n");
    build.append("            jniLibs.directories.add(\"../android/lib\")\n");
    build.append("            java.directories.add(\"java\")\n        }\n    }\n}\n");
    build.append("dependencies {\n    implementation(\"com.google.firebase:firebase-messaging:")!;
    build.append(FIREBASE_MESSAGING_VERSION);
    build.append("\")\n}\n")!;
    let settings = cat([
        "pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }\n",
        "dependencyResolutionManagement { repositories { google(); mavenCentral() } }\n",
        "rootProject.name = \"app\"\n",
    ]);
    if (!writeText(cat([project, "/build.gradle.kts"]).view(), build.view()) ||
        !writeText(cat([project, "/settings.gradle.kts"]).view(), settings.view()) ||
        !writeText(
            cat([project, "/gradle.properties"]).view(),
            "android.useAndroidX=true\norg.gradle.jvmargs=-Xmx2g\n",
        ) ||
        !writeText(cat([project, "/local.properties"]).view(), cat(["sdk.dir=", sdk, "\n"]).view()) ||
        !writeText(cat([java.view(), "/PushService.java"]).view(), PUSH_SERVICE) ||
        !writeText(cat([java.view(), "/CallChoice.java"]).view(), CALL_CHOICE) ||
        !writeText(cat([ceesafeJava.view(), "/Extension.java"]).view(), EXTENSION_CLASS) ||
        !writeText(cat([java.view(), "/ExtensionHost.java"]).view(), EXTENSION_HOST) ||
        !writeText(cat([ceesafeJava.view(), "/Files.java"]).view(), FILES_PROVIDER)) {
        return fail("could not write the Gradle project");
    }
    let wrapperProperties = cat([project, "/gradle/wrapper/gradle-wrapper.properties"]);
    if (!readText(wrapperProperties.view()).view().contains(cat(["gradle-", GRADLE_VERSION, "-"]).view())) {
        let gradle = someGradle();
        if (gradle.view().length == 0) {
            return fail("no Gradle to write the wrapper with: install Gradle, or set CEEUI_GRADLE to one");
        }
        // The wrapper is written in an empty directory: the project's own build needs the wrapper's Gradle.
        let script = cat([
            "rm -rf out/pack/gradle-wrapper && mkdir -p out/pack/gradle-wrapper && cd out/pack/gradle-wrapper && ",
            "touch settings.gradle.kts && \"$0\" -q --no-daemon wrapper --gradle-version ",
            GRADLE_VERSION,
            " && cp -R gradlew gradle ../android-gradle/",
        ]);
        if (!run("sh", ["-c", script.view(), gradle.view()])) {
            return fail("could not write the Gradle wrapper");
        }
    }
    Console.writeLine("ceeui-pack: building with Gradle (Firebase Messaging)");
    if (!run("sh", ["-c", "cd out/pack/android-gradle && ./gradlew -q assembleRelease"])) {
        return fail("Gradle failed (out/pack/android-gradle)");
    }
    if (!run("cp", ["out/pack/android-gradle/build/outputs/apk/release/app-release-unsigned.apk", base])) {
        return fail("Gradle made no APK");
    }
    return 0;
}

fn packAndroid(o: borrow Options) -> i32 {
    if (o.extension.view().length > 0 && o.firebase.view().length == 0) {
        // The extension runs for a push (CeeSafe ADR 0263): only an APK with Firebase Messaging gets one.
        return fail("--extension on Android needs --firebase");
    }
    let home = Environment.variable("HOME") ?? "";
    let sdk = match (Environment.variable("ANDROID_HOME")) {
        Some(s) => text(s),
        null => match (Environment.variable("ANDROID_SDK_ROOT")) {
            Some(s) => text(s),
            null => {
                let mac = cat([home, "/Library/Android/sdk"]);
                if (File.kind(mac.view()) is Ok(Some(PathKind.Directory))) mac else cat([home, "/Android/Sdk"])
            }
        },
    };
    let ndk = match (Environment.variable("ANDROID_NDK_HOME")) {
        Some(n) => text(n),
        null => {
            let dir = cat([sdk.view(), "/ndk"]);
            cat([dir.view(), "/", newest(dir.view()).view()])
        }
    };
    let toolsDir = cat([sdk.view(), "/build-tools"]);
    let tools = cat([toolsDir.view(), "/", newest(toolsDir.view()).view()]);
    let platformsDir = cat([sdk.view(), "/platforms"]);
    let jar = cat([platformsDir.view(), "/", newest(platformsDir.view()).view(), "/android.jar"]);
    let prebuiltDir = cat([ndk.view(), "/toolchains/llvm/prebuilt"]);
    let bin = cat([prebuiltDir.view(), "/", newest(prebuiltDir.view()).view(), "/bin"]);
    if (!(File.kind(
        jar.view(),
    ) is Ok(Some(PathKind.File))) || !(File.kind(bin.view()) is Ok(Some(PathKind.Directory)))) {
        return fail2(
            "no Android SDK with an NDK, build-tools and a platform under ",
            sdk.view(),
        ) + fail("  set ANDROID_HOME (and ANDROID_NDK_HOME)");
    }
    let stage = "out/pack/android";
    if (!freshDirectory(stage)) {
        return fail("could not make out/pack/android");
    }
    var abis = o.abis.view().split(",");
    loop {
        let abi = match (abis.next()) {
            Some(a) => a.trim(),
            null => { break; }
        };
        let triple = androidTriple(abi);
        if (triple.length == 0) {
            return fail2("not an Android ABI: ", abi);
        }
        // API level 25 (Android 7.1) is CeeSafe's floor (its ADR 0188).
        let cc = cat([bin.view(), "/", triple, "25-clang"]);
        let lib = cat([stage, "/lib/", abi]);
        if (!run("mkdir", ["-p", lib.view()])) {
            return fail("could not make the library's directory");
        }
        let so = cat([lib.view(), "/libmain.so"]);
        // A shared library may have undefined symbols, and then the app cannot load on the phone: the link refuses
        // them here, where it can be seen (a dependency's library that was not built for Android, say).
        let flags: [StringView; 16] = [
            "--arch",
            androidArch(abi),
            "--cc",
            cc.view(),
            "--cflag",
            "-shared",
            "--cflag",
            "-Wl,--no-undefined",
            "--cflag",
            "-fPIC",
            "--cflag",
            "-landroid",
            "--cflag",
            "-llog",
            "-o",
            so.view(),
        ];
        var variable = String.create();
        if (Environment.variable("OPENSSL_ANDROID_DIR") == null) {
            let system = if (abi == "arm64-v8a") text("android-arm64") else cat(["android-", abi]);
            let found = mobileOpenssl(system.view());
            if (found.view().length > 0) {
                variable = cat(["OPENSSL_ANDROID_DIR=", found.view()]);
            }
        }
        if (!build(flags[..], "android", variable.view())) {
            return fail2("the app was not built for ", abi);
        }
        if (o.extension.view().length > 0) {
            // The notification extension (CeeSafe ADR 0263): the package in --extension's directory, built as the app
            // is, into lib/<abi>/libextension.so, which the push service loads in its own process.
            let extension = cat([Directory.current()!.view(), "/", lib.view(), "/libextension.so"]);
            var extensionFlags = Vector<StringView>.create();
            for (f in flags[0..14]) {
                extensionFlags.push(f);
            }
            extensionFlags.push("-o");
            extensionFlags.push(extension.view());
            if (!buildIn(o.extension.view(), extensionFlags.view(), "android", variable.view())) {
                return fail2("the notification extension was not built for ", abi);
            }
        }
    }
    let manifest = cat([stage, "/AndroidManifest.xml"]);
    if (!writeText(manifest.view(), androidManifest(o).view())) {
        return fail("could not write AndroidManifest.xml");
    }
    let base = cat([stage, "/base.apk"]);
    let aligned = cat([stage, "/aligned.apk"]);
    let apk = cat(["out/pack/", o.name.view(), ".apk"]);
    if (o.firebase.view().length > 0) {
        if (gradleBuild(o, sdk.view(), base.view()) != 0) {
            return 1;
        }
    } else {
        if (!run(
            cat([tools.view(), "/aapt2"]).view(),
            ["link", "-o", base.view(), "-I", jar.view(), "--manifest", manifest.view()],
        )) {
            return fail("aapt2 failed");
        }
        // The provider (CeeSafe ADR 0268), compiled with javac against the platform and made a classes.dex by d8.
        let source = cat([stage, "/java/org/ceesafe/Files.java"]);
        let classes = cat([stage, "/classes"]);
        if (!run("mkdir", ["-p", cat([stage, "/java/org/ceesafe"]).view(), classes.view()]) ||
            !writeText(source.view(), FILES_PROVIDER)) {
            return fail("could not write the provider's source");
        }
        if (!run(
            "javac",
            ["--release", "11", "-Xlint:-options", "-classpath", jar.view(), "-d", classes.view(), source.view()],
        )) {
            return fail("javac failed (is a JDK on PATH?)");
        }
        if (!run(
            cat([tools.view(), "/d8"]).view(),
            [
                "--release",
                "--min-api",
                "25",
                "--lib",
                jar.view(),
                "--output",
                stage,
                cat([classes.view(), "/org/ceesafe/Files.class"]).view(),
            ],
        )) {
            return fail("d8 failed");
        }
        // The libraries go into the archive under lib/<abi>/, and the dex at its root, which zip takes from the
        // directory it runs in.
        if (!run("sh", ["-c", "cd out/pack/android && zip -q -r base.apk lib classes.dex"])) {
            return fail("zip failed");
        }
    }
    if (!run(cat([tools.view(), "/zipalign"]).view(), ["-f", "-p", "4", base.view(), aligned.view()])) {
        return fail("zipalign failed");
    }
    let keystore = if (o.keystore.view().length > 0) text(o.keystore.view())
        else cat([home, "/.android/debug.keystore"]);
    let pass = cat(["pass:", o.storePass.view()]);
    if (!run(
        cat([tools.view(), "/apksigner"]).view(),
        ["sign", "--ks", keystore.view(), "--ks-pass", pass.view(), "--out", apk.view(), aligned.view()],
    )) {
        return fail("apksigner failed (is there a keystore? Android Studio makes ~/.android/debug.keystore)");
    }
    Console.write("packed ");
    Console.writeLine(apk.view());
    return 0;
}

/// The directory of the web host (ceeui-web) a package depends on: the path of its `ceeui_web` dependency in
/// the ceesafe.toml's text, or empty.
fn webHostPath(toml: StringView) -> String {
    var lines = toml.split("\n");
    loop {
        let line = match (lines.next()) {
            Some(l) => l.trim(),
            null => { break; }
        };
        match (line.splitOnce("=")) {
            Some(halves) => {
                if (halves.left.trim() == "ceeui_web") {
                    match (halves.right.indexOf("path")) {
                        Some(at) => {
                            let rest = halves.right[at..];
                            match (rest.indexOf("\"")) {
                                Some(open) => {
                                    let value = rest[open + 1..];
                                    match (value.indexOf("\"")) {
                                        Some(end) => { return text(value[0..end]); }
                                        null => {}
                                    }
                                }
                                null => {}
                            }
                        }
                        null => {}
                    }
                }
            }
            null => {}
        }
    }
    return String.create();
}

/// `n` in decimal.
fn decimal(n: usize) -> String {
    var s = String.create();
    if (n >= 10) {
        s.append(decimal(n / 10).view());
    }
    let digits = "0123456789";
    s.append(digits[n % 10..n % 10 + 1]);
    return s;
}

/// The web target's compiling and linking, for `sh -c`. What the program imports (web_wait and the rest) is the
/// page's worker's: left undefined, imported.
const WEB_COMPILE: StringView = "set -e\n" +
    "CLANG=${CLANG:-$( [ -x /opt/homebrew/opt/llvm/bin/clang ] && echo /opt/homebrew/opt/llvm/bin/clang || echo clang )}\n" +
    "objects=\"\"\n" +
    "for source in $(find out/pack/web-c -name '*.c'); do\n" +
    "    \"$CLANG\" --target=wasm64 -O2 -ffreestanding -nostdlib -mbulk-memory -Iout/pack/web-c -c \"$source\" -o \"${source%.c}.o\"\n" +
    "    objects=\"$objects ${source%.c}.o\"\n" +
    "done\n" +
    "\"${WASM_LD:-wasm-ld}\" -m wasm64 --no-entry --import-undefined --export=run --export=web_take -o out/pack/web/web.wasm $objects\n";

/// Copies the font files named on the lines of `list` into out/pack/web/fonts as PREFIX0, PREFIX1, ..., and appends
/// their names to `json` as an array; false when one cannot be copied.
fn copyFonts(list: StringView, prefix: StringView, json: borrow mut String) -> bool {
    json.append("[");
    var fonts = list.split("\n");
    var count: usize = 0;
    loop {
        let font = match (fonts.next()) {
            Some(f) => f,
            null => { break; }
        };
        if (font.length == 0) {
            continue;
        }
        let name = cat([prefix, decimal(count).view()]);
        if (!run("cp", [font, cat(["out/pack/web/fonts/", name.view()]).view()])) {
            return false;
        }
        if (count > 0) {
            json.append(", ");
        }
        json.append("\"")!;
        json.append(name.view());
        json.append("\"")!;
        count += 1;
    }
    json.append("]");
    return true;
}

/// The web target: the package's C from ceesafec, compiled and linked for 64-bit WebAssembly by clang and wasm-ld,
/// beside the web host's page, the app's fonts and app.json, which lists them.
fn packWeb(o: borrow Options, toml: StringView) -> i32 {
    let host = webHostPath(toml);
    if (host.view().length == 0) {
        return fail("the web target needs a package that depends on ceeui_web by path");
    }
    let out = "out/pack/web";
    let c = "out/pack/web-c";
    // The directory itself stays, so a serve.py running in it keeps serving.
    if (!run("rm", ["-rf", c, "out/pack/web/fonts"]) || !run("mkdir", ["-p", "out/pack/web/fonts"])) {
        return fail("cannot make out/pack/web");
    }
    if (!run("ceesafec", ["build", "--emit", "c", "-o", c])) {
        return fail("the package was not built");
    }
    if (!run("sh", ["-c", WEB_COMPILE])) {
        return fail("clang or wasm-ld failed: the web target needs a clang with the wasm64 target, and wasm-ld");
    }
    let page = cat([host.view(), "/page/"]);
    let html = readText(cat([page.view(), "index.html"]).view());
    let title = "<title>CeeUI</title>";
    match (html.view().indexOf(title)) {
        Some(at) => {
            let named = cat([
                html.view()[0..at],
                "<title>",
                xml(o.name.view()).view(),
                "</title>",
                html.view()[at + title.length..],
            ]);
            if (!writeText("out/pack/web/index.html", named.view())) {
                return fail("cannot write out/pack/web/index.html");
            }
        }
        null => { return fail2("no page in ", page.view()); }
    }
    for (file in ["web.js", "worker.js", "serve.py"]) {
        if (!run("cp", [cat([page.view(), file]).view(), out])) {
            return fail2("cannot copy ", file);
        }
    }
    // The fonts under plain names, and app.json with the names in the app's order.
    var json = text("{\"fonts\": ");
    if (!copyFonts(o.fonts.view(), "font-", mut json)) {
        return fail("cannot copy a font");
    }
    json.append(", \"fallbacks\": ");
    if (!copyFonts(o.fallbacks.view(), "fallback-", mut json)) {
        return fail("cannot copy a fallback font");
    }
    json.append("}\n");
    if (!writeText("out/pack/web/app.json", json.view())) {
        return fail("cannot write out/pack/web/app.json");
    }
    Console.writeLine("packed out/pack/web: python3 out/pack/web/serve.py, then http://localhost:8017/");
    return 0;
}

fn usage() -> i32 {
    Console.writeErrorLine("usage: ceeui_pack <macos|ios|ios-simulator|android|web> [--name NAME] [--id ID]");
    Console.writeErrorLine("           [--version V] [--abi arm64-v8a,x86_64] [--profile FILE] [--identity NAME]");
    Console.writeErrorLine(
        "           [--keystore FILE] [--keystore-pass PASSWORD] [--network WHY] [--bluetooth WHY]",
    );
    Console.writeErrorLine(
        "           [--camera WHY] [--microphone WHY] [--save-photos WHY] [--contacts WHY] [--calls]",
    );
    Console.writeErrorLine("           [--notifications] [--push] [--group ID] [--extension DIR] [--firebase FILE]");
    Console.writeErrorLine("           [--font FILE]... [--fallback FILE]...");
    Console.writeErrorLine("run in the app's package directory; the result is under out/pack");
    Console.writeErrorLine(
        "   or: ceeui_pack new NAME [--ceeui PATH]   a new app in directory NAME (its CeeUI",
    );
    Console.writeErrorLine("       packages from GitHub, or from the CeeUI checkout at PATH)");
    return 2;
}

/// `text` with every `from` in it replaced by `to`.
fn replaced(text: StringView, from: StringView, to: StringView) -> String {
    var out = String.create();
    let t = text.bytes();
    let f = from.bytes();
    var i: usize = 0;
    var run: usize = 0;
    while (i < t.length) {
        var same = f.length > 0 && i + f.length <= t.length;
        if (same) {
            for (k in 0..f.length) {
                if (t[i + k] != f[k]) {
                    same = false;
                    break;
                }
            }
        }
        if (same) {
            out.appendUtf8(t[run..i]);
            out.append(to);
            i += f.length;
            run = i;
        } else {
            i += 1;
        }
    }
    out.appendUtf8(t[run..t.length]);
    return out;
}

/// Whether `name` can name a package: lowercase letters, digits and underscores, a letter first.
fn packageName(name: StringView) -> bool {
    let b = name.bytes();
    if (b.length == 0 || b[0] < 'a' || b[0] > 'z') {
        return false;
    }
    for (c in b) {
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_')) {
            return false;
        }
    }
    return true;
}

/// `ceeui-pack new NAME [--ceeui PATH]`: a new app in directory NAME (templates.cee), depending on CeeUI's
/// packages from its repository, or from the checkout at PATH.
fn newApp() -> i32 {
    let name = Process.argument(2) ?? "";
    if (!packageName(name)) {
        return fail("new: give the app a name of lowercase letters, digits and underscores, a letter first");
    }
    var local = String.create();
    if (Process.argumentCount() >= 5 && (Process.argument(3) ?? "") == "--ceeui") {
        local = text(Process.argument(4) ?? "");
    } else if (Process.argumentCount() != 3) {
        return usage();
    }
    // Never over what is there.
    if (run("test", ["-e", name])) {
        return fail("new: there is already a file or directory of that name here");
    }
    var deps = String.create();
    for (dep in [
        ["ceeui", "ceeui"],
        ["ceeui_fonts", "ceeui-fonts"],
        ["ceeui_desktop", "ceeui-desktop"],
    ]) {
        deps.append(dep[0]);
        if (local.view().length > 0) {
            deps.append(" = { path = \"")!;
            deps.append(local.view());
            deps.append("/");
            deps.append(dep[1]);
            deps.append("\" }\n")!;
        } else {
            deps.append(" = { git = \"https://github.com/CeeSafe/CeeUI.git\", branch = \"main\", dir = \"")!;
            deps.append(dep[1]);
            deps.append("\" }\n")!;
        }
    }
    if (!run("mkdir", ["-p", cat([name, "/src"]).view()])) {
        return fail("new: cannot make the app's directory");
    }
    for (k in 0..TEMPLATE_COUNT) {
        let named = replaced(TEMPLATE_TEXTS[k], "__NAME__", name);
        let content = replaced(named.view(), "__DEPS__\n", deps.view());
        let path = cat([name, "/", TEMPLATE_PATHS[k]]);
        if (!writeText(path.view(), content.view())) {
            return fail("new: cannot write the app's files");
        }
    }
    Console.write("ceeui-pack: made ");
    Console.write(name);
    Console.writeLine(": a CeeUI app. Then:");
    Console.write("  cd ");
    Console.write(name);
    Console.write(" && ceesafec fetch && ceesafec build && out/");
    Console.writeLine(name);
    return 0;
}

fn main() -> i32 {
    if ((Process.argument(1) ?? "") == "new") {
        return newApp();
    }
    let toml = readText("ceesafe.toml");
    let package = tomlValue(toml.view(), "name");
    if (package.view().length == 0) {
        return fail("no ceesafe.toml with a name here: run it in the app's package directory");
    }
    var packageVersion = tomlValue(toml.view(), "version");
    if (packageVersion.view().length == 0) {
        packageVersion = text("1.0");
    }
    var o = Options {
        target: text(Process.argument(1) ?? ""),
        name: text(package.view()),
        id: cat(["com.example.", package.view()]),
        version: packageVersion,
        binary: text(package.view()),
        abis: text("arm64-v8a"),
        profile: String.create(),
        identity: String.create(),
        keystore: String.create(),
        storePass: text("android"),
        network: String.create(),
        camera: String.create(),
        contacts: String.create(),
        microphone: String.create(),
        savePhotos: String.create(),
        bluetooth: String.create(),
        notifications: false,
        calls: false,
        push: false,
        group: String.create(),
        extension: String.create(),
        firebase: String.create(),
        fonts: String.create(),
        fallbacks: String.create(),
    };
    var i: usize = 2;
    while (i < Process.argumentCount()) {
        let flag = Process.argument(i) ?? "";
        if (flag == "--calls") {
            o.calls = true; // a switch
            i += 1;
            continue;
        }
        if (flag == "--notifications") {
            o.notifications = true; // a switch: no value follows
            i += 1;
            continue;
        }
        if (flag == "--push") {
            o.push = true;
            i += 1;
            continue;
        }
        let value = match (Process.argument(i + 1)) {
            Some(v) => v,
            null => { return usage(); }
        };
        if (flag == "--name") {
            o.name = text(value);
        } else if (flag == "--id") {
            o.id = text(value);
        } else if (flag == "--version") {
            o.version = text(value);
        } else if (flag == "--abi") {
            o.abis = text(value);
        } else if (flag == "--profile") {
            o.profile = text(value);
        } else if (flag == "--identity") {
            o.identity = text(value);
        } else if (flag == "--keystore") {
            o.keystore = text(value);
        } else if (flag == "--keystore-pass") {
            o.storePass = text(value);
        } else if (flag == "--network") {
            o.network = text(value);
        } else if (flag == "--camera") {
            o.camera = text(value);
        } else if (flag == "--contacts") {
            o.contacts = text(value);
        } else if (flag == "--microphone") {
            o.microphone = text(value);
        } else if (flag == "--save-photos") {
            o.savePhotos = text(value);
        } else if (flag == "--group") {
            o.group = text(value);
        } else if (flag == "--extension") {
            o.extension = text(value);
        } else if (flag == "--firebase") {
            o.firebase = text(value);
        } else if (flag == "--bluetooth") {
            o.bluetooth = text(value);
        } else if (flag == "--fallback") {
            o.fallbacks.append(value);
            o.fallbacks.append("\n");
        } else if (flag == "--font") {
            o.fonts.append(value);
            o.fonts.append("\n");
        } else {
            return usage();
        }
        i += 2;
    }
    if (o.target.view() == "macos") {
        return packMac(o);
    }
    if (o.target.view() == "ios") {
        return packIos(o, false);
    }
    if (o.target.view() == "ios-simulator") {
        return packIos(o, true);
    }
    if (o.target.view() == "android") {
        return packAndroid(o);
    }
    if (o.target.view() == "web") {
        return packWeb(o, toml.view());
    }
    return usage();
}
