// SPDX-License-Identifier: MIT
// A ClayWind window on the desktop: a Pane is one window's Ui, Damage, input (DesktopPlatform) and clock, drawn by a
// Raster that several panes may share (its fonts and caches loaded once). The raster keeps the frame it drew last;
// with more than one window open, each pane keeps a copy of its own last frame (RasterFrame), so drawing another
// window between its frames costs it nothing: its next frame is still redrawn only where it changed.
//
//     var share = RasterShare.create();
//     loop {
//         if (pane.takeEvents(mut window)) { return 0; }
//         pane.begin(mut window);
//         myFrame(mut pane.ui, …);
//         if (!pane.end(mut window, raster)) { … }
//         pane.draw(mut raster, mut share, mut window, Color.hex(0x0F172AFF));
//         pane.platform.endFrame();
//         if (pane.ui.needsFrame()) { window.waitFrame(); } else { Window.waitAny(pane.ui.frameDelayMs(IDLE_MS)); }
//     }

import claywind;

/// The largest frame a desktop Raster is made for: a window larger than this at its scale is drawn at a lower one.
public const MAX_PIXELS_WIDTH: usize = 2880;
public const MAX_PIXELS_HEIGHT: usize = 1800;

/// How long an idle app sleeps for want of an event (an event or a wake ends it sooner).
public const IDLE_MS: u32 = 0xFFFFFFFF;

/// The ratio to draw at: the window's scale, lowered until `size` points fit the largest frame.
public fn ratioFor(size: WindowSize, scale: f32) -> f32 {
    let w = round<f32>(if (size.width < 1) 1 else size.width);
    let h = round<f32>(if (size.height < 1) 1 else size.height);
    let wanted = if (scale >= 1.0) scale else 1.0;
    let fitW = round<f32>(MAX_PIXELS_WIDTH) / w;
    let fitH = round<f32>(MAX_PIXELS_HEIGHT) / h;
    return wanted.min(fitW).min(fitH);
}

/// The frame's size in pixels for `size` points at `scale` (at ratioFor's ratio).
public fn pixelsFor(size: WindowSize, scale: f32) -> [usize; 2] {
    let ratio = ratioFor(size, scale);
    let w = saturatingTruncate<usize>(Math.round(round<f32>(size.width) * ratio));
    let h = saturatingTruncate<usize>(Math.round(round<f32>(size.height) * ratio));
    return [w.max(1).min(MAX_PIXELS_WIDTH), h.max(1).min(MAX_PIXELS_HEIGHT)];
}

/// The reason a window did not open, in words.
public fn windowError(e: WindowError) -> StringView => match (e) {
    WindowError.Unsupported => "this system has no window support",
    WindowError.NoDisplay => "no display",
    WindowError.NotMainThread => "not on the main thread",
    WindowError.Resources => "the system refused",
};

/// A Raster RasterCapacity for desktop windows: frames up to MAX_PIXELS, and room for the system's fallback fonts
/// (a CJK font is tens of megabytes).
public fn desktopRasterCapacity() -> RasterCapacity {
    var capacity = RasterCapacity.of(MAX_PIXELS_WIDTH, MAX_PIXELS_HEIGHT);
    capacity.fontBytes = 100663296;
    return capacity;
}

/// What the panes sharing one Raster know of it: which pane's frame it holds, and how many windows are open.
public struct RasterShare {
    owner: u32;
    windows: u32;

    public fn create() -> RasterShare => RasterShare { owner: 0, windows: 1 };

    /// How many windows draw with the raster now (a pane keeps a copy of its frames while there are two or more).
    public fn setWindows(borrow mut this, count: u32) {
        this.windows = count;
    }
}

/// One window's part of a desktop app: its Ui, the Damage of its frames, its last frame (with other windows open), its
/// input, and its clock.
public struct Pane<region r> {
    public ui: Ui<r>;
    public damage: Damage<r>;
    frame: RasterFrame<r>;
    public platform: DesktopPlatform;
    last: u64;
    id: u32;
    /// Whether the window was asked for its touches (they are turned on at the first events taken).
    touchesAsked: bool;

    /// A pane numbered `id` (each window's its own, from 1), with room for `elements` elements and `commands` render
    /// commands a frame, frames of up to `pixels` pixels kept, for a window of `size` points.
    public fn create(
        memory: borrow(r) FixedBufferAllocator,
        id: u32,
        elements: usize,
        commands: usize,
        pixels: usize,
        size: WindowSize,
    ) -> Result<Pane<r>, AllocError> {
        return Ok(Pane {
            ui: Ui.create(memory, UiCapacity.of(elements))?,
            damage: Damage.create(memory, commands)?,
            frame: RasterFrame.create(memory, pixels)?,
            platform: DesktopPlatform.create(Dims { w: round<f32>(size.width), h: round<f32>(size.height) }),
            last: Timer.now(),
            id: id,
            touchesAsked: false,
        });
    }

    /// Takes the window's events, touches and safe area into the platform; true when the window asks to close. On a
    /// touch screen (iOS, Android) the window gives every finger, for the Ui's gestures, instead of a pointer.
    public fn takeEvents(borrow mut this, window: borrow mut Window) -> bool {
        let closed = this.takeQueued(mut window);
        this.platform.setSafeArea(window.safeArea()); // after the events: a change came as one of them
        return closed;
    }

    fn takeQueued(borrow mut this, window: borrow mut Window) -> bool {
        if (!this.touchesAsked) {
            this.touchesAsked = true;
            let _ = window.setTouches(true);
        }
        loop {
            match (window.nextTouch()) {
                Some(t) => { this.platform.touch(t); }
                null => { break; }
            }
        }
        loop {
            match (window.nextEvent()) {
                Some(WindowEvent.Closed) => { return true; }
                Some(e) => { this.platform.apply(e); }
                null => { return false; }
            }
        }
    }

    /// Starts a frame: the clock, the input, and the text the window's input method has.
    public fn begin(borrow mut this, window: borrow mut Window) {
        let now = Timer.now();
        this.platform.setFrameTime(round<f32>(now - this.last) / 1000.0);
        this.last = now;
        this.ui.begin(mut this.platform);
        this.platform.editInto(mut this.ui, mut window);
    }

    /// Ends a frame: layout (measured by `metrics`), the text input's place and the cursor. False when the frame
    /// does not fit the Ui's capacity.
    public fn end<M: TextMetrics>(borrow mut this, window: borrow mut Window, metrics: borrow M) -> bool {
        match (this.ui.endFrame(mut this.platform, metrics)) {
            Ok() => {}
            Err(_) => { return false; }
        }
        this.platform.editFrom(this.ui, mut window);
        window.setCursor(windowCursor(this.platform.cursor));
        return true;
    }

    /// Draws the frame into `raster` over `clear` and shows what changed in `window`. The raster first takes back
    /// this pane's last frame if it holds another's; with other windows open, the pane keeps a copy of what it drew.
    /// False when the window refused the frame.
    public fn draw(
        borrow mut this,
        raster: borrow mut Raster,
        share: borrow mut RasterShare,
        window: borrow mut Window,
        clear: Color,
    ) -> bool {
        let size = window.size();
        let scale = window.scale();
        let px = pixelsFor(size, scale);
        let ratio = ratioFor(size, scale);
        var boxes = this.damage.plan(this.ui, clear, px[0], px[1], ratio);
        if (boxes == 0) {
            return true;
        }
        if (share.owner != this.id) {
            if (!raster.takeFrame(mut this.frame)) {
                this.damage.invalidate(); // no frame of its own to draw over: draw it whole
                boxes = this.damage.plan(this.ui, clear, px[0], px[1], ratio);
            }
            share.owner = this.id;
        }
        raster.setPixelRatio(ratio);
        raster.resize(px[0], px[1]);
        this.damage.draw(mut raster, this.ui, clear);
        if (share.windows > 1 && !raster.keepFrame(mut this.frame)) {
            this.frame.clear(); // too large to keep: drawn whole after another window's frame
        }
        // Only the boxes Damage redrew changed: the window shows just those (Window.presentChanged).
        var shown = [WindowBox { x: 0, y: 0, width: 0, height: 0 }; 4];
        for (k in 0..boxes) {
            let r = this.damage.redrawn(k);
            shown[k] = WindowBox {
                x: saturatingTruncate<u32>(r.x),
                y: saturatingTruncate<u32>(r.y),
                width: saturatingTruncate<u32>(r.w),
                height: saturatingTruncate<u32>(r.h),
            };
        }
        let width = truncate<u32>(raster.frameWidth());
        let height = truncate<u32>(raster.frameHeight());
        return window.presentChanged(raster.pixels(), width, height, shown[0..boxes]).isOk();
    }

    /// The pane's window closed: it forgets its frame, and its next window starts with a whole one.
    public fn forget(borrow mut this, share: borrow mut RasterShare) {
        this.frame.clear();
        this.damage.invalidate();
        if (share.owner == this.id) {
            share.owner = 0;
        }
    }
}
