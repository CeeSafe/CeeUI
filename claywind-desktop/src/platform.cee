// SPDX-License-Identifier: MIT
// A native window (lib/std's Window, CeeSafe ADR 0069) as a ClayWind platform: its events folded into per-frame state.

import claywind.Platform;
import claywind.Pointer;
import claywind.Cursor;
import claywind.Key;
import claywind.Dims;
import claywind.Vec2;
import claywind.Insets;
import claywind.TextKind;
import claywind.ReturnKey;
import claywind.keyIndex;
import claywind.Ui;
import claywind.EditCommand;
import claywind.Keystroke;
import claywind.Modifiers;
import claywind.FileDrag;
import claywind.Touch;
import claywind.TouchPhase;

/// Wheel lines to ClayWind's wheel units: what the browser host's page sends for one notch.
const WHEEL_UNITS: f32 = 2.5;

public struct DesktopPlatform {
    size: Dims;
    /// The window's safe area (CeeSafe's Window.safeArea, ADR 0156): none on a desktop.
    safe: Insets;
    /// The soft keyboard's inset (CeeSafe's Window.keyboardInset, ADR 0157): none on a desktop.
    keyboard: f32;
    pointerState: Pointer;
    /// Keys held, went down this frame, and OS-repeated this frame, by `keyIndex`.
    down: u64;
    pressed: u64;
    repeated: u64;
    typed: [u32; 64];
    typedCount: usize;
    typedRead: usize;
    dt: f32;
    clock: f64;
    public cursor: Cursor;
    /// Keys pressed this frame with their modifiers, for the Ui's key bindings; and whether the input method was
    /// on after the last frame.
    strokes: [Keystroke; 16];
    strokeCount: usize;
    strokeRead: usize;
    textInput: bool;
    /// Actions chosen in the window's menu this frame (their names' hashes), for the Ui (Platform.nextChosenAction).
    chosen: [u32; 8];
    chosenCount: usize;
    chosenRead: usize;
    /// Files dragged from the system over the window this frame (the host sets it from Window.dragOver and nextDrop).
    files: FileDrag?;
    /// The window's touches this frame (CeeSafe's Window.nextTouch, ADR 0155), for the Ui's gestures; past 64 a frame,
    /// later moves are left out, never a finger's start or end.
    touches: [Touch; 64];
    touchCount: usize;
    touchRead: usize;

    public fn create(size: Dims) -> DesktopPlatform => DesktopPlatform {
        size: size,
        safe: Insets.zero(),
        keyboard: 0.0,
        pointerState: Pointer.at(Vec2 { x: -100.0, y: -100.0 }),
        down: 0,
        pressed: 0,
        repeated: 0,
        typed: [0u32; 64],
        typedCount: 0,
        typedRead: 0,
        dt: 0.0,
        clock: 0.0,
        cursor: Cursor.Default,
        strokes: [Keystroke { key: null, character: 0, modifiers: Modifiers.none() }; 16],
        strokeCount: 0,
        strokeRead: 0,
        textInput: false,
        chosen: [0u32; 8],
        chosenCount: 0,
        chosenRead: 0,
        files: null,
        touches: [Touch { id: 0, phase: TouchPhase.Began, position: Vec2.zero(), time: 0.0 }; 64],
        touchCount: 0,
        touchRead: 0,
    };

    /// The window's safe area, which the host reads with the window's events (a change comes as a Resized).
    public fn setSafeArea(borrow mut this, safe: WindowInsets) {
        this.safe = Insets { left: safe.left, top: safe.top, right: safe.right, bottom: safe.bottom };
    }

    /// How much of the window's bottom the soft keyboard covers, read as the safe area is.
    public fn setKeyboardInset(borrow mut this, inset: f32) {
        this.keyboard = inset;
    }

    /// A touch from the window, for this frame.
    public fn touch(borrow mut this, t: WindowTouch) {
        let phase = match (t.phase) {
            WindowTouchPhase.Began => TouchPhase.Began,
            WindowTouchPhase.Moved => TouchPhase.Moved,
            WindowTouchPhase.Ended => TouchPhase.Ended,
            WindowTouchPhase.Cancelled => TouchPhase.Cancelled,
        };
        let moved = match (phase) {
            TouchPhase.Moved => true,
            _ => false,
        };
        if (this.touchCount == 64 || (moved && this.touchCount >= 56)) {
            return; // the last eight places are kept for starts and ends
        }
        this.touches[this.touchCount] = Touch {
            id: t.id,
            phase: phase,
            position: Vec2 { x: t.x, y: t.y },
            time: round<f64>(t.time) / 1000000000.0,
        };
        this.touchCount += 1;
    }

    /// Files the system drags over the window this frame, or dropped (`dropped`), or none (null).
    public fn setFileDrag(borrow mut this, files: FileDrag?) {
        this.files = files;
    }

    /// An action chosen in the window's menu (its name's hash), for the next frame.
    public fn choose(borrow mut this, action: u32) {
        if (this.chosenCount < 8) {
            this.chosen[this.chosenCount] = action;
            this.chosenCount += 1;
        }
    }

    /// Seconds since the previous frame (the host measures it).
    public fn setFrameTime(borrow mut this, seconds: f32) {
        this.dt = if (seconds > 0.25) 0.25 else seconds;
        this.clock += seconds as f64;
    }

    /// Clears the one-frame edges after a frame used them.
    public fn endFrame(borrow mut this) {
        this.pointerState.pressed = false;
        this.pointerState.released = false;
        this.pointerState.secondaryPressed = false;
        this.pointerState.wheel = Vec2.zero();
        this.pressed = 0;
        this.repeated = 0;
        this.typedCount = 0;
        this.typedRead = 0;
        this.strokeCount = 0;
        this.strokeRead = 0;
        this.chosenCount = 0;
        this.chosenRead = 0;
        this.touchCount = 0;
        this.touchRead = 0;
    }

    /// After `ui.begin` (whose key bindings turned this frame's shortcuts into edit commands): the clipboard's text
    /// for a Paste, and the input method's composition, into the Ui.
    public fn editInto(borrow this, ui: borrow mut Ui, window: borrow mut Window) {
        if (ui.commanded(EditCommand.Paste)) {
            var text = String.create();
            if (window.clipboardText(mut text)) {
                ui.paste(text.view().bytes());
            }
        }
        ui.setComposition(window.composition().bytes(), window.compositionCaret());
    }

    /// After the frame: what it copied onto the clipboard, and the input method on while a text field has focus,
    /// its candidate window at the field's caret (in points).
    public fn editFrom(borrow mut this, ui: borrow Ui, window: borrow mut Window) {
        match (ui.copiedText()) {
            Some(bytes) => {
                match (StringView.fromUtf8(bytes)) {
                    Some(text) => { let ignored = window.setClipboardText(text); }
                    null => {}
                }
            }
            null => {}
        }
        let wanted = ui.wantsTextInput();
        if (wanted) {
            // The kind of text first, so that a phone's keyboard comes up as the field's (the window ignores a kind
            // it already has, and a desktop every kind).
            window.setTextInputKind(match (ui.textInputKind()) {
                TextKind.Text => WindowTextKind.Text,
                TextKind.Number => WindowTextKind.Number,
                TextKind.Decimal => WindowTextKind.Decimal,
                TextKind.Email => WindowTextKind.Email,
                TextKind.Url => WindowTextKind.Url,
                TextKind.Password => WindowTextKind.Password,
            });
            // What its Return key says (CeeSafe ADR 0161).
            window.setReturnKey(match (ui.returnKey()) {
                ReturnKey.Done => WindowReturnKey.Done,
                ReturnKey.Go => WindowReturnKey.Go,
                ReturnKey.Next => WindowReturnKey.Next,
                ReturnKey.Search => WindowReturnKey.Search,
                ReturnKey.Send => WindowReturnKey.Send,
                ReturnKey.System => WindowReturnKey.Default,
            });
        }
        if (wanted != this.textInput) {
            window.setTextInput(wanted);
            this.textInput = wanted;
        }
        if (wanted) {
            let area = ui.textInputArea();
            window.setTextInputArea(WindowBox {
                x: saturatingTruncate<u32>(area.x.max(0.0)),
                y: saturatingTruncate<u32>(area.y.max(0.0)),
                width: saturatingTruncate<u32>(area.w.max(1.0)),
                height: saturatingTruncate<u32>(area.h.max(1.0)),
            });
        }
    }

    /// Folds one window event into this frame's state (Closed is the host's).
    public fn apply(borrow mut this, e: WindowEvent) {
        match (e) {
            WindowEvent.Resized(s) => { this.size = Dims { w: round<f32>(s.width), h: round<f32>(s.height) }; }
            WindowEvent.PointerMoved(x, y) => { this.pointerState.position = Vec2 { x: x, y: y }; }
            WindowEvent.PointerButton(button, down, x, y) => {
                this.pointerState.position = Vec2 { x: x, y: y };
                match (button) {
                    WindowButton.Secondary => {
                        this.pointerState.secondaryDown = down;
                        if (down) {
                            this.pointerState.secondaryPressed = true;
                        }
                    }
                    WindowButton.Middle => {}
                    WindowButton.Primary => {
                        if (down) {
                            this.pointerState.down = true;
                            this.pointerState.pressed = true;
                        } else if (this.pointerState.down) {
                            this.pointerState.down = false;
                            this.pointerState.released = true;
                        }
                    }
                }
            }
            WindowEvent.Wheel(_, dy) => { this.pointerState.wheel.y += dy * WHEEL_UNITS; }
            WindowEvent.Key(key, down, repeat, modifiers) => {
                // A modifier key alone sends nothing on every system, so the held modifiers come with each key.
                this.hold(Key.LeftShift, modifiers.shift);
                this.hold(Key.LeftControl, modifiers.control);
                this.hold(Key.LeftAlt, modifiers.alt);
                // Each key pressed (or repeated), with its modifiers, for the Ui's key bindings.
                if (down && this.strokeCount < 16) {
                    let m = Modifiers {
                        shift: modifiers.shift,
                        control: modifiers.control,
                        alt: modifiers.alt,
                        command: modifiers.command,
                    };
                    let character = match (key) {
                        WindowKey.Character(c) => if (c >= 'A' && c <= 'Z') c + 32 else c,
                        _ => 0,
                    };
                    let named = match (key) {
                        WindowKey.Character(_) => null,
                        _ => claywindKey(key),
                    };
                    if (character != 0 || named != null) {
                        this.strokes[this.strokeCount] = Keystroke { key: named, character: character, modifiers: m };
                        this.strokeCount += 1;
                    }
                }
                match (claywindKey(key)) {
                    Some(k) => {
                        let bit = 1u64 << (keyIndex(k) as u64);
                        if (!down) {
                            this.down = this.down & (bit ^ 0xFFFFFFFFFFFFFFFF);
                        } else if (repeat) {
                            this.repeated = this.repeated | bit;
                        } else {
                            this.down = this.down | bit;
                            this.pressed = this.pressed | bit;
                        }
                    }
                    null => {}
                }
            }
            WindowEvent.Text(c) => {
                if (this.typedCount < 64) {
                    this.typed[this.typedCount] = c;
                    this.typedCount += 1;
                }
            }
            WindowEvent.Focus(focused) => {
                if (!focused) {
                    // Keys and buttons released while another window had the focus never arrive.
                    this.down = 0;
                    this.pointerState.down = false;
                    this.pointerState.secondaryDown = false;
                }
            }
            WindowEvent.Closed => {}
            // The window keeps the composition; editInto passes it on every frame.
            WindowEvent.Composition => {}
        }
    }

    fn hold(borrow mut this, key: Key, held: bool) {
        let bit = 1u64 << (keyIndex(key) as u64);
        this.down = if (held) this.down | bit else this.down & (bit ^ 0xFFFFFFFFFFFFFFFF);
    }
}

impl Platform for DesktopPlatform {
    fn fileDrag(borrow this) -> FileDrag? => this.files;
    fn nextTouch(borrow mut this) -> Touch? {
        if (this.touchRead >= this.touchCount) {
            return null;
        }
        let t = this.touches[this.touchRead];
        this.touchRead += 1;
        return t;
    }
    fn nextChosenAction(borrow mut this) -> u32 {
        if (this.chosenRead >= this.chosenCount) {
            return 0;
        }
        let c = this.chosen[this.chosenRead];
        this.chosenRead += 1;
        return c;
    }
    fn screenSize(borrow this) -> Dims => this.size;
    fn safeArea(borrow this) -> Insets => this.safe;
    fn keyboardInset(borrow this) -> f32 => this.keyboard;
    fn frameTime(borrow this) -> f32 => this.dt;
    fn time(borrow this) -> f64 => this.clock;
    fn pointer(borrow this) -> Pointer => this.pointerState;
    fn keyDown(borrow this, key: Key) -> bool => (this.down >> (keyIndex(key) as u64)) & 1 == 1;
    fn keyPressed(borrow this, key: Key) -> bool => (this.pressed >> (keyIndex(key) as u64)) & 1 == 1;
    fn keyRepeated(borrow this, key: Key) -> bool => (this.repeated >> (keyIndex(key) as u64)) & 1 == 1;
    fn nextKeystroke(borrow mut this) -> Keystroke? {
        if (this.strokeRead >= this.strokeCount) {
            return null;
        }
        let s = this.strokes[this.strokeRead];
        this.strokeRead += 1;
        return s;
    }
    fn nextChar(borrow mut this) -> u32 {
        if (this.typedRead >= this.typedCount) {
            return 0;
        }
        let c = this.typed[this.typedRead];
        this.typedRead += 1;
        return c;
    }
    fn setCursor(borrow mut this, cursor: Cursor) {
        this.cursor = cursor;
    }
}

/// The window's key as ClayWind's; printable keys arrive as typed text instead (`Text`).
fn claywindKey(key: WindowKey) -> Key? => match (key) {
    WindowKey.Escape => Key.Escape,
    WindowKey.Enter => Key.Enter,
    WindowKey.Tab => Key.Tab,
    WindowKey.Backspace => Key.Backspace,
    WindowKey.Delete => Key.Delete,
    WindowKey.Left => Key.Left,
    WindowKey.Right => Key.Right,
    WindowKey.Up => Key.Up,
    WindowKey.Down => Key.Down,
    WindowKey.Home => Key.Home,
    WindowKey.End => Key.End,
    WindowKey.PageUp => Key.PageUp,
    WindowKey.PageDown => Key.PageDown,
    WindowKey.Function(n) => match (n) {
        1 => Key.F1,
        2 => Key.F2,
        3 => Key.F3,
        4 => Key.F4,
        5 => Key.F5,
        6 => Key.F6,
        7 => Key.F7,
        8 => Key.F8,
        9 => Key.F9,
        10 => Key.F10,
        11 => Key.F11,
        _ => Key.F12,
    },
    _ => null,
};

/// ClayWind's cursor as the window's.
public fn windowCursor(cursor: Cursor) -> WindowCursor => match (cursor) {
    Cursor.Default => WindowCursor.Default,
    Cursor.Pointer => WindowCursor.Pointer,
    Cursor.Text => WindowCursor.Text,
};
