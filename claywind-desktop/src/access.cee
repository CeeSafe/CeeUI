// SPDX-License-Identifier: MIT
// Accessibility (roadmap P5): the Ui's elements for a screen reader go to the window (CeeSafe's ADR 0164), and what
// the reader asks comes back as the Ui's actions. The window is told only when the list changed.

import claywind;

fn windowRole(role: AccessRole) -> WindowAccessRole => match (role) {
    AccessRole.Text => WindowAccessRole.Text,
    AccessRole.Button => WindowAccessRole.Button,
    AccessRole.Checkbox => WindowAccessRole.Checkbox,
    AccessRole.Radio => WindowAccessRole.Radio,
    AccessRole.TextField => WindowAccessRole.TextField,
    AccessRole.Slider => WindowAccessRole.Slider,
    AccessRole.Tab => WindowAccessRole.Tab,
    AccessRole.ListItem => WindowAccessRole.ListItem,
    AccessRole.MenuItem => WindowAccessRole.MenuItem,
    AccessRole.Dropdown => WindowAccessRole.Dropdown,
    AccessRole.Image => WindowAccessRole.Image,
};

fn roleNumber(role: AccessRole) -> u64 => match (role) {
    AccessRole.Text => 0,
    AccessRole.Button => 1,
    AccessRole.Checkbox => 2,
    AccessRole.Radio => 3,
    AccessRole.TextField => 4,
    AccessRole.Slider => 5,
    AccessRole.Tab => 6,
    AccessRole.ListItem => 7,
    AccessRole.MenuItem => 8,
    AccessRole.Dropdown => 9,
    AccessRole.Image => 10,
};

fn mix(sum: u64, value: u64) -> u64 => (sum ^ value).wrappingMul(0x100000001B3);

fn mixBytes(sum: u64, bytes: Slice<u8>) -> u64 {
    var s = mix(sum, bytes.length as u64);
    for (b in bytes) {
        s = mix(s, b as u64);
    }
    return s;
}

/// What a frame's accessible elements come to, as one number: equal for two frames a reader could not tell apart.
fn accessSum(ui: borrow Ui) -> u64 {
    var sum: u64 = 0xCBF29CE484222325;
    for (i in 0..ui.accessCount()) {
        let node = ui.accessAt(i);
        sum = mix(sum, node.id as u64);
        sum = mix(sum, roleNumber(node.role));
        sum = mix(sum, node.flags as u64);
        sum = mix(sum, node.min.bits() as u64);
        sum = mix(sum, node.max.bits() as u64);
        sum = mix(sum, node.now.bits() as u64);
        sum = mix(sum, node.caret as u64);
        sum = mix(sum, node.anchor as u64);
        match (ui.accessBox(node)) {
            Some(box) => {
                sum = mix(sum, box.x.bits() as u64);
                sum = mix(sum, box.y.bits() as u64);
                sum = mix(sum, box.w.bits() as u64);
                sum = mix(sum, box.h.bits() as u64);
            }
            null => { sum = mix(sum, 1); }
        }
        sum = mixBytes(sum, ui.accessLabel(node));
        sum = mixBytes(sum, ui.accessValueOf(node));
    }
    return sum;
}

/// The reader's requests waiting in `window`, into `ui`: its next frame's controls see them.
public fn takeAccessActions(ui: borrow mut Ui, window: borrow mut Window) {
    loop {
        match (window.takeAccessAction()) {
            Some(request) => {
                let action = match (request.action) {
                    WindowAccessAction.Press => AccessAction.Press,
                    WindowAccessAction.Focus => AccessAction.Focus,
                    WindowAccessAction.Increment => AccessAction.Increment,
                    WindowAccessAction.Decrement => AccessAction.Decrement,
                };
                let _ = ui.accessAct(truncate<u32>(request.id), action);
            }
            null => { break; }
        }
    }
}

/// The frame `ui` just laid out, as `window`'s elements, if it is not what the window has (`last`, which is
/// updated). An element with no place, with the id 0 or with an id an earlier one has is left out: the window
/// takes each id once. Out of memory, the window keeps what it had.
public fn giveAccessNodes(ui: borrow Ui, window: borrow mut Window, last: borrow mut u64) {
    let sum = accessSum(ui);
    if (sum == last) {
        return;
    }
    var nodes = Vector<WindowAccessNode>.create();
    var text = Vector<u8>.create();
    for (i in 0..ui.accessCount()) {
        let node = ui.accessAt(i);
        if (node.id == 0) {
            continue;
        }
        var seen = false;
        for (k in 0..nodes.length) {
            if (nodes[k].id == node.id as u64) {
                seen = true;
                break;
            }
        }
        if (seen) {
            continue;
        }
        let box = match (ui.accessBox(node)) {
            Some(b) => b,
            null => { continue; }
        };
        let labelStart = truncate<u32>(text.length);
        let label = ui.accessLabel(node);
        let value = ui.accessValueOf(node);
        var ok = true;
        for (b in label) {
            ok = ok && text.push(b) is Ok();
        }
        let valueStart = truncate<u32>(text.length);
        for (b in value) {
            ok = ok && text.push(b) is Ok();
        }
        ok = ok && nodes.push(WindowAccessNode {
            id: node.id as u64,
            role: windowRole(node.role),
            flags: node.flags, // the Ui's flags are the window's, bit for bit
            x: box.x,
            y: box.y,
            width: box.w,
            height: box.h,
            min: node.min as f64,
            max: node.max as f64,
            now: node.now as f64,
            labelStart: labelStart,
            labelLength: truncate<u32>(label.length),
            valueStart: valueStart,
            valueLength: truncate<u32>(value.length),
            caret: truncate<u32>(node.caret.min(value.length)),
            anchor: truncate<u32>(node.anchor.min(value.length)),
        }) is Ok();
        if (!ok) {
            return;
        }
    }
    window.setAccessNodes(nodes.view(), text.view());
    last = sum;
}
